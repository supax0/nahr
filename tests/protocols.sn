// WebSocket handshake, frames and close codes; SSE encoding.
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان, من_بايتات;
من نهر.معالجة استورد طلب;
من نهر.ردود استورد استجابة;
من نهر.مقبس_ويب استورد
    تحقق_مصافحة_مقبس_ويب, مفتاح_قبول_مقبس_ويب, رد_مصافحة_مقبس_ويب,
    رد_رفض_مصافحة_مقبس_ويب, خطأ_مصافحة_مقبس_ويب,
    إطار, إطار_نصي, رمز_إطار_خادم, حلل_إطار_عميل, إطار_محلل, خطأ_إطار,
    مجمع_رسالة, أنشئ_مجمع_رسالة, أنشئ_مجمع_رسالة_بحد, ادفع_إطارا,
    رسالة, خطأ_رسالة, نوع_إطار, رمز_إغلاق_لخطأ, رمز_إغلاق_مقبول;
من نهر.أحداث استورد حدث, أنشئ_حدثا, عين_نوع_حدث, نسق_حدثا, خطأ_حدث;
من نهر.اختبار استورد أنشئ_طلبا, عين_رأس_طلب, حالة_الرد, رأس_الرد_أو_فارغ;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    ليكن الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    ليكن لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

عرف رأس(الطلب: &متغير طلب, الاسم: نص, القيمة: نص): فراغ {
    ليكن تجاهل: منطقي = عين_رأس_طلب(الطلب, &الاسم, &القيمة);
}

// A masked client frame with the given opcode byte and payload.
عرف إطار_عميل(الأول: ط8, الحمولة: &متجه ط8): متجه ط8 {
    ليكن الناتج: متغير متجه ط8 = [];
    ألحق(الناتج, الأول);
    ألحق(الناتج, 0x80 | (الطول(*الحمولة) مثل ط8));
    ليكن القناع: متجه ط8 = [0x11, 0x22, 0x33, 0x44];
    ألحق(الناتج, القناع[0]);
    ألحق(الناتج, القناع[1]);
    ألحق(الناتج, القناع[2]);
    ألحق(الناتج, القناع[3]);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحمولة) مثل طبيعي)) {
        ألحق(الناتج, (*الحمولة)[ف] ^ القناع[ف % 4]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

عرف ادفع(المجمع: &متغير مجمع_رسالة, البايتات: &متجه ط8): نتيجة اختياري رسالة, خطأ_رسالة {
    طابق حلل_إطار_عميل(البايتات) مع
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(خطأ_رسالة.استمرار_بلا_بداية()); }
    | نتيجة.نجح(المحلل) -> { أرجع ادفع_إطارا(المجمع, &المحلل.الإطار); };
}

@@اختبار
عرف مقبس_الويب_والأحداث(): نتيجة عدد, فشل {
    // RFC 6455 §1.3 example key.
    ليكن المفتاح: نص = «dGhlIHNhbXBsZSBub25jZQ==»;
    ليكن القبول: نص = مفتاح_قبول_مقبس_ويب(&المفتاح);
    ليكن المتوقع: نص = «s3pPLMBiTxaQ9kYGzzhZRbK+xOo=»;
    إذا (!نصان_متساويان(&القبول, &المتوقع)) { أرجع لم_يتحقق("!نصان_متساويان(&القبول, &المتوقع)"); };

    ليكن get: نص = «GET»;
    ليكن الهدف: نص = «/ws»;
    ليكن ق: متغير طلب = أنشئ_طلبا(&get, &الهدف);
    رأس(&متغير ق, «host», «example.com»);
    رأس(&متغير ق, «upgrade», «WebSocket»);
    رأس(&متغير ق, «connection», «keep-alive, Upgrade»);
    رأس(&متغير ق, «sec-websocket-key», «dGhlIHNhbXBsZSBub25jZQ==»);
    رأس(&متغير ق, «sec-websocket-version», «13»);
    طابق تحقق_مصافحة_مقبس_ويب(&ق) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق تحقق_مصافحة_مقبس_ويب(&ق) مع"); }
    | نتيجة.نجح(_) -> { };
    رأس(&متغير ق, «sec-websocket-version», «8»);
    طابق تحقق_مصافحة_مقبس_ويب(&ق) مع
    | نتيجة.نجح(_) -> { أرجع لم_يتحقق("طابق تحقق_مصافحة_مقبس_ويب(&ق) مع"); }
    | نتيجة.خطأ(الخطأ) -> {
        ليكن ر: استجابة = رد_رفض_مصافحة_مقبس_ويب(&الخطأ);
        إذا (حالة_الرد(&ر) != 426) { أرجع لم_يتحقق("حالة_الرد(&ر) != 426"); };
        ليكن الاسم: نص = «sec-websocket-version»;
        ليكن القيمة: نص = رأس_الرد_أو_فارغ(&ر, &الاسم);
        ليكن ثلاثة_عشر: نص = «13»;
        إذا (!نصان_متساويان(&القيمة, &ثلاثة_عشر)) { أرجع لم_يتحقق("!نصان_متساويان(&القيمة, &ثلاثة_عشر)"); };
    };

    // Text frame round trip through the assembler.
    ليكن المجمع: متغير مجمع_رسالة = أنشئ_مجمع_رسالة();
    ليكن مرحبا: متجه ط8 = [0x68, 0x69];
    ليكن خام: متجه ط8 = إطار_عميل(0x81, &مرحبا);
    طابق ادفع(&متغير المجمع, &خام) مع
    | نتيجة.نجح(اختياري.موجود(الرسالة)) -> {
        إذا ((الطول(الرسالة.الحمولة) مثل طبيعي) != 2) { أرجع لم_يتحقق("(الطول(الرسالة.الحمولة) مثل طبيعي) != 2"); };
    }
    | _ -> { أرجع لم_يتحقق("}"); };

    // Close frames: 1000 + "bye" is fine; 1005 and 999 are refused; one byte
    // is refused; an invalid UTF-8 reason is refused (1007).
    ليكن إغلاق_سليم: متجه ط8 = [0x03, 0xE8, 0x62, 0x79, 0x65];
    ليكن خام_سليم: متجه ط8 = إطار_عميل(0x88, &إغلاق_سليم);
    طابق ادفع(&متغير المجمع, &خام_سليم) مع
    | نتيجة.نجح(اختياري.موجود(_)) -> { }
    | _ -> { أرجع لم_يتحقق("طابق ادفع(&متغير المجمع, &خام_سليم) مع"); };
    ليكن إغلاق_محجوز: متجه ط8 = [0x03, 0xED];
    ليكن خام_محجوز: متجه ط8 = إطار_عميل(0x88, &إغلاق_محجوز);
    طابق ادفع(&متغير المجمع, &خام_محجوز) مع
    | نتيجة.خطأ(خطأ_رسالة.رمز_إغلاق_غير_صالح) -> { }
    | _ -> { أرجع لم_يتحقق("طابق ادفع(&متغير المجمع, &خام_محجوز) مع"); };
    إذا (رمز_إغلاق_مقبول(999) || رمز_إغلاق_مقبول(1015) || !رمز_إغلاق_مقبول(4000)) { أرجع لم_يتحقق("رمز_إغلاق_مقبول(999) || رمز_إغلاق_مقبول(1015) || !رمز_إغلاق_مقبول(4000)"); };
    ليكن إغلاق_سبب_تالف: متجه ط8 = [0x03, 0xE8, 0xFF];
    ليكن خام_تالف: متجه ط8 = إطار_عميل(0x88, &إغلاق_سبب_تالف);
    طابق ادفع(&متغير المجمع, &خام_تالف) مع
    | نتيجة.خطأ(الخطأ) -> {
        إذا (رمز_إغلاق_لخطأ(&الخطأ) != 1007) { أرجع لم_يتحقق("رمز_إغلاق_لخطأ(&الخطأ) != 1007"); };
    }
    | _ -> { أرجع لم_يتحقق("}"); };

    // Message size bound: a 4-byte limit refuses a 5-byte message (1009).
    ليكن صغير: متغير مجمع_رسالة = أنشئ_مجمع_رسالة_بحد(4);
    ليكن خمسة: متجه ط8 = [1, 2, 3, 4, 5];
    ليكن خام_كبير: متجه ط8 = إطار_عميل(0x02, &خمسة);
    طابق ادفع(&متغير صغير, &خام_كبير) مع
    | نتيجة.خطأ(الخطأ) -> {
        إذا (رمز_إغلاق_لخطأ(&الخطأ) != 1009) { أرجع لم_يتحقق("رمز_إغلاق_لخطأ(&الخطأ) != 1009"); };
    }
    | _ -> { أرجع لم_يتحقق("}"); };

    // SSE: multi-line data is split; injected newlines in public fields are
    // refused when encoding.
    ليكن البيانات: نص = "a\nb";
    ليكن الحدث: متغير حدث = أنشئ_حدثا(&البيانات);
    ليكن النوع: نص = «tick»;
    إذا (!عين_نوع_حدث(&متغير الحدث, &النوع)) { أرجع لم_يتحقق("!عين_نوع_حدث(&متغير الحدث, &النوع)"); };
    طابق نسق_حدثا(&الحدث) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق نسق_حدثا(&الحدث) مع"); }
    | نتيجة.نجح(البايتات) -> {
        ليكن النص: نص = من_بايتات(&البايتات);
        ليكن المتوقع_sse: نص = "event: tick\ndata: a\ndata: b\n\n";
        إذا (!نصان_متساويان(&النص, &المتوقع_sse)) { أرجع لم_يتحقق("!نصان_متساويان(&النص, &المتوقع_sse)"); };
    };
    الحدث.النوع := "x\nid: evil";
    طابق نسق_حدثا(&الحدث) مع
    | نتيجة.نجح(_) -> { أرجع لم_يتحقق("طابق نسق_حدثا(&الحدث) مع"); }
    | نتيجة.خطأ(_) -> { };
    أرجع نتيجة.نجح(0);
}
