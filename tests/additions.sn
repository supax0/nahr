// JSON writer and typed JSON responses, JSON error responses, static files
// with ETags, request ids, and the borrowing request context.
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان, يحتوي_نصا, من_بايتات;
من std.fs استورد اكتب_الملف, أزل_ملفا, أنشئ_دليلا_مؤقتا;
من نهر.توجيه استورد موجه, أنشئ_موجها, جلب, استخدم_وسيطا, وسيط, اربط_ملفات;
من نهر.معالجة استورد طلب, من_دالة, من_سياق;
من نهر.استخراج استورد معاملات_مسار;
من نهر.ردود استورد استجابة;
من نهر.جسم استورد رد_نصي;
من نهر.جسون استورد
    كاتب_جسون, كاتب_جسون_جديد, ابدأ_كائنا, أنه_كائنا, ابدأ_مصفوفة, أنه_مصفوفة,
    اكتب_مفتاحا, اكتب_نصا, اكتب_عددا, اكتب_حقلا_نصيا, اكتب_حقلا_عدديا,
    نص_كاتب_جسون, رد_جسون_بـ, اكتب_مصفوفة_بـ, وثيقة_جسون_إلى_نص;
من std.json استورد حلل_جسون;
من نهر.وسطاء استورد أخطاء_جسون, معرف_الطلب;
من نهر.سياق استورد سياق_طلب, عين_سمة, سمة_نص, قيمة_سياق;
من نهر.اختبار استورد
    اختبر, اختبر_جلب, أنشئ_طلبا, عين_رأس_طلب, حالة_الرد, نص_الرد, رأس_الرد_أو_فارغ;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    دع الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    دع لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

نوع مستخدم = { الاسم: نص, العمر: عدد };

عرف رمز_مستخدم(المستخدم: &مستخدم, الكاتب: &متغير كاتب_جسون): فراغ {
    ابدأ_كائنا(الكاتب);
    دع ح_1: نص = «name»;
    اكتب_حقلا_نصيا(الكاتب, &ح_1, &(*المستخدم).الاسم);
    دع ح_2: نص = «age»;
    اكتب_حقلا_عدديا(الكاتب, &ح_2, (*المستخدم).العمر);
    أنه_كائنا(الكاتب);
}

عرف رمز_المستخدمين(القيم: &متجه مستخدم, الكاتب: &متغير كاتب_جسون): فراغ {
    اكتب_مصفوفة_بـ(الكاتب, القيم, رمز_مستخدم);
}

عرف المستخدمون(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع أ: مستخدم = { الاسم: «ليلى», العمر: 30 };
    دع ب: مستخدم = { الاسم: "a\"b", العمر: 2 };
    دع القيم: متجه مستخدم = [أ, ب];
    أرجع رد_جسون_بـ(200, &القيم, رمز_المستخدمين);
}

عرف بسياق(الحالة: &عدد, السياق: &متغير سياق_طلب): استجابة {
    دع الاسم: نص = «who»;
    عين_سمة(السياق, &الاسم, قيمة_سياق.نصية(استنسخ(&(*(*السياق).الطلب).الطريقة)));
    طابق سمة_نص(السياق, &الاسم) مع
    | اختياري.موجود(القيمة) -> { أرجع رد_نصي(200, &القيمة); }
    | اختياري.لا_شيء -> { دع ن: نص = «x»; أرجع رد_نصي(500, &ن); };
}

عرف يحتوي(النص: &نص, الجزء: نص): منطقي { أرجع يحتوي_نصا(النص, &الجزء); }
عرف يساوي(النص: &نص, الآخر: نص): منطقي { أرجع نصان_متساويان(النص, &الآخر); }

@@اختبار
عرف إضافات_الجسون_والملفات(): نتيجة عدد, فشل {
    // Writer: escaping, commas, and failure on misuse.
    دع ك: متغير كاتب_جسون = كاتب_جسون_جديد();
    ابدأ_كائنا(&متغير ك);
    دع ح_3: نص = «a»;
    دع ح_4: نص = "x\ny";
    اكتب_حقلا_نصيا(&متغير ك, &ح_3, &ح_4);
    دع ح_5: نص = «b»;
    اكتب_مفتاحا(&متغير ك, &ح_5);
    ابدأ_مصفوفة(&متغير ك);
    اكتب_عددا(&متغير ك, 1);
    اكتب_عددا(&متغير ك, -2);
    أنه_مصفوفة(&متغير ك);
    أنه_كائنا(&متغير ك);
    طابق نص_كاتب_جسون(&ك) مع
    | اختياري.لا_شيء -> { أرجع لم_يتحقق("طابق نص_كاتب_جسون(&ك) مع"); }
    | اختياري.موجود(النص) -> {
        إذا (!يساوي(&النص, "{\"a\":\"x\\ny\",\"b\":[1,-2]}")) { أرجع لم_يتحقق("!يساوي(&النص, '{\\'a\\':\\'x\\\\ny\\',\\'b\\':[1,-2]}')"); };
    };
    دع خاطئ: متغير كاتب_جسون = كاتب_جسون_جديد();
    ابدأ_كائنا(&متغير خاطئ);
    اكتب_عددا(&متغير خاطئ, 1);
    طابق نص_كاتب_جسون(&خاطئ) مع
    | اختياري.موجود(_) -> { أرجع لم_يتحقق("طابق نص_كاتب_جسون(&خاطئ) مع"); }
    | اختياري.لا_شيء -> { };

    // Static files under a temporary directory.
    دع الدليل: نص;
    دع ح_6: نص = «nahr-test»;
    طابق أنشئ_دليلا_مؤقتا(&ح_6) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق أنشئ_دليلا_مؤقتا(&ح_6) مع"); }
    | نتيجة.نجح(المسار) -> { الدليل := المسار; };
    دع الملف: نص = صل(&الدليل, «/hello.txt»);
    دع ح_7: نص = «مرحبا»;
    طابق اكتب_الملف(&الملف, &ح_7) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق اكتب_الملف(&الملف, &ح_7) مع"); } | نتيجة.نجح(_) -> { };

    دع الموجه: متغير موجه<عدد> = أنشئ_موجها(0);
    دع أخطاء: وسيط<عدد> = أخطاء_جسون();
    دع معرف: وسيط<عدد> = معرف_الطلب();
    استخدم_وسيطا(&متغير الموجه, أخطاء);
    استخدم_وسيطا(&متغير الموجه, معرف);
    دع مسار_المستخدمين: نص = «/users»;
    دع مسار_السياق: نص = «/ctx»;
    دع بادئة: نص = «/static/»;
    طابق جلب(&متغير الموجه, &مسار_المستخدمين, من_دالة(المستخدمون)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &مسار_المستخدمين, من_دالة(المستخدمون)) مع"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &مسار_السياق, من_سياق(بسياق)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &مسار_السياق, من_سياق(بسياق)) مع"); } | نتيجة.نجح(_) -> { };
    طابق اربط_ملفات(&متغير الموجه, &بادئة, &الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق اربط_ملفات(&متغير الموجه, &بادئة, &الدليل) مع"); } | نتيجة.نجح(_) -> { };

    // Typed JSON response.
    دع ر1: استجابة = اختبر_جلب(&الموجه, &مسار_المستخدمين);
    دع ج1: نص = نص_الرد(&ر1);
    إذا (!يساوي(&ج1, "[{\"name\":\"ليلى\",\"age\":30},{\"name\":\"a\\\"b\",\"age\":2}]")) { أرجع لم_يتحقق("!يساوي(&ج1, '[{\\'name\\':\\'ليلى\\',\\'age\\':30},{\\'name\\':\\'a\\\\\\'b\\',\\'age\\':2}]')"); };
    دع ct: نص = «content-type»;
    دع نوع1: نص = رأس_الرد_أو_فارغ(&ر1, &ct);
    إذا (!يحتوي(&نوع1, «application/json»)) { أرجع لم_يتحقق("!يحتوي(&نوع1, 'application/json')"); };

    // Errors become JSON, and keep their headers.
    دع ح_8: نص = «/missing»;
    دع ر2: استجابة = اختبر_جلب(&الموجه, &ح_8);
    دع ج2: نص = نص_الرد(&ر2);
    إذا (حالة_الرد(&ر2) != 404 || !يساوي(&ج2, "{\"error\":{\"status\":404,\"message\":\"Not Found\"}}")) { أرجع لم_يتحقق("حالة_الرد(&ر2) != 404 || !يساوي(&ج2, '{\\'error\\':{\\'status\\':404,\\'message\\':\\'Not Found\\'}}')"); };

    // Request ids: generated, or kept when the client sends one.
    دع rid: نص = «x-request-id»;
    دع مولد: نص = رأس_الرد_أو_فارغ(&ر1, &rid);
    إذا ((الطول(مولد) مثل طبيعي) != 36) { أرجع لم_يتحقق("(الطول(مولد) مثل طبيعي) != 36"); };
    دع get: نص = «GET»;
    دع ق: متغير طلب = أنشئ_طلبا(&get, &مسار_السياق);
    دع ح_9: نص = «abc-123»;
    دع تجاهل: منطقي = عين_رأس_طلب(&متغير ق, &rid, &ح_9);
    دع ر3: استجابة = اختبر(&الموجه, &ق);
    دع محفوظ: نص = رأس_الرد_أو_فارغ(&ر3, &rid);
    إذا (!يساوي(&محفوظ, «abc-123»)) { أرجع لم_يتحقق("!يساوي(&محفوظ, 'abc-123')"); };
    // Context borrows the request.
    دع ج3: نص = نص_الرد(&ر3);
    إذا (!يساوي(&ج3, «GET»)) { أرجع لم_يتحقق("!يساوي(&ج3, 'GET')"); };

    // Static: served with an ETag; If-None-Match gives 304; traversal is 404.
    دع ح_10: نص = «/static/hello.txt»;
    دع ق4: متغير طلب = أنشئ_طلبا(&get, &ح_10);
    دع ر4: استجابة = اختبر(&الموجه, &ق4);
    دع ج4: نص = نص_الرد(&ر4);
    إذا (حالة_الرد(&ر4) != 200 || !يساوي(&ج4, «مرحبا»)) { أرجع لم_يتحقق("حالة_الرد(&ر4) != 200 || !يساوي(&ج4, 'مرحبا')"); };
    دع etag: نص = «etag»;
    دع الوسم: نص = رأس_الرد_أو_فارغ(&ر4, &etag);
    إذا (!يحتوي(&الوسم, «W/»)) { أرجع لم_يتحقق("!يحتوي(&الوسم, 'W/')"); };
    دع ح_11: نص = «if-none-match»;
    دع تجاهل2: منطقي = عين_رأس_طلب(&متغير ق4, &ح_11, &الوسم);
    دع ر5: استجابة = اختبر(&الموجه, &ق4);
    إذا (حالة_الرد(&ر5) != 304) { أرجع لم_يتحقق("حالة_الرد(&ر5) != 304"); };
    دع ح_12: نص = «/static/../hello.txt»;
    دع ر6: استجابة = اختبر_جلب(&الموجه, &ح_12);
    إذا (حالة_الرد(&ر6) != 404) { أرجع لم_يتحقق("حالة_الرد(&ر6) != 404"); };

    // std.json documents are serialized with correct escaping.
    دع مصدر: نص = "[\"x\\ny\", \"q\\\"\"]";
    طابق حلل_جسون(&مصدر) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق حلل_جسون(&مصدر) مع"); }
    | نتيجة.نجح(الوثيقة) -> {
        طابق وثيقة_جسون_إلى_نص(&الوثيقة) مع
        | اختياري.لا_شيء -> { أرجع لم_يتحقق("طابق وثيقة_جسون_إلى_نص(&الوثيقة) مع"); }
        | اختياري.موجود(النص) -> {
            إذا (!يساوي(&النص, "[\"x\\ny\",\"q\\\"\"]")) { أرجع لم_يتحقق("!يساوي(&النص, '[\\'x\\\\ny\\',\\'q\\\\\\'\\']')"); };
        };
    };

    طابق أزل_ملفا(&الملف) مع | نتيجة.خطأ(_) -> { } | نتيجة.نجح(_) -> { };
    أرجع نتيجة.نجح(0);
}

عرف صل(أ: &نص, ب: نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) { ألحق(الناتج, (*أ)[ف]); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(ب) مثل طبيعي)) { ألحق(الناتج, ب[ف]); ف := ف + 1; }
    أرجع من_بايتات(&الناتج);
}

