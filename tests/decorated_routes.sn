// Routes declared with definition decorators (@@), registered on a router.
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان;
من نهر.توجيه استورد
    موجه, أنشئ_موجها, مسار_جلب, مسار_إرسال, مسار, أضف_المسارات_المزخرفة, عدد_المسارات_المزخرفة;
من نهر.معالجة استورد طلب;
من نهر.استخراج استورد معاملات_مسار, معامل_مسار_خام;
من نهر.ردود استورد استجابة;
من نهر.جسم استورد رد_نصي;
من نهر.اختبار استورد اختبر_جلب, اختبر, أنشئ_طلبا, حالة_الرد, نص_الرد;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    دع الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    دع لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

@@مسار_جلب(«/hello/{name}»)
عرف ترحيب(الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع الاسم: نص = «name»;
    طابق معامل_مسار_خام(المعاملات, &الاسم) مع
    | اختياري.موجود(القيمة) -> { أرجع رد_نصي(200, &القيمة); }
    | اختياري.لا_شيء -> { دع فارغ: نص = «»; أرجع رد_نصي(400, &فارغ); };
}

@@مسار_إرسال(«/items»)
عرف أنشئ_عنصرا(الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع النص: نص = «created»;
    أرجع رد_نصي(201, &النص);
}

@@مسار(«DELETE», «/items/{id}»)
عرف احذف_عنصرا(الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع النص: نص = «»;
    أرجع رد_نصي(204, &النص);
}

نوع حالة = { الاسم: نص };

@@اختبار
عرف المسارات_المزخرفة(): نتيجة عدد, فشل {
    إذا (عدد_المسارات_المزخرفة() != 3) { أرجع لم_يتحقق("عدد_المسارات_المزخرفة() != 3"); };
    دع الحالة: حالة = { الاسم: «x» };
    دع الموجه: متغير موجه<حالة> = أنشئ_موجها(الحالة);
    طابق أضف_المسارات_المزخرفة(&متغير الموجه) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق أضف_المسارات_المزخرفة(&متغير الموجه) مع"); }
    | نتيجة.نجح(العدد) -> { إذا (العدد != 3) { أرجع لم_يتحقق("طابق أضف_المسارات_المزخرفة(&متغير الموجه) مع"); }; };
    دع م1: نص = «/hello/ليلى»;
    دع ر1: استجابة = اختبر_جلب(&الموجه, &م1);
    دع ن1: نص = نص_الرد(&ر1);
    دع متوقع: نص = «ليلى»;
    إذا (حالة_الرد(&ر1) != 200 || !نصان_متساويان(&ن1, &متوقع)) { أرجع لم_يتحقق("حالة_الرد(&ر1) != 200 || !نصان_متساويان(&ن1, &متوقع)"); };
    دع post: نص = «POST»;
    دع م2: نص = «/items»;
    دع ط2: طلب = أنشئ_طلبا(&post, &م2);
    دع ر2: استجابة = اختبر(&الموجه, &ط2);
    إذا (حالة_الرد(&ر2) != 201) { أرجع لم_يتحقق("حالة_الرد(&ر2) != 201"); };
    دع del: نص = «DELETE»;
    دع م3: نص = «/items/7»;
    دع ط3: طلب = أنشئ_طلبا(&del, &م3);
    دع ر3: استجابة = اختبر(&الموجه, &ط3);
    إذا (حالة_الرد(&ر3) != 204) { أرجع لم_يتحقق("حالة_الرد(&ر3) != 204"); };
    // Registering twice is the router's duplicate-route error.
    طابق أضف_المسارات_المزخرفة(&متغير الموجه) مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(_) -> { أرجع لم_يتحقق("طابق أضف_المسارات_المزخرفة(&متغير الموجه) مع"); };
    أرجع نتيجة.نجح(0);
}
