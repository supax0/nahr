// Diagnostics: durations, reason phrases, system error text, levels.
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان, يحتوي_نصا;
من نهر.سجلات استورد
    نص_المدة, عبارة_الحالة, إعداد_سجل, مستوى_مفعل, مستوى_سجل, سجل_معلومة;
من نهر.تشغيل استورد وصف_رمز_نظام;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    ليكن الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    ليكن لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

عرف يساوي(النص: &نص, الآخر: نص): منطقي { أرجع نصان_متساويان(النص, &الآخر); }
عرف يحتوي(النص: &نص, الجزء: نص): منطقي { أرجع يحتوي_نصا(النص, &الجزء); }

@@اختبار
عرف السجلات(): نتيجة عدد, فشل {
    ليكن م1: نص = نص_المدة(410000);
    إذا (!يساوي(&م1, «0.41ms»)) { أرجع لم_يتحقق("!يساوي(&م1, '0.41ms')"); };
    ليكن م2: نص = نص_المدة(1234567);
    إذا (!يساوي(&م2, «1.23ms»)) { أرجع لم_يتحقق("!يساوي(&م2, '1.23ms')"); };
    ليكن م3: نص = نص_المدة(1050000000);
    إذا (!يساوي(&م3, «1050.00ms»)) { أرجع لم_يتحقق("!يساوي(&م3, '1050.00ms')"); };
    ليكن م4: نص = نص_المدة(10000);
    إذا (!يساوي(&م4, «0.01ms»)) { أرجع لم_يتحقق("!يساوي(&م4, '0.01ms')"); };

    ليكن ع1: نص = عبارة_الحالة(303);
    ليكن ع2: نص = عبارة_الحالة(429);
    ليكن ع3: نص = عبارة_الحالة(599);
    إذا (!يساوي(&ع1, «See Other») || !يساوي(&ع2, «Too Many Requests») || الطول(ع3) != 0) { أرجع لم_يتحقق("!يساوي(&ع1, 'See Other') || !يساوي(&ع2, 'Too Many Requests') || الطول(ع3) != 0"); };

    ليكن خ1: نص = وصف_رمز_نظام(-98);
    إذا (!يحتوي(&خ1, «address already in use (errno 98)»)) { أرجع لم_يتحقق("!يحتوي(&خ1, 'address already in use (errno 98)')"); };
    ليكن خ2: نص = وصف_رمز_نظام(-48);
    إذا (!يحتوي(&خ2, «address already in use (errno 48)»)) { أرجع لم_يتحقق("!يحتوي(&خ2, 'address already in use (errno 48)')"); };
    ليكن خ3: نص = وصف_رمز_نظام(-7777);
    إذا (!يساوي(&خ3, «system error (errno 7777)»)) { أرجع لم_يتحقق("!يساوي(&خ3, 'system error (errno 7777)')"); };

    ليكن الإعداد: إعداد_سجل = { الحد: 2, الطلبات: صواب, الألوان: خطأ, الوقت: خطأ };
    إذا (مستوى_مفعل(&الإعداد, مستوى_سجل.معلومة())) { أرجع لم_يتحقق("مستوى_مفعل(&الإعداد, مستوى_سجل.معلومة())"); };
    إذا (!مستوى_مفعل(&الإعداد, مستوى_سجل.عطل())) { أرجع لم_يتحقق("!مستوى_مفعل(&الإعداد, مستوى_سجل.عطل())"); };
    // Writes one line to stderr; it must not crash.
    سجل_معلومة(«log test line»);
    أرجع نتيجة.نجح(0);
}
