// Handler decorators: @محمي, @بحد_جسم, @مضغوط, @مراقب, stacked.
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان, كرر_النص;
من نهر.توجيه استورد موجه, أنشئ_موجها, جلب, أرسل;
من نهر.معالجة استورد طلب, من_دالة;
من نهر.استخراج استورد معاملات_مسار;
من نهر.ردود استورد استجابة;
من نهر.جسم استورد رد_نصي;
من نهر.وسطاء استورد محمي, بحد_جسم, مضغوط, مراقب;
من نهر.اختبار استورد
    اختبر, أنشئ_طلبا, عين_رأس_طلب, عين_جسم_نصي, حالة_الرد, رأس_الرد_أو_فارغ;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    ليكن الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    ليكن لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

عرف مقبول(الحالة: &عدد, الرمز: &نص): منطقي {
    ليكن السر: نص = «secret»;
    أرجع نصان_متساويان(الرمز, &السر);
}

عرف لا_شيء(الحالة: &عدد, الطلب: &طلب, الاستجابة: &استجابة): فراغ { }

@مراقب(لا_شيء)
@مضغوط
@محمي(مقبول)
عرف كبير(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن الوحدة: نص = «nahr »;
    ليكن النص: نص = كرر_النص(&الوحدة, 400);
    أرجع رد_نصي(200, &النص);
}

@بحد_جسم(4)
عرف استلام(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن النص: نص = «ok»;
    أرجع رد_نصي(200, &النص);
}

عرف رأس(الطلب: &متغير طلب, الاسم: نص, القيمة: نص): فراغ {
    ليكن تجاهل: منطقي = عين_رأس_طلب(الطلب, &الاسم, &القيمة);
}

@@اختبار
عرف مزخرفات_المعالجات(): نتيجة عدد, فشل {
    ليكن الموجه: متغير موجه<عدد> = أنشئ_موجها(0);
    ليكن a: نص = «/big»;
    ليكن b: نص = «/in»;
    طابق جلب(&متغير الموجه, &a, من_دالة(كبير)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &a, من_دالة(كبير)) مع"); } | نتيجة.نجح(_) -> { };
    طابق أرسل(&متغير الموجه, &b, من_دالة(استلام)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق أرسل(&متغير الموجه, &b, من_دالة(استلام)) مع"); } | نتيجة.نجح(_) -> { };

    ليكن get: نص = «GET»;
    ليكن ق1: متغير طلب = أنشئ_طلبا(&get, &a);
    ليكن ر1: استجابة = اختبر(&الموجه, &ق1);
    إذا (حالة_الرد(&ر1) != 401) { أرجع لم_يتحقق("حالة_الرد(&ر1) != 401"); };
    رأس(&متغير ق1, «authorization», «Bearer secret»);
    رأس(&متغير ق1, «accept-encoding», «gzip»);
    ليكن ر2: استجابة = اختبر(&الموجه, &ق1);
    إذا (حالة_الرد(&ر2) != 200) { أرجع لم_يتحقق("حالة_الرد(&ر2) != 200"); };
    ليكن ce: نص = «content-encoding»;
    ليكن الترميز: نص = رأس_الرد_أو_فارغ(&ر2, &ce);
    ليكن gzip: نص = «gzip»;
    إذا (!نصان_متساويان(&الترميز, &gzip)) { أرجع لم_يتحقق("!نصان_متساويان(&الترميز, &gzip)"); };

    ليكن post: نص = «POST»;
    ليكن ق2: متغير طلب = أنشئ_طلبا(&post, &b);
    ليكن خمسة: نص = «12345»;
    عين_جسم_نصي(&متغير ق2, &خمسة);
    ليكن ر3: استجابة = اختبر(&الموجه, &ق2);
    إذا (حالة_الرد(&ر3) != 413) { أرجع لم_يتحقق("حالة_الرد(&ر3) != 413"); };
    أرجع نتيجة.نجح(0);
}
