// HTML templates: escaping, if/for/include/extends, filters, whitespace
// control, errors with lines, loading a directory, and template responses.
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان, يحتوي_نصا, من_بايتات;
من std.fs استورد اكتب_الملف, أنشئ_دليلا, أنشئ_دليلا_مؤقتا;
من std.io استورد اطبع_سطر;
من نهر.قوالب استورد
    قوالب, قوالب_جديدة, أضف_قالبا, حمل_قوالب, اعرض_قالبا, اعرض_نص_قالب, رد_قالب,
    سياق_قالب, قيمة_قالب, حقل_قالب, عين_قيمة, حقل, قيمة_نص, قيمة_آمنة, قيمة_عدد,
    قيمة_منطقية, قيمة_قائمة, قيمة_كائن, قائمة_بـ, قائمة_نصوص, اهرب_html,
    خطأ_قالب, وصف_خطأ_قالب;
من نهر.توجيه استورد موجه, أنشئ_موجها, جلب;
من نهر.معالجة استورد طلب, من_دالة;
من نهر.استخراج استورد معاملات_مسار;
من نهر.ردود استورد استجابة;
من نهر.اختبار استورد اختبر_جلب, حالة_الرد, نص_الرد, رأس_الرد_أو_فارغ;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    دع الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    دع لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

نوع منتج = { الاسم: نص, السعر: عدد };

عرف قيمة_منتج(المنتج: &منتج): قيمة_قالب {
    دع الحقول: متجه حقل_قالب = [
        حقل(«name», قيمة_نص(استنسخ(&(*المنتج).الاسم))),
        حقل(«price», قيمة_عدد((*المنتج).السعر))
    ];
    أرجع قيمة_كائن(الحقول);
}

عرف صل(أ: &نص, ب: نص): نص {
    دع الناتج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) { ألحق(الناتج, (*أ)[ف]); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(ب) مثل طبيعي)) { ألحق(الناتج, ب[ف]); ف := ف + 1; }
    أرجع من_بايتات(&الناتج);
}

عرف صل_نصين(أ: نص, ب: نص): نص { أرجع صل(&أ, ب); }
عرف يحتوي(النص: &نص, الجزء: نص): منطقي { أرجع يحتوي_نصا(النص, &الجزء); }
عرف يساوي(النص: &نص, الآخر: نص): منطقي { أرجع نصان_متساويان(النص, &الآخر); }

// Renders المصدر and compares it with المتوقع; prints both when they differ.
عرف يعرض(المصدر: نص, السياق: &سياق_قالب, المتوقع: نص): منطقي {
    طابق اعرض_نص_قالب(المصدر, السياق) مع
    | نتيجة.خطأ(الخطأ) -> {
        دع تجاهل: نتيجة عدد, عدد = اطبع_سطر(وصف_خطأ_قالب(&الخطأ));
        أرجع خطأ;
    }
    | نتيجة.نجح(النص) -> {
        إذا (نصان_متساويان(&النص, &المتوقع)) { أرجع صواب; };
        دع ت1: نتيجة عدد, عدد = اطبع_سطر(صل_نصين(«got:      », استنسخ(&النص)));
        دع ت2: نتيجة عدد, عدد = اطبع_سطر(صل_نصين(«expected: », المتوقع));
        أرجع خطأ;
    };
}

// The error text for المصدر, or empty when it renders.
عرف خطأ_العرض(المصدر: نص, السياق: &سياق_قالب): نص {
    طابق اعرض_نص_قالب(المصدر, السياق) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع وصف_خطأ_قالب(&الخطأ); }
    | نتيجة.نجح(_) -> { أرجع «»; };
}

نوع حالة_موقع = { القوالب: قوالب };

عرف الصفحة(الحالة: &حالة_موقع, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع السياق: متغير سياق_قالب = [];
    عين_قيمة(&متغير السياق, «title», قيمة_نص(«Shop & more»));
    دع قهوة: منتج = { الاسم: «قهوة», السعر: 12 };
    دع شاي: منتج = { الاسم: «<tea>», السعر: 8 };
    دع المنتجات: متجه منتج = [قهوة, شاي];
    عين_قيمة(&متغير السياق, «products», قائمة_بـ(&المنتجات, قيمة_منتج));
    أرجع رد_قالب(&(*الحالة).القوالب, «pages/shop.html», &السياق);
}

عرف المكسورة(الحالة: &حالة_موقع, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع السياق: سياق_قالب = [];
    أرجع رد_قالب(&(*الحالة).القوالب, «missing.html», &السياق);
}

@@اختبار
عرف القوالب(): نتيجة عدد, فشل {
    دع س: متغير سياق_قالب = [];
    عين_قيمة(&متغير س, «name», قيمة_نص(«<b>"Ali" & 'Sara'</b>»));
    عين_قيمة(&متغير س, «html», قيمة_آمنة(«<em>ok</em>»));
    عين_قيمة(&متغير س, «n», قيمة_عدد(3));
    عين_قيمة(&متغير س, «yes», قيمة_منطقية(صواب));
    دع الأسماء: متجه نص = [«a», «b», «c»];
    عين_قيمة(&متغير س, «letters», قائمة_نصوص(&الأسماء));
    دع المستخدم: متجه حقل_قالب = [حقل(«name», قيمة_نص(«ليلى»)), حقل(«admin», قيمة_منطقية(خطأ))];
    عين_قيمة(&متغير س, «user», قيمة_كائن(المستخدم));
    // عين_قيمة replaces an earlier value.
    عين_قيمة(&متغير س, «n», قيمة_عدد(4));

    // Escaping, safe values, numbers and booleans.
    إذا (!يعرض(«{{ name }}», &س, «&lt;b&gt;&#34;Ali&#34; &amp; &#39;Sara&#39;&lt;/b&gt;»)) { أرجع لم_يتحقق("!يعرض('{{ name }}', &س, '&lt;b&gt;&#34;Ali&#34; &amp; &#39;Sara&#39;&lt;/b&gt;')"); };
    إذا (!يعرض(«{{ html }} {{ name|safe }}», &س, «<em>ok</em> <b>"Ali" & 'Sara'</b>»)) { أرجع لم_يتحقق("!يعرض('{{ html }} {{ name|safe }}', &س, '<em>ok</em> <b>'Ali' & 'Sara'</b>')"); };
    إذا (!يعرض(«{{ n }} {{ yes }} [{{ nothing }}]», &س, «4 true []»)) { أرجع لم_يتحقق("!يعرض('{{ n }} {{ yes }} [{{ nothing }}]', &س, '4 true []')"); };
    دع نص_مهرب: نص = «a<b»;
    دع المهرب: نص = اهرب_html(&نص_مهرب);
    إذا (!يساوي(&المهرب, «a&lt;b»)) { أرجع لم_يتحقق("!يساوي(&المهرب, 'a&lt;b')"); };

    // Paths: fields and list elements.
    إذا (!يعرض(«{{ user.name }} {{ letters.1 }} [{{ user.missing }}]», &س, «ليلى b []»)) { أرجع لم_يتحقق("!يعرض('{{ user.name }} {{ letters.1 }} [{{ user.missing }}]', &س, 'ليلى b []')"); };

    // if / elif / else and expressions.
    إذا (!يعرض(«{% if n > 5 %}big{% elif n == 4 %}four{% else %}small{% endif %}», &س, «four»)) { أرجع لم_يتحقق("!يعرض('{% if n > 5 %}big{% elif n == 4 %}four{% else %}small{% endif %}', &س, 'four')"); };
    إذا (!يعرض(«{% if not user.admin and yes %}user{% endif %}», &س, «user»)) { أرجع لم_يتحقق("!يعرض('{% if not user.admin and yes %}user{% endif %}', &س, 'user')"); };
    إذا (!يعرض(«{% if user.name == "ليلى" or n < 0 %}hi{% endif %}», &س, «hi»)) { أرجع لم_يتحقق("!يعرض('{% if user.name == 'ليلى' or n < 0 %}hi{% endif %}', &س, 'hi')"); };
    إذا (!يعرض(«{{ nothing or "fallback" }}», &س, «fallback»)) { أرجع لم_يتحقق("!يعرض('{{ nothing or 'fallback' }}', &س, 'fallback')"); };

    // for loops, loop variables, and for-else.
    إذا (!يعرض(«{% for l in letters %}{{ loop.index }}{{ l }}{% if not loop.last %},{% endif %}{% endfor %}», &س, «1a,2b,3c»)) { أرجع لم_يتحقق("!يعرض('{% for l in letters %}{{ loop.index }}{{ l }}{% if not loop.last %},{% endif %}{% endfor %}', &س, '1a,2b,3c')"); };
    إذا (!يعرض(«{% for x in nothing %}x{% else %}empty{% endfor %}», &س, «empty»)) { أرجع لم_يتحقق("!يعرض('{% for x in nothing %}x{% else %}empty{% endfor %}', &س, 'empty')"); };
    إذا (!يعرض(«{% for f in user %}{{ f.key }}={{ f.value }};{% endfor %}», &س, «name=ليلى;admin=false;»)) { أرجع لم_يتحقق("!يعرض('{% for f in user %}{{ f.key }}={{ f.value }};{% endfor %}', &س, 'name=ليلى;admin=false;')"); };

    // Filters.
    إذا (!يعرض(«{{ letters|length }} {{ user.name|length }} {{ letters|join(", ") }}», &س, «3 4 a, b, c»)) { أرجع لم_يتحقق("!يعرض('{{ letters|length }} {{ user.name|length }} {{ letters|join(', ') }}', &س, '3 4 a, b, c')"); };
    إذا (!يعرض(«{{ nothing|default("none") }} {{ "Ab"|upper }}{{ "Ab"|lower }} [{{ "  x "|trim }}]», &س, «none ABab [x]»)) { أرجع لم_يتحقق("!يعرض('{{ nothing|default('none') }} {{ 'Ab'|upper }}{{ 'Ab'|lower }} [{{ ' x '|trim }}]', &س, 'none ABab [x]')"); };
    إذا (!يعرض(«{{ name|e }}», &س, «&lt;b&gt;&#34;Ali&#34; &amp; &#39;Sara&#39;&lt;/b&gt;»)) { أرجع لم_يتحقق("!يعرض('{{ name|e }}', &س, '&lt;b&gt;&#34;Ali&#34; &amp; &#39;Sara&#39;&lt;/b&gt;')"); };

    // Comments and whitespace control.
    إذا (!يعرض("<ul>\n  {%- for l in letters %}\n  <li>{{ l }}</li>\n  {%- endfor %}\n</ul>{# gone #}", &س, "<ul>\n  <li>a</li>\n  <li>b</li>\n  <li>c</li>\n</ul>")) { أرجع لم_يتحقق("!يعرض('<ul>\\n {%- for l in letters %}\\n <li>{{ l }}</li>\\n {%- endfor %}\\n</ul>{# gone #}', &س, '<ul>\\n <li>a</li>\\n <li>b</li>\\n <li>c</li>\\n</ul>')"); };

    // Errors name the template and line.
    دع خ1: نص = خطأ_العرض("line1\n{% if n %}open", &س);
    إذا (!يحتوي(&خ1, «missing {% endif %}»)) { دع ت: نتيجة عدد, عدد = اطبع_سطر(خ1); أرجع لم_يتحقق("إذا (!يحتوي(&خ1, 'missing {% endif %}')) { دع ت: نتيجة عدد, عدد = اطبع_سطر(خ1); أرجع 17; };"); };
    دع خ2: نص = خطأ_العرض("a\nb\n{{ n | nofilter }}", &س);
    إذا (!يحتوي(&خ2, «<string>:3: unknown filter: nofilter»)) { دع ت: نتيجة عدد, عدد = اطبع_سطر(خ2); أرجع لم_يتحقق("إذا (!يحتوي(&خ2, '<string>:3: unknown filter: nofilter')) { دع ت: نتيجة عدد, عدد = اطبع_سطر(خ2); أرجع 18; };"); };
    دع خ3: نص = خطأ_العرض(«{% while %}», &س);
    إذا (!يحتوي(&خ3, «unexpected {% while %}»)) { أرجع لم_يتحقق("!يحتوي(&خ3, 'unexpected {% while %}')"); };
    دع خ4: نص = خطأ_العرض(«{{ n », &س);
    إذا (!يحتوي(&خ4, «not closed»)) { أرجع لم_يتحقق("!يحتوي(&خ4, 'not closed')"); };

    // Strict mode: undefined names are errors (default still works).
    دع صارمة: متغير قوالب = قوالب_جديدة();
    صارمة.صارم := صواب;
    طابق أضف_قالبا(&متغير صارمة, «s.html», «{{ nothing|default("d") }} {{ missing }}») مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق أضف_قالبا(&متغير صارمة, 's.html', '{{ nothing|default('d') }} {{ missing }}') مع"); } | نتيجة.نجح(_) -> { };
    دع اسم_صارم: نص = «s.html»;
    طابق اعرض_قالبا(&صارمة, &اسم_صارم, &س) مع
    | نتيجة.نجح(_) -> { أرجع لم_يتحقق("طابق اعرض_قالبا(&صارمة, &اسم_صارم, &س) مع"); }
    | نتيجة.خطأ(الخطأ) -> {
        دع النص: نص = وصف_خطأ_قالب(&الخطأ);
        إذا (!يحتوي(&النص, «s.html:1: undefined: missing»)) { دع ت: نتيجة عدد, عدد = اطبع_سطر(النص); أرجع لم_يتحقق("إذا (!يحتوي(&النص, 's.html:1: undefined: missing')) { دع ت: نتيجة عدد, عدد = اطبع_سطر(النص); أرجع 23; };"); };
    };

    // A template directory: layout with blocks, a page that extends it, a
    // partial it includes, and a template in a subdirectory.
    دع الدليل: متغير نص = «»;
    دع البادئة: نص = «nahr-templates»;
    طابق أنشئ_دليلا_مؤقتا(&البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق أنشئ_دليلا_مؤقتا(&البادئة) مع"); }
    | نتيجة.نجح(المسار) -> { الدليل := المسار; };
    دع الصفحات: نص = صل(&الدليل, «/pages»);
    طابق أنشئ_دليلا(&الصفحات) مع | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق أنشئ_دليلا(&الصفحات) مع | نتيجة.خطأ(_) -> { أرجع 31; } | نتيجة.نجح(_) -> { };"); } | نتيجة.نجح(_) -> { };
    دع م1: نص = صل(&الدليل, «/base.html»);
    دع ن1: نص = "<title>{% block title %}Site{% endblock %}</title>{% include \"nav.html\" %}<main>{% block content %}{% endblock %}</main>";
    طابق اكتب_الملف(&م1, &ن1) مع | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق اكتب_الملف(&م1, &ن1) مع | نتيجة.خطأ(_) -> { أرجع 32; } | نتيجة.نجح(_) -> { };"); } | نتيجة.نجح(_) -> { };
    دع م2: نص = صل(&الدليل, «/nav.html»);
    دع ن2: نص = «<nav>{{ title }}</nav>»;
    طابق اكتب_الملف(&م2, &ن2) مع | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق اكتب_الملف(&م2, &ن2) مع | نتيجة.خطأ(_) -> { أرجع 33; } | نتيجة.نجح(_) -> { };"); } | نتيجة.نجح(_) -> { };
    دع م3: نص = صل(&الدليل, «/pages/shop.html»);
    دع ن3: نص = "{% extends \"base.html\" %}{% block title %}{{ title }}{% endblock %}{% block content %}{% for p in products %}<p>{{ p.name }}: {{ p.price }}</p>{% endfor %}{% endblock %}";
    طابق اكتب_الملف(&م3, &ن3) مع | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق اكتب_الملف(&م3, &ن3) مع | نتيجة.خطأ(_) -> { أرجع 34; } | نتيجة.نجح(_) -> { };"); } | نتيجة.نجح(_) -> { };
    دع م4: نص = صل(&الدليل, «/.hidden.html»);
    دع ن4: نص = «{% bad %}»;
    طابق اكتب_الملف(&م4, &ن4) مع | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق اكتب_الملف(&م4, &ن4) مع | نتيجة.خطأ(_) -> { أرجع 35; } | نتيجة.نجح(_) -> { };"); } | نتيجة.نجح(_) -> { };

    دع المجموعة: متغير قوالب = قوالب_جديدة();
    طابق حمل_قوالب(استنسخ(&الدليل)) مع
    | نتيجة.خطأ(الخطأ) -> { دع ت: نتيجة عدد, عدد = اطبع_سطر(وصف_خطأ_قالب(&الخطأ)); أرجع لم_يتحقق("طابق حمل_قوالب(استنسخ(&الدليل)) مع"); }
    | نتيجة.نجح(م) -> { المجموعة := م; };
    إذا (الطول(المجموعة.القوالب) != 3) { أرجع لم_يتحقق("الطول(المجموعة.القوالب) != 3"); };

    دع الحالة: حالة_موقع = { القوالب: المجموعة };
    دع الموجه: متغير موجه<حالة_موقع> = أنشئ_موجها(الحالة);
    دع مسار_المتجر: نص = «/shop»;
    دع مسار_المكسور: نص = «/broken»;
    طابق جلب(&متغير الموجه, &مسار_المتجر, من_دالة(الصفحة)) مع | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &مسار_المتجر, من_دالة(الصفحة)) مع | نتيجة.خطأ(_) -> { أرجع 38; } | نتيجة.نجح(_) -> { };"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &مسار_المكسور, من_دالة(المكسورة)) مع | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &مسار_المكسور, من_دالة(المكسورة)) مع | نتيجة.خطأ(_) -> { أرجع 39; } | نتيجة.نجح(_) -> { };"); } | نتيجة.نجح(_) -> { };

    دع ر1: استجابة = اختبر_جلب(&الموجه, &مسار_المتجر);
    إذا (حالة_الرد(&ر1) != 200) { أرجع لم_يتحقق("حالة_الرد(&ر1) != 200"); };
    دع ص1: نص = نص_الرد(&ر1);
    دع متوقع1: نص = «<title>Shop &amp; more</title><nav>Shop &amp; more</nav><main><p>قهوة: 12</p><p>&lt;tea&gt;: 8</p></main>»;
    إذا (!نصان_متساويان(&ص1, &متوقع1)) { دع ت: نتيجة عدد, عدد = اطبع_سطر(ص1); أرجع لم_يتحقق("إذا (!نصان_متساويان(&ص1, &متوقع1)) { دع ت: نتيجة عدد, عدد = اطبع_سطر(ص1); أرجع 41; };"); };
    دع ct: نص = «content-type»;
    دع نوع1: نص = رأس_الرد_أو_فارغ(&ر1, &ct);
    إذا (!يساوي(&نوع1, «text/html; charset=utf-8»)) { أرجع لم_يتحقق("!يساوي(&نوع1, 'text/html; charset=utf-8')"); };

    // A missing template is a 500 (and logged), not a crash.
    دع ر2: استجابة = اختبر_جلب(&الموجه, &مسار_المكسور);
    إذا (حالة_الرد(&ر2) != 500) { أرجع لم_يتحقق("حالة_الرد(&ر2) != 500"); };

    // A parse error while loading names the file and line.
    دع م5: نص = صل(&الدليل, «/bad.html»);
    دع ن5: نص = "ok\n{% for x %}";
    طابق اكتب_الملف(&م5, &ن5) مع | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق اكتب_الملف(&م5, &ن5) مع | نتيجة.خطأ(_) -> { أرجع 44; } | نتيجة.نجح(_) -> { };"); } | نتيجة.نجح(_) -> { };
    طابق حمل_قوالب(استنسخ(&الدليل)) مع
    | نتيجة.نجح(_) -> { أرجع لم_يتحقق("طابق حمل_قوالب(استنسخ(&الدليل)) مع"); }
    | نتيجة.خطأ(الخطأ) -> {
        دع النص: نص = وصف_خطأ_قالب(&الخطأ);
        إذا (!يحتوي(&النص, «bad.html:2: for expects»)) { دع ت: نتيجة عدد, عدد = اطبع_سطر(النص); أرجع لم_يتحقق("إذا (!يحتوي(&النص, 'bad.html:2: for expects')) { دع ت: نتيجة عدد, عدد = اطبع_سطر(النص); أرجع 46; };"); };
    };
    أرجع نتيجة.نجح(0);
}
