// Body, header, cookie/session, validation, result and context handlers.
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان, عدد_إلى_نص;
من std.json استورد وثيقة_جسون, قيمة_جسون;
من نهر.توجيه استورد موجه, أنشئ_موجها, جلب, أرسل;
من نهر.معالجة استورد
    طلب, من_دالة, من_سياق, مع_استخراج, مع_استخراجين, حول_معالج_نتيجة;
من نهر.استخراج استورد
    مستخرج, معاملات_مسار, استخرج_نصا, استخرج_رأسا_مطلوبا, استخرج_معامل_مسار;
من نهر.ردود استورد استجابة, رد_ملف_من_دليل, مسار_نسبي_آمن;
من نهر.جسم استورد رد_نصي;
من نهر.جسون استورد استخرج_جسونا;
من نهر.جلسات استورد إعداد_جلسة, إعداد_جلسة_افتراضي, استخرج_جلسة, عين_جلسة;
من نهر.كعكات استورد إعداد_كعكة, إعداد_كعكة_افتراضي, عين_كعكة, سياسة_نفس_الموقع;
من نهر.تحقق استورد تحقق_نصا, خطأ_تحقق, تحقق_مستخرجا;
من نهر.سياق استورد سياق_طلب, عين_سمة, سمة_نص, قيمة_سياق;
من نهر.اختبار استورد
    اختبر, اختبر_جلب, أنشئ_طلبا, عين_رأس_طلب, عين_جسم_نصي,
    حالة_الرد, نص_الرد, رأس_الرد_أو_فارغ;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    ليكن الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    ليكن لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

عرف صدى(الحالة: &عدد, النص: نص): استجابة {
    أرجع رد_نصي(200, &النص);
}

عرف صدى_اثنين(الحالة: &عدد, الأول: نص, الثاني: نص): استجابة {
    ليكن النص: نص = الثاني;
    أرجع رد_نصي(200, &النص);
}

// Reads {"n": <number>} as an int.
عرف فك_عدد(الوثيقة: &وثيقة_جسون): نتيجة عدد, نص {
    أرجع نتيجة.نجح(7);
}

عرف رفض_فك(الخطأ: &نص): استجابة {
    أرجع رد_نصي(422, الخطأ);
}

عرف عدد_إلى_رد(الحالة: &عدد, القيمة: عدد): استجابة {
    ليكن النص: نص = عدد_إلى_نص(القيمة);
    أرجع رد_نصي(200, &النص);
}

عرف حمل_جلسة(الحالة: &عدد, المعرف: &نص): اختياري نص {
    ليكن الصحيح: نص = «s1»;
    إذا (نصان_متساويان(المعرف, &الصحيح)) { أرجع اختياري.موجود(«user-1»); };
    أرجع اختياري.لا_شيء();
}

عرف قصير_بما_يكفي(القيمة: &نص): نتيجة منطقي, خطأ_تحقق {
    أرجع تحقق_نصا(القيمة, 1, 3);
}

عرف رفض_تحقق(الخطأ: &خطأ_تحقق): استجابة {
    ليكن النص: نص = «too long»;
    أرجع رد_نصي(422, &النص);
}

عرف قسمة(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): نتيجة عدد, نص {
    إذا (*الحالة == 0) { أرجع نتيجة.خطأ(«division by zero»); };
    أرجع نتيجة.نجح(100 / *الحالة);
}

عرف نجاح_عدد(القيمة: عدد): استجابة {
    ليكن النص: نص = عدد_إلى_نص(القيمة);
    أرجع رد_نصي(200, &النص);
}

عرف فشل_نص(الخطأ: &نص): استجابة {
    أرجع رد_نصي(500, الخطأ);
}

عرف بسياق(الحالة: &عدد, السياق: &متغير سياق_طلب): استجابة {
    ليكن الاسم: نص = «who»;
    عين_سمة(السياق, &الاسم, قيمة_سياق.نصية(«ctx»));
    طابق سمة_نص(السياق, &الاسم) مع
    | اختياري.موجود(القيمة) -> { أرجع رد_نصي(200, &القيمة); }
    | اختياري.لا_شيء -> {
        ليكن النص: نص = «missing»;
        أرجع رد_نصي(500, &النص);
    };
}

عرف ملف(الحالة: &عدد, المسار: نص): استجابة {
    ليكن الدليل: نص = «/tmp»;
    أرجع رد_ملف_من_دليل(&الدليل, &المسار);
}

عرف طلب_بـ(الطريقة: نص, الهدف: نص): طلب {
    أرجع أنشئ_طلبا(&الطريقة, &الهدف);
}

عرف رأس(الطلب: &متغير طلب, الاسم: نص, القيمة: نص): فراغ {
    ليكن تجاهل: منطقي = عين_رأس_طلب(الطلب, &الاسم, &القيمة);
}

عرف يرد(الموجه: &موجه<عدد>, الطلب: &طلب, الحالة: طبيعي, الجسم: نص): منطقي {
    ليكن ر: استجابة = اختبر(الموجه, الطلب);
    إذا (حالة_الرد(&ر) != الحالة) { أرجع خطأ; };
    ليكن النص: نص = نص_الرد(&ر);
    أرجع نصان_متساويان(&النص, &الجسم);
}

@@اختبار
عرف المستخرجات(): نتيجة عدد, فشل {
    ليكن الموجه: متغير موجه<عدد> = أنشئ_موجها(4);
    ليكن x_name: نص = «x-name»;
    ليكن nm: نص = «name»;
    ليكن الإعداد_الجلسة: إعداد_جلسة = إعداد_جلسة_افتراضي();

    ليكن م_نص: مستخرج<عدد, نص> = استخرج_نصا();
    ليكن م_رأس: مستخرج<عدد, نص> = استخرج_رأسا_مطلوبا(&x_name);
    ليكن م_جسون: مستخرج<عدد, عدد> = استخرج_جسونا(فك_عدد, رفض_فك);
    ليكن م_جلسة: مستخرج<عدد, نص> = استخرج_جلسة(&الإعداد_الجلسة, حمل_جلسة);
    ليكن م_مسار: مستخرج<عدد, نص> = استخرج_معامل_مسار(&nm);
    ليكن م_متحقق: مستخرج<عدد, نص> = تحقق_مستخرجا(م_مسار, قصير_بما_يكفي, رفض_تحقق);
    ليكن حرفي_1: نص = «path»;
    ليكن م_ملف: مستخرج<عدد, نص> = استخرج_معامل_مسار(&حرفي_1);

    ليكن أنماط: متجه نص = [«/text», «/header», «/json», «/session», «/short/{name}», «/divide», «/ctx», «/files/{*path}»];
    طابق أرسل(&متغير الموجه, &أنماط[0], مع_استخراج(م_نص, صدى)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق أرسل(&متغير الموجه, &أنماط[0], مع_استخراج(م_نص, صدى)) مع"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &أنماط[1], مع_استخراجين(م_رأس, م_جلسة, صدى_اثنين)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &أنماط[1], مع_استخراجين(م_رأس, م_جلسة, صدى_اثنين)) مع"); } | نتيجة.نجح(_) -> { };
    طابق أرسل(&متغير الموجه, &أنماط[2], مع_استخراج(م_جسون, عدد_إلى_رد)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق أرسل(&متغير الموجه, &أنماط[2], مع_استخراج(م_جسون, عدد_إلى_رد)) مع"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &أنماط[4], مع_استخراج(م_متحقق, صدى)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &أنماط[4], مع_استخراج(م_متحقق, صدى)) مع"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &أنماط[5], حول_معالج_نتيجة(قسمة, نجاح_عدد, فشل_نص)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &أنماط[5], حول_معالج_نتيجة(قسمة, نجاح_عدد, فشل_نص)) مع"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &أنماط[6], من_سياق(بسياق)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &أنماط[6], من_سياق(بسياق)) مع"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &أنماط[7], مع_استخراج(م_ملف, ملف)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &أنماط[7], مع_استخراج(م_ملف, ملف)) مع"); } | نتيجة.نجح(_) -> { };

    // Text body; a JSON body sent as text/plain is 415.
    ليكن ق1: متغير طلب = طلب_بـ(«POST», «/text»);
    ليكن حرفي_2: نص = «hello»;
    عين_جسم_نصي(&متغير ق1, &حرفي_2);
    إذا (!يرد(&الموجه, &ق1, 200, «hello»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق1, 200, 'hello')"); };
    ليكن ق2: متغير طلب = طلب_بـ(«POST», «/json»);
    ليكن حرفي_3: نص = «{"n": 7}»;
    عين_جسم_نصي(&متغير ق2, &حرفي_3);
    رأس(&متغير ق2, «content-type», «text/plain»);
    إذا (!يرد(&الموجه, &ق2, 415, «Unsupported media type»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق2, 415, 'Unsupported media type')"); };
    رأس(&متغير ق2, «content-type», «application/json»);
    إذا (!يرد(&الموجه, &ق2, 200, «7»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق2, 200, '7')"); };
    ليكن حرفي_4: نص = «{bad»;
    عين_جسم_نصي(&متغير ق2, &حرفي_4);
    إذا (!يرد(&الموجه, &ق2, 400, «Invalid JSON body»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق2, 400, 'Invalid JSON body')"); };

    // Required header + session cookie, combined.
    ليكن ق3: متغير طلب = طلب_بـ(«GET», «/header»);
    إذا (!يرد(&الموجه, &ق3, 400, «Required header is missing»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق3, 400, 'Required header is missing')"); };
    رأس(&متغير ق3, «x-name», «n»);
    إذا (!يرد(&الموجه, &ق3, 401, «Session is required»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق3, 401, 'Session is required')"); };
    رأس(&متغير ق3, «cookie», «a=b; nahr_session=s1»);
    إذا (!يرد(&الموجه, &ق3, 200, «user-1»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق3, 200, 'user-1')"); };
    رأس(&متغير ق3, «cookie», «nahr_session=nope»);
    إذا (!يرد(&الموجه, &ق3, 401, «Session is required»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق3, 401, 'Session is required')"); };

    // Validation counts characters: "علي" is 3 characters (6 bytes).
    ليكن ق4: طلب = طلب_بـ(«GET», «/short/%D8%B9%D9%84%D9%8A»);
    إذا (!يرد(&الموجه, &ق4, 200, «علي»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق4, 200, 'علي')"); };
    ليكن ق5: طلب = طلب_بـ(«GET», «/short/abcd»);
    إذا (!يرد(&الموجه, &ق5, 422, «too long»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق5, 422, 'too long')"); };

    // Result handlers and context handlers.
    ليكن ق6: طلب = طلب_بـ(«GET», «/divide»);
    إذا (!يرد(&الموجه, &ق6, 200, «25»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق6, 200, '25')"); };
    ليكن ق7: طلب = طلب_بـ(«GET», «/ctx»);
    إذا (!يرد(&الموجه, &ق7, 200, «ctx»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق7, 200, 'ctx')"); };

    // File serving never leaves its directory.
    ليكن ق8: طلب = طلب_بـ(«GET», «/files/../etc/passwd»);
    إذا (!يرد(&الموجه, &ق8, 404, «Not Found»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق8, 404, 'Not Found')"); };
    ليكن ق9: طلب = طلب_بـ(«GET», «/files/%2E%2E/etc/passwd»);
    إذا (!يرد(&الموجه, &ق9, 404, «Not Found»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق9, 404, 'Not Found')"); };
    ليكن ق10: طلب = طلب_بـ(«GET», «/files/definitely-missing-nahr-file»);
    إذا (!يرد(&الموجه, &ق10, 404, «Not Found»)) { أرجع لم_يتحقق("!يرد(&الموجه, &ق10, 404, 'Not Found')"); };
    ليكن حرفي_5: نص = «/etc/passwd»;
    ليكن حرفي_6: نص = «a/b.txt»;
    إذا (مسار_نسبي_آمن(&حرفي_5) || !مسار_نسبي_آمن(&حرفي_6)) { أرجع لم_يتحقق("مسار_نسبي_آمن(&حرفي_5) || !مسار_نسبي_آمن(&حرفي_6)"); };

    // SameSite=None requires Secure.
    ليكن الكعكة: متغير إعداد_كعكة = إعداد_كعكة_افتراضي();
    الكعكة.نفس_الموقع := سياسة_نفس_الموقع.لا_شيء();
    ليكن حرفي_7: نص = «x»;
    ليكن ر: متغير استجابة = رد_نصي(200, &حرفي_7);
    ليكن حرفي_8: نص = «a»;
    ليكن حرفي_9: نص = «b»;
    إذا (عين_كعكة(&متغير ر, &حرفي_8, &حرفي_9, &الكعكة)) { أرجع لم_يتحقق("عين_كعكة(&متغير ر, &حرفي_8, &حرفي_9, &الكعكة)"); };
    الكعكة.آمنة := صواب;
    ليكن حرفي_10: نص = «a»;
    ليكن حرفي_11: نص = «b»;
    إذا (!عين_كعكة(&متغير ر, &حرفي_10, &حرفي_11, &الكعكة)) { أرجع لم_يتحقق("!عين_كعكة(&متغير ر, &حرفي_10, &حرفي_11, &الكعكة)"); };
    أرجع نتيجة.نجح(0);
}
