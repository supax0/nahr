// Instantiates the rest of the public generic surface and runs it through the
// test client: handler adapters, three extractors, route middleware from a
// function, observers, form decoding, every method helper and serving.
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان, عدد_إلى_نص, طبيعي_إلى_نص;
من نهر.توجيه استورد
    موجه, أنشئ_موجها, سجل_مسارا, خطأ_توجيه, جلب, أرسل, استبدل, عدل, احذف, رأس,
    خيارات, اتصل, تتبع, حالة_الموجه, وسيط, وسيط_بمعطيات, تنفيذ_وسيط,
    التالي, تابع, استخدم_وسيطا, استخدم_وسيطا_للمسارات, وجه_الطلب;
من نهر.معالجة استورد
    طلب, معالج, من_دالة, من_بسيط, من_حالة, من_طلب, من_مسار, مع_وسيط,
    معالج_بمعطيات, استدع, مع_استخراج, مع_ثلاثة_استخراجات;
من نهر.استخراج استورد
    مستخرج, معاملات_مسار, استخرج, مستخرج_من_دالة, اجمع_مستخرجين,
    اجمع_ثلاثة_مستخرجات, قيمتان, ثلاث_قيم, استخرج_رأسا,
    استخرج_رمز_حامل, استخرج_هوية_حامل, استخرج_نموذجا_متعددا,
    استخرج_معامل_مسار_طبيعي, استخرج_معامل_استعلام, استخرج_معامل_استعلام_عدد,
    استخرج_معامل_استعلام_طبيعي, جزء_متعدد;
من نهر.ردود استورد استجابة, من_نتيجة, عين_رأسا;
من نهر.جسم استورد رد_نصي;
من نهر.أخطاء استورد حول_خطأ, خطأ_جاهز, رد_خطأ_جاهز;
من نهر.نموذج استورد استخرج_نموذجا, حقل_نموذج;
من نهر.وسطاء استورد وسيط_مسار, وسيط_مسار_من_دالة, التالي_مسار, تابع_مسار, راقب;
من نهر.تشغيل استورد شغل_على, شغل_على_مع_دورة_حياة, خطأ_تشغيل;
من نهر.اختبار استورد
    اختبر, اختبر_جلب, اختبر_إرسال, أنشئ_طلبا, عين_رأس_طلب, عين_جسم_نصي,
    حالة_الرد, نص_الرد, رأس_الرد_أو_فارغ;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    دع الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    دع لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

عرف بسيط(): استجابة { دع ن: نص = «simple»; أرجع رد_نصي(200, &ن); }
عرف بالحالة(الحالة: &عدد): استجابة { دع ن: نص = عدد_إلى_نص(*الحالة); أرجع رد_نصي(200, &ن); }
عرف بالطلب(الحالة: &عدد, الطلب: &طلب): استجابة { أرجع رد_نصي(200, &(*الطلب).الطريقة); }
عرف بالمسار(الحالة: &عدد, المعاملات: &معاملات_مسار): استجابة { دع ن: نص = «path»; أرجع رد_نصي(200, &ن); }
عرف كامل(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة { دع ن: نص = «full»; أرجع رد_نصي(200, &ن); }

عرف ثلاثة(الحالة: &عدد, أ: طبيعي, ب: اختياري نص, ج: عدد): استجابة {
    دع ن: نص = عدد_إلى_نص((أ مثل عدد) + ج);
    أرجع رد_نصي(200, &ن);
}

عرف زوج(الحالة: &عدد, القيم: قيمتان<اختياري نص, طبيعي>): استجابة {
    دع ن: نص = طبيعي_إلى_نص(القيم.الثانية);
    أرجع رد_نصي(200, &ن);
}

عرف هوية(الحالة: &عدد, الرمز: &نص): نتيجة نص, استجابة {
    أرجع نتيجة.نجح(استنسخ(الرمز));
}

عرف صدى(الحالة: &عدد, القيمة: نص): استجابة { أرجع رد_نصي(200, &القيمة); }

عرف أجزاء(الحالة: &عدد, القيمة: متجه جزء_متعدد): استجابة {
    دع ن: نص = طبيعي_إلى_نص(الطول(القيمة) مثل طبيعي);
    أرجع رد_نصي(200, &ن);
}

عرف فك_نموذج(الحقول: &متجه حقل_نموذج): نتيجة طبيعي, نص {
    أرجع نتيجة.نجح(الطول(*الحقول) مثل طبيعي);
}
عرف رفض(الخطأ: &نص): استجابة { أرجع رد_نصي(422, الخطأ); }
عرف عدد_حقول(الحالة: &عدد, القيمة: طبيعي): استجابة {
    دع ن: نص = طبيعي_إلى_نص(القيمة);
    أرجع رد_نصي(200, &ن);
}

// Route middleware written as a function: adds a header after the handler.
عرف وسم(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار, التالي: &التالي_مسار<عدد>): استجابة {
    دع الاستجابة: متغير استجابة = تابع_مسار(التالي, الحالة, الطلب, المعاملات);
    دع ن: نص = «x-tag»;
    دع ق: نص = «on»;
    دع تجاهل: منطقي = عين_رأسا(&متغير الاستجابة, &ن, &ق);
    أرجع الاستجابة;
}


// A global middleware with a text argument (a header value), the way
// configured middleware is built.
عرف نفذ_رأس_ثابت(المعطيات: &متجه نص, الإزاحة: طبيعي, الحالة: &عدد, الطلب: &طلب, التالي: &التالي<عدد>): استجابة {
    دع الاستجابة: متغير استجابة = تابع(التالي, الطلب);
    دع ن: نص = «x-static»;
    دع تجاهل: منطقي = عين_رأسا(&متغير الاستجابة, &ن, &(*المعطيات)[الإزاحة]);
    أرجع الاستجابة;
}

عرف مراقب(الحالة: &عدد, الطلب: &طلب, الاستجابة: &استجابة): فراغ { }
عرف خطاف(الحالة: &عدد): فراغ { }

عرف سجل(النتيجة: نتيجة طبيعي, خطأ_توجيه): منطقي {
    طابق النتيجة مع
    | نتيجة.نجح(_) -> { أرجع صواب; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عرف نص_يساوي(ر: &استجابة, المتوقع: نص): منطقي {
    دع النص: نص = نص_الرد(ر);
    أرجع نصان_متساويان(&النص, &المتوقع);
}

@@اختبار
عرف الواجهة_العامة(): نتيجة عدد, فشل {
    دع الموجه: متغير موجه<عدد> = أنشئ_موجها(42);
    إذا (*حالة_الموجه(&الموجه) != 42) { أرجع لم_يتحقق("*حالة_الموجه(&الموجه) != 42"); };

    دع أنماط: متجه نص = [«/s», «/st», «/rq», «/p», «/full/{n}», «/three/{n}», «/form», «/multi»];
    دع n: نص = «n»;
    دع q: نص = «q»;
    دع h: نص = «x-h»;

    دع م_طبيعي: مستخرج<عدد, طبيعي> = استخرج_معامل_مسار_طبيعي(&n);
    دع م_رأس: مستخرج<عدد, اختياري نص> = استخرج_رأسا(&h);
    دع م_عدد: مستخرج<عدد, عدد> = استخرج_معامل_استعلام_عدد(&q);
    دع م_نموذج: مستخرج<عدد, طبيعي> = استخرج_نموذجا(فك_نموذج, رفض);
    دع م_متعدد: مستخرج<عدد, متجه جزء_متعدد> = استخرج_نموذجا_متعددا();
    دع م_استعلام: مستخرج<عدد, اختياري نص> = استخرج_معامل_استعلام(&q);
    دع م_استعلام_ط: مستخرج<عدد, طبيعي> = استخرج_معامل_استعلام_طبيعي(&q);
    دع م_حامل: مستخرج<عدد, نص> = استخرج_رمز_حامل();
    دع م_هوية: مستخرج<عدد, نص> = استخرج_هوية_حامل(هوية);
    دع م_زوج: مستخرج<عدد, قيمتان<اختياري نص, طبيعي> > =
        اجمع_مستخرجين(استنسخ(&م_رأس), استنسخ(&م_استعلام_ط));
    دع م_ثلاثي: مستخرج<عدد, ثلاث_قيم<طبيعي, اختياري نص, عدد> > =
        اجمع_ثلاثة_مستخرجات(استنسخ(&م_طبيعي), استنسخ(&م_رأس), استنسخ(&م_عدد));

    إذا (!سجل(جلب(&متغير الموجه, &أنماط[0], من_بسيط(بسيط)))) { أرجع لم_يتحقق("!سجل(جلب(&متغير الموجه, &أنماط[0], من_بسيط(بسيط)))"); };
    إذا (!سجل(جلب(&متغير الموجه, &أنماط[1], من_حالة(بالحالة)))) { أرجع لم_يتحقق("!سجل(جلب(&متغير الموجه, &أنماط[1], من_حالة(بالحالة)))"); };
    إذا (!سجل(استبدل(&متغير الموجه, &أنماط[2], من_طلب(بالطلب)))) { أرجع لم_يتحقق("!سجل(استبدل(&متغير الموجه, &أنماط[2], من_طلب(بالطلب)))"); };
    إذا (!سجل(عدل(&متغير الموجه, &أنماط[2], من_طلب(بالطلب)))) { أرجع لم_يتحقق("!سجل(عدل(&متغير الموجه, &أنماط[2], من_طلب(بالطلب)))"); };
    إذا (!سجل(احذف(&متغير الموجه, &أنماط[2], من_طلب(بالطلب)))) { أرجع لم_يتحقق("!سجل(احذف(&متغير الموجه, &أنماط[2], من_طلب(بالطلب)))"); };
    إذا (!سجل(خيارات(&متغير الموجه, &أنماط[2], من_طلب(بالطلب)))) { أرجع لم_يتحقق("!سجل(خيارات(&متغير الموجه, &أنماط[2], من_طلب(بالطلب)))"); };
    إذا (!سجل(تتبع(&متغير الموجه, &أنماط[2], من_طلب(بالطلب)))) { أرجع لم_يتحقق("!سجل(تتبع(&متغير الموجه, &أنماط[2], من_طلب(بالطلب)))"); };
    إذا (!سجل(رأس(&متغير الموجه, &أنماط[3], من_مسار(بالمسار)))) { أرجع لم_يتحقق("!سجل(رأس(&متغير الموجه, &أنماط[3], من_مسار(بالمسار)))"); };
    إذا (!سجل(جلب(&متغير الموجه, &أنماط[4], مع_وسيط(من_دالة(كامل), وسيط_مسار_من_دالة(وسم))))) { أرجع لم_يتحقق("!سجل(جلب(&متغير الموجه, &أنماط[4], مع_وسيط(من_دالة(كامل), وسيط_مسار_من_دالة(وسم))))"); };
    إذا (!سجل(جلب(&متغير الموجه, &أنماط[5], مع_ثلاثة_استخراجات(استنسخ(&م_طبيعي), استنسخ(&م_رأس), م_عدد, ثلاثة)))) { أرجع لم_يتحقق("!سجل(جلب(&متغير الموجه, &أنماط[5], مع_ثلاثة_استخراجات(استنسخ(&م_طبيعي), استنسخ(&م_رأس), م_عدد, ثلاثة)))"); };
    إذا (!سجل(أرسل(&متغير الموجه, &أنماط[6], مع_استخراج(م_نموذج, عدد_حقول)))) { أرجع لم_يتحقق("!سجل(أرسل(&متغير الموجه, &أنماط[6], مع_استخراج(م_نموذج, عدد_حقول)))"); };
    إذا (!سجل(أرسل(&متغير الموجه, &أنماط[7], مع_استخراج(م_متعدد, أجزاء)))) { أرجع لم_يتحقق("!سجل(أرسل(&متغير الموجه, &أنماط[7], مع_استخراج(م_متعدد, أجزاء)))"); };

    دع قيمة_ثابتة: متجه نص = [«yes»];
    دع تنفيذ_ثابت: تنفيذ_وسيط<عدد> = نفذ_رأس_ثابت;
    استخدم_وسيطا(&متغير الموجه, وسيط_بمعطيات(تنفيذ_ثابت, قيمة_ثابتة));
    دع م_مراقب: وسيط<عدد> = راقب(مراقب);
    استخدم_وسيطا(&متغير الموجه, م_مراقب);

    دع ر1: استجابة = اختبر_جلب(&الموجه, &أنماط[0]);
    إذا (!نص_يساوي(&ر1, «simple»)) { أرجع لم_يتحقق("!نص_يساوي(&ر1, 'simple')"); };
    دع ر2: استجابة = اختبر_جلب(&الموجه, &أنماط[1]);
    إذا (!نص_يساوي(&ر2, «42»)) { أرجع لم_يتحقق("!نص_يساوي(&ر2, '42')"); };
    دع full: نص = «/full/1»;
    دع ر3: استجابة = اختبر_جلب(&الموجه, &full);
    دع x_tag: نص = «x-tag»;
    دع x_static: نص = «x-static»;
    دع وسم_القيمة: نص = رأس_الرد_أو_فارغ(&ر3, &x_tag);
    دع ثابت_القيمة: نص = رأس_الرد_أو_فارغ(&ر3, &x_static);
    دع on: نص = «on»;
    دع yes: نص = «yes»;
    إذا (!نص_يساوي(&ر3, «full») || !نصان_متساويان(&وسم_القيمة, &on)
        || !نصان_متساويان(&ثابت_القيمة, &yes)) { أرجع لم_يتحقق("إذا (!نص_يساوي(&ر3, 'full') || !نصان_متساويان(&وسم_القيمة, &on)"); };
    دع three: نص = «/three/5?q=-2»;
    دع ر4: استجابة = اختبر_جلب(&الموجه, &three);
    إذا (!نص_يساوي(&ر4, «3»)) { أرجع لم_يتحقق("!نص_يساوي(&ر4, '3')"); };
    دع form: نص = «/form»;
    دع جسم_النموذج: نص = «a=1&b=2»;
    دع post: نص = «POST»;
    دع ق5: متغير طلب = أنشئ_طلبا(&post, &form);
    عين_جسم_نصي(&متغير ق5, &جسم_النموذج);
    دع ct: نص = «content-type»;
    دع urlenc: نص = «application/x-www-form-urlencoded»;
    دع تجاهل: منطقي = عين_رأس_طلب(&متغير ق5, &ct, &urlenc);
    دع ر5: استجابة = اختبر(&الموجه, &ق5);
    إذا (!نص_يساوي(&ر5, «2»)) { أرجع لم_يتحقق("!نص_يساوي(&ر5, '2')"); };
    دع ر6: استجابة = اختبر_إرسال(&الموجه, &form, &جسم_النموذج);
    إذا (حالة_الرد(&ر6) != 415) { أرجع لم_يتحقق("حالة_الرد(&ر6) != 415"); };

    // Error helpers.
    دع خ: خطأ_جاهز = خطأ_جاهز.غير_موجود(«none»);
    دع ر7: استجابة = حول_خطأ(&خ, رد_خطأ_جاهز);
    إذا (حالة_الرد(&ر7) != 404) { أرجع لم_يتحقق("حالة_الرد(&ر7) != 404"); };
    دع نتيجة_رد: نتيجة استجابة, خطأ_جاهز = نتيجة.خطأ(خطأ_جاهز.تعارض(«c»));
    دع ر8: استجابة = من_نتيجة(نتيجة_رد, رد_خطأ_جاهز);
    إذا (حالة_الرد(&ر8) != 409) { أرجع لم_يتحقق("حالة_الرد(&ر8) != 409"); };

    // Serving is only compiled here, never started.
    إذا (*حالة_الموجه(&الموجه) == 7) {
        دع العنوان: نص = «127.0.0.1:0»;
        دع _أ: نتيجة عدد, خطأ_تشغيل = شغل_على_مع_دورة_حياة(&العنوان, &الموجه, خطاف, خطاف);
    };
    أرجع نتيجة.نجح(0);
}
