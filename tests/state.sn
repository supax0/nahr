// Application state is shared by every request: an atomic counter and a
// Mutex in the state keep their changes (std's router copies its own state
// per request, so Nahr keeps the application state behind an Arc).
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد طبيعي_إلى_نص, حلل_طبيعي;
من std.sync استورد
    ذرة_ط64, أنشئ_ذرة_ط64, احمل_ط64, اجمع_واجلب_ط64, ترتيب_ذاكرة,
    قفل, أنشئ_قفل, نفذ_مع_القفل;
من نهر.توجيه استورد موجه, أنشئ_موجها, جلب, حالة_الموجه, استخدم_وسيطا, وسيط, وسيط_من_دالة, تابع, التالي;
من نهر.معالجة استورد طلب, من_دالة;
من نهر.استخراج استورد معاملات_مسار;
من نهر.ردود استورد استجابة;
من نهر.جسم استورد رد_نصي;
من نهر.اختبار استورد اختبر_جلب, نص_الرد;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    دع الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    دع لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

نوع حالة = { العداد: ذرة_ط64, الأسماء: قفل<متجه نص>, الوسيط: ذرة_ط64 };

عرف عد(الحالة: &حالة, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع القديم: ط64 = اجمع_واجلب_ط64(&(*الحالة).العداد, 1 مثل ط64, ترتيب_ذاكرة.مسترخ());
    دع العدد: طبيعي = نفذ_مع_القفل(
        &(*الحالة).الأسماء,
        دالة(القائمة: &متغير متجه نص): طبيعي -> أضف_اسما(القائمة)
    );
    دع النص: نص = طبيعي_إلى_نص((القديم مثل طبيعي) * 100 + العدد);
    أرجع رد_نصي(200, &النص);
}

عرف أضف_اسما(القائمة: &متغير متجه نص): طبيعي {
    ألحق(*القائمة, «x»);
    أرجع الطول(*القائمة) مثل طبيعي;
}

// Middleware sees the same state as handlers.
عرف عداد_الوسيط(الحالة: &حالة, الطلب: &طلب, التالي: &التالي<حالة>): استجابة {
    دع تجاهل: ط64 = اجمع_واجلب_ط64(&(*الحالة).الوسيط, 1 مثل ط64, ترتيب_ذاكرة.مسترخ());
    أرجع تابع(التالي, الطلب);
}

عرف رقم_الرد(الرد: &استجابة): طبيعي {
    دع النص: نص = نص_الرد(الرد);
    طابق حلل_طبيعي(&النص) مع
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; }
    | نتيجة.خطأ(_) -> { أرجع 999999; };
}

@@اختبار
عرف الحالة_المشتركة(): نتيجة عدد, فشل {
    دع الأسماء: متجه نص = [];
    دع البداية: حالة = {
        العداد: أنشئ_ذرة_ط64(0 مثل ط64),
        الأسماء: أنشئ_قفل(الأسماء),
        الوسيط: أنشئ_ذرة_ط64(0 مثل ط64)
    };
    دع الموجه: متغير موجه<حالة> = أنشئ_موجها(البداية);
    دع المسار: نص = «/»;
    طابق جلب(&متغير الموجه, &المسار, من_دالة(عد)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &المسار, من_دالة(عد)) مع"); } | نتيجة.نجح(_) -> { };
    دع الوسيط: وسيط<حالة> = وسيط_من_دالة(عداد_الوسيط);
    استخدم_وسيطا(&متغير الموجه, الوسيط);

    دع ر1: استجابة = اختبر_جلب(&الموجه, &المسار);
    دع ر2: استجابة = اختبر_جلب(&الموجه, &المسار);
    دع ر3: استجابة = اختبر_جلب(&الموجه, &المسار);
    // old counter * 100 + names after the append: 1, 102, 203.
    إذا (رقم_الرد(&ر1) != 1) { أرجع لم_يتحقق("رقم_الرد(&ر1) != 1"); };
    إذا (رقم_الرد(&ر2) != 102) { أرجع لم_يتحقق("رقم_الرد(&ر2) != 102"); };
    إذا (رقم_الرد(&ر3) != 203) { أرجع لم_يتحقق("رقم_الرد(&ر3) != 203"); };
    دع الحالة: &حالة = حالة_الموجه(&الموجه);
    إذا (احمل_ط64(&(*الحالة).العداد, ترتيب_ذاكرة.مسترخ()) != (3 مثل ط64)) { أرجع لم_يتحقق("احمل_ط64(&(*الحالة).العداد, ترتيب_ذاكرة.مسترخ()) != (3 مثل ط64)"); };
    إذا (احمل_ط64(&(*الحالة).الوسيط, ترتيب_ذاكرة.مسترخ()) != (3 مثل ط64)) { أرجع لم_يتحقق("احمل_ط64(&(*الحالة).الوسيط, ترتيب_ذاكرة.مسترخ()) != (3 مثل ط64)"); };
    أرجع نتيجة.نجح(0);
}
