// Rate limiting: per-key budgets, 429 with Retry-After, global key.
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان;
من نهر.توجيه استورد موجه, أنشئ_موجها, جلب, استخدم_وسيطا, وسيط;
من نهر.معالجة استورد طلب, من_دالة;
من نهر.استخراج استورد معاملات_مسار;
من نهر.ردود استورد استجابة;
من نهر.جسم استورد رد_نصي;
من نهر.وسطاء استورد حد_المعدل, مفتاح_بالرأس, مفتاح_عام, مفتاح_معدل;
من نهر.اختبار استورد اختبر, أنشئ_طلبا, عين_رأس_طلب, حالة_الرد, رأس_الرد_أو_فارغ;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    ليكن الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    ليكن لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

عرف الجذر(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن النص: نص = «ok»;
    أرجع رد_نصي(200, &النص);
}

عرف طلب_بمفتاح(المفتاح: نص): طلب {
    ليكن get: نص = «GET»;
    ليكن الهدف: نص = «/»;
    ليكن الطلب: متغير طلب = أنشئ_طلبا(&get, &الهدف);
    ليكن الاسم: نص = «x-api-key»;
    ليكن تجاهل: منطقي = عين_رأس_طلب(&متغير الطلب, &الاسم, &المفتاح);
    أرجع الطلب;
}

@@اختبار
عرف ميزانيات_حد_المعدل(): نتيجة عدد, فشل {
    ليكن الموجه: متغير موجه<عدد> = أنشئ_موجها(0);
    ليكن جذر: نص = «/»;
    طابق جلب(&متغير الموجه, &جذر, من_دالة(الجذر)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &جذر, من_دالة(الجذر)) مع"); } | نتيجة.نجح(_) -> { };
    ليكن اسم: نص = «x-api-key»;
    ليكن المفتاح: مفتاح_معدل<عدد> = مفتاح_بالرأس(&اسم);
    ليكن الحد: وسيط<عدد> = حد_المعدل(2, 60, المفتاح);
    استخدم_وسيطا(&متغير الموجه, الحد);

    ليكن أ: طلب = طلب_بمفتاح(«a»);
    ليكن ب: طلب = طلب_بمفتاح(«b»);
    ليكن ر1: استجابة = اختبر(&الموجه, &أ);
    ليكن ر2: استجابة = اختبر(&الموجه, &أ);
    ليكن ر3: استجابة = اختبر(&الموجه, &أ);
    إذا (حالة_الرد(&ر1) != 200 || حالة_الرد(&ر2) != 200) { أرجع لم_يتحقق("حالة_الرد(&ر1) != 200 || حالة_الرد(&ر2) != 200"); };
    إذا (حالة_الرد(&ر3) != 429) { أرجع لم_يتحقق("حالة_الرد(&ر3) != 429"); };
    ليكن retry: نص = «retry-after»;
    ليكن الانتظار: نص = رأس_الرد_أو_فارغ(&ر3, &retry);
    إذا ((الطول(الانتظار) مثل طبيعي) == 0) { أرجع لم_يتحقق("(الطول(الانتظار) مثل طبيعي) == 0"); };
    // Another key has its own budget.
    ليكن ر4: استجابة = اختبر(&الموجه, &ب);
    إذا (حالة_الرد(&ر4) != 200) { أرجع لم_يتحقق("حالة_الرد(&ر4) != 200"); };

    // Global key: one budget for all.
    ليكن عام_موجه: متغير موجه<عدد> = أنشئ_موجها(0);
    طابق جلب(&متغير عام_موجه, &جذر, من_دالة(الجذر)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير عام_موجه, &جذر, من_دالة(الجذر)) مع"); } | نتيجة.نجح(_) -> { };
    ليكن الكل: مفتاح_معدل<عدد> = مفتاح_عام();
    ليكن حد_عام: وسيط<عدد> = حد_المعدل(1, 60, الكل);
    استخدم_وسيطا(&متغير عام_موجه, حد_عام);
    ليكن ر5: استجابة = اختبر(&عام_موجه, &أ);
    ليكن ر6: استجابة = اختبر(&عام_موجه, &ب);
    إذا (حالة_الرد(&ر5) != 200 || حالة_الرد(&ر6) != 429) { أرجع لم_يتحقق("حالة_الرد(&ر5) != 200 || حالة_الرد(&ر6) != 429"); };
    أرجع نتيجة.نجح(0);
}
