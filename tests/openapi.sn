// OpenAPI: documented routes, nesting with the document, JSON and docs page.
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان, يحتوي_نصا;
من نهر.توجيه استورد موجه, أنشئ_موجها, جلب;
من نهر.معالجة استورد طلب, من_دالة, معالج;
من نهر.استخراج استورد معاملات_مسار;
من نهر.ردود استورد استجابة;
من نهر.جسم استورد رد_نصي;
من نهر.توثيق استورد
    وثيقة_واجهة, أنشئ_وثيقة, صف_جلب, عملية_واجهة, ضمن_استجابة, استجابة_فقط,
    سجل_موثقا, اربط_موثقا, واجهة_إلى_جسون,
    معالج_المخطط, معالج_صفحة_التوثيق, صفحة_توثيق_بمخطط;
من نهر.اختبار استورد اختبر_جلب, حالة_الرد, نص_الرد, رأس_الرد_أو_فارغ;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    ليكن الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    ليكن لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

عرف قائمة(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن النص: نص = «[]»;
    أرجع رد_نصي(200, &النص);
}

عرف يحتوي(النص: &نص, الجزء: نص): منطقي { أرجع يحتوي_نصا(النص, &الجزء); }

@@اختبار
عرف توثيق_openapi(): نتيجة عدد, فشل {
    ليكن العنوان: نص = «Nahr test»;
    ليكن الإصدار: نص = «1.0.0»;
    ليكن الوثيقة: متغير وثيقة_واجهة = أنشئ_وثيقة(&العنوان, &الإصدار);
    ليكن الموجه: متغير موجه<عدد> = أنشئ_موجها(0);

    // A sub-router documented on its own, mounted under /api.
    ليكن فرعي: متغير موجه<عدد> = أنشئ_موجها(0);
    ليكن وثيقة_فرعية: متغير وثيقة_واجهة = أنشئ_وثيقة(&العنوان, &الإصدار);
    ليكن المسار: نص = «/users»;
    ليكن العملية: متغير عملية_واجهة = صف_جلب(&المسار);
    ليكن رمز: نص = «200»;
    ليكن الوصف: نص = «OK»;
    ضمن_استجابة(&متغير العملية, استجابة_فقط(&رمز, &الوصف));
    ليكن المعالج: معالج<عدد> = من_دالة(قائمة);
    طابق سجل_موثقا(&متغير فرعي, &متغير وثيقة_فرعية, العملية, المعالج) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق سجل_موثقا(&متغير فرعي, &متغير وثيقة_فرعية, العملية, المعالج) مع"); } | نتيجة.نجح(_) -> { };
    ليكن api: نص = «/api»;
    طابق اربط_موثقا(&متغير الموجه, &متغير الوثيقة, &api, &فرعي, &وثيقة_فرعية) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق اربط_موثقا(&متغير الموجه, &متغير الوثيقة, &api, &فرعي, &وثيقة_فرعية) مع"); } | نتيجة.نجح(_) -> { };

    طابق واجهة_إلى_جسون(&الوثيقة) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق واجهة_إلى_جسون(&الوثيقة) مع"); }
    | نتيجة.نجح(الجسون) -> {
        إذا (!يحتوي(&الجسون, «"openapi":"3.2.0"»)) { أرجع لم_يتحقق("!يحتوي(&الجسون, ''openapi':'3.2.0'')"); };
        إذا (!يحتوي(&الجسون, «"/api/users"»)) { أرجع لم_يتحقق("!يحتوي(&الجسون, ''/api/users'')"); };
    };

    ليكن مسار_المخطط: نص = «/openapi.json»;
    ليكن مسار_الصفحة: نص = «/docs»;
    طابق جلب(&متغير الموجه, &مسار_المخطط, معالج_المخطط(استنسخ(&الوثيقة))) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &مسار_المخطط, معالج_المخطط(استنسخ(&الوثيقة))) مع"); } | نتيجة.نجح(_) -> { };
    ليكن الصفحة: معالج<عدد> = معالج_صفحة_التوثيق();
    طابق جلب(&متغير الموجه, &مسار_الصفحة, الصفحة) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &مسار_الصفحة, الصفحة) مع"); } | نتيجة.نجح(_) -> { };

    ليكن ر1: استجابة = اختبر_جلب(&الموجه, &مسار_المخطط);
    إذا (حالة_الرد(&ر1) != 200) { أرجع لم_يتحقق("حالة_الرد(&ر1) != 200"); };
    ليكن ct: نص = «content-type»;
    ليكن النوع: نص = رأس_الرد_أو_فارغ(&ر1, &ct);
    إذا (!يحتوي(&النوع, «application/json»)) { أرجع لم_يتحقق("!يحتوي(&النوع, 'application/json')"); };
    ليكن ر2: استجابة = اختبر_جلب(&الموجه, &مسار_الصفحة);
    ليكن الجسم: نص = نص_الرد(&ر2);
    إذا (!يحتوي(&الجسم, «content="openapi.json"»)) { أرجع لم_يتحقق("!يحتوي(&الجسم, 'content='openapi.json'')"); };
    ليكن مسار_api: نص = «/api/users»;
    ليكن ر3: استجابة = اختبر_جلب(&الموجه, &مسار_api);
    إذا (حالة_الرد(&ر3) != 200) { أرجع لم_يتحقق("حالة_الرد(&ر3) != 200"); };

    // The spec URL is HTML-escaped into the page.
    ليكن خطر: نص = «x"><script>»;
    ليكن صفحة: نص = صفحة_توثيق_بمخطط(&خطر);
    إذا (يحتوي(&صفحة, «x"><script>») || !يحتوي(&صفحة, «x&quot;&gt;&lt;script&gt;»)) { أرجع لم_يتحقق("يحتوي(&صفحة, 'x'><script>') || !يحتوي(&صفحة, 'x&quot;&gt;&lt;script&gt;')"); };
    أرجع نتيجة.نجح(0);
}
