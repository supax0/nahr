// Routing: methods, path parameters, HEAD, 404/405, merge and nest.
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان, عدد_إلى_نص, صل_النصوص;
من نهر.توجيه استورد موجه, أنشئ_موجها, جلب, أرسل, ادمج, اربط;
من نهر.معالجة استورد طلب, من_دالة, مع_استخراج, مع_استخراجين;
من نهر.استخراج استورد
    مستخرج,
    معاملات_مسار,
    استخرج_معامل_مسار,
    استخرج_معامل_مسار_عدد,
    استخرج_معامل_استعلام_مطلوب;
من نهر.ردود استورد استجابة;
من نهر.جسم استورد رد_نصي;
من نهر.اختبار استورد
    اختبر, اختبر_جلب, أنشئ_طلبا, حالة_الرد, نص_الرد, رأس_الرد_أو_فارغ;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    دع الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    دع لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

عرف الجذر(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع النص: نص = «root»;
    أرجع رد_نصي(200, &النص);
}

عرف المستخدم(الحالة: &عدد, الاسم: نص): استجابة {
    أرجع رد_نصي(200, &الاسم);
}

عرف المنشور(الحالة: &عدد, المعرف: عدد): استجابة {
    دع النص: نص = عدد_إلى_نص(المعرف + *الحالة);
    أرجع رد_نصي(200, &النص);
}

عرف البحث(الحالة: &عدد, الاسم: نص, السؤال: نص): استجابة {
    دع الأجزاء: متجه نص = [الاسم, السؤال];
    دع الفاصل: نص = «:»;
    دع النص: نص = صل_النصوص(&الأجزاء, &الفاصل);
    أرجع رد_نصي(200, &النص);
}

عرف يساوي(أ: &نص, ب: نص): منطقي { أرجع نصان_متساويان(أ, &ب); }

عرف افحص_جلب(الموجه: &موجه<عدد>, الهدف: نص, الحالة: طبيعي, الجسم: نص): منطقي {
    دع ر: استجابة = اختبر_جلب(الموجه, &الهدف);
    إذا (حالة_الرد(&ر) != الحالة) { أرجع خطأ; };
    دع النص: نص = نص_الرد(&ر);
    أرجع نصان_متساويان(&النص, &الجسم);
}

@@اختبار
عرف التوجيه(): نتيجة عدد, فشل {
    دع الموجه: متغير موجه<عدد> = أنشئ_موجها(1000);
    دع جذر: نص = «/»;
    دع نمط_المستخدم: نص = «/users/{name}»;
    دع نمط_المنشور: نص = «/posts/{id}»;
    دع نمط_البحث: نص = «/search/{name}»;
    دع name: نص = «name»;
    دع id: نص = «id»;
    دع q: نص = «q»;

    // SultanC infers a generic call's type arguments from its own arguments
    // or from a typed binding, so extractors are bound with their types.
    دع مستخرج_الاسم: مستخرج<عدد, نص> = استخرج_معامل_مسار(&name);
    دع مستخرج_المعرف: مستخرج<عدد, عدد> = استخرج_معامل_مسار_عدد(&id);
    دع مستخرج_السؤال: مستخرج<عدد, نص> = استخرج_معامل_استعلام_مطلوب(&q);

    طابق جلب(&متغير الموجه, &جذر, من_دالة(الجذر)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير الموجه, &جذر, من_دالة(الجذر)) مع"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &نمط_المستخدم,
        مع_استخراج(استنسخ(&مستخرج_الاسم), المستخدم)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("مع_استخراج(استنسخ(&مستخرج_الاسم), المستخدم)) مع"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &نمط_المنشور,
        مع_استخراج(مستخرج_المعرف, المنشور)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("مع_استخراج(مستخرج_المعرف, المنشور)) مع"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &نمط_البحث,
        مع_استخراجين(
            استنسخ(&مستخرج_الاسم),
            مستخرج_السؤال,
            البحث
        )) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق(")) مع"); } | نتيجة.نجح(_) -> { };

    إذا (!افحص_جلب(&الموجه, «/», 200, «root»)) { أرجع لم_يتحقق("!افحص_جلب(&الموجه, '/', 200, 'root')"); };
    // Path parameters are percent-decoded: %D8%B9%D9%84%D9%8A is "علي".
    إذا (!افحص_جلب(&الموجه, «/users/%D8%B9%D9%84%D9%8A», 200, «علي»)) { أرجع لم_يتحقق("!افحص_جلب(&الموجه, '/users/%D8%B9%D9%84%D9%8A', 200, 'علي')"); };
    إذا (!افحص_جلب(&الموجه, «/users/a%2Fb», 200, «a/b»)) { أرجع لم_يتحقق("!افحص_جلب(&الموجه, '/users/a%2Fb', 200, 'a/b')"); };
    إذا (!افحص_جلب(&الموجه, «/users/%ZZ», 400, «Invalid path parameter»)) { أرجع لم_يتحقق("!افحص_جلب(&الموجه, '/users/%ZZ', 400, 'Invalid path parameter')"); };
    إذا (!افحص_جلب(&الموجه, «/posts/5», 200, «1005»)) { أرجع لم_يتحقق("!افحص_جلب(&الموجه, '/posts/5', 200, '1005')"); };
    إذا (!افحص_جلب(&الموجه, «/posts/x», 400, «Invalid path parameter»)) { أرجع لم_يتحقق("!افحص_جلب(&الموجه, '/posts/x', 400, 'Invalid path parameter')"); };
    إذا (!افحص_جلب(&الموجه, «/search/a?q=b+c», 200, «a:b c»)) { أرجع لم_يتحقق("!افحص_جلب(&الموجه, '/search/a?q=b+c', 200, 'a:b c')"); };
    إذا (!افحص_جلب(&الموجه, «/search/a», 400, «Invalid query parameter»)) { أرجع لم_يتحقق("!افحص_جلب(&الموجه, '/search/a', 400, 'Invalid query parameter')"); };
    دع مفقود: نص = «/missing»;
    دع ر404: استجابة = اختبر_جلب(&الموجه, &مفقود);
    إذا (حالة_الرد(&ر404) != 404) { أرجع لم_يتحقق("حالة_الرد(&ر404) != 404"); };

    // HEAD is answered by the GET route; 405 lists HEAD next to GET.
    دع head: نص = «HEAD»;
    دع طلب_head: طلب = أنشئ_طلبا(&head, &جذر);
    دع ر_head: استجابة = اختبر(&الموجه, &طلب_head);
    إذا (حالة_الرد(&ر_head) != 200) { أرجع لم_يتحقق("حالة_الرد(&ر_head) != 200"); };
    دع post: نص = «POST»;
    دع طلب_post: طلب = أنشئ_طلبا(&post, &جذر);
    دع ر405: استجابة = اختبر(&الموجه, &طلب_post);
    إذا (حالة_الرد(&ر405) != 405) { أرجع لم_يتحقق("حالة_الرد(&ر405) != 405"); };
    دع allow: نص = «allow»;
    دع المسموح: نص = رأس_الرد_أو_فارغ(&ر405, &allow);
    إذا (!يساوي(&المسموح, «GET, HEAD»)) { أرجع لم_يتحقق("!يساوي(&المسموح, 'GET, HEAD')"); };

    // Nesting: "/api" + "/" is "/api"; "/api" + "/users/{name}".
    دع فرعي: متغير موجه<عدد> = أنشئ_موجها(0);
    طابق جلب(&متغير فرعي, &جذر, من_دالة(الجذر)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير فرعي, &جذر, من_دالة(الجذر)) مع"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير فرعي, &نمط_المستخدم,
        مع_استخراج(استنسخ(&مستخرج_الاسم), المستخدم)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("مع_استخراج(استنسخ(&مستخرج_الاسم), المستخدم)) مع"); } | نتيجة.نجح(_) -> { };
    دع api: نص = «/api»;
    طابق اربط(&متغير الموجه, &api, &فرعي) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق اربط(&متغير الموجه, &api, &فرعي) مع"); } | نتيجة.نجح(_) -> { };
    إذا (!افحص_جلب(&الموجه, «/api», 200, «root»)) { أرجع لم_يتحقق("!افحص_جلب(&الموجه, '/api', 200, 'root')"); };
    إذا (!افحص_جلب(&الموجه, «/api/users/x», 200, «x»)) { أرجع لم_يتحقق("!افحص_جلب(&الموجه, '/api/users/x', 200, 'x')"); };

    // A conflicting merge fails and leaves the router unchanged.
    دع متعارض: متغير موجه<عدد> = أنشئ_موجها(0);
    دع جديد: نص = «/new»;
    طابق جلب(&متغير متعارض, &جديد, من_دالة(الجذر)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير متعارض, &جديد, من_دالة(الجذر)) مع"); } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير متعارض, &جذر, من_دالة(الجذر)) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق جلب(&متغير متعارض, &جذر, من_دالة(الجذر)) مع"); } | نتيجة.نجح(_) -> { };
    طابق ادمج(&متغير الموجه, &متعارض) مع
    | نتيجة.نجح(_) -> { أرجع لم_يتحقق("طابق ادمج(&متغير الموجه, &متعارض) مع"); } | نتيجة.خطأ(_) -> { };
    إذا (!افحص_جلب(&الموجه, «/new», 404, «Not Found»)) { أرجع لم_يتحقق("!افحص_جلب(&الموجه, '/new', 404, 'Not Found')"); };
    أرجع نتيجة.نجح(0);
}
