// Static sites: index files, trailing-slash redirects, charset, precompressed
// files, Cache-Control, ETag/304, the single-page fallback, and serving "/".
من std.error استورد فشل, فشل_من;
من std.text استورد صل_النصوص;
من std.text استورد نصان_متساويان, يحتوي_نصا, من_بايتات;
من std.fs استورد اكتب_الملف, أنشئ_دليلا, أنشئ_دليلا_مؤقتا;
من std.io استورد اطبع_سطر;
من نهر.توجيه استورد
    موجه, أنشئ_موجها, اربط_ملفات, اربط_ملفات_بإعداد, إعداد_ملفات, إعداد_ملفات_افتراضي;
من نهر.معالجة استورد طلب;
من نهر.ردود استورد استجابة;
من نهر.اختبار استورد
    اختبر, اختبر_جلب, أنشئ_طلبا, عين_رأس_طلب, حالة_الرد, نص_الرد, رأس_الرد_أو_فارغ;

// فحص لم يتحقق، مع نص الفحص.
عرف لم_يتحقق(الفحص: نص): نتيجة عدد, فشل {
    ليكن الأجزاء: متجه نص = [«لم يتحقق: », الفحص];
    ليكن لا_شيء: نص = «»;
    أرجع نتيجة.خطأ(فشل_من(صل_النصوص(&الأجزاء, &لا_شيء)));
}

عرف صل(أ: &نص, ب: نص): نص {
    ليكن الناتج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*أ) مثل طبيعي)) { ألحق(الناتج, (*أ)[ف]); ف := ف + 1; }
    ف := 0;
    طالما (ف < (الطول(ب) مثل طبيعي)) { ألحق(الناتج, ب[ف]); ف := ف + 1; }
    أرجع من_بايتات(&الناتج);
}

عرف يساوي(النص: &نص, الآخر: نص): منطقي { أرجع نصان_متساويان(النص, &الآخر); }

عرف اكتب(الدليل: &نص, الاسم: نص, المحتوى: نص): منطقي {
    ليكن المسار: نص = صل(الدليل, الاسم);
    طابق اكتب_الملف(&المسار, &المحتوى) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(_) -> { أرجع صواب; };
}

عرف رأس(الرد: &استجابة, الاسم: نص): نص { أرجع رأس_الرد_أو_فارغ(الرد, &الاسم); }

عرف جلب_مع(الموجه: &موجه<عدد>, الهدف: نص, الاسم: نص, القيمة: نص): استجابة {
    ليكن get: نص = «GET»;
    ليكن الطلب: متغير طلب = أنشئ_طلبا(&get, &الهدف);
    ليكن ت: منطقي = عين_رأس_طلب(&متغير الطلب, &الاسم, &القيمة);
    أرجع اختبر(الموجه, &الطلب);
}

عرف اجلب(الموجه: &موجه<عدد>, الهدف: نص): استجابة { أرجع اختبر_جلب(الموجه, &الهدف); }

@@اختبار
عرف الملفات_الثابتة(): نتيجة عدد, فشل {
    ليكن الدليل: متغير نص = «»;
    ليكن البادئة: نص = «nahr-static»;
    طابق أنشئ_دليلا_مؤقتا(&البادئة) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق أنشئ_دليلا_مؤقتا(&البادئة) مع"); }
    | نتيجة.نجح(المسار) -> { الدليل := المسار; };
    ليكن الفرعي: نص = صل(&الدليل, «/docs»);
    طابق أنشئ_دليلا(&الفرعي) مع | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق أنشئ_دليلا(&الفرعي) مع | نتيجة.خطأ(_) -> { أرجع 2; } | نتيجة.نجح(_) -> { };"); } | نتيجة.نجح(_) -> { };
    إذا (!اكتب(&الدليل, «/index.html», «<h1>مرحبا</h1>»)) { أرجع لم_يتحقق("!اكتب(&الدليل, '/index.html', '<h1>مرحبا</h1>')"); };
    إذا (!اكتب(&الدليل, «/app.js», «console.log(1)»)) { أرجع لم_يتحقق("!اكتب(&الدليل, '/app.js', 'console.log(1)')"); };
    إذا (!اكتب(&الدليل, «/app.js.br», «BR»)) { أرجع لم_يتحقق("!اكتب(&الدليل, '/app.js.br', 'BR')"); };
    إذا (!اكتب(&الدليل, «/style.css», «body{}»)) { أرجع لم_يتحقق("!اكتب(&الدليل, '/style.css', 'body{}')"); };
    إذا (!اكتب(&الدليل, «/style.css.gz», «GZ»)) { أرجع لم_يتحقق("!اكتب(&الدليل, '/style.css.gz', 'GZ')"); };
    إذا (!اكتب(&الدليل, «/docs/index.html», «docs»)) { أرجع لم_يتحقق("!اكتب(&الدليل, '/docs/index.html', 'docs')"); };

    // Default settings at /static.
    ليكن الموجه: متغير موجه<عدد> = أنشئ_موجها(0);
    ليكن مسار_ثابت: نص = «/static»;
    طابق اربط_ملفات(&متغير الموجه, &مسار_ثابت, &الدليل) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق اربط_ملفات(&متغير الموجه, &مسار_ثابت, &الدليل) مع"); } | نتيجة.نجح(_) -> { };

    ليكن ر1: استجابة = اجلب(&الموجه, «/static/»);
    ليكن ج1: نص = نص_الرد(&ر1);
    إذا (حالة_الرد(&ر1) != 200 || !يساوي(&ج1, «<h1>مرحبا</h1>»)) { أرجع لم_يتحقق("حالة_الرد(&ر1) != 200 || !يساوي(&ج1, '<h1>مرحبا</h1>')"); };
    ليكن ن1: نص = رأس(&ر1, «content-type»);
    إذا (!يساوي(&ن1, «text/html; charset=utf-8»)) { ليكن ت: نتيجة عدد, عدد = اطبع_سطر(ن1); أرجع لم_يتحقق("إذا (!يساوي(&ن1, 'text/html; charset=utf-8')) { دع ت: نتيجة عدد, عدد = اطبع_سطر(ن1); أرجع 11; };"); };

    ليكن ر2: استجابة = اجلب(&الموجه, «/static/docs?x=1»);
    ليكن م2: نص = رأس(&ر2, «location»);
    إذا (حالة_الرد(&ر2) != 301 || !يساوي(&م2, «/static/docs/?x=1»)) { أرجع لم_يتحقق("حالة_الرد(&ر2) != 301 || !يساوي(&م2, '/static/docs/?x=1')"); };
    ليكن ر3: استجابة = اجلب(&الموجه, «/static/docs/»);
    ليكن ج3: نص = نص_الرد(&ر3);
    إذا (!يساوي(&ج3, «docs»)) { أرجع لم_يتحقق("!يساوي(&ج3, 'docs')"); };
    ليكن ر4: استجابة = اجلب(&الموجه, «/static»);
    ليكن م4: نص = رأس(&ر4, «location»);
    إذا (حالة_الرد(&ر4) != 301 || !يساوي(&م4, «/static/»)) { أرجع لم_يتحقق("حالة_الرد(&ر4) != 301 || !يساوي(&م4, '/static/')"); };

    ليكن ر5: استجابة = اجلب(&الموجه, «/static/app.js»);
    ليكن ن5: نص = رأس(&ر5, «content-type»);
    إذا (!يساوي(&ن5, «text/javascript; charset=utf-8»)) { ليكن ت: نتيجة عدد, عدد = اطبع_سطر(ن5); أرجع لم_يتحقق("إذا (!يساوي(&ن5, 'text/javascript; charset=utf-8')) { دع ت: نتيجة عدد, عدد = اطبع_سطر(ن5); أرجع 15; };"); };
    ليكن ر6: استجابة = اجلب(&الموجه, «/static/style.css»);
    ليكن ن6: نص = رأس(&ر6, «content-type»);
    إذا (!يساوي(&ن6, «text/css; charset=utf-8»)) { أرجع لم_يتحقق("!يساوي(&ن6, 'text/css; charset=utf-8')"); };
    // Without مضغوطة, a .br next to the file is not used.
    ليكن ر7: استجابة = جلب_مع(&الموجه, «/static/app.js», «accept-encoding», «br»);
    ليكن ج7: نص = نص_الرد(&ر7);
    إذا (!يساوي(&ج7, «console.log(1)»)) { أرجع لم_يتحقق("!يساوي(&ج7, 'console.log(1)')"); };
    // Escaping the directory is 404.
    ليكن ر8: استجابة = اجلب(&الموجه, «/static/../x»);
    إذا (حالة_الرد(&ر8) != 404) { أرجع لم_يتحقق("حالة_الرد(&ر8) != 404"); };
    ليكن ر9: استجابة = اجلب(&الموجه, «/static/nope.txt»);
    إذا (حالة_الرد(&ر9) != 404) { أرجع لم_يتحقق("حالة_الرد(&ر9) != 404"); };

    // ETag and 304.
    ليكن وسم: نص = رأس(&ر5, «etag»);
    ليكن ر10: استجابة = جلب_مع(&الموجه, «/static/app.js», «if-none-match», استنسخ(&وسم));
    إذا (حالة_الرد(&ر10) != 304) { أرجع لم_يتحقق("حالة_الرد(&ر10) != 304"); };

    // The whole site at "/", precompressed, cached, with a single-page
    // fallback.
    ليكن الإعداد: متغير إعداد_ملفات = إعداد_ملفات_افتراضي();
    الإعداد.مضغوطة := صواب;
    الإعداد.التخزين := «public, max-age=31536000, immutable»;
    الإعداد.تخزين_الصفحات := «no-cache»;
    الإعداد.البديل := «index.html»;
    ليكن الموقع: متغير موجه<عدد> = أنشئ_موجها(0);
    ليكن الجذر: نص = «/»;
    طابق اربط_ملفات_بإعداد(&متغير الموقع, &الجذر, &الدليل, &الإعداد) مع
    | نتيجة.خطأ(_) -> { أرجع لم_يتحقق("طابق اربط_ملفات_بإعداد(&متغير الموقع, &الجذر, &الدليل, &الإعداد) مع"); } | نتيجة.نجح(_) -> { };

    ليكن ر11: استجابة = اجلب(&الموقع, «/»);
    ليكن ج11: نص = نص_الرد(&ر11);
    ليكن ت11: نص = رأس(&ر11, «cache-control»);
    إذا (!يساوي(&ج11, «<h1>مرحبا</h1>») || !يساوي(&ت11, «no-cache»)) { أرجع لم_يتحقق("!يساوي(&ج11, '<h1>مرحبا</h1>') || !يساوي(&ت11, 'no-cache')"); };
    ليكن ر12: استجابة = جلب_مع(&الموقع, «/app.js», «accept-encoding», «gzip, br»);
    ليكن ج12: نص = نص_الرد(&ر12);
    ليكن ت12: نص = رأس(&ر12, «content-encoding»);
    ليكن غ12: نص = رأس(&ر12, «vary»);
    ليكن خ12: نص = رأس(&ر12, «cache-control»);
    ليكن ن12: نص = رأس(&ر12, «content-type»);
    إذا (!يساوي(&ج12, «BR») || !يساوي(&ت12, «br») || !يساوي(&غ12, «accept-encoding»)) { أرجع لم_يتحقق("!يساوي(&ج12, 'BR') || !يساوي(&ت12, 'br') || !يساوي(&غ12, 'accept-encoding')"); };
    إذا (!يساوي(&خ12, «public, max-age=31536000, immutable») || !يساوي(&ن12, «text/javascript; charset=utf-8»)) { أرجع لم_يتحقق("!يساوي(&خ12, 'public, max-age=31536000, immutable') || !يساوي(&ن12, 'text/javascript; charset=utf-8')"); };
    // br refused with q=0; there is no .gz for app.js, so the plain file.
    ليكن ر13: استجابة = جلب_مع(&الموقع, «/app.js», «accept-encoding», «br;q=0, gzip»);
    ليكن ج13: نص = نص_الرد(&ر13);
    ليكن ت13: نص = رأس(&ر13, «content-encoding»);
    إذا (!يساوي(&ج13, «console.log(1)») || الطول(ت13) != 0) { أرجع لم_يتحقق("!يساوي(&ج13, 'console.log(1)') || الطول(ت13) != 0"); };
    ليكن ر14: استجابة = جلب_مع(&الموقع, «/style.css», «accept-encoding», «gzip»);
    ليكن ج14: نص = نص_الرد(&ر14);
    إذا (!يساوي(&ج14, «GZ»)) { أرجع لم_يتحقق("!يساوي(&ج14, 'GZ')"); };
    // A browser route with no file gets index.html.
    ليكن ر15: استجابة = اجلب(&الموقع, «/app/settings/profile»);
    ليكن ج15: نص = نص_الرد(&ر15);
    إذا (حالة_الرد(&ر15) != 200 || !يساوي(&ج15, «<h1>مرحبا</h1>»)) { أرجع لم_يتحقق("حالة_الرد(&ر15) != 200 || !يساوي(&ج15, '<h1>مرحبا</h1>')"); };
    // But escaping the directory is still 404.
    ليكن ر16: استجابة = اجلب(&الموقع, «/../etc/passwd»);
    إذا (حالة_الرد(&ر16) != 404) { أرجع لم_يتحقق("حالة_الرد(&ر16) != 404"); };
    أرجع نتيجة.نجح(0);
}
