// The same "/plain" answer as server.sn, served by std's event-driven HTTP
// server with no Nahr code at all: no router, middleware, logging or
// shutdown handling. bench/run.sh runs it as MODES=std, so a slowdown that
// also shows here comes from std (its sockets, poller and accept loop), not
// from Nahr.
//
//   NAHR_BENCH_PORT=8090  NAHR_BENCH_WORKERS=0 (0 = every core)
من std.http استورد
    إعداد_خادم_ويب,
    إعداد_خادم_ويب_افتراضي,
    شغل_خادم_ويب_بأحداث,
    طلب_ويب,
    استجابة_ويب,
    خدمة_ويب,
    استجابة_نص_ويب;
من std.sync استورد مشترك, أنشئ_مشترك;
من std.env استورد متغير_بيئة;
من std.text استورد صل_النصوص, حلل_طبيعي;

نوع حالة = { الاسم: نص };

عرف أجب(الحالة: &حالة, الطلب: &طلب_ويب<متجه ط8>): استجابة_ويب<متجه ط8> {
    ليكن النص: نص = «ok»;
    أرجع استجابة_نص_ويب(200, &النص);
}

عرف من_البيئة(الاسم: نص, البديل: نص): نص {
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { أرجع القيمة; }
    | _ -> { أرجع البديل; };
}

عرف الرئيسية(): عدد {
    ليكن المنفذ: نص = من_البيئة(«NAHR_BENCH_PORT», «8090»);
    ليكن الأجزاء: متجه نص = [«127.0.0.1:», المنفذ];
    ليكن لا_شيء: نص = «»;
    ليكن العنوان: نص = صل_النصوص(&الأجزاء, &لا_شيء);
    ليكن الخيوط_نص: نص = من_البيئة(«NAHR_BENCH_WORKERS», «0»);
    ليكن الخيوط: متغير طبيعي = 0;
    طابق حلل_طبيعي(&الخيوط_نص) مع
    | نتيجة.نجح(ع) -> { الخيوط := ع; }
    | نتيجة.خطأ(_) -> { };
    ليكن الإعداد: إعداد_خادم_ويب = إعداد_خادم_ويب_افتراضي(&العنوان);
    ليكن البداية: حالة = { الاسم: «std» };
    ليكن المشترك: مشترك<حالة> = أنشئ_مشترك(البداية);
    ليكن الخدمة: خدمة_ويب<حالة, متجه ط8, متجه ط8> = أجب;
    طابق شغل_خادم_ويب_بأحداث(&الإعداد, المشترك, الخدمة, الخيوط) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> { أرجع 0; };
}
