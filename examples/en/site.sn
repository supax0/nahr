            field("title", text_value("A web framework for SultanC")),
            field("tagline", text_value("This page is a template rendered by Nahr; the styles and script are static files it serves.")),
            field("features_title", text_value("What this page uses")),
            field("live_title", text_value("Live from the server")),
            field("visits", text_value("Page views")),
            field("uptime", text_value("Uptime")),
            field("likes", text_value("Likes")),
            field("like", text_value("Like")),
            field("notes_title", text_value("Notes")),
            field("placeholder", text_value("Write a note")),
            field("add", text_value("Add")),
            field("empty", text_value("No notes yet.")),
