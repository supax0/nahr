// A full site served by Nahr: HTML templates, static CSS and JavaScript, and
// a JSON API.
//
//   /            the page in Arabic     /en          in English
//   POST /notes  a form that adds a note, then redirects (Post/Redirect/Get)
//   GET  /api/status   POST /api/like   called by app.js
//   /static/*    style.css, app.js, favicon.svg
//   anything else  a 404 page from the 404.html template
//
// The templates and files are in nahr/examples/site, shared with the Arabic
// example. From the folder that holds nahr and sultanc:
//
//     (cd sultanc && ./build/sultanc "$OLDPWD/nahr/examples/en/site.sn" --package-graph "$OLDPWD/nahr/examples/package-graph.toml" -o "$OLDPWD/site_en")
//     ./site_en                      # http://127.0.0.1:8000
//
// Environment: NAHR_SITE (the site folder), NAHR_PORT, NAHR_RELOAD=1 to read
// the templates again on every request while developing, NAHR_SERIAL=1 for
// one thread (the interpreter).
from std.text import texts_equal, join, trim, strip_prefix;
from std.env import get_environment_variable;
from std.io import println;
from std.sync import
    atomic_u64, atomic_u64_new, atomic_u64_load, atomic_u64_fetch_add, memory_ordering,
    mutex, mutex_new, with_lock;
from std.time import monotonic_time_ns;
from std.http import http_request, http_response;
from nahr.routing import
    router, new_router, get, post, layer, middleware,
    serve_dir_with, static_config, default_static_config, routing_error;
from nahr.handler import request, from_fn;
from nahr.extract import path_params;
from nahr.response import response;
from nahr.body import text_response, redirect;
from nahr.form import form, form_field;
from nahr.json import
    json_writer, new_json_writer, json_begin_object, json_end_object, json_key, json_uint,
    json_writer_response;
from nahr.middleware import map_errors, error_response_mapper, compression;
from nahr.template import
    templates, load_templates, template_response, template_response_with_status, template_error_text,
    template_context, template_value, template_field, set_value, field,
    text_value, int_value, list_value, object_value;
from nahr.serve import serve_on, serve_on_parallel;

type note = { id: uint, text: string };

// Every server thread shares this: the counters are atomic, the notes are
// behind a mutex.
type site_state = {
    templates: templates,
    started: int,
    visits: atomic_u64,
    likes: atomic_u64,
    notes: mutex<vector note>
};

def now(): int {
    match monotonic_time_ns() with
    | result.ok(value) -> { return value; }
    | result.err(_) -> { return 0; };
}

def env_or(name: string, fallback: string): string {
    match get_environment_variable(&name) with
    | result.ok(option.some(value)) -> { return value; }
    | _ -> { return fallback; };
}

def concat(a: string, b: string): string {
    let parts: vector string = [a, b];
    let none: string = "";
    return join(&parts, &none);
}

def equals(text: &string, other: string): bool { return texts_equal(text, &other); }

def starts(text: &string, prefix: string): bool {
    match strip_prefix(text, &prefix) with
    | option.some(_) -> { return true; }
    | option.none -> { return false; };
}

// ---- translation: the same templates for both languages, texts from here ----

