def feature(title: string, text: string): template_value {
    let fields: vector template_field = [field("title", text_value(title)), field("text", text_value(text))];
    return object_value(fields);
}

def features(english: bool): template_value {
    if (english) {
        let items: vector template_value = [
            feature("Templates", "Jinja syntax: extends, blocks, include, for and if, with HTML escaping"),
            feature("Static files", "ETag and 304, charset, Cache-Control, precompressed .br/.gz"),
            feature("Forms", "the notes form posts, then redirects (Post/Redirect/Get)"),
            feature("JSON API", "app.js calls /api/status and /api/like"),
            feature("Middleware", "gzip compression and a template 404 page")
        ];
        return list_value(items);
    };
    let items: vector template_value = [
        feature("القوالب", "صياغة Jinja: الوراثة والكتل والتضمين والحلقات والشروط مع هروب HTML"),
        feature("الملفات الثابتة", "ETag و 304 وترميز المحارف و Cache-Control وملفات br و gz المضغوطة مسبقا"),
        feature("النماذج", "نموذج الملاحظات يرسل ثم يعيد التوجيه (Post/Redirect/Get)"),
        feature("واجهة JSON", "يستدعي app.js المسارين api/status و api/like"),
        feature("الوسطاء", "ضغط gzip وصفحة 404 من قالب")
    ];
    return list_value(items);
}

// The language, its direction, the link to the other language, and the texts.
def language_context(english: bool): template_context {
    let context: mutable template_context = [];
    if (english) {
        set_value(&mutable context, "lang", text_value("en"));
        set_value(&mutable context, "dir", text_value("ltr"));
        set_value(&mutable context, "home", text_value("/en"));
        set_value(&mutable context, "other_url", text_value("/"));
        set_value(&mutable context, "other_lang", text_value("ar"));
    } else {
        set_value(&mutable context, "lang", text_value("ar"));
        set_value(&mutable context, "dir", text_value("rtl"));
        set_value(&mutable context, "home", text_value("/"));
        set_value(&mutable context, "other_url", text_value("/en"));
        set_value(&mutable context, "other_lang", text_value("en"));
    };
    set_value(&mutable context, "t", page_texts(english));
    return context;
}

// ---- pages ----

def note_value(item: &note): template_value {
    let fields: vector template_field = [
        field("id", int_value((*item).id as int)),
        field("text", text_value(clone(&(*item).text)))
    ];
    return object_value(fields);
}

// Newest first.
def notes_value(state: &site_state): template_value {
    let copy: vector note = with_lock(
        &(*state).notes,
        fn(items: &mutable vector note): vector note -> clone(items)
    );
    let values: mutable vector template_value = [];
    let i: mutable uint = length(copy) as uint;
    while (i > 0) {
        i := i - 1;
        append(values, note_value(&copy[i]));
    }
    return list_value(values);
}

def page(state: &site_state, english: bool): response {
    let visits: u64 = atomic_u64_fetch_add(&(*state).visits, 1 as u64, memory_ordering.relaxed()) + 1;
    let likes: u64 = atomic_u64_load(&(*state).likes, memory_ordering.relaxed());
    let context: mutable template_context = language_context(english);
    set_value(&mutable context, "features", features(english));
    set_value(&mutable context, "visits", int_value(visits as int));
    set_value(&mutable context, "likes", int_value(likes as int));
    set_value(&mutable context, "notes", notes_value(state));
    return template_response(&(*state).templates, "index.html", &context);
}

def arabic(state: &site_state, req: &request, params: &path_params): response {
    return page(state, false);
}

def english(state: &site_state, req: &request, params: &path_params): response {
    return page(state, true);
}

def form_value(fields: &vector form_field, name: string): string {
    let i: mutable uint = 0;
    while (i < (length(*fields) as uint)) {
        if (texts_equal(&(*fields)[i].الاسم, &name)) { return clone(&(*fields)[i].القيمة); };
        i := i + 1;
    }
    return "";
}

// Keeps the newest 50 notes.
def add_note(items: &mutable vector note, text: string): uint {
    let id: mutable uint = 1;
    let count: uint = length(*items) as uint;
    if (count > 0) { id := (*items)[count - 1].id + 1; };
    let item: note = { id: id, text: text };
    append(*items, item);
    if (length(*items) > 50) {
        let kept: mutable vector note = [];
        let i: mutable uint = (length(*items) as uint) - 50;
        while (i < (length(*items) as uint)) { append(kept, clone(&(*items)[i])); i := i + 1; }
        *items := kept;
    };
    return id;
}

// POST /notes, then 303 back to the page in the same language.
def add_from_form(state: &site_state, req: &request, params: &path_params): response {
    let target: mutable string = "/";
    match form(req) with
    | result.err(_) -> { let body: string = "Bad Request"; return text_response(400, &body); }
    | result.ok(fields) -> {
        let lang: string = form_value(&fields, "lang");
        if (equals(&lang, "en")) { target := "/en"; };
        let raw: string = form_value(&fields, "text");
        let text: string = trim(&raw);
        if (length(text) > 0 && length(text) <= 1200) {
            let ignored: uint = with_lock(
                &(*state).notes,
                fn(items: &mutable vector note): uint -> add_note(items, clone(&text))
            );
        };
    };
    match redirect(303, &target) with
    | option.some(reply) -> { return reply; }
    | option.none -> { let body: string = ""; return text_response(500, &body); };
}

// ---- JSON API ----

// GET /api/status
def status(state: &site_state, req: &request, params: &path_params): response {
    let count: uint = with_lock(
        &(*state).notes,
        fn(items: &mutable vector note): uint -> length(*items) as uint
    );
    let writer: mutable json_writer = new_json_writer();
    json_begin_object(&mutable writer);
    let k1: string = "uptime_seconds";
    json_key(&mutable writer, &k1);
    json_uint(&mutable writer, ((now() - (*state).started) / 1000000000) as uint);
    let k2: string = "visits";
    json_key(&mutable writer, &k2);
    json_uint(&mutable writer, atomic_u64_load(&(*state).visits, memory_ordering.relaxed()) as uint);
    let k3: string = "likes";
    json_key(&mutable writer, &k3);
    json_uint(&mutable writer, atomic_u64_load(&(*state).likes, memory_ordering.relaxed()) as uint);
    let k4: string = "notes";
    json_key(&mutable writer, &k4);
    json_uint(&mutable writer, count);
    json_end_object(&mutable writer);
    return json_writer_response(200, &writer);
}

// POST /api/like
def like(state: &site_state, req: &request, params: &path_params): response {
    let likes: u64 = atomic_u64_fetch_add(&(*state).likes, 1 as u64, memory_ordering.relaxed()) + 1;
    let writer: mutable json_writer = new_json_writer();
    json_begin_object(&mutable writer);
    let key: string = "likes";
    json_key(&mutable writer, &key);
    json_uint(&mutable writer, likes as uint);
    json_end_object(&mutable writer);
    return json_writer_response(200, &writer);
}

// A 404 page from the template for site pages; /api errors and every other
// response pass unchanged.
def error_page(
    state: &site_state,
    req: &http_request<vector u8>,
    reply: http_response<vector u8>
): http_response<vector u8> {
    if (reply.الحالة != 404 || starts(&(*req).الهدف, "/api/")) { return reply; };
    let english: bool = starts(&(*req).الهدف, "/en");
    let context: template_context = language_context(english);
    return template_response_with_status(404, &(*state).templates, "404.html", &context);
}

def registered(outcome: result uint, routing_error): bool {
    match outcome with
    | result.ok(_) -> { return true; }
    | result.err(_) -> { return false; };
}

def main(): int {
    let site: string = env_or("NAHR_SITE", "nahr/examples/site");
    let port: string = env_or("NAHR_PORT", "8000");
    let template_dir: string = concat(clone(&site), "/templates");
    let public_dir: string = concat(clone(&site), "/public");

    let loaded: mutable templates;
    match load_templates(template_dir) with
    | result.ok(value) -> { loaded := value; }
    | result.err(error) -> {
        let ignored: result int, int = println(template_error_text(&error));
        return 1;
    };
    let reload: string = env_or("NAHR_RELOAD", "");
    loaded.إعادة_التحميل := equals(&reload, "1");

    let notes: vector note = [];
    let state: site_state = {
        templates: loaded,
        started: now(),
        visits: atomic_u64_new(0 as u64),
        likes: atomic_u64_new(0 as u64),
        notes: mutex_new(notes)
    };
    let app: mutable router<site_state> = new_router(state);

    let root: string = "/";
    let en: string = "/en";
    let notes_path: string = "/notes";
    let status_path: string = "/api/status";
    let like_path: string = "/api/like";
    let static_path: string = "/static";
    if (!registered(get(&mutable app, &root, from_fn(arabic)))) { return 2; };
    if (!registered(get(&mutable app, &en, from_fn(english)))) { return 3; };
    if (!registered(post(&mutable app, &notes_path, from_fn(add_from_form)))) { return 4; };
    if (!registered(get(&mutable app, &status_path, from_fn(status)))) { return 5; };
    if (!registered(post(&mutable app, &like_path, from_fn(like)))) { return 6; };

    // Static files stay in the browser cache for an hour.
    let config: mutable static_config = default_static_config();
    config.التخزين := "public, max-age=3600";
    config.مضغوطة := true;
    if (!registered(serve_dir_with(&mutable app, &static_path, &public_dir, &config))) { return 7; };

    let mapper: error_response_mapper<site_state> = error_page;
    let errors: middleware<site_state> = map_errors(mapper);
    let gzip: middleware<site_state> = compression(1024);
    layer(&mutable app, errors);
    layer(&mutable app, gzip);

    let address: string = concat("127.0.0.1:", port);
    let serial: string = env_or("NAHR_SERIAL", "");
    if (equals(&serial, "1")) {
        match serve_on(&address, &app) with
        | result.err(_) -> { return 8; }
        | result.ok(code) -> { return code; };
    };
    let ready: router<site_state> = app;
    match serve_on_parallel(&address, ready, 0) with
    | result.err(_) -> { return 9; }
    | result.ok(code) -> { return code; };
}
