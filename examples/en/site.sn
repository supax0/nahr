            field("not_found", text_value("This page does not exist.")),
            field("back", text_value("Back to the home page")),
            field("footer", text_value("Served by Nahr, written in SultanC."))
        ];
        return object_value(fields);
    };
    let fields: vector template_field = [
        field("site", text_value("نهر")),
        field("switch", text_value("English")),
        field("title", text_value("إطار ويب للغة سلطان سي")),
        field("tagline", text_value("هذه الصفحة قالب يعرضه نهر، والتنسيق والسكربت ملفات ثابتة يخدمها هو أيضا.")),
        field("features_title", text_value("ما تستخدمه هذه الصفحة")),
        field("live_title", text_value("مباشرة من الخادم")),
        field("visits", text_value("المشاهدات")),
        field("uptime", text_value("مدة التشغيل")),
        field("likes", text_value("الإعجابات")),
        field("like", text_value("أعجبني")),
        field("notes_title", text_value("الملاحظات")),
        field("placeholder", text_value("اكتب ملاحظة")),
        field("add", text_value("أضف")),
        field("empty", text_value("لا ملاحظات بعد.")),
        field("escape_hint", text_value("جرّب ملاحظة فيها <b>HTML</b>: القوالب تهرّبها.")),
