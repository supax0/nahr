// عرض نهر: غرفة دردشة حية ولوحة خادم، في ملف تنفيذي واحد.
//
//   GET  /                صفحة العرض (مضمنة في الملف التنفيذي)
//   GET  /api/messages    الرسائل كلها، جسون
//   POST /api/messages    رسالة جديدة {"الاسم": …, "النص": …}، جسون → 201
//   GET  /api/stats       إحصاءات الخادم، جسون
//   GET  /events          أحداث الخادم (SSE): الرسائل الجديدة والإحصاءات كل ثانية
//   GET  /ws              مقبس ويب: يعيد كل رسالة كما هي (لقياس زمن الذهاب والعودة)
//   GET  /source          شفرة هذا الملف، لتعرضها الصفحة
//
// افتح الصفحة في نافذتين: ما يكتب في واحدة يظهر في الأخرى فورا.
// وCtrl+C يوقف الخادم بأمان: ينهي الطلبات الجارية ويغلق البث.
//
//     (cd sultanc && ./build/sultanc "$OLDPWD/nahr/examples/ar/demo.sn" --package-graph "$OLDPWD/nahr/examples/package-graph.toml" -b llvm -O2 -o "$OLDPWD/demo")
//     ./demo      # http://127.0.0.1:8000
من std.text استورد قص_النص;
من std.time استورد وقت_رتيب_نانو, وقت_نظام_نانو, نم_نانو;
من std.sync استورد
    ذرة_ط64, أنشئ_ذرة_ط64, احمل_ط64, اجمع_واجلب_ط64, قارن_وبدّل_ط64, ترتيب_ذاكرة,
    قفل, أنشئ_قفل, نفذ_مع_القفل;
من std.http استورد هل_طلب_إيقاف_الويب;
من نهر.توجيه استورد
    موجه, أنشئ_موجها, جلب, أرسل, استخدم_وسيطا, وسيط, وسيط_من_دالة, تابع, التالي,
    اربط_مقبس_ويب, اربط_أحداث;
من نهر.معالجة استورد طلب, من_دالة;
من نهر.استخراج استورد معاملات_مسار;
من نهر.ردود استورد استجابة;
من نهر.جسم استورد رد_صفحة, رد_نصي;
من نهر.جسون استورد اقرأ_جسون_بـ, رد_جسون_من;
من نهر.مباشر استورد
    اتصال_مقبس_ويب, استقبل_رسالة_مقبس, أرسل_نصا_مقبس, نص_رسالة, رسالة_نصية,
    تدفق_ويب, أرسل_حدثا;
من نهر.أحداث استورد حدث, أنشئ_حدثا, عين_نوع_حدث, عين_معرف_حدث;
من نهر.وسطاء استورد أخطاء_جسون, معرف_الطلب;
من نهر.تشغيل استورد شغل_على_بأحداث;

// الأنواع التي تعبر الشبكة: @@جسون يولد مرمزها ومفككها وقت الترجمة.
@@جسون
نوع رسالة = { الرقم: عدد, الاسم: نص, النص: نص, الوقت: عدد };

@@جسون
نوع رسالة_جديدة = { الاسم: اختياري نص, النص: نص };

@@جسون
نوع قائمة_الرسائل = { الرسائل: متجه رسالة };

@@جسون
نوع إحصاءات = { الطلبات: عدد, الرسائل: عدد, المتصلون: عدد, الثواني: عدد };

@@جسون
نوع خطأ_تحقق = { detail: نص };

// حالة التطبيق: يشاركها كل طلب وكل خيط.
نوع تطبيق = {
    الرسائل: قفل<متجه رسالة>,
    الطلبات: ذرة_ط64,
    المتصلون: ذرة_ط64,
    البداية: عدد
};

عرف الآن_بالنانو(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(ن) -> { أرجع ن; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عرف ثواني_يونكس(): عدد {
    طابق وقت_نظام_نانو() مع
    | نتيجة.نجح(ن) -> { أرجع ن / 1000000000; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عرف انقص_ذرة(الذرة: &ذرة_ط64): فراغ {
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        ليكن الحالي: ط64 = احمل_ط64(الذرة, ترتيب_ذاكرة.مسترخ());
        إذا (الحالي == (0 مثل ط64)) { أرجع; };
        إذا (قارن_وبدّل_ط64(الذرة, الحالي, الحالي - 1, ترتيب_ذاكرة.تسلسلي()) == الحالي) { مستمر := خطأ; };
    }
}

// وسيط: يعد كل طلب يمر بالخادم.
عرف عداد_الطلبات(الحالة: &تطبيق, الطلب: &طلب, التالي: &التالي<تطبيق>): استجابة {
    ليكن تجاهل: ط64 = اجمع_واجلب_ط64(&(*الحالة).الطلبات, 1 مثل ط64, ترتيب_ذاكرة.مسترخ());
    أرجع تابع(التالي, الطلب);
}

عرف الصفحة(الحالة: &تطبيق, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن الجسم: نص = ضمن_ملف(«demo.html»);
    أرجع رد_صفحة(200, &الجسم);
}

// GET /source: هذا الملف نفسه، مضمنا وقت البناء.
عرف الشفرة(الحالة: &تطبيق, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن الجسم: نص = ضمن_ملف(«demo.sn»);
    أرجع رد_نصي(200, &الجسم);
}

عرف عدد_الرسائل(الحالة: &تطبيق): عدد {
    أرجع نفذ_مع_القفل(&(*الحالة).الرسائل, دالة(القائمة: &متغير متجه رسالة): عدد -> الطول(*القائمة) مثل عدد);
}

عرف انسخ_من(القائمة: &متغير متجه رسالة, البداية: طبيعي): متجه رسالة {
    ليكن الناتج: متغير متجه رسالة = [];
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < (الطول(*القائمة) مثل طبيعي)) {
        ألحق(الناتج, استنسخ(&(*القائمة)[ف]));
        ف := ف + 1;
    }
    أرجع الناتج;
}

// الرسائل من الموضع البداية فما بعده.
عرف الرسائل_من(الحالة: &تطبيق, البداية: طبيعي): متجه رسالة {
    أرجع نفذ_مع_القفل(
        &(*الحالة).الرسائل,
        دالة(القائمة: &متغير متجه رسالة): متجه رسالة -> انسخ_من(القائمة, البداية)
    );
}

عرف أضف_رسالة(القائمة: &متغير متجه رسالة, الاسم: &نص, النص: &نص): رسالة {
    ليكن الجديدة: رسالة = {
        الرقم: (الطول(*القائمة) مثل عدد) + 1,
        الاسم: استنسخ(الاسم),
        النص: استنسخ(النص),
        الوقت: ثواني_يونكس()
    };
    ألحق(*القائمة, استنسخ(&الجديدة));
    أرجع الجديدة;
}

عرف الإحصاءات_الآن(الحالة: &تطبيق): إحصاءات {
    ليكن الناتج: إحصاءات = {
        الطلبات: احمل_ط64(&(*الحالة).الطلبات, ترتيب_ذاكرة.مسترخ()) مثل عدد,
        الرسائل: عدد_الرسائل(الحالة),
        المتصلون: احمل_ط64(&(*الحالة).المتصلون, ترتيب_ذاكرة.مسترخ()) مثل عدد,
        الثواني: (الآن_بالنانو() - (*الحالة).البداية) / 1000000000
    };
    أرجع الناتج;
}

عرف رفض(الرسالة: نص): استجابة {
    ليكن الخطأ: خطأ_تحقق = { detail: الرسالة };
    أرجع رد_جسون_من(422, &الخطأ, جسون__خطأ_تحقق);
}

// GET /api/messages
عرف كل_الرسائل(الحالة: &تطبيق, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن القائمة: قائمة_الرسائل = { الرسائل: الرسائل_من(الحالة, 0) };
    أرجع رد_جسون_من(200, &القائمة, جسون__قائمة_الرسائل);
}

// POST /api/messages: يتحقق من الجسم كما يفعل FastAPI (415، 422).
عرف رسالة_جديدة_من_طلب(الحالة: &تطبيق, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    طابق اقرأ_جسون_بـ(الطلب, من_جسون__رسالة_جديدة) مع
    | نتيجة.خطأ(الرفض) -> { أرجع الرفض; }
    | نتيجة.نجح(المدخل) -> {
        ليكن النص: نص = قص_النص(&المدخل.النص);
        إذا ((الطول(النص) مثل طبيعي) == 0) { أرجع رفض(«النص فارغ»); };
        إذا ((الطول(النص) مثل طبيعي) > 2000) { أرجع رفض(«النص أطول من اللازم»); };
        ليكن الاسم: متغير نص = «ضيف»;
        طابق المدخل.الاسم مع
        | اختياري.موجود(القيمة) -> {
            ليكن المقصوص: نص = قص_النص(&القيمة);
            إذا ((الطول(المقصوص) مثل طبيعي) > 0 && (الطول(المقصوص) مثل طبيعي) <= 64) { الاسم := المقصوص; };
        }
        | اختياري.لا_شيء -> { };
        ليكن الجديدة: رسالة = نفذ_مع_القفل(
            &(*الحالة).الرسائل,
            دالة(القائمة: &متغير متجه رسالة): رسالة -> أضف_رسالة(القائمة, &الاسم, &النص)
        );
        أرجع رد_جسون_من(201, &الجديدة, جسون__رسالة);
    };
}

// GET /api/stats
عرف الإحصاءات(الحالة: &تطبيق, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن القيم: إحصاءات = الإحصاءات_الآن(الحالة);
    أرجع رد_جسون_من(200, &القيم, جسون__إحصاءات);
}

عرف أرسل_حدث_بنوع(التدفق: &متغير تدفق_ويب, النوع: نص, البيانات: &نص): منطقي {
    ليكن الحدث: متغير حدث = أنشئ_حدثا(البيانات);
    عين_نوع_حدث(&متغير الحدث, &النوع);
    أرجع أرسل_حدثا(التدفق, &الحدث);
}

// جولة واحدة من البث: الرسائل الجديدة، والإحصاءات كل أربع جولات.
// تجيب خطأ حين يغادر العميل.
عرف جولة_بث(
    الحالة: &تطبيق,
    التدفق: &متغير تدفق_ويب,
    التالي_منها: &متغير طبيعي,
    الجولة: طبيعي
): منطقي {
    ليكن الجديدة: متجه رسالة = الرسائل_من(الحالة, *التالي_منها);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الجديدة) مثل طبيعي)) {
        ليكن البيانات: نص = جسون__رسالة(&الجديدة[ف]);
        إذا (!أرسل_حدث_بنوع(التدفق, «message», &البيانات)) { أرجع خطأ; };
        ف := ف + 1;
    }
    *التالي_منها := *التالي_منها + (الطول(الجديدة) مثل طبيعي);
    إذا (الجولة % 4 == 0) {
        ليكن القيم: إحصاءات = الإحصاءات_الآن(الحالة);
        ليكن البيانات: نص = جسون__إحصاءات(&القيم);
        إذا (!أرسل_حدث_بنوع(التدفق, «stats», &البيانات)) { أرجع خطأ; };
    };
    أرجع صواب;
}

// GET /events: يبقى مع العميل حتى يغادر أو يطلب إيقاف الخادم.
عرف البث(الحالة: &تطبيق, الطلب: &طلب, المعاملات: &معاملات_مسار, التدفق: &متغير تدفق_ويب): فراغ {
    ليكن تجاهل: ط64 = اجمع_واجلب_ط64(&(*الحالة).المتصلون, 1 مثل ط64, ترتيب_ذاكرة.مسترخ());
    ليكن التالي_منها: متغير طبيعي = 0;
    ليكن الجولة: متغير طبيعي = 0;
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر && !هل_طلب_إيقاف_الويب()) {
        مستمر := جولة_بث(الحالة, التدفق, &متغير التالي_منها, الجولة);
        الجولة := الجولة + 1;
        إذا (مستمر) { ليكن انتظر: نتيجة عدد, عدد = نم_نانو(250000000); };
    }
    انقص_ذرة(&(*الحالة).المتصلون);
}

// GET /ws: يعيد كل رسالة نصية كما هي؛ الصفحة تقيس زمن الذهاب والعودة.
عرف المرآة(الحالة: &تطبيق, الطلب: &طلب, المعاملات: &معاملات_مسار, الاتصال: &متغير اتصال_مقبس_ويب): فراغ {
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر && !هل_طلب_إيقاف_الويب()) {
        طابق استقبل_رسالة_مقبس(الاتصال) مع
        | نتيجة.خطأ(_) -> { مستمر := خطأ; }
        | نتيجة.نجح(الرسالة) -> {
            إذا (رسالة_نصية(&الرسالة)) {
                ليكن النص: نص = نص_رسالة(&الرسالة);
                إذا (!أرسل_نصا_مقبس(الاتصال, &النص)) { مستمر := خطأ; };
            };
        };
    }
}

عرف الرئيسية(): عدد {
    ليكن الترحيب: متجه رسالة = [];
    ليكن البداية: تطبيق = {
        الرسائل: أنشئ_قفل(الترحيب),
        الطلبات: أنشئ_ذرة_ط64(0 مثل ط64),
        المتصلون: أنشئ_ذرة_ط64(0 مثل ط64),
        البداية: الآن_بالنانو()
    };
    ليكن الموجه: متغير موجه<تطبيق> = أنشئ_موجها(البداية);
    ليكن الجذر: نص = «/»;
    ليكن الرسائل: نص = «/api/messages»;
    ليكن الإحصاءات_مسار: نص = «/api/stats»;
    ليكن الأحداث: نص = «/events»;
    ليكن المقبس: نص = «/ws»;
    ليكن الشفرة_مسار: نص = «/source»;
    طابق جلب(&متغير الموجه, &الجذر, من_دالة(الصفحة)) مع | نتيجة.خطأ(_) -> { أرجع 1; } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &الرسائل, من_دالة(كل_الرسائل)) مع | نتيجة.خطأ(_) -> { أرجع 2; } | نتيجة.نجح(_) -> { };
    طابق أرسل(&متغير الموجه, &الرسائل, من_دالة(رسالة_جديدة_من_طلب)) مع | نتيجة.خطأ(_) -> { أرجع 3; } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &الإحصاءات_مسار, من_دالة(الإحصاءات)) مع | نتيجة.خطأ(_) -> { أرجع 4; } | نتيجة.نجح(_) -> { };
    طابق اربط_أحداث(&متغير الموجه, &الأحداث, البث) مع | نتيجة.خطأ(_) -> { أرجع 5; } | نتيجة.نجح(_) -> { };
    طابق اربط_مقبس_ويب(&متغير الموجه, &المقبس, المرآة) مع | نتيجة.خطأ(_) -> { أرجع 6; } | نتيجة.نجح(_) -> { };
    طابق جلب(&متغير الموجه, &الشفرة_مسار, من_دالة(الشفرة)) مع | نتيجة.خطأ(_) -> { أرجع 8; } | نتيجة.نجح(_) -> { };
    // الوسطاء: عد الطلبات، ومعرف لكل طلب، والأخطاء جسون.
    ليكن العداد: وسيط<تطبيق> = وسيط_من_دالة(عداد_الطلبات);
    استخدم_وسيطا(&متغير الموجه, العداد);
    ليكن المعرف: وسيط<تطبيق> = معرف_الطلب();
    استخدم_وسيطا(&متغير الموجه, المعرف);
    ليكن الأخطاء: وسيط<تطبيق> = أخطاء_جسون();
    استخدم_وسيطا(&متغير الموجه, الأخطاء);
    ليكن العنوان: نص = «127.0.0.1:8000»;
    ليكن الجاهز: موجه<تطبيق> = الموجه;
    طابق شغل_على_بأحداث(&العنوان, الجاهز, 0) مع
    | نتيجة.خطأ(_) -> { أرجع 7; }
    | نتيجة.نجح(_) -> { أرجع 0; };
}
