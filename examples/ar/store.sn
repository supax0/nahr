// متجر نهر: تطبيق كامل فوق مئة ألف منتج، مع اختبار حمل حي.
//
// الملفات:
//   store.sn            هذا الملف: يبني الكتالوج، ويسجل المسارات، ويشغل الخادم
//   store/catalog.sn    المنتجات في الذاكرة، والفهرس المقلوب، والبحث
//   store/api.sn        معالجات HTTP: البحث، والمنتج، والفئات، واختبار الحمل
//   store/loadtest.sn   مولد الحمل: اتصالات كثيرة، ومدرج تكراري للأزمنة
//   store/page.html     الصفحة: المتجر ولوحة اختبار الحمل
//
// البناء والتشغيل (الأفضل بخلفية LLVM):
//     (cd sultanc && ./build/sultanc "$OLDPWD/nahr/examples/ar/store.sn" --package-graph "$OLDPWD/nahr/examples/package-graph.toml" -b llvm -O2 -o "$OLDPWD/store")
//     ./store      # http://127.0.0.1:8000
//
// يقرأ NAHR_PORT للمنفذ (8000)، وNAHR_WORKERS لعدد عمال حلقة الأحداث (0،
// أي عامل لكل نواة)، وNAHR_PRODUCTS لعدد المنتجات (100000). مع المفسر
// (sultanc run) استعمل عددا صغيرا، مثل NAHR_PRODUCTS=500: المفسر أبطأ
// من الترجمة بآلاف المرات.
استورد "store/catalog.sn";
استورد "store/loadtest.sn";
استورد "store/api.sn";
من std.text استورد صل_النصوص, طبيعي_إلى_نص, عدد_إلى_نص, حلل_طبيعي;
من std.time استورد وقت_رتيب_نانو;
من std.env استورد متغير_بيئة;
من std.sync استورد أنشئ_مشترك;
من نهر.توجيه استورد موجه, أنشئ_موجها, جلب, أرسل, استخدم_وسيطا, وسيط, اربط_أحداث, خطأ_توجيه;
من نهر.معالجة استورد من_دالة;
من نهر.وسطاء استورد أخطاء_جسون, معرف_الطلب;
من نهر.سجلات استورد سجل_معلومة, سجل_عطل;
من نهر.تشغيل استورد شغل_على_بأحداث;

عرف الآن_بالمللي(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(ن) -> { أرجع ن / 1000000; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عرف من_البيئة(الاسم: نص, البديل: نص): نص {
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { أرجع القيمة; }
    | _ -> { أرجع البديل; };
}

عرف طبيعي_من_البيئة(الاسم: نص, البديل: طبيعي): طبيعي {
    ليكن النص: نص = من_البيئة(الاسم, «»);
    طابق حلل_طبيعي(&النص) مع
    | نتيجة.نجح(العدد) -> { أرجع العدد; }
    | نتيجة.خطأ(_) -> { أرجع البديل; };
}

عرف سجل(الأجزاء: متجه نص): فراغ {
    ليكن لا_شيء: نص = «»;
    سجل_معلومة(صل_النصوص(&الأجزاء, &لا_شيء));
}

// يسجل كل مسارات المتجر على الموجه.
عرف سجل_المسارات(الموجه: &متغير موجه<متجر>): نتيجة طبيعي, خطأ_توجيه {
    ليكن الجذر: نص = «/»;
    ليكن المنتجات_مسار: نص = «/api/products»;
    ليكن المنتج_مسار: نص = «/api/products/{id}»;
    ليكن الفئات_مسار: نص = «/api/categories»;
    ليكن الحمل_مسار: نص = «/api/load-test»;
    ليكن البث_مسار: نص = «/api/load-test/events»;
    طابق جلب(الموجه, &الجذر, من_دالة(الصفحة)) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { };
    طابق جلب(الموجه, &المنتجات_مسار, من_دالة(المنتجات)) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { };
    طابق جلب(الموجه, &المنتج_مسار, من_دالة(منتج_واحد)) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { };
    طابق جلب(الموجه, &الفئات_مسار, من_دالة(الفئات)) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { };
    طابق أرسل(الموجه, &الحمل_مسار, من_دالة(ابدأ_اختبار_الحمل)) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { };
    طابق جلب(الموجه, &الحمل_مسار, من_دالة(تقرير_الحمل)) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { };
    طابق اربط_أحداث(الموجه, &البث_مسار, بث_الحمل) مع | نتيجة.خطأ(خ) -> { أرجع نتيجة.خطأ(خ); } | نتيجة.نجح(_) -> { };
    أرجع نتيجة.نجح(7);
}

عرف الرئيسية(): عدد {
    // ١. البيانات
    ليكن المطلوب: طبيعي = طبيعي_من_البيئة(«NAHR_PRODUCTS», 100000);
    إذا (المطلوب < 4242) { سجل([«NAHR_PRODUCTS is below 4242: the product load test scenario needs product 4242»]); };
    سجل([«Building the catalog: », طبيعي_إلى_نص(المطلوب), « products...»]);
    ليكن البداية: عدد = الآن_بالمللي();
    ليكن الكتالوج: كتالوج = ابن_كتالوجا(المطلوب);
    سجل([
        «Catalog: », طبيعي_إلى_نص(عدد_المنتجات(&الكتالوج)), « products, »,
        طبيعي_إلى_نص(الطول(الكتالوج.المفردات) مثل طبيعي), « indexed words, built in »,
        عدد_إلى_نص(الآن_بالمللي() - البداية), « ms»
    ]);

    // ٢. الحالة
    ليكن المنفذ_نص: نص = من_البيئة(«NAHR_PORT», «8000»);
    ليكن أجزاء_العنوان: متجه نص = [«127.0.0.1:», المنفذ_نص];
    ليكن لا_شيء: نص = «»;
    ليكن العنوان: نص = صل_النصوص(&أجزاء_العنوان, &لا_شيء);
    ليكن الحالة: متجر = {
        الكتالوج: الكتالوج,
        المختبر: أنشئ_مشترك(مختبر_جديد()),
        العنوان: استنسخ(&العنوان)
    };

    // ٣. المسارات والوسطاء
    ليكن الموجه: متغير موجه<متجر> = أنشئ_موجها(الحالة);
    طابق سجل_المسارات(&متغير الموجه) مع
    | نتيجة.خطأ(_) -> { سجل_عطل(«could not register the routes»); أرجع 1; }
    | نتيجة.نجح(_) -> { };
    ليكن المعرف: وسيط<متجر> = معرف_الطلب();
    استخدم_وسيطا(&متغير الموجه, المعرف);
    ليكن الأخطاء: وسيط<متجر> = أخطاء_جسون();
    استخدم_وسيطا(&متغير الموجه, الأخطاء);

    // ٤. التشغيل: حلقة أحداث بعامل لكل نواة
    ليكن الجاهز: موجه<متجر> = الموجه;
    طابق شغل_على_بأحداث(&العنوان, الجاهز, طبيعي_من_البيئة(«NAHR_WORKERS», 0)) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(_) -> { أرجع 0; };
}
