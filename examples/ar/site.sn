// موقع كامل يخدمه نهر: قوالب HTML وملفات CSS و JavaScript ثابتة وواجهة JSON.
//
//   /            الصفحة بالعربية        /en          بالإنجليزية
//   POST /notes  نموذج يضيف ملاحظة ثم يعيد التوجيه (Post/Redirect/Get)
//   GET  /api/status   POST /api/like   يستدعيهما app.js
//   /static/*    style.css و app.js و favicon.svg
//   أي مسار آخر  صفحة 404 من القالب 404.html
//
// القوالب والملفات في nahr/examples/site، ويشغله المثال الإنجليزي نفسه.
// من المجلد الذي فيه nahr و sultanc:
//
//     (cd sultanc && ./build/sultanc "$OLDPWD/nahr/examples/ar/site.sn" --package-graph "$OLDPWD/nahr/examples/package-graph.toml" -o "$OLDPWD/site_ar")
//     ./site_ar                      # http://127.0.0.1:8000
//
// متغيرات البيئة: NAHR_SITE (مجلد الموقع)، NAHR_PORT، NAHR_RELOAD=1 لإعادة
// قراءة القوالب مع كل طلب أثناء التطوير، NAHR_SERIAL=1 لخيط واحد (للمفسر).
من std.text استورد نصان_متساويان, صل_النصوص, قص_النص, أزل_البادئة;
من std.env استورد متغير_بيئة;
من std.io استورد اطبع_سطر;
من std.sync استورد
    ذرة_ط64, أنشئ_ذرة_ط64, احمل_ط64, اجمع_واجلب_ط64, ترتيب_ذاكرة,
    قفل, أنشئ_قفل, نفذ_مع_القفل;
من std.time استورد وقت_رتيب_نانو;
من std.http استورد طلب_ويب, استجابة_ويب;
من نهر.توجيه استورد
    موجه, أنشئ_موجها, جلب, أرسل, استخدم_وسيطا, وسيط,
    اربط_ملفات_بإعداد, إعداد_ملفات, إعداد_ملفات_افتراضي, خطأ_توجيه;
من نهر.معالجة استورد طلب, من_دالة;
من نهر.استخراج استورد معاملات_مسار;
من نهر.ردود استورد استجابة;
من نهر.جسم استورد رد_نصي, إعادة_توجيه;
من نهر.نموذج استورد نموذج_الطلب, حقل_نموذج;
من نهر.جسون استورد
    كاتب_جسون, كاتب_جسون_جديد, ابدأ_كائنا, أنه_كائنا, اكتب_مفتاحا, اكتب_طبيعيا, رد_كاتب_جسون;
من نهر.وسطاء استورد حول_الأخطاء, محول_رد_خطأ, ضغط;
من نهر.قوالب استورد
    قوالب, حمل_قوالب, رد_قالب, رد_قالب_بحالة, وصف_خطأ_قالب,
    سياق_قالب, قيمة_قالب, حقل_قالب, عين_قيمة, حقل,
    قيمة_نص, قيمة_عدد, قيمة_قائمة, قيمة_كائن;
من نهر.تشغيل استورد شغل_على, شغل_على_متوازيا;

نوع ملاحظة = { الرقم: طبيعي, النص: نص };

// تشاركها خيوط الخادم كلها، فالعدادات ذرية والملاحظات خلف قفل.
نوع حالة_الموقع = {
    القوالب: قوالب,
    البداية: عدد,
    الزيارات: ذرة_ط64,
    الإعجابات: ذرة_ط64,
    الملاحظات: قفل<متجه ملاحظة>
};

عرف الآن(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عرف بيئة_أو(الاسم: نص, الافتراضي: نص): نص {
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { أرجع القيمة; }
    | _ -> { أرجع الافتراضي; };
}

عرف صل(أ: نص, ب: نص): نص {
    دع الأجزاء: متجه نص = [أ, ب];
    دع فارغ: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &فارغ);
}

عرف يساوي(النص: &نص, الآخر: نص): منطقي { أرجع نصان_متساويان(النص, &الآخر); }

عرف يبدأ(النص: &نص, البادئة: نص): منطقي {
    طابق أزل_البادئة(النص, &البادئة) مع
    | اختياري.موجود(_) -> { أرجع صواب; }
    | اختياري.لا_شيء -> { أرجع خطأ; };
}

// ---- الترجمة: القوالب نفسها لكل لغة، والنصوص من هنا ----

عرف نصوص_الصفحة(إنجليزية: منطقي): قيمة_قالب {
    إذا (إنجليزية) {
        دع الحقول: متجه حقل_قالب = [
            حقل(«site», قيمة_نص(«Nahr»)),
            حقل(«switch», قيمة_نص(«العربية»)),
            حقل(«title», قيمة_نص(«A web framework for SultanC»)),
            حقل(«tagline», قيمة_نص(«This page is a template rendered by Nahr; the styles and script are static files it serves.»)),
            حقل(«features_title», قيمة_نص(«What this page uses»)),
            حقل(«live_title», قيمة_نص(«Live from the server»)),
            حقل(«visits», قيمة_نص(«Page views»)),
            حقل(«uptime», قيمة_نص(«Uptime»)),
            حقل(«likes», قيمة_نص(«Likes»)),
            حقل(«like», قيمة_نص(«Like»)),
            حقل(«notes_title», قيمة_نص(«Notes»)),
            حقل(«placeholder», قيمة_نص(«Write a note»)),
            حقل(«add», قيمة_نص(«Add»)),
            حقل(«empty», قيمة_نص(«No notes yet.»)),
            حقل(«escape_hint», قيمة_نص(«Try a note with <b>HTML</b>: templates escape it.»)),
            حقل(«not_found», قيمة_نص(«This page does not exist.»)),
            حقل(«back», قيمة_نص(«Back to the home page»)),
            حقل(«footer», قيمة_نص(«Served by Nahr, written in SultanC.»))
        ];
        أرجع قيمة_كائن(الحقول);
    };
    دع الحقول: متجه حقل_قالب = [
        حقل(«site», قيمة_نص(«نهر»)),
        حقل(«switch», قيمة_نص(«English»)),
        حقل(«title», قيمة_نص(«إطار ويب للغة سلطان سي»)),
        حقل(«tagline», قيمة_نص(«هذه الصفحة قالب يعرضه نهر، والتنسيق والسكربت ملفات ثابتة يخدمها هو أيضا.»)),
        حقل(«features_title», قيمة_نص(«ما تستخدمه هذه الصفحة»)),
        حقل(«live_title», قيمة_نص(«مباشرة من الخادم»)),
        حقل(«visits», قيمة_نص(«المشاهدات»)),
        حقل(«uptime», قيمة_نص(«مدة التشغيل»)),
        حقل(«likes», قيمة_نص(«الإعجابات»)),
        حقل(«like», قيمة_نص(«أعجبني»)),
        حقل(«notes_title», قيمة_نص(«الملاحظات»)),
        حقل(«placeholder», قيمة_نص(«اكتب ملاحظة»)),
        حقل(«add», قيمة_نص(«أضف»)),
        حقل(«empty», قيمة_نص(«لا ملاحظات بعد.»)),
        حقل(«escape_hint», قيمة_نص(«جرّب ملاحظة فيها <b>HTML</b>: القوالب تهرّبها.»)),
        حقل(«not_found», قيمة_نص(«هذه الصفحة غير موجودة.»)),
        حقل(«back», قيمة_نص(«العودة إلى الصفحة الرئيسية»)),
        حقل(«footer», قيمة_نص(«يخدمها نهر، المكتوب بسلطان سي.»))
    ];
    أرجع قيمة_كائن(الحقول);
}

عرف ميزة(العنوان: نص, النص: نص): قيمة_قالب {
    دع الحقول: متجه حقل_قالب = [حقل(«title», قيمة_نص(العنوان)), حقل(«text», قيمة_نص(النص))];
    أرجع قيمة_كائن(الحقول);
}

عرف الميزات(إنجليزية: منطقي): قيمة_قالب {
    إذا (إنجليزية) {
        دع القائمة: متجه قيمة_قالب = [
            ميزة(«Templates», «Jinja syntax: extends, blocks, include, for and if, with HTML escaping»),
            ميزة(«Static files», «ETag and 304, charset, Cache-Control, precompressed .br/.gz»),
            ميزة(«Forms», «the notes form posts, then redirects (Post/Redirect/Get)»),
            ميزة(«JSON API», «app.js calls /api/status and /api/like»),
            ميزة(«Middleware», «gzip compression and a template 404 page»)
        ];
        أرجع قيمة_قائمة(القائمة);
    };
    دع القائمة: متجه قيمة_قالب = [
        ميزة(«القوالب», «صياغة Jinja: الوراثة والكتل والتضمين والحلقات والشروط مع هروب HTML»),
        ميزة(«الملفات الثابتة», «ETag و 304 وترميز المحارف و Cache-Control وملفات br و gz المضغوطة مسبقا»),
        ميزة(«النماذج», «نموذج الملاحظات يرسل ثم يعيد التوجيه (Post/Redirect/Get)»),
        ميزة(«واجهة JSON», «يستدعي app.js المسارين api/status و api/like»),
        ميزة(«الوسطاء», «ضغط gzip وصفحة 404 من قالب»)
    ];
    أرجع قيمة_قائمة(القائمة);
}

// اللغة، والاتجاه، ورابط اللغة الأخرى، ونصوص الصفحة.
عرف سياق_اللغة(إنجليزية: منطقي): سياق_قالب {
    دع السياق: متغير سياق_قالب = [];
    إذا (إنجليزية) {
        عين_قيمة(&متغير السياق, «lang», قيمة_نص(«en»));
        عين_قيمة(&متغير السياق, «dir», قيمة_نص(«ltr»));
        عين_قيمة(&متغير السياق, «home», قيمة_نص(«/en»));
        عين_قيمة(&متغير السياق, «other_url», قيمة_نص(«/»));
        عين_قيمة(&متغير السياق, «other_lang», قيمة_نص(«ar»));
    } وإلا {
        عين_قيمة(&متغير السياق, «lang», قيمة_نص(«ar»));
        عين_قيمة(&متغير السياق, «dir», قيمة_نص(«rtl»));
        عين_قيمة(&متغير السياق, «home», قيمة_نص(«/»));
        عين_قيمة(&متغير السياق, «other_url», قيمة_نص(«/en»));
        عين_قيمة(&متغير السياق, «other_lang», قيمة_نص(«en»));
    };
    عين_قيمة(&متغير السياق, «t», نصوص_الصفحة(إنجليزية));
    أرجع السياق;
}

// ---- الصفحات ----

عرف قيمة_ملاحظة(الملاحظة: &ملاحظة): قيمة_قالب {
    دع الحقول: متجه حقل_قالب = [
        حقل(«id», قيمة_عدد((*الملاحظة).الرقم مثل عدد)),
        حقل(«text», قيمة_نص(استنسخ(&(*الملاحظة).النص)))
    ];
    أرجع قيمة_كائن(الحقول);
}

// الأحدث أولا.
عرف الملاحظات(الحالة: &حالة_الموقع): قيمة_قالب {
    دع النسخة: متجه ملاحظة = نفذ_مع_القفل(
        &(*الحالة).الملاحظات,
        دالة(القائمة: &متغير متجه ملاحظة): متجه ملاحظة -> استنسخ(القائمة)
    );
    دع القيم: متغير متجه قيمة_قالب = [];
    دع ف: متغير طبيعي = الطول(النسخة) مثل طبيعي;
    طالما (ف > 0) {
        ف := ف - 1;
        ألحق(القيم, قيمة_ملاحظة(&النسخة[ف]));
    }
    أرجع قيمة_قائمة(القيم);
}

عرف الصفحة(الحالة: &حالة_الموقع, إنجليزية: منطقي): استجابة {
    دع الزيارات: ط64 = اجمع_واجلب_ط64(&(*الحالة).الزيارات, 1 مثل ط64, ترتيب_ذاكرة.مسترخ()) + 1;
    دع الإعجابات: ط64 = احمل_ط64(&(*الحالة).الإعجابات, ترتيب_ذاكرة.مسترخ());
    دع السياق: متغير سياق_قالب = سياق_اللغة(إنجليزية);
    عين_قيمة(&متغير السياق, «features», الميزات(إنجليزية));
    عين_قيمة(&متغير السياق, «visits», قيمة_عدد(الزيارات مثل عدد));
    عين_قيمة(&متغير السياق, «likes», قيمة_عدد(الإعجابات مثل عدد));
    عين_قيمة(&متغير السياق, «notes», الملاحظات(الحالة));
    أرجع رد_قالب(&(*الحالة).القوالب, «index.html», &السياق);
}

عرف العربية(الحالة: &حالة_الموقع, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    أرجع الصفحة(الحالة, خطأ);
}

عرف الإنجليزية(الحالة: &حالة_الموقع, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    أرجع الصفحة(الحالة, صواب);
}

عرف حقل_من(الحقول: &متجه حقل_نموذج, الاسم: نص): نص {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحقول) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الحقول)[ف].الاسم, &الاسم)) { أرجع استنسخ(&(*الحقول)[ف].القيمة); };
        ف := ف + 1;
    }
    أرجع «»;
}

// تحتفظ بآخر 50 ملاحظة.
عرف أضف_ملاحظة(القائمة: &متغير متجه ملاحظة, النص: نص): طبيعي {
    دع الرقم: متغير طبيعي = 1;
    دع العدد: طبيعي = الطول(*القائمة) مثل طبيعي;
    إذا (العدد > 0) { الرقم := (*القائمة)[العدد - 1].الرقم + 1; };
    دع الجديدة: ملاحظة = { الرقم: الرقم, النص: النص };
    ألحق(*القائمة, الجديدة);
    إذا (الطول(*القائمة) > 50) {
        دع الباقي: متغير متجه ملاحظة = [];
        دع ف: متغير طبيعي = (الطول(*القائمة) مثل طبيعي) - 50;
        طالما (ف < (الطول(*القائمة) مثل طبيعي)) { ألحق(الباقي, استنسخ(&(*القائمة)[ف])); ف := ف + 1; }
        *القائمة := الباقي;
    };
    أرجع الرقم;
}

// POST /notes ثم 303 إلى صفحة اللغة نفسها.
عرف أضف_من_النموذج(الحالة: &حالة_الموقع, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع الوجهة: متغير نص = «/»;
    طابق نموذج_الطلب(الطلب) مع
    | نتيجة.خطأ(_) -> { دع النص: نص = «Bad Request»; أرجع رد_نصي(400, &النص); }
    | نتيجة.نجح(الحقول) -> {
        دع اللغة: نص = حقل_من(&الحقول, «lang»);
        إذا (يساوي(&اللغة, «en»)) { الوجهة := «/en»; };
        دع الخام: نص = حقل_من(&الحقول, «text»);
        دع النص: نص = قص_النص(&الخام);
        إذا (الطول(النص) > 0 && الطول(النص) <= 1200) {
            دع تجاهل: طبيعي = نفذ_مع_القفل(
                &(*الحالة).الملاحظات,
                دالة(القائمة: &متغير متجه ملاحظة): طبيعي -> أضف_ملاحظة(القائمة, استنسخ(&النص))
            );
        };
    };
    طابق إعادة_توجيه(303, &الوجهة) مع
    | اختياري.موجود(الرد) -> { أرجع الرد; }
    | اختياري.لا_شيء -> { دع النص: نص = «»; أرجع رد_نصي(500, &النص); };
}

// ---- واجهة JSON ----

// GET /api/status
عرف الحالة_الآن(الحالة: &حالة_الموقع, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع العدد: طبيعي = نفذ_مع_القفل(
        &(*الحالة).الملاحظات,
        دالة(القائمة: &متغير متجه ملاحظة): طبيعي -> الطول(*القائمة) مثل طبيعي
    );
    دع الكاتب: متغير كاتب_جسون = كاتب_جسون_جديد();
    ابدأ_كائنا(&متغير الكاتب);
    دع م1: نص = «uptime_seconds»;
    اكتب_مفتاحا(&متغير الكاتب, &م1);
    اكتب_طبيعيا(&متغير الكاتب, ((الآن() - (*الحالة).البداية) / 1000000000) مثل طبيعي);
    دع م2: نص = «visits»;
    اكتب_مفتاحا(&متغير الكاتب, &م2);
    اكتب_طبيعيا(&متغير الكاتب, احمل_ط64(&(*الحالة).الزيارات, ترتيب_ذاكرة.مسترخ()) مثل طبيعي);
    دع م3: نص = «likes»;
    اكتب_مفتاحا(&متغير الكاتب, &م3);
    اكتب_طبيعيا(&متغير الكاتب, احمل_ط64(&(*الحالة).الإعجابات, ترتيب_ذاكرة.مسترخ()) مثل طبيعي);
    دع م4: نص = «notes»;
    اكتب_مفتاحا(&متغير الكاتب, &م4);
    اكتب_طبيعيا(&متغير الكاتب, العدد);
    أنه_كائنا(&متغير الكاتب);
    أرجع رد_كاتب_جسون(200, &الكاتب);
}

// POST /api/like
عرف أعجب(الحالة: &حالة_الموقع, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع الجديد: ط64 = اجمع_واجلب_ط64(&(*الحالة).الإعجابات, 1 مثل ط64, ترتيب_ذاكرة.مسترخ()) + 1;
    دع الكاتب: متغير كاتب_جسون = كاتب_جسون_جديد();
    ابدأ_كائنا(&متغير الكاتب);
    دع المفتاح: نص = «likes»;
    اكتب_مفتاحا(&متغير الكاتب, &المفتاح);
    اكتب_طبيعيا(&متغير الكاتب, الجديد مثل طبيعي);
    أنه_كائنا(&متغير الكاتب);
    أرجع رد_كاتب_جسون(200, &الكاتب);
}

// 404 لصفحات الموقع من القالب؛ أخطاء /api وبقية الحالات تبقى كما هي.
عرف صفحة_الخطأ(
    الحالة: &حالة_الموقع,
    الطلب: &طلب_ويب<متجه ط8>,
    الاستجابة: استجابة_ويب<متجه ط8>
): استجابة_ويب<متجه ط8> {
    إذا (الاستجابة.الحالة != 404 || يبدأ(&(*الطلب).الهدف, «/api/»)) { أرجع الاستجابة; };
    دع إنجليزية: منطقي = يبدأ(&(*الطلب).الهدف, «/en»);
    دع السياق: سياق_قالب = سياق_اللغة(إنجليزية);
    أرجع رد_قالب_بحالة(404, &(*الحالة).القوالب, «404.html», &السياق);
}

عرف سجل(النتيجة: نتيجة طبيعي, خطأ_توجيه): منطقي {
    طابق النتيجة مع
    | نتيجة.نجح(_) -> { أرجع صواب; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

عرف الرئيسية(): عدد {
    دع الموقع: نص = بيئة_أو(«NAHR_SITE», «nahr/examples/site»);
    دع المنفذ: نص = بيئة_أو(«NAHR_PORT», «8000»);
    دع دليل_القوالب: نص = صل(استنسخ(&الموقع), «/templates»);
    دع دليل_الملفات: نص = صل(استنسخ(&الموقع), «/public»);

    دع المجموعة: متغير قوالب;
    طابق حمل_قوالب(دليل_القوالب) مع
    | نتيجة.نجح(م) -> { المجموعة := م; }
    | نتيجة.خطأ(الخطأ) -> {
        دع ت: نتيجة عدد, عدد = اطبع_سطر(وصف_خطأ_قالب(&الخطأ));
        أرجع 1;
    };
    دع إعادة: نص = بيئة_أو(«NAHR_RELOAD», «»);
    المجموعة.إعادة_التحميل := يساوي(&إعادة, «1»);

    دع الملاحظات: متجه ملاحظة = [];
    دع الحالة: حالة_الموقع = {
        القوالب: المجموعة,
        البداية: الآن(),
        الزيارات: أنشئ_ذرة_ط64(0 مثل ط64),
        الإعجابات: أنشئ_ذرة_ط64(0 مثل ط64),
        الملاحظات: أنشئ_قفل(الملاحظات)
    };
    دع الموجه: متغير موجه<حالة_الموقع> = أنشئ_موجها(الحالة);

    دع جذر: نص = «/»;
    دع en: نص = «/en»;
    دع notes: نص = «/notes»;
    دع status: نص = «/api/status»;
    دع like: نص = «/api/like»;
    دع static: نص = «/static»;
    إذا (!سجل(جلب(&متغير الموجه, &جذر, من_دالة(العربية)))) { أرجع 2; };
    إذا (!سجل(جلب(&متغير الموجه, &en, من_دالة(الإنجليزية)))) { أرجع 3; };
    إذا (!سجل(أرسل(&متغير الموجه, &notes, من_دالة(أضف_من_النموذج)))) { أرجع 4; };
    إذا (!سجل(جلب(&متغير الموجه, &status, من_دالة(الحالة_الآن)))) { أرجع 5; };
    إذا (!سجل(أرسل(&متغير الموجه, &like, من_دالة(أعجب)))) { أرجع 6; };

    // الملفات الثابتة تخزن ساعة في المتصفح.
    دع الإعداد: متغير إعداد_ملفات = إعداد_ملفات_افتراضي();
    الإعداد.التخزين := «public, max-age=3600»;
    الإعداد.مضغوطة := صواب;
    إذا (!سجل(اربط_ملفات_بإعداد(&متغير الموجه, &static, &دليل_الملفات, &الإعداد))) { أرجع 7; };

    دع المحول: محول_رد_خطأ<حالة_الموقع> = صفحة_الخطأ;
    دع الأخطاء: وسيط<حالة_الموقع> = حول_الأخطاء(المحول);
    دع المضغوط: وسيط<حالة_الموقع> = ضغط(1024);
    استخدم_وسيطا(&متغير الموجه, الأخطاء);
    استخدم_وسيطا(&متغير الموجه, المضغوط);

    دع العنوان: نص = صل(«127.0.0.1:», المنفذ);
    دع تسلسلي: نص = بيئة_أو(«NAHR_SERIAL», «»);
    إذا (يساوي(&تسلسلي, «1»)) {
        طابق شغل_على(&العنوان, &الموجه) مع
        | نتيجة.خطأ(_) -> { أرجع 8; }
        | نتيجة.نجح(الرمز) -> { أرجع الرمز; };
    };
    دع الجاهز: موجه<حالة_الموقع> = الموجه;
    طابق شغل_على_متوازيا(&العنوان, الجاهز, 0) مع
    | نتيجة.خطأ(_) -> { أرجع 9; }
    | نتيجة.نجح(الرمز) -> { أرجع الرمز; };
}
