// أصغر تطبيق بنهر: مسار GET واحد على 127.0.0.1:8000.
//
// من المجلد الذي فيه nahr و sultanc:
//     (cd sultanc && ./build/sultanc "$OLDPWD/nahr/examples/ar/hello.sn" --package-graph "$OLDPWD/nahr/examples/package-graph.toml" -o "$OLDPWD/hello_ar")
من نهر.توجيه استورد
    موجه,
    أنشئ_موجها,
    جلب;

من نهر.معالجة استورد
    طلب,
    من_دالة;

من نهر.استخراج استورد
    معاملات_مسار;

من نهر.ردود استورد
    استجابة;

من نهر.جسم استورد
    رد_نصي;

من نهر.تشغيل استورد
    شغل_على;

عرف الصفحة_الأولى(
    الحالة: &عدد,
    الطلب: &طلب,
    المعاملات: &معاملات_مسار
): استجابة {
    ليكن النص: نص = «Hello from Nahr»;
    أرجع رد_نصي(200, &النص);
}

عرف الرئيسية(): عدد {
    ليكن الموجه: متغير موجه<عدد> =
        أنشئ_موجها(0);
    ليكن المسار: نص = «/»;

    طابق جلب(
        &متغير الموجه,
        &المسار,
        من_دالة(الصفحة_الأولى)
    ) مع
    | نتيجة.خطأ(_) -> { أرجع 1; }
    | نتيجة.نجح(_) -> { };

    ليكن العنوان: نص = «127.0.0.1:8000»;
    طابق شغل_على(&العنوان, &الموجه) مع
    | نتيجة.خطأ(_) -> { أرجع 2; }
    | نتيجة.نجح(الرمز) -> { أرجع الرمز; };
}
