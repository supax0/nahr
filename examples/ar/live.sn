// اتصالات مباشرة: مقبس ويب يردد الرسائل، وتدفق أحداث من الخادم (SSE).
//
//   GET /ws        مقبس ويب: كل رسالة نصية تعود «صدى: …»، و«وداعا» تغلقه
//   GET /ticks     أحداث الخادم: حدث «tick» كل ثانية، خمس مرات
//   GET /          صفحة تستخدم الاثنين (مضمنة في الملف التنفيذي)
//
//     (cd sultanc && ./build/sultanc "$OLDPWD/nahr/examples/ar/live.sn" --package-graph "$OLDPWD/nahr/examples/package-graph.toml" -o "$OLDPWD/live_ar")
//     ./live_ar      # http://127.0.0.1:8000
//
// يبقى المعالج المباشر مع اتصاله حتى يعود، في خيط خاص به.
من std.text استورد نصان_متساويان, صل_النصوص, طبيعي_إلى_نص;
من std.time استورد نم_نانو;
من نهر.توجيه استورد موجه, أنشئ_موجها, جلب, اربط_مقبس_ويب, اربط_أحداث;
من نهر.معالجة استورد طلب, من_دالة;
من نهر.استخراج استورد معاملات_مسار;
من نهر.ردود استورد استجابة;
من نهر.جسم استورد رد_صفحة;
من نهر.مباشر استورد
    اتصال_مقبس_ويب, استقبل_رسالة_مقبس, أرسل_نصا_مقبس, أغلق_مقبسا,
    نص_رسالة, رسالة_نصية, تدفق_ويب, أرسل_حدثا;
من نهر.أحداث استورد حدث, أنشئ_حدثا, عين_نوع_حدث, عين_معرف_حدث;
من نهر.تشغيل استورد شغل_على_بأحداث;

نوع تطبيق = { الاسم: نص };

عرف الصفحة(الحالة: &تطبيق, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    // الصفحة جزء من الملف التنفيذي: يقرأها ضمن_ملف وقت البناء.
    ليكن الجسم: نص = ضمن_ملف(«live.html»);
    أرجع رد_صفحة(200, &الجسم);
}

// اتصال واحد: يردد كل رسالة نصية حتى «وداعا» أو يغلق العميل.
عرف صدى(الحالة: &تطبيق, الطلب: &طلب, المعاملات: &معاملات_مسار, الاتصال: &متغير اتصال_مقبس_ويب): فراغ {
    ليكن الترحيب: نص = «متصل بنهر»;
    ليكن تجاهل: منطقي = أرسل_نصا_مقبس(الاتصال, &الترحيب);
    ليكن مستمر: متغير منطقي = صواب;
    طالما (مستمر) {
        طابق استقبل_رسالة_مقبس(الاتصال) مع
        | نتيجة.خطأ(_) -> { مستمر := خطأ; }
        | نتيجة.نجح(الرسالة) -> {
            إذا (رسالة_نصية(&الرسالة)) {
                ليكن النص: نص = نص_رسالة(&الرسالة);
                ليكن وداع: نص = «وداعا»;
                إذا (نصان_متساويان(&النص, &وداع)) {
                    ليكن السبب: نص = «مع السلامة»;
                    أغلق_مقبسا(الاتصال, 1000, &السبب);
                    مستمر := خطأ;
                } وإلا {
                    ليكن الأجزاء: متجه نص = [«صدى: », النص];
                    ليكن فارغ: نص = «»;
                    ليكن الرد: نص = صل_النصوص(&الأجزاء, &فارغ);
                    إذا (!أرسل_نصا_مقبس(الاتصال, &الرد)) { مستمر := خطأ; };
                };
            };
        };
    }
}

// خمسة أحداث «tick»، واحد كل ثانية؛ يتوقف إذا غادر العميل.
عرف نبضات(الحالة: &تطبيق, الطلب: &طلب, المعاملات: &معاملات_مسار, التدفق: &متغير تدفق_ويب): فراغ {
    ليكن ف: متغير طبيعي = 1;
    طالما (ف <= 5) {
        ليكن البيانات: نص = طبيعي_إلى_نص(ف);
        ليكن الحدث: متغير حدث = أنشئ_حدثا(&البيانات);
        ليكن النوع: نص = «tick»;
        عين_نوع_حدث(&متغير الحدث, &النوع);
        عين_معرف_حدث(&متغير الحدث, &البيانات);
        إذا (!أرسل_حدثا(التدفق, &الحدث)) { أرجع; };
        إذا (ف < 5) { ليكن انتظر: نتيجة عدد, عدد = نم_نانو(1000000000); };
        ف := ف + 1;
    }
}

عرف الرئيسية(): عدد {
    ليكن الحالة: تطبيق = { الاسم: «مباشر» };
    ليكن الموجه: متغير موجه<تطبيق> = أنشئ_موجها(الحالة);
    ليكن الجذر: نص = «/»;
    ليكن المقبس: نص = «/ws»;
    ليكن الأحداث: نص = «/ticks»;
    طابق جلب(&متغير الموجه, &الجذر, من_دالة(الصفحة)) مع | نتيجة.خطأ(_) -> { أرجع 1; } | نتيجة.نجح(_) -> { };
    طابق اربط_مقبس_ويب(&متغير الموجه, &المقبس, صدى) مع | نتيجة.خطأ(_) -> { أرجع 2; } | نتيجة.نجح(_) -> { };
    طابق اربط_أحداث(&متغير الموجه, &الأحداث, نبضات) مع | نتيجة.خطأ(_) -> { أرجع 3; } | نتيجة.نجح(_) -> { };
    ليكن العنوان: نص = «127.0.0.1:8000»;
    ليكن الجاهز: موجه<تطبيق> = الموجه;
    طابق شغل_على_بأحداث(&العنوان, الجاهز, 0) مع
    | نتيجة.خطأ(_) -> { أرجع 4; }
    | نتيجة.نجح(_) -> { أرجع 0; };
}
