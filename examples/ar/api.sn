// واجهة صغيرة: مستخرجات المسار والاستعلام، مسار محمي بـ @محمي، ضغط بـ
// @مضغوط، CORS عام، ووثيقة OpenAPI مع صفحة توثيق.
//
// GET /                      -> «نهر»
// GET /users/{name}?lang=ar  -> تحية (الاسم مفكوك الترميز)
// GET /admin                 -> يحتاج "Authorization: Bearer secret"
// GET /report                -> نص طويل يضغط بـ gzip
// GET /info                  -> جسون من نوع التطبيق عبر رد_جسون_بـ
// الأخطاء كلها جسون، ولكل طلب X-Request-Id
// GET /openapi.json, /docs   -> وثيقة OpenAPI 3.2.0 وصفحة التوثيق
//
// من جذر مستودع سلطان سي:
//     ./build/sultanc ../nahr/examples/ar/api.sn --package-graph ../nahr/examples/package-graph.toml -o ../nahr_api
من std.text استورد نصان_متساويان, صل_النصوص, كرر_النص;
من نهر.توجيه استورد موجه, أنشئ_موجها, جلب, استخدم_وسيطا, وسيط;
من نهر.معالجة استورد طلب, معالج, من_دالة, مع_استخراجين;
من نهر.استخراج استورد مستخرج, معاملات_مسار, استخرج_معامل_مسار, استخرج_معامل_استعلام;
من نهر.ردود استورد استجابة;
من نهر.جسم استورد رد_نصي;
من نهر.وسطاء استورد
    إعداد_أصول, أصول_افتراضية, سياسة_الأصول, خطأ_أصول, محمي, مضغوط,
    أخطاء_جسون, معرف_الطلب;
من نهر.جسون استورد كاتب_جسون, ابدأ_كائنا, أنه_كائنا, اكتب_حقلا_نصيا, اكتب_حقلا_عدديا, رد_جسون_بـ;
من نهر.توثيق استورد
    وثيقة_واجهة, أنشئ_وثيقة, صف_جلب, عملية_واجهة, ضمن_استجابة, استجابة_فقط,
    سجل_موثقا, معالج_المخطط, معالج_صفحة_التوثيق,
    ضمن_معاملا, معامل_مسار, معامل_استعلام, مخطط_نصي;
من نهر.تشغيل استورد شغل_على;

عرف البداية(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع النص: نص = «نهر»;
    أرجع رد_نصي(200, &النص);
}

عرف التحية(الحالة: &عدد, الاسم: نص, اللغة: اختياري نص): استجابة {
    دع ar: نص = «ar»;
    دع التحية: متغير نص = «Hello»;
    طابق اللغة مع
    | اختياري.موجود(القيمة) -> {
        إذا (نصان_متساويان(&القيمة, &ar)) { التحية := «أهلا»; };
    }
    | اختياري.لا_شيء -> { };
    دع الأجزاء: متجه نص = [التحية, الاسم];
    دع الفاصل: نص = «، »;
    دع النص: نص = صل_النصوص(&الأجزاء, &الفاصل);
    أرجع رد_نصي(200, &النص);
}

نوع معلومات = { الاسم: نص, الإصدار: نص, المسارات: عدد };

عرف رمز_المعلومات(القيمة: &معلومات, الكاتب: &متغير كاتب_جسون): فراغ {
    ابدأ_كائنا(الكاتب);
    دع الاسم: نص = «name»;
    دع الإصدار: نص = «version»;
    دع المسارات: نص = «routes»;
    اكتب_حقلا_نصيا(الكاتب, &الاسم, &(*القيمة).الاسم);
    اكتب_حقلا_نصيا(الكاتب, &الإصدار, &(*القيمة).الإصدار);
    اكتب_حقلا_عدديا(الكاتب, &المسارات, (*القيمة).المسارات);
    أنه_كائنا(الكاتب);
}

عرف المعلومات(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع القيمة: معلومات = { الاسم: «نهر», الإصدار: «0.1.0», المسارات: 7 };
    أرجع رد_جسون_بـ(200, &القيمة, رمز_المعلومات);
}

عرف رمز_مقبول(الحالة: &عدد, الرمز: &نص): منطقي {
    دع السر: نص = «secret»;
    أرجع نصان_متساويان(الرمز, &السر);
}

// كل استدعاء لـ الإدارة يمر أولا عبر محمي(رمز_مقبول، …).
@محمي(رمز_مقبول)
عرف الإدارة(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع النص: نص = «لوحة الإدارة»;
    أرجع رد_نصي(200, &النص);
}

// المزخرفات تتراكب: الحماية أولا ثم الضغط على الرد.
@مضغوط
@محمي(رمز_مقبول)
عرف التقرير(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    دع السطر: نص = "سطر من التقرير\n";
    دع النص: نص = كرر_النص(&السطر, 200);
    أرجع رد_نصي(200, &النص);
}

عرف وثق(
    الموجه: &متغير موجه<عدد>,
    الوثيقة: &متغير وثيقة_واجهة,
    المسار: نص,
    المعالج: معالج<عدد>
): منطقي {
    دع العملية: متغير عملية_واجهة = صف_جلب(&المسار);
    أرجع وثق_عملية(الموجه, الوثيقة, العملية, المعالج);
}

// يسجل مسار GET مع عمليته في وثيقة OpenAPI. معاملات المسار يجب أن تعرف في
// العملية، وإلا ترفض الوثيقة "/users/{name}".
عرف وثق_عملية(
    الموجه: &متغير موجه<عدد>,
    الوثيقة: &متغير وثيقة_واجهة,
    العملية_الأصلية: عملية_واجهة,
    المعالج: معالج<عدد>
): منطقي {
    دع العملية: متغير عملية_واجهة = العملية_الأصلية;
    دع رمز: نص = «200»;
    دع الوصف: نص = «OK»;
    ضمن_استجابة(&متغير العملية, استجابة_فقط(&رمز, &الوصف));
    طابق سجل_موثقا(الموجه, الوثيقة, العملية, المعالج) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(_) -> { أرجع صواب; };
}

عرف الرئيسية(): عدد {
    دع الموجه: متغير موجه<عدد> = أنشئ_موجها(0);
    دع العنوان: نص = «مثال نهر»;
    دع الإصدار: نص = «0.1.0»;
    دع الوثيقة: متغير وثيقة_واجهة = أنشئ_وثيقة(&العنوان, &الإصدار);

    // المستخرجات تربط بأنواعها: سلطان سي يستنتج معاملات النوع من معاملات
    // الاستدعاء أو من الربط.
    دع name: نص = «name»;
    دع lang: نص = «lang»;
    دع الاسم: مستخرج<عدد, نص> = استخرج_معامل_مسار(&name);
    دع اللغة: مستخرج<عدد, اختياري نص> = استخرج_معامل_استعلام(&lang);

    إذا (!وثق(&متغير الموجه, &متغير الوثيقة, «/admin», من_دالة(الإدارة))) { أرجع 1; };
    إذا (!وثق(&متغير الموجه, &متغير الوثيقة, «/report», من_دالة(التقرير))) { أرجع 8; };
    إذا (!وثق(&متغير الموجه, &متغير الوثيقة, «/info», من_دالة(المعلومات))) { أرجع 9; };

    إذا (!وثق(&متغير الموجه, &متغير الوثيقة, «/», من_دالة(البداية))) { أرجع 2; };
    دع مسار_المستخدم: نص = «/users/{name}»;
    دع عملية_المستخدم: متغير عملية_واجهة = صف_جلب(&مسار_المستخدم);
    ضمن_معاملا(&متغير عملية_المستخدم, معامل_مسار(&name, مخطط_نصي()));
    ضمن_معاملا(&متغير عملية_المستخدم, معامل_استعلام(&lang, خطأ, مخطط_نصي()));
    إذا (!وثق_عملية(&متغير الموجه, &متغير الوثيقة, عملية_المستخدم,
        مع_استخراجين(الاسم, اللغة, التحية))) { أرجع 3; };

    دع مسار_المخطط: نص = «/openapi.json»;
    دع مسار_الصفحة: نص = «/docs»;
    طابق جلب(&متغير الموجه, &مسار_المخطط, معالج_المخطط(استنسخ(&الوثيقة))) مع
    | نتيجة.خطأ(_) -> { أرجع 4; } | نتيجة.نجح(_) -> { };
    دع الصفحة: معالج<عدد> = معالج_صفحة_التوثيق();
    طابق جلب(&متغير الموجه, &مسار_الصفحة, الصفحة) مع
    | نتيجة.خطأ(_) -> { أرجع 5; } | نتيجة.نجح(_) -> { };

    // الأخطاء جسون أولا، فهي ترى كل رد.
    دع الأخطاء: وسيط<عدد> = أخطاء_جسون();
    دع المعرف: وسيط<عدد> = معرف_الطلب();
    استخدم_وسيطا(&متغير الموجه, الأخطاء);
    استخدم_وسيطا(&متغير الموجه, المعرف);

    دع الأصول: متغير إعداد_أصول = أصول_افتراضية();
    دع نتيجة_الأصول: نتيجة وسيط<عدد>, خطأ_أصول = سياسة_الأصول(&الأصول);
    طابق نتيجة_الأصول مع
    | نتيجة.خطأ(_) -> { أرجع 6; }
    | نتيجة.نجح(الوسيط) -> { استخدم_وسيطا(&متغير الموجه, الوسيط); };

    دع العنوان_الشبكي: نص = «127.0.0.1:8000»;
    طابق شغل_على(&العنوان_الشبكي, &الموجه) مع
    | نتيجة.خطأ(_) -> { أرجع 7; }
    | نتيجة.نجح(الرمز) -> { أرجع الرمز; };
}
