// واجهة المتجر: معالجات HTTP فوق الكتالوج واختبار الحمل.
//
//   GET  /                         الصفحة (مضمنة في الملف التنفيذي)
//   GET  /api/products             بحث وتصفية وترتيب وصفحات
//          ?q=قهوة&category=…&min=…&max=…&sort=newest|cheapest|priciest|rating&page=1&size=20
//   GET  /api/products/{id}        منتج واحد
//   GET  /api/categories           الفئات وأعداد منتجاتها
//   POST /api/load-test            يبدأ اختبار حمل {"السيناريو": …, "الاتصالات": …, "الثواني": …}
//   GET  /api/load-test            تقرير الاختبار الجاري أو الأخير
//   GET  /api/load-test/events     التقرير نفسه بثا (SSE)، أربع مرات في الثانية
//
// كل خطأ في المدخلات 422 بجسم {"detail": …} كما يجيب FastAPI، ويحمل كل
// رد بحث رأس Server-Timing بزمن البحث.
استورد "catalog.sn";
استورد "loadtest.sn";
من std.text استورد نصان_متساويان, حلل_عدد, حلل_طبيعي, عدد_إلى_نص, صل_النصوص, بايتات_من_نص;
من std.time استورد وقت_رتيب_نانو, نم_نانو;
من std.sync استورد مشترك, اقرأ_مشترك;
من std.http استورد أول_قيمة_استعلام_ويب, هل_طلب_إيقاف_الويب;
من نهر.معالجة استورد طلب;
من نهر.استخراج استورد معاملات_مسار, معامل_مسار_عدد, استعلام, زوج_استعلام;
من نهر.ردود استورد استجابة, عين_رأسا;
من نهر.جسم استورد رد_صفحة;
من نهر.جسون استورد اقرأ_جسون_بـ, رد_جسون_من;
من نهر.مباشر استورد تدفق_ويب, أرسل_حدثا;
من نهر.أحداث استورد حدث, أنشئ_حدثا, عين_نوع_حدث;

// ———————————————————————— الحالة ————————————————————————

// حالة التطبيق: يقرؤها كل طلب، ولا يغيرها إلا المختبر بعداداته الذرية.
عام نوع متجر = {
    الكتالوج: كتالوج,
    المختبر: مشترك<مختبر_الحمل>,
    // عنوان الخادم نفسه، يرسل إليه المختبر طلباته.
    العنوان: نص
};

// ———————————————————————— الردود ————————————————————————

@@جسون
عام نوع خطأ_مدخلات = { detail: نص };

@@جسون
عام نوع قائمة_الفئات = { المنتجات: عدد, الفئات: متجه فئة };

@@جسون
عام نوع طلب_اختبار = { السيناريو: نص, الاتصالات: عدد, الثواني: عدد };

عرف رفض(الحالة: طبيعي, الرسالة: نص): استجابة {
    ليكن الخطأ: خطأ_مدخلات = { detail: الرسالة };
    أرجع رد_جسون_من(الحالة, &الخطأ, جسون__خطأ_مدخلات);
}

// مكروثوان بصيغة المللي ثانية بثلاث منازل: 642 ← «0.642».
عرف بالمللي(المكرو: عدد): نص {
    ليكن الكسر: عدد = المكرو % 1000;
    ليكن الأصفار: متغير نص = «»;
    إذا (الكسر < 100) { الأصفار := «0»; };
    إذا (الكسر < 10) { الأصفار := «00»; };
    ليكن الأجزاء: متجه نص = [عدد_إلى_نص(المكرو / 1000), «.», الأصفار, عدد_إلى_نص(الكسر)];
    ليكن لا_شيء: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &لا_شيء);
}

عرف يساوي(النص: &نص, المطلوب: نص): منطقي { أرجع نصان_متساويان(النص, &المطلوب); }

عرف قيمة_استعلام(الأزواج: &متجه زوج_استعلام, الاسم: نص): اختياري نص {
    أرجع أول_قيمة_استعلام_ويب(الأزواج, &الاسم);
}

عرف الآن_بالنانو(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(ن) -> { أرجع ن; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

// ———————————————————————— قراءة الاستعلام ————————————————————————

// معامل استعلام عددي: البديل إن غاب، وخطأ إن لم يكن عددا.
عرف عدد_من_الاستعلام(الأزواج: &متجه زوج_استعلام, الاسم: نص, البديل: عدد): نتيجة عدد, نص {
    طابق قيمة_استعلام(الأزواج, استنسخ(&الاسم)) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.نجح(البديل); }
    | اختياري.موجود(القيمة) -> {
        طابق حلل_عدد(&القيمة) مع
        | نتيجة.نجح(العدد) -> { أرجع نتيجة.نجح(العدد); }
        | نتيجة.خطأ(_) -> {
            ليكن الأجزاء: متجه نص = [«المعامل », الاسم, « ليس عددا»];
            ليكن لا_شيء: نص = «»;
            أرجع نتيجة.خطأ(صل_النصوص(&الأجزاء, &لا_شيء));
        };
    };
}

عرف ترتيب_من_نص(النص: &نص): اختياري ترتيب_منتجات {
    إذا (يساوي(النص, «newest»)) { أرجع اختياري.موجود(ترتيب_منتجات.الأحدث()); };
    إذا (يساوي(النص, «cheapest»)) { أرجع اختياري.موجود(ترتيب_منتجات.الأرخص()); };
    إذا (يساوي(النص, «priciest»)) { أرجع اختياري.موجود(ترتيب_منتجات.الأغلى()); };
    إذا (يساوي(النص, «rating»)) { أرجع اختياري.موجود(ترتيب_منتجات.الأعلى_تقييما()); };
    أرجع اختياري.لا_شيء();
}

// يحول معاملات الطلب إلى استعلام منتجات، أو يجيب برسالة الخطأ.
عرف استعلام_من_طلب(الكتالوج: &كتالوج, الطلب: &طلب): نتيجة استعلام_منتجات, نص {
    ليكن الأزواج: متغير متجه زوج_استعلام = [];
    طابق استعلام(الطلب) مع
    | نتيجة.نجح(ق) -> { الأزواج := ق; }
    | نتيجة.خطأ(_) -> { أرجع نتيجة.خطأ(«الاستعلام غير صالح»); };

    ليكن النص: متغير نص = «»;
    طابق قيمة_استعلام(&الأزواج, «q») مع
    | اختياري.موجود(القيمة) -> { النص := القيمة; }
    | اختياري.لا_شيء -> { };

    ليكن الفئة: متغير اختياري طبيعي = اختياري.لا_شيء();
    طابق قيمة_استعلام(&الأزواج, «category») مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الاسم) -> {
        إذا ((الطول(الاسم) مثل طبيعي) > 0) {
            طابق فئة_باسم(الكتالوج, &الاسم) مع
            | اختياري.موجود(الرقم) -> { الفئة := اختياري.موجود(الرقم); }
            | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(«الفئة غير موجودة»); };
        };
    };

    ليكن الترتيب: متغير ترتيب_منتجات = ترتيب_منتجات.الأحدث();
    طابق قيمة_استعلام(&الأزواج, «sort») مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طابق ترتيب_من_نص(&القيمة) مع
        | اختياري.موجود(ت) -> { الترتيب := ت; }
        | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(«الترتيب واحد من: newest, cheapest, priciest, rating»); };
    };

    ليكن الأدنى: عدد;
    طابق عدد_من_الاستعلام(&الأزواج, «min», 0) مع
    | نتيجة.نجح(ق) -> { الأدنى := ق; } | نتيجة.خطأ(ر) -> { أرجع نتيجة.خطأ(ر); };
    ليكن الأعلى: عدد;
    طابق عدد_من_الاستعلام(&الأزواج, «max», 1000000) مع
    | نتيجة.نجح(ق) -> { الأعلى := ق; } | نتيجة.خطأ(ر) -> { أرجع نتيجة.خطأ(ر); };
    ليكن الصفحة: عدد;
    طابق عدد_من_الاستعلام(&الأزواج, «page», 1) مع
    | نتيجة.نجح(ق) -> { الصفحة := ق; } | نتيجة.خطأ(ر) -> { أرجع نتيجة.خطأ(ر); };
    ليكن الحجم: عدد;
    طابق عدد_من_الاستعلام(&الأزواج, «size», 20) مع
    | نتيجة.نجح(ق) -> { الحجم := ق; } | نتيجة.خطأ(ر) -> { أرجع نتيجة.خطأ(ر); };
    إذا (الصفحة < 1) { أرجع نتيجة.خطأ(«الصفحة تبدأ من 1»); };
    إذا (الحجم < 1 || الحجم > 100) { أرجع نتيجة.خطأ(«الحجم من 1 إلى 100»); };
    إذا (الأدنى > الأعلى) { أرجع نتيجة.خطأ(«أدنى سعر أكبر من أعلاه»); };

    ليكن الناتج: استعلام_منتجات = {
        النص: النص,
        الفئة: الفئة,
        أدنى_سعر: الأدنى,
        أعلى_سعر: الأعلى,
        الترتيب: الترتيب,
        الصفحة: الصفحة مثل طبيعي,
        الحجم: الحجم مثل طبيعي
    };
    أرجع نتيجة.نجح(الناتج);
}

// ———————————————————————— المعالجات ————————————————————————

// GET /
عام عرف الصفحة(المتجر: &متجر, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن الجسم: نص = ضمن_ملف(«page.html»);
    أرجع رد_صفحة(200, &الجسم);
}

// GET /api/products
عام عرف المنتجات(المتجر: &متجر, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    طابق استعلام_من_طلب(&(*المتجر).الكتالوج, الطلب) مع
    | نتيجة.خطأ(الرسالة) -> { أرجع رفض(422, الرسالة); }
    | نتيجة.نجح(الاستعلام) -> {
        ليكن البداية: عدد = الآن_بالنانو();
        ليكن الصفحة: صفحة_منتجات = ابحث_في_الكتالوج(&(*المتجر).الكتالوج, &الاستعلام);
        ليكن المكرو: عدد = (الآن_بالنانو() - البداية) / 1000;
        ليكن الرد: متغير استجابة = رد_جسون_من(200, &الصفحة, جسون__صفحة_منتجات);
        ليكن الأجزاء: متجه نص = [«search;dur=», بالمللي(المكرو)];
        ليكن لا_شيء: نص = «»;
        ليكن التوقيت: نص = صل_النصوص(&الأجزاء, &لا_شيء);
        ليكن الرأس: نص = «server-timing»;
        ليكن تجاهل: منطقي = عين_رأسا(&متغير الرد, &الرأس, &التوقيت);
        أرجع الرد;
    };
}

// GET /api/products/{id}
عام عرف منتج_واحد(المتجر: &متجر, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن الاسم: نص = «id»;
    طابق معامل_مسار_عدد(المعاملات, &الاسم) مع
    | نتيجة.خطأ(_) -> { أرجع رفض(422, «رقم المنتج ليس عددا»); }
    | نتيجة.نجح(الرقم) -> {
        طابق منتج_برقم(&(*المتجر).الكتالوج, الرقم) مع
        | اختياري.لا_شيء -> { أرجع رفض(404, «المنتج غير موجود»); }
        | اختياري.موجود(المنتج) -> { أرجع رد_جسون_من(200, &المنتج, جسون__منتج); };
    };
}

// GET /api/categories
عام عرف الفئات(المتجر: &متجر, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن القائمة: قائمة_الفئات = {
        المنتجات: عدد_المنتجات(&(*المتجر).الكتالوج) مثل عدد,
        الفئات: استنسخ(&(*المتجر).الكتالوج.الفئات)
    };
    أرجع رد_جسون_من(200, &القائمة, جسون__قائمة_الفئات);
}

// سيناريو اختبار الحمل: مسار الطلب، والرد الصحيح عليه بايتا ببايت، يحسب
// من الكتالوج مباشرة بالاستعلام نفسه الذي يمثله المسار.
نوع سيناريو = { المسار: نص, المتوقع: متجه ط8 };

عرف سيناريو_بحث(الكتالوج: &كتالوج, المسار: نص, الاستعلام: استعلام_منتجات): سيناريو {
    ليكن الصفحة: صفحة_منتجات = ابحث_في_الكتالوج(الكتالوج, &الاستعلام);
    ليكن الناتج: سيناريو = { المسار: المسار, المتوقع: بايتات_من_نص(جسون__صفحة_منتجات(&الصفحة)) };
    أرجع الناتج;
}

// ثلاثة أحمال: طلب خفيف، وتصفح يمسح الكتالوج كله، وبحث نصي.
عرف سيناريو_باسم(الكتالوج: &كتالوج, الاسم: &نص): اختياري سيناريو {
    إذا (يساوي(الاسم, «product»)) {
        طابق منتج_برقم(الكتالوج, 4242) مع
        | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); }
        | اختياري.موجود(المنتج) -> {
            ليكن الناتج: سيناريو = { المسار: «/api/products/4242», المتوقع: بايتات_من_نص(جسون__منتج(&المنتج)) };
            أرجع اختياري.موجود(الناتج);
        };
    };
    إذا (يساوي(الاسم, «browse»)) {
        ليكن الفئة: نص = «إلكترونيات»;
        ليكن الاستعلام: استعلام_منتجات = {
            النص: «», الفئة: فئة_باسم(الكتالوج, &الفئة), أدنى_سعر: 0, أعلى_سعر: 1000000,
            الترتيب: ترتيب_منتجات.الأرخص(), الصفحة: 5, الحجم: 20
        };
        // category=إلكترونيات&sort=cheapest&page=5
        أرجع اختياري.موجود(سيناريو_بحث(الكتالوج,
            «/api/products?category=%D8%A5%D9%84%D9%83%D8%AA%D8%B1%D9%88%D9%86%D9%8A%D8%A7%D8%AA&sort=cheapest&page=5», الاستعلام));
    };
    إذا (يساوي(الاسم, «search»)) {
        ليكن الاستعلام: استعلام_منتجات = {
            النص: «قهوة عربية», الفئة: اختياري.لا_شيء(), أدنى_سعر: 0, أعلى_سعر: 1000000,
            الترتيب: ترتيب_منتجات.الأعلى_تقييما(), الصفحة: 1, الحجم: 20
        };
        // q=قهوة عربية&sort=rating
        أرجع اختياري.موجود(سيناريو_بحث(الكتالوج,
            «/api/products?q=%D9%82%D9%87%D9%88%D8%A9%20%D8%B9%D8%B1%D8%A8%D9%8A%D8%A9&sort=rating», الاستعلام));
    };
    أرجع اختياري.لا_شيء();
}

// POST /api/load-test
عام عرف ابدأ_اختبار_الحمل(المتجر: &متجر, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    طابق اقرأ_جسون_بـ(الطلب, من_جسون__طلب_اختبار) مع
    | نتيجة.خطأ(الرفض) -> { أرجع الرفض; }
    | نتيجة.نجح(المطلوب) -> {
        ليكن السيناريو: سيناريو;
        طابق سيناريو_باسم(&(*المتجر).الكتالوج, &المطلوب.السيناريو) مع
        | اختياري.موجود(ق) -> { السيناريو := ق; }
        | اختياري.لا_شيء -> { أرجع رفض(422, «السيناريو واحد من: product, browse, search»); };
        إذا (المطلوب.الاتصالات < 1 || المطلوب.الاتصالات > 256) { أرجع رفض(422, «الاتصالات من 1 إلى 256»); };
        إذا (المطلوب.الثواني < 1 || المطلوب.الثواني > 30) { أرجع رفض(422, «المدة من 1 إلى 30 ثانية»); };
        ليكن الإعداد: إعداد_اختبار = {
            العنوان: استنسخ(&(*المتجر).العنوان),
            المسار: استنسخ(&السيناريو.المسار),
            المتوقع: استنسخ(&السيناريو.المتوقع),
            الاتصالات: المطلوب.الاتصالات مثل طبيعي,
            الثواني: المطلوب.الثواني مثل طبيعي
        };
        طابق ابدأ_اختبار(&(*المتجر).المختبر, الإعداد) مع
        | بدء_الاختبار.بدأ -> { }
        | بدء_الاختبار.جار_بالفعل -> { أرجع رفض(409, «اختبار آخر جار»); }
        | بدء_الاختبار.بلا_خيوط -> { أرجع رفض(503, «اختبار الحمل يحتاج خيوط النظام، وهي غير متاحة هنا (المفسر)»); };
        ليكن التقرير: تقرير_اختبار = تقرير_الاختبار(اقرأ_مشترك(&(*المتجر).المختبر));
        أرجع رد_جسون_من(202, &التقرير, جسون__تقرير_اختبار);
    };
}

// GET /api/load-test
عام عرف تقرير_الحمل(المتجر: &متجر, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة {
    ليكن التقرير: تقرير_اختبار = تقرير_الاختبار(اقرأ_مشترك(&(*المتجر).المختبر));
    أرجع رد_جسون_من(200, &التقرير, جسون__تقرير_اختبار);
}

// GET /api/load-test/events: التقرير كل ربع ثانية أثناء الاختبار، وكل
// ثانية في غيره، حتى يغادر العميل أو يطلب إيقاف الخادم.
عام عرف بث_الحمل(المتجر: &متجر, الطلب: &طلب, المعاملات: &معاملات_مسار, التدفق: &متغير تدفق_ويب): فراغ {
    ليكن المختبر: &مختبر_الحمل = اقرأ_مشترك(&(*المتجر).المختبر);
    طالما (!هل_طلب_إيقاف_الويب()) {
        ليكن التقرير: تقرير_اختبار = تقرير_الاختبار(المختبر);
        ليكن البيانات: نص = جسون__تقرير_اختبار(&التقرير);
        ليكن الحدث: متغير حدث = أنشئ_حدثا(&البيانات);
        ليكن النوع: نص = «report»;
        عين_نوع_حدث(&متغير الحدث, &النوع);
        إذا (!أرسل_حدثا(التدفق, &الحدث)) { أرجع; };
        ليكن المهلة: متغير عدد = 1000000000;
        إذا (هل_الاختبار_جار(المختبر)) { المهلة := 250000000; };
        ليكن انتظر: نتيجة عدد, عدد = نم_نانو(المهلة);
    }
}
