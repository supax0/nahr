// الكتالوج: المنتجات في الذاكرة، والبحث فيها.
//
// يولد الكتالوج مئة ألف منتج بمولد أرقام حتمي، فتتطابق البيانات في كل
// تشغيل. ويحضر عند البدء ما يجعل البحث سريعا، كما تفعل محركات البيانات
// العمودية: أعمدة متجاورة للأسعار والفئات والأسماء المطبعة للبحث، وأربعة
// ترتيبات جاهزة (الأحدث، الأرخص، الأغلى، الأعلى تقييما).
//
// والبحث النصي بفهرس مقلوب (inverted index) كمحركات البحث: لكل كلمة قائمة
// المنتجات التي تحويها، وتطابق كل كلمة في الاستعلام بداية كلمة في الاسم،
// فتجد «قهو» كل «قهوة». ثم يمر البحث على الترتيب المطلوب مرة واحدة: يطابق
// الفئة ونطاق السعر والنص، ويعد النتائج، ويقطع الصفحة المطلوبة.
من std.text استورد صل_النصوص, طبيعي_إلى_نص, استبدل_في_النص, نصان_متساويان, قسم_النص, يبدأ_بـ;
من std.collections استورد
    خريطة_نص_فهرس, أنشئ_خريطة_نص_فهرس, أدرج_في_خريطة_نص_فهرس, ابحث_في_خريطة_نص_فهرس,
    خطأ_إدراج_الخريطة, متجه_بسعة;
استورد std.collections.sort;

// ———————————————————————— الأنواع ————————————————————————

@@جسون
عام نوع منتج = {
    الرقم: عدد,
    الاسم: نص,
    الفئة: نص,
    العلامة: نص,
    السعر: عدد,
    التقييم: عدد,
    المخزون: عدد
};

@@جسون
عام نوع فئة = { الاسم: نص, العدد: عدد };

عام نوع ترتيب_منتجات =
    | الأحدث
    | الأرخص
    | الأغلى
    | الأعلى_تقييما
;

عام نوع استعلام_منتجات = {
    النص: نص,
    الفئة: اختياري طبيعي,
    أدنى_سعر: عدد,
    أعلى_سعر: عدد,
    الترتيب: ترتيب_منتجات,
    الصفحة: طبيعي,
    الحجم: طبيعي
};

@@جسون
عام نوع صفحة_منتجات = {
    الإجمالي: عدد,
    الصفحة: عدد,
    الصفحات: عدد,
    المنتجات: متجه منتج
};

عام نوع كتالوج = {
    المنتجات: متجه منتج,
    // أعمدة البحث: العنصر ف في كل عمود للمنتج ف.
    الأسعار: متجه عدد,
    فئة_المنتج: متجه طبيعي,
    // مواضع المنتجات بكل ترتيب، بترتيب أنواع ترتيب_منتجات.
    الترتيبات: متجه متجه طبيعي,
    // الفهرس المقلوب: الكلمة ف في المفردات تظهر في المنتجات المواضع[ف].
    المفردات: متجه نص,
    المواضع: متجه متجه طبيعي,
    الفئات: متجه فئة
};

// ———————————————————————— بيانات التوليد ————————————————————————

عرف أسماء_الفئات(): متجه نص {
    ليكن الناتج: متجه نص = [
        «إلكترونيات», «أجهزة منزلية», «أثاث», «قهوة وشاي»,
        «كتب», «رياضة», «عناية شخصية», «ألعاب»
    ];
    أرجع الناتج;
}

// أصناف كل فئة، بالترتيب نفسه لأسماء_الفئات.
عرف أصناف_الفئة(الفئة: طبيعي): متجه نص {
    إذا (الفئة == 0) { ليكن ن: متجه نص = [«سماعة رأس لاسلكية», «شاحن سريع», «لوحة مفاتيح ميكانيكية», «فأرة لاسلكية», «شاشة عرض», «مكبر صوت محمول»]; أرجع ن; };
    إذا (الفئة == 1) { ليكن ن: متجه نص = [«غلاية كهربائية», «مكنسة لاسلكية», «خلاط», «مكواة بخار», «منقي هواء», «قلاية هوائية»]; أرجع ن; };
    إذا (الفئة == 2) { ليكن ن: متجه نص = [«كرسي مكتب», «طاولة قهوة», «رف كتب», «مكتب خشبي», «أريكة صغيرة», «خزانة جانبية»]; أرجع ن; };
    إذا (الفئة == 3) { ليكن ن: متجه نص = [«قهوة عربية», «قهوة مختصة», «شاي أخضر», «شاي أسود», «دلة قهوة», «مطحنة قهوة»]; أرجع ن; };
    إذا (الفئة == 4) { ليكن ن: متجه نص = [«رواية», «كتاب طبخ», «كتاب تاريخ», «ديوان شعر», «كتاب برمجة», «قصص أطفال»]; أرجع ن; };
    إذا (الفئة == 5) { ليكن ن: متجه نص = [«حذاء جري», «سجادة يوغا», «دمبل», «دراجة ثابتة», «حبل قفز», «حقيبة رياضية»]; أرجع ن; };
    إذا (الفئة == 6) { ليكن ن: متجه نص = [«عطر», «كريم مرطب», «شامبو», «ماكينة حلاقة», «فرشاة أسنان كهربائية», «مجفف شعر»]; أرجع ن; };
    ليكن ن: متجه نص = [«لعبة تركيب», «سيارة تحكم», «لغز خشبي», «لعبة لوحية», «دمية», «طائرة ورقية»];
    أرجع ن;
}

عرف العلامات(): متجه نص {
    ليكن الناتج: متجه نص = [
        «نوفا», «أفق», «سراج», «رمال», «نخيل», «واحة»,
        «بريق», «زمرد», «مدار», «قمة», «صقر», «لؤلؤ»
    ];
    أرجع الناتج;
}

عرف الإصدارات(): متجه نص {
    ليكن الناتج: متجه نص = [«برو», «لايت», «ماكس», «بلس», «ميني», «إير», «ألترا», «كلاسيك»];
    أرجع الناتج;
}

// مولد بارك وميلر: حتمي، ولا يتجاوز حاصل ضربه 2^47 فلا يفيض.
عرف التالي_عشوائيا(البذرة: &متغير عدد): عدد {
    *البذرة := (*البذرة * 48271) % 2147483647;
    أرجع *البذرة;
}

عرف عشوائي_حتى(البذرة: &متغير عدد, الحد: عدد): عدد {
    أرجع التالي_عشوائيا(البذرة) % الحد;
}

// ———————————————————————— التطبيع للبحث ————————————————————————

// يوحد صور الحروف التي يكتبها الناس بطرق مختلفة، فيجد «اسعار» ما كتب
// «أسعار»: الهمزات على الألف، والتاء المربوطة، والألف المقصورة، والتطويل.
عام عرف طبع_للبحث(النص: &نص): نص {
    ليكن الناتج: متغير نص = استنسخ(النص);
    ليكن الصور: متجه نص = [«أ», «إ», «آ», «ة», «ى», «ـ»];
    ليكن البدائل: متجه نص = [«ا», «ا», «ا», «ه», «ي», «»];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الصور) مثل طبيعي)) {
        الناتج := استبدل_في_النص(&الناتج, &الصور[ف], &البدائل[ف]);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// كلمات النص بعد تطبيعه، بلا فراغات.
عام عرف كلمات_للبحث(النص: &نص): متجه نص {
    ليكن المطبع: نص = طبع_للبحث(النص);
    ليكن فراغ_بينها: نص = « »;
    ليكن الأجزاء: متجه نص = قسم_النص(&المطبع, &فراغ_بينها);
    ليكن الناتج: متغير متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
        إذا ((الطول(الأجزاء[ف]) مثل طبيعي) > 0) { ألحق(الناتج, استنسخ(&الأجزاء[ف])); };
        ف := ف + 1;
    }
    أرجع الناتج;
}

// يضيف كلمات اسم المنتج إلى الفهرس المقلوب.
عرف فهرس_الاسم(
    المفردات: &متغير متجه نص,
    المواضع: &متغير متجه متجه طبيعي,
    الأرقام: &متغير خريطة_نص_فهرس,
    الاسم: &نص,
    الموضع: طبيعي
): فراغ {
    ليكن الكلمات: متجه نص = كلمات_للبحث(الاسم);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الكلمات) مثل طبيعي)) {
        ليكن الرقم: متغير طبيعي = 0;
        طابق ابحث_في_خريطة_نص_فهرس(الأرقام, &الكلمات[ف]) مع
        | اختياري.موجود(الموجود) -> { الرقم := الموجود; }
        | اختياري.لا_شيء -> {
            الرقم := الطول(*المفردات) مثل طبيعي;
            ألحق(*المفردات, استنسخ(&الكلمات[ف]));
            ليكن فارغة: متجه طبيعي = [];
            ألحق(*المواضع, فارغة);
            ليكن تجاهل: نتيجة اختياري طبيعي, خطأ_إدراج_الخريطة =
                أدرج_في_خريطة_نص_فهرس(الأرقام, استنسخ(&الكلمات[ف]), الرقم);
        };
        // كلمة تتكرر في الاسم نفسه تضاف مرة واحدة.
        ليكن القائمة: &متغير متجه طبيعي = &متغير (*المواضع)[الرقم];
        ليكن العدد: طبيعي = الطول(*القائمة) مثل طبيعي;
        إذا (العدد == 0 || (*القائمة)[العدد - 1] != الموضع) { ألحق(*القائمة, الموضع); };
        ف := ف + 1;
    }
}

// ———————————————————————— بناء الكتالوج ————————————————————————

// ترتيب مسبق لأرقام المنتجات حسب مفتاح: يرمز المفتاح والموضع في عدد
// واحد (المفتاح × 2^20 + الموضع) ثم يرتب الأعداد.
عرف رتب_حسب_مفتاح(المفاتيح: &متجه عدد): متجه طبيعي {
    ليكن المرمزة: متغير متجه عدد = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*المفاتيح) مثل طبيعي)) {
        ألحق(المرمزة, (*المفاتيح)[ف] * 1048576 + (ف مثل عدد));
        ف := ف + 1;
    }
    رتب_عدد(&متغير المرمزة);
    ليكن الناتج: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < (الطول(المرمزة) مثل طبيعي)) {
        ألحق(الناتج, (المرمزة[ف] % 1048576) مثل طبيعي);
        ف := ف + 1;
    }
    أرجع الناتج;
}

// كتالوج من العدد المطلوب من المنتجات، يتطابق في كل تشغيل.
عام عرف ابن_كتالوجا(العدد: طبيعي): كتالوج {
    ليكن الفئات_نصوص: متجه نص = أسماء_الفئات();
    ليكن العلامات_نصوص: متجه نص = العلامات();
    ليكن الإصدارات_نصوص: متجه نص = الإصدارات();
    ليكن الأصناف: متغير متجه متجه نص = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الفئات_نصوص) مثل طبيعي)) { ألحق(الأصناف, أصناف_الفئة(ف)); ف := ف + 1; }

    ليكن المنتجات: متغير متجه منتج = [];
    ليكن المفردات: متغير متجه نص = [];
    ليكن المواضع: متغير متجه متجه طبيعي = [];
    ليكن أرقام_المفردات: متغير خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    ليكن فئة_المنتج: متغير متجه طبيعي = [];
    ليكن أعداد_الفئات: متغير متجه عدد = [0, 0, 0, 0, 0, 0, 0, 0];
    ليكن مفاتيح_السعر: متغير متجه عدد = [];
    ليكن مفاتيح_التقييم: متغير متجه عدد = [];
    ليكن البذرة: متغير عدد = 20261110;
    ليكن فاصل: نص = « »;
    ف := 0;
    طالما (ف < العدد) {
        ليكن الفئة: طبيعي = عشوائي_حتى(&متغير البذرة, الطول(الفئات_نصوص) مثل عدد) مثل طبيعي;
        ليكن الصنف: طبيعي = عشوائي_حتى(&متغير البذرة, الطول(الأصناف[الفئة]) مثل عدد) مثل طبيعي;
        ليكن العلامة: طبيعي = عشوائي_حتى(&متغير البذرة, الطول(العلامات_نصوص) مثل عدد) مثل طبيعي;
        ليكن الإصدار: طبيعي = عشوائي_حتى(&متغير البذرة, الطول(الإصدارات_نصوص) مثل عدد) مثل طبيعي;
        ليكن الطراز: طبيعي = (عشوائي_حتى(&متغير البذرة, 20) + 1) مثل طبيعي;
        ليكن أجزاء_الاسم: متجه نص = [
            استنسخ(&الأصناف[الفئة][الصنف]), استنسخ(&العلامات_نصوص[العلامة]),
            استنسخ(&الإصدارات_نصوص[الإصدار]), طبيعي_إلى_نص(الطراز)
        ];
        ليكن الاسم: نص = صل_النصوص(&أجزاء_الاسم, &فاصل);
        ليكن السعر: عدد = 15 + عشوائي_حتى(&متغير البذرة, 2986);
        ليكن التقييم: عدد = 25 + عشوائي_حتى(&متغير البذرة, 26);
        ليكن الجديد: منتج = {
            الرقم: (ف مثل عدد) + 1,
            الاسم: الاسم,
            الفئة: استنسخ(&الفئات_نصوص[الفئة]),
            العلامة: استنسخ(&العلامات_نصوص[العلامة]),
            السعر: السعر,
            التقييم: التقييم,
            المخزون: عشوائي_حتى(&متغير البذرة, 500)
        };
        فهرس_الاسم(&متغير المفردات, &متغير المواضع, &متغير أرقام_المفردات, &الجديد.الاسم, ف);
        ألحق(المنتجات, الجديد);
        ألحق(فئة_المنتج, الفئة);
        أعداد_الفئات[الفئة] := أعداد_الفئات[الفئة] + 1;
        ألحق(مفاتيح_السعر, السعر);
        // الأعلى تقييما أولا: المفتاح الأصغر للتقييم الأعلى.
        ألحق(مفاتيح_التقييم, 100 - التقييم);
        ف := ف + 1;
    }

    // الترتيبات الأربعة: الأحدث عكس الإدخال، والأغلى عكس الأرخص.
    ليكن الأرخص: متجه طبيعي = رتب_حسب_مفتاح(&مفاتيح_السعر);
    ليكن الأحدث: متغير متجه طبيعي = [];
    ليكن الأغلى: متغير متجه طبيعي = [];
    ف := 0;
    طالما (ف < العدد) {
        ألحق(الأحدث, العدد - 1 - ف);
        ألحق(الأغلى, الأرخص[العدد - 1 - ف]);
        ف := ف + 1;
    }
    ليكن الترتيبات: متجه متجه طبيعي = [الأحدث, الأرخص, الأغلى, رتب_حسب_مفتاح(&مفاتيح_التقييم)];

    ليكن الفئات: متغير متجه فئة = [];
    ف := 0;
    طالما (ف < (الطول(الفئات_نصوص) مثل طبيعي)) {
        ليكن الجديدة: فئة = { الاسم: استنسخ(&الفئات_نصوص[ف]), العدد: أعداد_الفئات[ف] };
        ألحق(الفئات, الجديدة);
        ف := ف + 1;
    }
    ليكن الناتج: كتالوج = {
        المنتجات: المنتجات,
        الأسعار: مفاتيح_السعر,
        فئة_المنتج: فئة_المنتج,
        الترتيبات: الترتيبات,
        المفردات: المفردات,
        المواضع: المواضع,
        الفئات: الفئات
    };
    أرجع الناتج;
}

// ———————————————————————— القراءة والبحث ————————————————————————

عام عرف عدد_المنتجات(الكتالوج: &كتالوج): طبيعي {
    أرجع الطول((*الكتالوج).المنتجات) مثل طبيعي;
}

// المنتج برقمه (يبدأ من 1).
عام عرف منتج_برقم(الكتالوج: &كتالوج, الرقم: عدد): اختياري منتج {
    إذا (الرقم < 1 || الرقم > (عدد_المنتجات(الكتالوج) مثل عدد)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(استنسخ(&(*الكتالوج).المنتجات[(الرقم - 1) مثل طبيعي]));
}

// رقم الفئة باسمها.
عام عرف فئة_باسم(الكتالوج: &كتالوج, الاسم: &نص): اختياري طبيعي {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*الكتالوج).الفئات) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الكتالوج).الفئات[ف].الاسم, الاسم)) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// لكل منتج: كم كلمة من الاستعلام تطابق بداية كلمة في اسمه. يطابق المنتج
// النص حين تطابق كل الكلمات (حتى 255 كلمة). يعلم المنتج للكلمة ك فقط إن
// طابق الكلمات قبلها، فتكون النتيجة تقاطع قوائم الكلمات.
عرف علم_المطابقة_النصية(الكتالوج: &كتالوج, الكلمات: &متجه نص): متجه ط8 {
    ليكن العلامات: متغير متجه ط8 = [];
    إذا ((الطول(*الكلمات) مثل طبيعي) == 0) { أرجع العلامات; };
    ليكن العدد: طبيعي = عدد_المنتجات(الكتالوج);
    العلامات := متجه_بسعة(العدد);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) { ألحق(العلامات, 0); ف := ف + 1; }
    ليكن ك: متغير طبيعي = 0;
    طالما (ك < (الطول(*الكلمات) مثل طبيعي) && ك < 255) {
        ليكن السابقة: ط8 = ك مثل ط8;
        ليكن ع: متغير طبيعي = 0;
        طالما (ع < (الطول((*الكتالوج).المفردات) مثل طبيعي)) {
            إذا (يبدأ_بـ(&(*الكتالوج).المفردات[ع], &(*الكلمات)[ك])) {
                ليكن القائمة: &متجه طبيعي = &(*الكتالوج).المواضع[ع];
                ليكن ق: متغير طبيعي = 0;
                طالما (ق < (الطول(*القائمة) مثل طبيعي)) {
                    ليكن م: طبيعي = (*القائمة)[ق];
                    إذا (العلامات[م] == السابقة) { العلامات[م] := السابقة + 1; };
                    ق := ق + 1;
                }
            };
            ع := ع + 1;
        }
        ك := ك + 1;
    }
    أرجع العلامات;
}

عرف رقم_الترتيب(الترتيب: &ترتيب_منتجات): طبيعي {
    طابق *الترتيب مع
    | ترتيب_منتجات.الأحدث -> { أرجع 0; }
    | ترتيب_منتجات.الأرخص -> { أرجع 1; }
    | ترتيب_منتجات.الأغلى -> { أرجع 2; }
    | ترتيب_منتجات.الأعلى_تقييما -> { أرجع 3; };
}

// يمسح الكتالوج كله: يعد كل ما يطابق، ويجمع منتجات الصفحة المطلوبة.
عام عرف ابحث_في_الكتالوج(الكتالوج: &كتالوج, الاستعلام: &استعلام_منتجات): صفحة_منتجات {
    // كل ما تحتاجه الحلقة يقرأ مرة واحدة قبلها.
    ليكن الترتيب: &متجه طبيعي = &(*الكتالوج).الترتيبات[رقم_الترتيب(&(*الاستعلام).الترتيب)];
    ليكن الأسعار: &متجه عدد = &(*الكتالوج).الأسعار;
    ليكن الفئات: &متجه طبيعي = &(*الكتالوج).فئة_المنتج;
    ليكن الكلمات: متجه نص = كلمات_للبحث(&(*الاستعلام).النص);
    ليكن بنص: منطقي = (الطول(الكلمات) مثل طبيعي) > 0;
    ليكن العلامات: متجه ط8 = علم_المطابقة_النصية(الكتالوج, &الكلمات);
    ليكن كل_الكلمات: ط8 = الطول(الكلمات) مثل ط8;
    ليكن بفئة: متغير منطقي = خطأ;
    ليكن الفئة: متغير طبيعي = 0;
    طابق (*الاستعلام).الفئة مع
    | اختياري.موجود(القيمة) -> { بفئة := صواب; الفئة := القيمة; }
    | اختياري.لا_شيء -> { };
    ليكن الأدنى: عدد = (*الاستعلام).أدنى_سعر;
    ليكن الأعلى: عدد = (*الاستعلام).أعلى_سعر;
    ليكن البداية: طبيعي = ((*الاستعلام).الصفحة - 1) * (*الاستعلام).الحجم;
    ليكن النهاية: طبيعي = البداية + (*الاستعلام).الحجم;

    ليكن المطابقة: متغير طبيعي = 0;
    ليكن الصفحة: متغير متجه منتج = [];
    ليكن العدد: طبيعي = الطول(*الترتيب) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن م: طبيعي = (*الترتيب)[ف];
        // الشروط الأرخص أولا: الفئة، ثم السعر، ثم النص.
        إذا ((!بفئة || (*الفئات)[م] == الفئة)
            && (*الأسعار)[م] >= الأدنى && (*الأسعار)[م] <= الأعلى
            && (!بنص || العلامات[م] == كل_الكلمات)) {
            إذا (المطابقة >= البداية && المطابقة < النهاية) {
                ألحق(الصفحة, استنسخ(&(*الكتالوج).المنتجات[م]));
            };
            المطابقة := المطابقة + 1;
        };
        ف := ف + 1;
    }
    ليكن الحجم: طبيعي = (*الاستعلام).الحجم;
    ليكن الناتج: صفحة_منتجات = {
        الإجمالي: المطابقة مثل عدد,
        الصفحة: (*الاستعلام).الصفحة مثل عدد,
        الصفحات: ((المطابقة + الحجم - 1) / الحجم) مثل عدد,
        المنتجات: الصفحة
    };
    أرجع الناتج;
}
