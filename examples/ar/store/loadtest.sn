// اختبار الحمل: يرسل طلبات HTTP/1.1 إلى الخادم من اتصالات كثيرة في آن
// واحد، ويقيس عدد الطلبات وزمن كل طلب، كما تفعل أدوات مثل wrk وoha.
//
// لكل اتصال خيط خاص به يبقي اتصاله مفتوحا (keep-alive): يرسل طلبا، وينتظر
// الرد كاملا، ثم يرسل التالي، حتى ينتهي الوقت. تجمع الأزمنة في مدرج
// تكراري لوغاريتمي (أربع خانات لكل ضعف) تقرأ منه النسب المئوية p50 وp99
// دون حفظ كل زمن.
//
// لا يعد الطلب ناجحا إلا إن كانت حالته 2xx وجسمه مطابقا بايتا ببايت للجسم
// المتوقع، الذي يحسبه المتصل قبل الاختبار. ويعد التقرير الاتصالات التي
// فتحت فعلا، فيظهر اختبار فتح اتصالات أقل مما طلب.
//
// المولد والخادم في عملية واحدة على جهاز واحد، فيتقاسمان المعالج: النتيجة
// أقل مما يعطيه مولد في عملية أخرى (bench/store.sh) أو على جهاز آخر، ولا
// تصلح للمقارنة بأطر أخرى.
من std.text استورد صل_النصوص, بايتات_من_نص, طبيعي_إلى_نص, عدد_إلى_نص;
من std.time استورد وقت_رتيب_نانو, نم_نانو;
من std.net استورد
    عنوان_مقبس, حلل_عنوان_مقبس, تدفق_تي_سي_بي, خيار_مقبس,
    اتصل_تي_سي_بي_بخيارات, اقرأ_تي_سي_بي, اكتب_تي_سي_بي, أغلق_تدفق_تي_سي_بي;
من std.sync استورد
    ذرة_ط64, أنشئ_ذرة_ط64, احمل_ط64, اخزن_ط64, اجمع_واجلب_ط64, قارن_وبدّل_ط64, ترتيب_ذاكرة,
    مشترك, استنسخ_مشترك, اقرأ_مشترك;
من std.thread استورد أطلق, انضم, مقبض_خيط;
من std.http استورد هل_طلب_إيقاف_الويب;
من نهر.سجلات استورد سجل_معلومة, أوقف_سجل_الوصول_مؤقتا, استأنف_سجل_الوصول;

// ———————————————————————— الأنواع ————————————————————————

عام نوع إعداد_اختبار = {
    العنوان: نص,
    المسار: نص,
    // جسم الرد الصحيح، يقارن به كل رد.
    المتوقع: متجه ط8,
    الاتصالات: طبيعي,
    الثواني: طبيعي
};

// ما انتهى إليه طلب واحد.
نوع نتيجة_رد =
    | سليم        // حالة 2xx والجسم المتوقع
    | خاطئ        // رد كامل بحالة أخرى أو جسم آخر
    | منقطع       // خطأ في الشبكة أو اتصال مغلق
;

// ما تعرضه الصفحة عن الاختبار الجاري أو الأخير.
@@جسون
عام نوع تقرير_اختبار = {
    الحالة: نص,
    الاتصالات: عدد,
    الثواني: عدد,
    المنقضي_بالمللي: عدد,
    الاتصالات_المفتوحة: عدد,
    الطلبات: عدد,
    الردود_الخاطئة: عدد,
    أخطاء_الشبكة: عدد,
    في_الثانية: عدد,
    الوسيط_بالمكرو: عدد,
    ص99_بالمكرو: عدد
};

// حالة المختبر، مشتركة بين خيوطه وبين معالجات الطلبات. كل حقل ذري،
// فلا يحتاج القارئ ولا الكاتب قفلا.
عام نوع مختبر_الحمل = {
    الحالة: ذرة_ط64,
    الاتصالات: ذرة_ط64,
    الثواني: ذرة_ط64,
    المفتوحة: ذرة_ط64,
    الطلبات: ذرة_ط64,
    الخاطئة: ذرة_ط64,
    الأخطاء: ذرة_ط64,
    البداية: ذرة_ط64,
    النهاية: ذرة_ط64,
    المدرج: متجه ذرة_ط64
};

دع خاملا: ط64 = 0;
دع جاريا: ط64 = 1;
دع منتهيا: ط64 = 2;
دع عدد_الخانات: طبيعي = 128;

عام عرف مختبر_جديد(): مختبر_الحمل {
    دع المدرج: متغير متجه ذرة_ط64 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الخانات) { ألحق(المدرج, أنشئ_ذرة_ط64(0 مثل ط64)); ف := ف + 1; }
    دع الناتج: مختبر_الحمل = {
        الحالة: أنشئ_ذرة_ط64(خاملا),
        الاتصالات: أنشئ_ذرة_ط64(0 مثل ط64),
        الثواني: أنشئ_ذرة_ط64(0 مثل ط64),
        المفتوحة: أنشئ_ذرة_ط64(0 مثل ط64),
        الطلبات: أنشئ_ذرة_ط64(0 مثل ط64),
        الخاطئة: أنشئ_ذرة_ط64(0 مثل ط64),
        الأخطاء: أنشئ_ذرة_ط64(0 مثل ط64),
        البداية: أنشئ_ذرة_ط64(0 مثل ط64),
        النهاية: أنشئ_ذرة_ط64(0 مثل ط64),
        المدرج: المدرج
    };
    أرجع الناتج;
}

// ———————————————————————— الوقت والمدرج ————————————————————————

عرف الآن(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(ن) -> { أرجع ن; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

// خانة زمن بالمكروثانية: أربع خانات لكل ضعف، فالخطأ أقل من ربع القيمة.
عرف خانة_الزمن(المكرو: عدد): طبيعي {
    دع ق: عدد = المكرو + 1;
    إذا (ق < 4) { أرجع ق مثل طبيعي; };
    دع الأس: متغير عدد = 2;
    طالما ((ق >> (الأس + 1)) > 0) { الأس := الأس + 1; }
    دع الكسر: عدد = (ق >> (الأس - 2)) & 3;
    دع الخانة: طبيعي = (الأس * 4 + الكسر) مثل طبيعي;
    إذا (الخانة >= عدد_الخانات) { أرجع عدد_الخانات - 1; };
    أرجع الخانة;
}

// الحد الأعلى لأزمنة الخانة، بالمكروثانية.
عرف أعلى_الخانة(الخانة: طبيعي): عدد {
    إذا (الخانة < 4) { أرجع الخانة مثل عدد; };
    دع الأس: عدد = (الخانة / 4) مثل عدد;
    دع الكسر: عدد = (الخانة % 4) مثل عدد;
    أرجع ((4 + الكسر + 1) << (الأس - 2)) - 2;
}

// الزمن الذي يقل عنه الجزء المطلوب من الطلبات (بالألف: 500 للوسيط).
عرف نسبة_مئوية(المختبر: &مختبر_الحمل, بالألف: عدد): عدد {
    دع المجموع: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الخانات) {
        المجموع := المجموع + (احمل_ط64(&(*المختبر).المدرج[ف], ترتيب_ذاكرة.مسترخ()) مثل عدد);
        ف := ف + 1;
    }
    إذا (المجموع == 0) { أرجع 0; };
    دع الهدف: عدد = (المجموع * بالألف + 999) / 1000;
    دع المتراكم: متغير عدد = 0;
    ف := 0;
    طالما (ف < عدد_الخانات) {
        المتراكم := المتراكم + (احمل_ط64(&(*المختبر).المدرج[ف], ترتيب_ذاكرة.مسترخ()) مثل عدد);
        إذا (المتراكم >= الهدف) { أرجع أعلى_الخانة(ف); };
        ف := ف + 1;
    }
    أرجع أعلى_الخانة(عدد_الخانات - 1);
}

// ———————————————————————— طلب واحد ————————————————————————

عرف طلب_بايتات(المسار: &نص): متجه ط8 {
    دع الأجزاء: متجه نص = [«GET », استنسخ(المسار), " HTTP/1.1\r\nHost: 127.0.0.1\r\nUser-Agent: nahr-load\r\n\r\n"];
    دع لا_شيء: نص = «»;
    أرجع بايتات_من_نص(صل_النصوص(&الأجزاء, &لا_شيء));
}

عرف اكتب_كله(التدفق: &تدفق_تي_سي_بي, البايتات: &متجه ط8): منطقي {
    دع المكتوب: متغير عدد = 0;
    دع الكل: عدد = الطول(*البايتات) مثل عدد;
    طالما (المكتوب < الكل) {
        طابق اكتب_تي_سي_بي(التدفق, البايتات, المكتوب, الكل - المكتوب) مع
        | نتيجة.نجح(ن) -> { إذا (ن <= 0) { أرجع خطأ; }; المكتوب := المكتوب + ن; }
        | نتيجة.خطأ(_) -> { أرجع خطأ; };
    }
    أرجع صواب;
}

عرف حرف_صغير(البايت: ط8): ط8 {
    إذا (البايت >= 0x41 && البايت <= 0x5A) { أرجع البايت + 0x20; };
    أرجع البايت;
}

// هل يبدأ السطر عند الموضع باسم الرأس (بلا تفريق بين الحالتين)؟
عرف يبدأ_برأس(المخزن: &متجه ط8, الموضع: طبيعي, النهاية: طبيعي, الاسم: &متجه ط8): منطقي {
    دع الطول_المطلوب: طبيعي = الطول(*الاسم) مثل طبيعي;
    إذا (الموضع + الطول_المطلوب > النهاية) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_المطلوب) {
        إذا (حرف_صغير((*المخزن)[الموضع + ف]) != (*الاسم)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// طول الجسم من رأس Content-Length في الرؤوس [0، النهاية).
عرف طول_الجسم(المخزن: &متجه ط8, النهاية: طبيعي): طبيعي {
    دع الاسم: متجه ط8 = بايتات_من_نص("\ncontent-length:");
    دع ف: متغير طبيعي = 0;
    طالما (ف < النهاية) {
        إذا (يبدأ_برأس(المخزن, ف, النهاية, &الاسم)) {
            دع ك: متغير طبيعي = ف + (الطول(الاسم) مثل طبيعي);
            طالما (ك < النهاية && (*المخزن)[ك] == 0x20) { ك := ك + 1; }
            دع القيمة: متغير طبيعي = 0;
            طالما (ك < النهاية && (*المخزن)[ك] >= 0x30 && (*المخزن)[ك] <= 0x39) {
                القيمة := القيمة * 10 + (((*المخزن)[ك] - 0x30) مثل طبيعي);
                ك := ك + 1;
            }
            أرجع القيمة;
        };
        ف := ف + 1;
    }
    أرجع 0;
}

// نهاية الرؤوس (بعد \r\n\r\n) إن وصلت.
عرف نهاية_الرؤوس(المخزن: &متجه ط8, المقروء: طبيعي): اختياري طبيعي {
    إذا (المقروء < 4) { أرجع اختياري.لا_شيء(); };
    دع ف: متغير طبيعي = 0;
    طالما (ف + 3 < المقروء) {
        إذا ((*المخزن)[ف] == 0x0D && (*المخزن)[ف + 1] == 0x0A && (*المخزن)[ف + 2] == 0x0D && (*المخزن)[ف + 3] == 0x0A) {
            أرجع اختياري.موجود(ف + 4);
        };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

// هل الجسم [البداية، النهاية) هو المتوقع بايتا ببايت؟
عرف جسم_مطابق(المخزن: &متجه ط8, البداية: طبيعي, النهاية: طبيعي, المتوقع: &متجه ط8): منطقي {
    دع الطول_المتوقع: طبيعي = الطول(*المتوقع) مثل طبيعي;
    إذا (النهاية - البداية != الطول_المتوقع) { أرجع خطأ; };
    دع ف: متغير طبيعي = 0;
    طالما (ف < الطول_المتوقع) {
        إذا ((*المخزن)[البداية + ف] != (*المتوقع)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// يقرأ ردا واحدا كاملا ويحكم عليه: سليم إن كانت حالته 2xx وجسمه المتوقع.
عرف اقرأ_ردا(التدفق: &تدفق_تي_سي_بي, المخزن: &متغير متجه ط8, المتوقع: &متجه ط8): نتيجة_رد {
    دع السعة: عدد = الطول(*المخزن) مثل عدد;
    دع المقروء: متغير عدد = 0;
    دع الرؤوس: متغير اختياري طبيعي = اختياري.لا_شيء();
    دع الكامل: متغير طبيعي = 0;
    طالما (صواب) {
        إذا (المقروء >= السعة) { أرجع نتيجة_رد.منقطع(); };
        طابق اقرأ_تي_سي_بي(التدفق, المخزن, المقروء, السعة - المقروء) مع
        | نتيجة.خطأ(_) -> { أرجع نتيجة_رد.منقطع(); }
        | نتيجة.نجح(ن) -> { إذا (ن <= 0) { أرجع نتيجة_رد.منقطع(); }; المقروء := المقروء + ن; };
        طابق الرؤوس مع
        | اختياري.موجود(_) -> { }
        | اختياري.لا_شيء -> {
            طابق نهاية_الرؤوس(المخزن, المقروء مثل طبيعي) مع
            | اختياري.موجود(النهاية) -> {
                الرؤوس := اختياري.موجود(النهاية);
                الكامل := النهاية + طول_الجسم(المخزن, النهاية);
            }
            | اختياري.لا_شيء -> { };
        };
        طابق الرؤوس مع
        | اختياري.موجود(بداية_الجسم) -> {
            إذا ((المقروء مثل طبيعي) >= الكامل) {
                // «HTTP/1.1 200»: رقم الحالة الأول في الموضع 9.
                دع حالة_ناجحة: منطقي = المقروء > 9 && (*المخزن)[9] == 0x32;
                إذا (حالة_ناجحة && جسم_مطابق(المخزن, بداية_الجسم, الكامل, المتوقع)) { أرجع نتيجة_رد.سليم(); };
                أرجع نتيجة_رد.خاطئ();
            };
        }
        | اختياري.لا_شيء -> { };
    }
    أرجع نتيجة_رد.منقطع();
}

// ———————————————————————— الخيوط ————————————————————————

عرف زد(الذرة: &ذرة_ط64): فراغ {
    دع تجاهل: ط64 = اجمع_واجلب_ط64(الذرة, 1 مثل ط64, ترتيب_ذاكرة.مسترخ());
}

// يعد الطلب في خانته: الناجح وحده يدخل المدرج وعدد الطلبات.
عرف سجل_طلبا(المختبر: &مختبر_الحمل, البداية: عدد, النتيجة: نتيجة_رد): فراغ {
    طابق النتيجة مع
    | نتيجة_رد.منقطع -> { زد(&(*المختبر).الأخطاء); أرجع; }
    | نتيجة_رد.خاطئ -> { زد(&(*المختبر).الخاطئة); أرجع; }
    | نتيجة_رد.سليم -> { };
    دع الخانة: طبيعي = خانة_الزمن((الآن() - البداية) / 1000);
    زد(&(*المختبر).المدرج[الخانة]);
    زد(&(*المختبر).الطلبات);
}

// اتصال واحد: يتصل، ويرسل طلبا بعد طلب حتى الموعد، ويعيد الاتصال إن انقطع.
عرف عامل_اتصال(المشترك: مشترك<مختبر_الحمل>, العنوان: عنوان_مقبس, الطلب: متجه ط8, المتوقع: متجه ط8, الموعد: عدد): فراغ {
    دع المختبر: &مختبر_الحمل = اقرأ_مشترك(&المشترك);
    دع المخزن: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < 262144) { ألحق(المخزن, 0); ف := ف + 1; }
    // بلا تأخير Nagle، ومهلة قراءة ثانيتين: لا يعلق اتصال بعد الموعد.
    دع الخيارات: متجه خيار_مقبس = [خيار_مقبس.بلا_تأخير_تي_سي_بي(صواب), خيار_مقبس.مهلة_استقبال(2000)];
    دع فتح_مرة: متغير منطقي = خطأ;
    طالما (الآن() < الموعد && !هل_طلب_إيقاف_الويب()) {
        طابق اتصل_تي_سي_بي_بخيارات(&العنوان, &الخيارات) مع
        | نتيجة.خطأ(_) -> {
            سجل_طلبا(المختبر, 0, نتيجة_رد.منقطع());
            دع انتظر: نتيجة عدد, عدد = نم_نانو(10000000);
        }
        | نتيجة.نجح(التدفق) -> {
            إذا (!فتح_مرة) { فتح_مرة := صواب; زد(&(*المختبر).المفتوحة); };
            دع متصل: متغير منطقي = صواب;
            طالما (متصل && الآن() < الموعد && !هل_طلب_إيقاف_الويب()) {
                دع البداية: عدد = الآن();
                دع النتيجة: متغير نتيجة_رد = نتيجة_رد.منقطع();
                إذا (اكتب_كله(&التدفق, &الطلب)) { النتيجة := اقرأ_ردا(&التدفق, &متغير المخزن, &المتوقع); };
                سجل_طلبا(المختبر, البداية, استنسخ(&النتيجة));
                طابق النتيجة مع
                | نتيجة_رد.منقطع -> { متصل := خطأ; }
                | _ -> { };
            }
            دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
        };
    }
}

عرف صفر_العدادات(المختبر: &مختبر_الحمل): فراغ {
    اخزن_ط64(&(*المختبر).المفتوحة, 0 مثل ط64, ترتيب_ذاكرة.مسترخ());
    اخزن_ط64(&(*المختبر).الطلبات, 0 مثل ط64, ترتيب_ذاكرة.مسترخ());
    اخزن_ط64(&(*المختبر).الخاطئة, 0 مثل ط64, ترتيب_ذاكرة.مسترخ());
    اخزن_ط64(&(*المختبر).الأخطاء, 0 مثل ط64, ترتيب_ذاكرة.مسترخ());
    دع ف: متغير طبيعي = 0;
    طالما (ف < عدد_الخانات) { اخزن_ط64(&(*المختبر).المدرج[ف], 0 مثل ط64, ترتيب_ذاكرة.مسترخ()); ف := ف + 1; }
}

// يدير الاختبار كله في خيط خاص: يطلق خيوط الاتصالات، وينتظرها، ويسجل
// ملخصا واحدا بدل سطر لكل طلب.
عرف أدر_الاختبار(المشترك: مشترك<مختبر_الحمل>, الإعداد: إعداد_اختبار): فراغ {
    دع المختبر: &مختبر_الحمل = اقرأ_مشترك(&المشترك);
    دع العنوان: عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&الإعداد.العنوان) مع
    | نتيجة.نجح(ع) -> { العنوان := ع; }
    | نتيجة.خطأ(_) -> { اخزن_ط64(&(*المختبر).الحالة, منتهيا, ترتيب_ذاكرة.تسلسلي()); أرجع; };
    دع الطلب: متجه ط8 = طلب_بايتات(&الإعداد.المسار);
    دع الموعد: عدد = الآن() + (الإعداد.الثواني مثل عدد) * 1000000000;

    أوقف_سجل_الوصول_مؤقتا();
    دع البدء: متجه نص = [«Load test: GET », استنسخ(&الإعداد.المسار), «, », طبيعي_إلى_نص(الإعداد.الاتصالات), « connections, », طبيعي_إلى_نص(الإعداد.الثواني), « s»];
    دع لا_شيء: نص = «»;
    سجل_معلومة(صل_النصوص(&البدء, &لا_شيء));

    دع الخيوط: متغير متجه مقبض_خيط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < الإعداد.الاتصالات) {
        دع نسخة_المختبر: مشترك<مختبر_الحمل> = استنسخ_مشترك(&المشترك);
        دع نسخة_العنوان: عنوان_مقبس = استنسخ(&العنوان);
        دع نسخة_الطلب: متجه ط8 = استنسخ(&الطلب);
        دع نسخة_المتوقع: متجه ط8 = استنسخ(&الإعداد.المتوقع);
        طابق أطلق(دالة(): فراغ -> عامل_اتصال(
            استنسخ_مشترك(&نسخة_المختبر), استنسخ(&نسخة_العنوان), استنسخ(&نسخة_الطلب), استنسخ(&نسخة_المتوقع), الموعد
        )) مع
        | نتيجة.نجح(المقبض) -> { ألحق(الخيوط, المقبض); }
        | نتيجة.خطأ(_) -> { };
        ف := ف + 1;
    }
    طالما ((الطول(الخيوط) مثل طبيعي) > 0) {
        طابق أزل_الأخير(الخيوط) مع
        | اختياري.موجود(المقبض) -> { دع المنضم: متغير مقبض_خيط = المقبض; انضم(&متغير المنضم); }
        | اختياري.لا_شيء -> { };
    }
    اخزن_ط64(&(*المختبر).النهاية, الآن() مثل ط64, ترتيب_ذاكرة.تسلسلي());
    اخزن_ط64(&(*المختبر).الحالة, منتهيا, ترتيب_ذاكرة.تسلسلي());
    استأنف_سجل_الوصول();

    دع التقرير: تقرير_اختبار = تقرير_الاختبار(المختبر);
    دع الملخص: متجه نص = [
        «Load test done: », عدد_إلى_نص(التقرير.الطلبات), « valid responses, », عدد_إلى_نص(التقرير.في_الثانية), « req/s, p50 »,
        عدد_إلى_نص(التقرير.الوسيط_بالمكرو), « µs, p99 », عدد_إلى_نص(التقرير.ص99_بالمكرو), « µs; »,
        عدد_إلى_نص(التقرير.الاتصالات_المفتوحة), «/», عدد_إلى_نص(التقرير.الاتصالات), « connections opened, »,
        عدد_إلى_نص(التقرير.الردود_الخاطئة), « wrong responses, », عدد_إلى_نص(التقرير.أخطاء_الشبكة), « network errors»
    ];
    سجل_معلومة(صل_النصوص(&الملخص, &لا_شيء));
}

// ———————————————————————— الواجهة ————————————————————————

عام نوع بدء_الاختبار =
    | بدأ
    | جار_بالفعل      // اختبار آخر لم ينته
    | بلا_خيوط        // لا خيوط نظام هنا (المفسر مثلا)
;

// يبدأ اختبارا جديدا في خيط خاص.
عام عرف ابدأ_اختبار(المشترك: &مشترك<مختبر_الحمل>, الإعداد: إعداد_اختبار): بدء_الاختبار {
    دع المختبر: &مختبر_الحمل = اقرأ_مشترك(المشترك);
    دع السابقة: ط64 = احمل_ط64(&(*المختبر).الحالة, ترتيب_ذاكرة.تسلسلي());
    إذا (السابقة == جاريا) { أرجع بدء_الاختبار.جار_بالفعل(); };
    إذا (قارن_وبدّل_ط64(&(*المختبر).الحالة, السابقة, جاريا, ترتيب_ذاكرة.تسلسلي()) != السابقة) {
        أرجع بدء_الاختبار.جار_بالفعل();
    };
    صفر_العدادات(المختبر);
    اخزن_ط64(&(*المختبر).الاتصالات, الإعداد.الاتصالات مثل ط64, ترتيب_ذاكرة.مسترخ());
    اخزن_ط64(&(*المختبر).الثواني, الإعداد.الثواني مثل ط64, ترتيب_ذاكرة.مسترخ());
    اخزن_ط64(&(*المختبر).البداية, الآن() مثل ط64, ترتيب_ذاكرة.تسلسلي());
    دع نسخة_المختبر: مشترك<مختبر_الحمل> = استنسخ_مشترك(المشترك);
    دع نسخة_الإعداد: إعداد_اختبار = الإعداد;
    طابق أطلق(دالة(): فراغ -> أدر_الاختبار(استنسخ_مشترك(&نسخة_المختبر), استنسخ(&نسخة_الإعداد))) مع
    | نتيجة.نجح(_) -> { أرجع بدء_الاختبار.بدأ(); }
    | نتيجة.خطأ(_) -> {
        اخزن_ط64(&(*المختبر).الحالة, خاملا, ترتيب_ذاكرة.تسلسلي());
        أرجع بدء_الاختبار.بلا_خيوط();
    };
}

عام عرف هل_الاختبار_جار(المختبر: &مختبر_الحمل): منطقي {
    أرجع احمل_ط64(&(*المختبر).الحالة, ترتيب_ذاكرة.تسلسلي()) == جاريا;
}

// صورة الاختبار الآن: الحالة، والعدادات، والنسب المئوية.
عام عرف تقرير_الاختبار(المختبر: &مختبر_الحمل): تقرير_اختبار {
    دع الحالة: ط64 = احمل_ط64(&(*المختبر).الحالة, ترتيب_ذاكرة.تسلسلي());
    دع البداية: عدد = احمل_ط64(&(*المختبر).البداية, ترتيب_ذاكرة.تسلسلي()) مثل عدد;
    دع النهاية: متغير عدد = الآن();
    إذا (الحالة == منتهيا) { النهاية := احمل_ط64(&(*المختبر).النهاية, ترتيب_ذاكرة.تسلسلي()) مثل عدد; };
    دع المنقضي: متغير عدد = 0;
    إذا (الحالة != خاملا) { المنقضي := (النهاية - البداية) / 1000000; };
    دع الطلبات: عدد = احمل_ط64(&(*المختبر).الطلبات, ترتيب_ذاكرة.مسترخ()) مثل عدد;
    دع في_الثانية: متغير عدد = 0;
    إذا (المنقضي > 0) { في_الثانية := الطلبات * 1000 / المنقضي; };
    دع الوصف: متغير نص = «idle»;
    إذا (الحالة == جاريا) { الوصف := «running»; };
    إذا (الحالة == منتهيا) { الوصف := «done»; };
    دع الناتج: تقرير_اختبار = {
        الحالة: الوصف,
        الاتصالات: احمل_ط64(&(*المختبر).الاتصالات, ترتيب_ذاكرة.مسترخ()) مثل عدد,
        الثواني: احمل_ط64(&(*المختبر).الثواني, ترتيب_ذاكرة.مسترخ()) مثل عدد,
        المنقضي_بالمللي: المنقضي,
        الاتصالات_المفتوحة: احمل_ط64(&(*المختبر).المفتوحة, ترتيب_ذاكرة.مسترخ()) مثل عدد,
        الطلبات: الطلبات,
        الردود_الخاطئة: احمل_ط64(&(*المختبر).الخاطئة, ترتيب_ذاكرة.مسترخ()) مثل عدد,
        أخطاء_الشبكة: احمل_ط64(&(*المختبر).الأخطاء, ترتيب_ذاكرة.مسترخ()) مثل عدد,
        في_الثانية: في_الثانية,
        الوسيط_بالمكرو: نسبة_مئوية(المختبر, 500),
        ص99_بالمكرو: نسبة_مئوية(المختبر, 990)
    };
    أرجع الناتج;
}
