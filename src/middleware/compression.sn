من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    رأس_ويب,
    أول_قيمة_رأس_ويب,
    ضع_رأس_ويب,
    احذف_رأس_ويب;

من std.compression استورد
    اضغط_جي_زيب;

استورد std.text.compare;
استورد std.text.search;
استورد std.text.transform;
استورد std.text.number;
استورد response.headers;
استورد routing.router;

// The q-value of one Accept-Encoding item is zero ("not acceptable",
// RFC 9110 §12.4.2): "q=0", "q=0.", "q=0.0" … "q=0.000".
عرف وزن_صفري(المعاملات: &متجه نص): منطقي {
    ليكن ف: متغير طبيعي = 1;
    طالما (ف < (الطول(*المعاملات) مثل طبيعي)) {
        ليكن المعامل: نص = حول_النص_إلى_صغير_أسكي(&(*المعاملات)[ف]);
        ليكن البادئة: نص = «q=»;
        طابق أزل_البادئة(&المعامل, &البادئة) مع
        | اختياري.لا_شيء -> { }
        | اختياري.موجود(القيمة_الخام) -> {
            ليكن القيمة: نص = قص_النص(&القيمة_الخام);
            ليكن العدد: طبيعي = الطول(القيمة) مثل طبيعي;
            إذا (العدد == 0 || القيمة[0] != 0x30) { أرجع خطأ; };
            ليكن ج: متغير طبيعي = 1;
            طالما (ج < العدد) {
                إذا (القيمة[ج] != 0x30 && القيمة[ج] != 0x2E) { أرجع خطأ; };
                ج := ج + 1;
            }
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Whether the request accepts gzip: an explicit "gzip" (or "x-gzip") item
// with a non-zero weight, or "*" with a non-zero weight when gzip is not
// listed. Every Accept-Encoding line counts (RFC 9110 §12.5.3).
عرف يقبل_جي_زيب(الطلب: &طلب_ويب<متجه ط8>): منطقي {
    ليكن الاسم: نص = «accept-encoding»;
    ليكن العناصر: متجه نص = عناصر_قائمة_رأس(&(*الطلب).الرؤوس, &الاسم);
    ليكن فاصلة_منقوطة: نص = «;»;
    ليكن gzip: نص = «gzip»;
    ليكن x_gzip: نص = «x-gzip»;
    ليكن نجمة: نص = «*»;
    ليكن حكم_صريح: متغير اختياري منطقي = اختياري.لا_شيء();
    ليكن حكم_النجمة: متغير اختياري منطقي = اختياري.لا_شيء();
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العناصر) مثل طبيعي)) {
        ليكن الأجزاء: متجه نص = قسم_النص(&العناصر[ف], &فاصلة_منقوطة);
        ليكن الترميز: نص = قص_النص(&الأجزاء[0]);
        ليكن مقبول: منطقي = !وزن_صفري(&الأجزاء);
        إذا (نصان_متساويان_بلا_حالة_أسكي(&الترميز, &gzip)
            || نصان_متساويان_بلا_حالة_أسكي(&الترميز, &x_gzip)) {
            حكم_صريح := اختياري.موجود(مقبول);
        } وإلا إذا (نصان_متساويان(&الترميز, &نجمة)) {
            حكم_النجمة := اختياري.موجود(مقبول);
        };
        ف := ف + 1;
    }
    طابق حكم_صريح مع
    | اختياري.موجود(الحكم) -> { أرجع الحكم; }
    | اختياري.لا_شيء -> { };
    طابق حكم_النجمة مع
    | اختياري.موجود(الحكم) -> { أرجع الحكم; }
    | اختياري.لا_شيء -> { };
    أرجع خطأ;
}

// Media types whose bodies are already compressed.
عرف نوع_مضغوط_سلفا(النوع_الخام: &نص): منطقي {
    ليكن النوع: نص = حول_النص_إلى_صغير_أسكي(النوع_الخام);
    ليكن صورة: نص = «image/»;
    ليكن svg: نص = «image/svg»;
    ليكن فيديو: نص = «video/»;
    ليكن صوت: نص = «audio/»;
    ليكن خطوط: نص = «font/woff»;
    إذا (يبدأ_بـ(&النوع, &صورة) && !يبدأ_بـ(&النوع, &svg)) { أرجع صواب; };
    إذا (يبدأ_بـ(&النوع, &فيديو) || يبدأ_بـ(&النوع, &صوت)) { أرجع صواب; };
    إذا (يبدأ_بـ(&النوع, &خطوط)) { أرجع صواب; };
    ليكن المضغوطة: متجه نص = [
        «application/zip»,
        «application/gzip»,
        «application/x-gzip»,
        «application/zstd»,
        «application/x-7z-compressed»,
        «application/x-rar-compressed»,
        «application/x-bzip2»,
        «application/x-xz»,
        «application/wasm»
    ];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المضغوطة) مثل طبيعي)) {
        إذا (يبدأ_بـ(&النوع, &المضغوطة[ف])) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Whether this response may be gzip-encoded at all, independent of what the
// client accepts.
عرف قابلة_للضغط(
    الطلب: &طلب_ويب<متجه ط8>,
    الاستجابة: &استجابة_ويب<متجه ط8>,
    الحد_الأدنى: طبيعي
): منطقي {
    ليكن head: نص = «HEAD»;
    إذا (نصان_متساويان(&(*الطلب).الطريقة, &head)) { أرجع خطأ; };
    ليكن الحالة: طبيعي = (*الاستجابة).الحالة مثل طبيعي;
    إذا (الحالة < 200 || الحالة == 204 || الحالة == 206 || الحالة == 304) {
        أرجع خطأ;
    };
    ليكن الحجم: طبيعي = الطول((*الاستجابة).الجسم) مثل طبيعي;
    إذا (الحجم == 0 || الحجم < الحد_الأدنى) { أرجع خطأ; };

    ليكن الرؤوس: &متجه رأس_ويب = &(*الاستجابة).الرؤوس;
    ليكن اسم_الترميز: نص = «content-encoding»;
    ليكن اسم_المدى: نص = «content-range»;
    طابق أول_قيمة_رأس_ويب(الرؤوس, &اسم_الترميز) مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };
    طابق أول_قيمة_رأس_ويب(الرؤوس, &اسم_المدى) مع
    | اختياري.موجود(_) -> { أرجع خطأ; }
    | اختياري.لا_شيء -> { };

    // Cache-Control: no-transform forbids changing the representation
    // (RFC 9111 §5.2.2.6).
    ليكن اسم_التخزين: نص = «cache-control»;
    ليكن بلا_تحويل: نص = «no-transform»;
    إذا (قائمة_رأس_تحتوي(الرؤوس, &اسم_التخزين, &بلا_تحويل)) { أرجع خطأ; };

    ليكن اسم_النوع: نص = «content-type»;
    طابق أول_قيمة_رأس_ويب(الرؤوس, &اسم_النوع) مع
    | اختياري.موجود(النوع) -> {
        إذا (نوع_مضغوط_سلفا(&النوع)) { أرجع خطأ; };
    }
    | اختياري.لا_شيء -> { };
    أرجع صواب;
}

// A strong validator no longer identifies the encoded bytes, so it becomes
// weak (RFC 9110 §8.8.1, §8.8.3).
عرف أضعف_الوسم(الاستجابة: &متغير استجابة_ويب<متجه ط8>): فراغ {
    ليكن الاسم: نص = «etag»;
    طابق أول_قيمة_رأس_ويب(&(*الاستجابة).الرؤوس, &الاسم) مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(الوسم) -> {
        ليكن ضعيف: نص = «W/»;
        إذا (!يبدأ_بـ(&الوسم, &ضعيف)) {
            ليكن الأجزاء: متجه نص = [ضعيف, الوسم];
            ليكن فارغ: نص = «»;
            ليكن الجديد: نص = صل_النصوص(&الأجزاء, &فارغ);
            ليكن تجاهل: منطقي = عين_رأسا(الاستجابة, &الاسم, &الجديد);
        };
    };
}

// gzip-encodes الاستجابة for الطلب when it is eligible (at least الحد_الأدنى
// bytes, see `قابلة_للضغط`) and the client accepts gzip. Used by the `ضغط`
// middleware and the `@مضغوط` decorator.
عام عرف اضغط_الاستجابة(
    الطلب: &طلب_ويب<متجه ط8>,
    الاستجابة_الأصلية: استجابة_ويب<متجه ط8>,
    الحد_الأدنى: طبيعي
): استجابة_ويب<متجه ط8> {
    ليكن الاستجابة: متغير استجابة_ويب<متجه ط8> = الاستجابة_الأصلية;
    إذا (!قابلة_للضغط(الطلب, &الاستجابة, الحد_الأدنى)) {
        أرجع الاستجابة;
    };

    // The representation now depends on Accept-Encoding whether or not this
    // client gets gzip; caches must know (RFC 9110 §12.5.5).
    ليكن قيمة_التغيير: نص = «accept-encoding»;
    ليكن تجاهل_التغيير: منطقي = أضف_إلى_التغيير(&متغير الاستجابة, &قيمة_التغيير);
    إذا (!يقبل_جي_زيب(الطلب)) { أرجع الاستجابة; };

    الاستجابة.الجسم := اضغط_جي_زيب(&الاستجابة.الجسم);
    ليكن اسم_الترميز: نص = «content-encoding»;
    ليكن قيمة_الترميز: نص = «gzip»;
    ليكن تجاهل_الترميز: منطقي = عين_رأسا(
        &متغير الاستجابة,
        &اسم_الترميز,
        &قيمة_الترميز
    );
    // The HTTP/1 writer sets Content-Length from the new body.
    ليكن اسم_الطول: نص = «content-length»;
    ليكن تجاهل_الطول: طبيعي = احذف_رأس_ويب(
        &متغير الاستجابة.الرؤوس,
        &اسم_الطول
    );
    أضعف_الوسم(&متغير الاستجابة);
    أرجع الاستجابة;
}

عرف نفذ_الضغط<S>(
    الحد_الأدنى: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    التالي: &التالي<S>
): استجابة_ويب<متجه ط8> {
    أرجع اضغط_الاستجابة(الطلب, تابع(التالي, الطلب), الحد_الأدنى);
}

// gzip-encodes eligible response bodies of at least الحد_الأدنى bytes.
عام عرف ضغط<S>(الحد_الأدنى: طبيعي): وسيط<S> {
    ليكن التنفيذ: تنفيذ_وسيط<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        التالي: &التالي<S>
    ): استجابة_ويب<متجه ط8> -> نفذ_الضغط(
        الحد_الأدنى,
        الحالة,
        الطلب,
        التالي
    );
    ليكن المعطيات: متجه نص = [];
    أرجع وسيط_بمعطيات(التنفيذ, المعطيات);
}

عام مرادف compression = ضغط;
عام مرادف compress_response = اضغط_الاستجابة;
