من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب;

استورد extract.auth;
استورد middleware.chain;

// Decides whether a bearer token is accepted.
عام نوع مدقق_حامل<S> = دالة(
    &S,
    &نص
): منطقي;

عرف نفذ_حماية_حامل<S>(
    المدقق: مدقق_حامل<S>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب,
    التالي: &التالي_مسار<S>
): استجابة_ويب<متجه ط8> {
    طابق رمز_حامل(الطلب) مع
    | نتيجة.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_مصادقة.رمز_فارغ -> {
            دع الرمز: نص = «invalid_request»;
            أرجع رد_غير_مصرح_حامل(&الرمز);
        }
        | خطأ_مصادقة.رمز_غير_صالح -> {
            دع الرمز: نص = «invalid_request»;
            أرجع رد_غير_مصرح_حامل(&الرمز);
        }
        | _ -> {
            دع بلا_رمز: نص = «»;
            أرجع رد_غير_مصرح_حامل(&بلا_رمز);
        };
    }
    | نتيجة.نجح(الرمز) -> {
        إذا (!المدقق(الحالة, &الرمز)) {
            دع رمز_الخطأ: نص = «invalid_token»;
            أرجع رد_غير_مصرح_حامل(&رمز_الخطأ);
        };
        أرجع تابع_مسار(التالي, الحالة, الطلب, المعاملات);
    };
}

// Route middleware that requires a bearer token accepted by المدقق.
عام عرف يتطلب_حاملا<S>(
    المدقق: مدقق_حامل<S>
): وسيط_مسار<S> {
    دع التنفيذ: تنفيذ_وسيط_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب,
        التالي: &التالي_مسار<S>
    ): استجابة_ويب<متجه ط8> -> نفذ_حماية_حامل(
        المدقق,
        الحالة,
        الطلب,
        المعاملات,
        التالي
    );
    دع المعطيات: متجه نص = [];
    دع الناتج: وسيط_مسار<S> = {
        التنفيذ: التنفيذ,
        المعطيات: المعطيات
    };
    أرجع الناتج;
}

عام نوع bearer_validator<S> = مدقق_حامل<S>;
عام مرادف require_bearer = يتطلب_حاملا;
