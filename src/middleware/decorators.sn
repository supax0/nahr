من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    استجابة_نص_ويب;

استورد extract.auth;
استورد middleware.auth;
استورد middleware.compression;

// Handler decorators. A SultanC decorator wraps one function:
//
//     @محمي(رمز_مقبول)
//     عرف الإدارة(الحالة: &عدد, الطلب: &طلب, المعاملات: &معاملات_مسار): استجابة { … }
//
// makes every call of الإدارة run محمي(رمز_مقبول, <original>, …) first. They
// apply to the canonical handler shape (state, request, path parameters) and
// do the same work as the route middleware of this package, for one handler,
// wherever that handler is registered.

عام نوع أصل_معالج<S> = دالة(
    &S,
    &طلب_ويب<متجه ط8>,
    &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8>;

// Requires `Authorization: Bearer <token>` accepted by المدقق; 401 otherwise.
عام عرف محمي<S>(
    المدقق: مدقق_حامل<S>,
    الأصل: أصل_معالج<S>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    طابق رمز_حامل(الطلب) مع
    | نتيجة.خطأ(الخطأ) -> {
        طابق الخطأ مع
        | خطأ_مصادقة.رمز_فارغ -> {
            ليكن الرمز: نص = «invalid_request»;
            أرجع رد_غير_مصرح_حامل(&الرمز);
        }
        | خطأ_مصادقة.رمز_غير_صالح -> {
            ليكن الرمز: نص = «invalid_request»;
            أرجع رد_غير_مصرح_حامل(&الرمز);
        }
        | _ -> {
            ليكن بلا_رمز: نص = «»;
            أرجع رد_غير_مصرح_حامل(&بلا_رمز);
        };
    }
    | نتيجة.نجح(الرمز) -> {
        إذا (!المدقق(الحالة, &الرمز)) {
            ليكن رمز_الخطأ: نص = «invalid_token»;
            أرجع رد_غير_مصرح_حامل(&رمز_الخطأ);
        };
        أرجع الأصل(الحالة, الطلب, المعاملات);
    };
}

// 413 when the request body is larger than الحد bytes.
عام عرف بحد_جسم<S>(
    الحد: طبيعي,
    الأصل: أصل_معالج<S>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    إذا ((الطول((*الطلب).الجسم) مثل طبيعي) > الحد) {
        ليكن النص: نص = «Request body is too large»;
        أرجع استجابة_نص_ويب(413, &النص);
    };
    أرجع الأصل(الحالة, الطلب, المعاملات);
}

// gzip-encodes the handler's response (bodies of 1 KiB or more) when the
// client accepts it.
عام عرف مضغوط<S>(
    الأصل: أصل_معالج<S>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    أرجع اضغط_الاستجابة(الطلب, الأصل(الحالة, الطلب, المعاملات), 1024);
}

// Calls المراقب with the request and the handler's response.
عام عرف مراقب<S>(
    المراقب: دالة(&S, &طلب_ويب<متجه ط8>, &استجابة_ويب<متجه ط8>): فراغ,
    الأصل: أصل_معالج<S>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    ليكن الاستجابة: استجابة_ويب<متجه ط8> = الأصل(الحالة, الطلب, المعاملات);
    المراقب(الحالة, الطلب, &الاستجابة);
    أرجع الاستجابة;
}

عام نوع decorated_handler<S> = أصل_معالج<S>;
عام مرادف protected = محمي;
عام مرادف body_limited = بحد_جسم;
عام مرادف gzipped = مضغوط;
عام مرادف observed = مراقب;
