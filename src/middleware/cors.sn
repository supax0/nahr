من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    استجابة_فارغة_ويب,
    أول_قيمة_رأس_ويب;

استورد std.text.compare;
استورد std.text.search;
استورد std.text.number;
استورد response.headers;
استورد routing.router;

// CORS policy (Fetch standard, "CORS protocol").
//
// الأصول lists the allowed origins exactly as browsers send them
// ("https://example.com"); the single entry "*" allows any origin. With
// credentials, "*" is invalid for browsers, so `سياسة_الأصول` rejects that
// configuration instead of silently reflecting every origin.
عام نوع إعداد_أصول = {
    الأصول: متجه نص,
    الطرق: نص,
    الرؤوس: نص,
    الرؤوس_المكشوفة: نص,
    السماح_بالاعتمادات: منطقي,
    مدة_التخزين: طبيعي
};

عام نوع خطأ_أصول =
    | لا_أصول
    | نجمة_مع_اعتمادات
;

عام عرف أصول_افتراضية(): إعداد_أصول {
    ليكن الأصول: متجه نص = [«*»];
    ليكن الإعداد: إعداد_أصول = {
        الأصول: الأصول,
        الطرق: «GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS»,
        الرؤوس: «content-type, authorization»,
        الرؤوس_المكشوفة: «»,
        السماح_بالاعتمادات: خطأ,
        مدة_التخزين: 0
    };
    أرجع الإعداد;
}

// Argument layout of the CORS middleware.
عرف معطى_الطرق(): طبيعي { أرجع 0; }
عرف معطى_الرؤوس(): طبيعي { أرجع 1; }
عرف معطى_المكشوفة(): طبيعي { أرجع 2; }
عرف معطى_الاعتمادات(): طبيعي { أرجع 3; }
عرف معطى_المدة(): طبيعي { أرجع 4; }
عرف معطى_أول_أصل(): طبيعي { أرجع 5; }

عرف كل_الأصول(المعطيات: &متجه نص, الإزاحة: طبيعي): منطقي {
    ليكن نجمة: نص = «*»;
    ليكن العدد: طبيعي = الطول(*المعطيات) مثل طبيعي;
    ليكن ف: متغير طبيعي = الإزاحة + معطى_أول_أصل();
    طالما (ف < العدد) {
        إذا (نصان_متساويان(&(*المعطيات)[ف], &نجمة)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Origins are compared as serialized; scheme and host are ASCII
// case-insensitive.
عرف أصل_مسموح(
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الأصل: &نص
): منطقي {
    ليكن العدد: طبيعي = الطول(*المعطيات) مثل طبيعي;
    ليكن ف: متغير طبيعي = الإزاحة + معطى_أول_أصل();
    طالما (ف < العدد) {
        إذا (نصان_متساويان_بلا_حالة_أسكي(&(*المعطيات)[ف], الأصل)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف عين_إن_وجد(
    الاستجابة: &متغير استجابة,
    الاسم: &نص,
    القيمة: &نص
): فراغ {
    إذا ((الطول(*القيمة) مثل طبيعي) > 0) {
        ليكن تجاهل: منطقي = عين_رأسا(الاستجابة, الاسم, القيمة);
    };
}

عرف طبق_رؤوس_الأصل(
    الاستجابة: &متغير استجابة,
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الأصل: &نص
): فراغ {
    ليكن اعتمادات: منطقي =
        (الطول((*المعطيات)[الإزاحة + معطى_الاعتمادات()]) مثل طبيعي) > 0;
    ليكن نجمة: منطقي = كل_الأصول(المعطيات, الإزاحة) && !اعتمادات;
    ليكن اسم_الأصل: نص = «access-control-allow-origin»;
    إذا (نجمة) {
        ليكن القيمة: نص = «*»;
        ليكن تجاهل: منطقي = عين_رأسا(الاستجابة, &اسم_الأصل, &القيمة);
    } وإلا {
        ليكن تجاهل: منطقي = عين_رأسا(الاستجابة, &اسم_الأصل, الأصل);
    };
    إذا (اعتمادات) {
        ليكن الاسم: نص = «access-control-allow-credentials»;
        ليكن القيمة: نص = «true»;
        ليكن تجاهل: منطقي = عين_رأسا(الاستجابة, &الاسم, &القيمة);
    };
}

عرف رد_استباقي(
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الأصل: &اختياري نص
): استجابة_ويب<متجه ط8> {
    ليكن الاستجابة: متغير استجابة = استجابة_فارغة_ويب(204);
    طابق *الأصل مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طبق_رؤوس_الأصل(&متغير الاستجابة, المعطيات, الإزاحة, &القيمة);
        ليكن اسم_الطرق: نص = «access-control-allow-methods»;
        ليكن اسم_الرؤوس: نص = «access-control-allow-headers»;
        ليكن اسم_المدة: نص = «access-control-max-age»;
        عين_إن_وجد(&متغير الاستجابة, &اسم_الطرق, &(*المعطيات)[الإزاحة + معطى_الطرق()]);
        عين_إن_وجد(&متغير الاستجابة, &اسم_الرؤوس, &(*المعطيات)[الإزاحة + معطى_الرؤوس()]);
        عين_إن_وجد(&متغير الاستجابة, &اسم_المدة, &(*المعطيات)[الإزاحة + معطى_المدة()]);
    };
    ليكن تغيير_الطريقة: نص = «access-control-request-method»;
    ليكن تغيير_الرؤوس: نص = «access-control-request-headers»;
    ليكن تجاهل_الطريقة: منطقي = أضف_إلى_التغيير(&متغير الاستجابة, &تغيير_الطريقة);
    ليكن تجاهل_الرؤوس: منطقي = أضف_إلى_التغيير(&متغير الاستجابة, &تغيير_الرؤوس);
    أرجع الاستجابة;
}

عرف نفذ_أصول<S>(
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    التالي: &التالي<S>
): استجابة_ويب<متجه ط8> {
    ليكن اسم_الأصل: نص = «origin»;
    ليكن الأصل_المرسل: اختياري نص =
        أول_قيمة_رأس_ويب(&(*الطلب).الرؤوس, &اسم_الأصل);
    ليكن الأصل: متغير اختياري نص = اختياري.لا_شيء();
    طابق الأصل_المرسل مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        إذا (كل_الأصول(المعطيات, الإزاحة)
            || أصل_مسموح(المعطيات, الإزاحة, &القيمة)) {
            الأصل := اختياري.موجود(القيمة);
        };
    };

    // A preflight is OPTIONS with Access-Control-Request-Method.
    ليكن options: نص = «OPTIONS»;
    ليكن اسم_طلب_الطريقة: نص = «access-control-request-method»;
    إذا (نصان_متساويان(&(*الطلب).الطريقة, &options)) {
        طابق أول_قيمة_رأس_ويب(&(*الطلب).الرؤوس, &اسم_طلب_الطريقة) مع
        | اختياري.موجود(_) -> {
            ليكن الرد: متغير استجابة = رد_استباقي(المعطيات, الإزاحة, &الأصل);
            إذا (!كل_الأصول(المعطيات, الإزاحة)) {
                ليكن تجاهل: منطقي = أضف_إلى_التغيير(&متغير الرد, &اسم_الأصل);
            };
            أرجع الرد;
        }
        | اختياري.لا_شيء -> { };
    };

    ليكن الاستجابة: متغير استجابة = تابع(التالي, الطلب);
    طابق الأصل مع
    | اختياري.لا_شيء -> { }
    | اختياري.موجود(القيمة) -> {
        طبق_رؤوس_الأصل(&متغير الاستجابة, المعطيات, الإزاحة, &القيمة);
        ليكن اسم_المكشوفة: نص = «access-control-expose-headers»;
        عين_إن_وجد(&متغير الاستجابة, &اسم_المكشوفة, &(*المعطيات)[الإزاحة + معطى_المكشوفة()]);
    };
    // When the answer depends on Origin, caches must key on it, including
    // for requests that sent no Origin.
    ليكن اعتمادات: منطقي =
        (الطول((*المعطيات)[الإزاحة + معطى_الاعتمادات()]) مثل طبيعي) > 0;
    إذا (!كل_الأصول(المعطيات, الإزاحة) || اعتمادات) {
        ليكن تجاهل: منطقي = أضف_إلى_التغيير(&متغير الاستجابة, &اسم_الأصل);
    };
    أرجع الاستجابة;
}

عام عرف سياسة_الأصول<S>(
    الإعداد: &إعداد_أصول
): نتيجة وسيط<S>, خطأ_أصول {
    ليكن العدد: طبيعي = الطول((*الإعداد).الأصول) مثل طبيعي;
    إذا (العدد == 0) {
        أرجع نتيجة.خطأ(خطأ_أصول.لا_أصول());
    };
    ليكن نجمة: نص = «*»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا (نصان_متساويان(&(*الإعداد).الأصول[ف], &نجمة)
            && (*الإعداد).السماح_بالاعتمادات) {
            أرجع نتيجة.خطأ(خطأ_أصول.نجمة_مع_اعتمادات());
        };
        ف := ف + 1;
    }

    ليكن المعطيات: متغير متجه نص = [];
    ألحق(المعطيات, استنسخ(&(*الإعداد).الطرق));
    ألحق(المعطيات, استنسخ(&(*الإعداد).الرؤوس));
    ألحق(المعطيات, استنسخ(&(*الإعداد).الرؤوس_المكشوفة));
    إذا ((*الإعداد).السماح_بالاعتمادات) {
        ألحق(المعطيات, «true»);
    } وإلا {
        ألحق(المعطيات, «»);
    };
    إذا ((*الإعداد).مدة_التخزين > 0) {
        ألحق(المعطيات, طبيعي_إلى_نص((*الإعداد).مدة_التخزين));
    } وإلا {
        ألحق(المعطيات, «»);
    };
    ألحق_معطيات_أصول(&متغير المعطيات, &(*الإعداد).الأصول);

    ليكن التنفيذ: تنفيذ_وسيط<S> = دالة(
        معطيات_الطلب: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        التالي: &التالي<S>
    ): استجابة_ويب<متجه ط8> -> نفذ_أصول(
        معطيات_الطلب,
        الإزاحة,
        الحالة,
        الطلب,
        التالي
    );
    أرجع نتيجة.نجح(وسيط_بمعطيات(التنفيذ, المعطيات));
}

عرف ألحق_معطيات_أصول(الهدف: &متغير متجه نص, الأصول: &متجه نص): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأصول) مثل طبيعي)) {
        ألحق(*الهدف, استنسخ(&(*الأصول)[ف]));
        ف := ف + 1;
    }
}

عام مرادف cors_config = إعداد_أصول;
عام مرادف cors_error = خطأ_أصول;
عام مرادف default_cors = أصول_افتراضية;
عام مرادف cors = سياسة_الأصول;
عام مرادف cors_error.no_origins = خطأ_أصول.لا_أصول;
عام مرادف cors_error.wildcard_with_credentials = خطأ_أصول.نجمة_مع_اعتمادات;
