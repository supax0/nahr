من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    استجابة_بايتات_ويب,
    أول_قيمة_رأس_ويب;


استورد std.text.search;
استورد std.text.transform;
استورد std.text.number;
استورد std.text.from_bytes;
استورد routing.router;
استورد response.headers;
استورد json.writer;

// Error responses. Nahr's own rejections (400, 401, 404, 405, 413, 415, 422)
// and std's routing errors are short text/plain bodies. These middleware turn
// them into what an API wants, for every route at once; register them first
// so they see every response.

// Rewrites a response with status 400 or above.
عام نوع محول_رد_خطأ<S> = دالة(
    &S,
    &طلب_ويب<متجه ط8>,
    استجابة_ويب<متجه ط8>
): استجابة_ويب<متجه ط8>;

عرف نفذ_تحويل_الأخطاء<S>(
    المحول: محول_رد_خطأ<S>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    التالي: &التالي<S>
): استجابة_ويب<متجه ط8> {
    ليكن الاستجابة: استجابة_ويب<متجه ط8> = تابع(التالي, الطلب);
    إذا ((الاستجابة.الحالة مثل طبيعي) < 400) { أرجع الاستجابة; };
    أرجع المحول(الحالة, الطلب, الاستجابة);
}

// Calls المحول on every response with status 400 or above.
عام عرف حول_الأخطاء<S>(المحول: محول_رد_خطأ<S>): وسيط<S> {
    ليكن التنفيذ: تنفيذ_وسيط<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        التالي: &التالي<S>
    ): استجابة_ويب<متجه ط8> -> نفذ_تحويل_الأخطاء(
        المحول,
        الحالة,
        الطلب,
        التالي
    );
    ليكن المعطيات: متجه نص = [];
    أرجع وسيط_بمعطيات(التنفيذ, المعطيات);
}

// `{"error":{"status":404,"message":"Not Found"}}` for a text/plain error
// response; other responses (already JSON, HTML, empty) pass unchanged.
// Headers such as Allow or WWW-Authenticate are kept.
عام عرف رد_خطأ_جسون(الاستجابة: استجابة_ويب<متجه ط8>): استجابة_ويب<متجه ط8> {
    ليكن اسم_النوع: نص = «content-type»;
    ليكن نصي: نص = «text/plain»;
    طابق أول_قيمة_رأس_ويب(&الاستجابة.الرؤوس, &اسم_النوع) مع
    | اختياري.لا_شيء -> { أرجع الاستجابة; }
    | اختياري.موجود(النوع) -> {
        ليكن صغير: نص = حول_النص_إلى_صغير_أسكي(&النوع);
        إذا (!يبدأ_بـ(&صغير, &نصي)) { أرجع الاستجابة; };
    };
    ليكن النص_الخام: نص = من_بايتات(&الاستجابة.الجسم);
    ليكن الرسالة: نص = قص_النص(&النص_الخام);
    ليكن الجسم: متغير متجه ط8 = بايتات_من_نص(«{"error":{"status":»);
    ألحق_بايتات_نص(&متغير الجسم, طبيعي_إلى_نص(الاستجابة.الحالة مثل طبيعي));
    ألحق_بايتات_نص(&متغير الجسم, «,"message":»);
    إذا (!ألحق_نص_جسون(&متغير الجسم, &الرسالة)) { أرجع الاستجابة; };
    ألحق_بايتات_نص(&متغير الجسم, «}}»);

    ليكن الناتج: متغير استجابة_ويب<متجه ط8> = الاستجابة;
    الناتج.الجسم := الجسم;
    ليكن القيمة: نص = «application/json; charset=utf-8»;
    ليكن تجاهل: منطقي = عين_رأسا(&متغير الناتج, &اسم_النوع, &القيمة);
    أرجع الناتج;
}

عرف نفذ_أخطاء_جسون<S>(
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    الاستجابة: استجابة_ويب<متجه ط8>
): استجابة_ويب<متجه ط8> {
    أرجع رد_خطأ_جسون(الاستجابة);
}

// Turns every text/plain error response into a JSON error object.
عام عرف أخطاء_جسون<S>(): وسيط<S> {
    ليكن المحول: محول_رد_خطأ<S> = دالة(
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        الاستجابة: استجابة_ويب<متجه ط8>
    ): استجابة_ويب<متجه ط8> -> نفذ_أخطاء_جسون(الحالة, الطلب, الاستجابة);
    أرجع حول_الأخطاء(المحول);
}

عام نوع error_response_mapper<S> = محول_رد_خطأ<S>;
عام مرادف map_errors = حول_الأخطاء;
عام مرادف json_errors = أخطاء_جسون;
عام مرادف json_error_response = رد_خطأ_جسون;
