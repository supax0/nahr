من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب;

// Route middleware. It wraps one route's handler: it receives the matched
// path parameters and a `التالي_مسار` value that runs the rest of the route
// chain. Like extractors, middleware keeps its configuration as text
// arguments (`المعطيات`), because SultanC closures capture plain values only.
//
// Global middleware (`وسيط<S>`) lives with the router in routing.router,
// since its continuation runs the router itself.

// Runs the wrapped handler (or the next route middleware) at an offset.
عام نوع تنفيذ_مسار<S> = دالة(
    &متجه نص,
    طبيعي,
    &S,
    &طلب_ويب<متجه ط8>,
    &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8>;

// The rest of a route chain: what `تابع_مسار` runs.
عام نوع التالي_مسار<S> = {
    التنفيذ: تنفيذ_مسار<S>,
    المعطيات: &متجه نص,
    الإزاحة: طبيعي
};

عام نوع تنفيذ_وسيط_مسار<S> = دالة(
    &متجه نص,
    طبيعي,
    &S,
    &طلب_ويب<متجه ط8>,
    &معاملات_مسار_ويب,
    &التالي_مسار<S>
): استجابة_ويب<متجه ط8>;

عام نوع وسيط_مسار<S> = {
    التنفيذ: تنفيذ_وسيط_مسار<S>,
    المعطيات: متجه نص
};

// Middleware function without arguments.
عام نوع دالة_وسيط_مسار<S> = دالة(
    &S,
    &طلب_ويب<متجه ط8>,
    &معاملات_مسار_ويب,
    &التالي_مسار<S>
): استجابة_ويب<متجه ط8>;

// Continues a route chain with a (possibly changed) request.
عام عرف تابع_مسار<S>(
    التالي: &التالي_مسار<S>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    ليكن التنفيذ: تنفيذ_مسار<S> = (*التالي).التنفيذ;
    أرجع التنفيذ(
        (*التالي).المعطيات,
        (*التالي).الإزاحة,
        الحالة,
        الطلب,
        المعاملات
    );
}

عرف نفذ_دالة_وسيط_مسار<S>(
    الدالة: دالة_وسيط_مسار<S>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب,
    التالي: &التالي_مسار<S>
): استجابة_ويب<متجه ط8> {
    أرجع الدالة(الحالة, الطلب, المعاملات, التالي);
}

عام عرف وسيط_مسار_من_دالة<S>(
    الدالة: دالة_وسيط_مسار<S>
): وسيط_مسار<S> {
    ليكن التنفيذ: تنفيذ_وسيط_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب,
        التالي: &التالي_مسار<S>
    ): استجابة_ويب<متجه ط8> -> نفذ_دالة_وسيط_مسار(
        الدالة,
        الحالة,
        الطلب,
        المعاملات,
        التالي
    );
    ليكن المعطيات: متجه نص = [];
    ليكن الناتج: وسيط_مسار<S> = {
        التنفيذ: التنفيذ,
        المعطيات: المعطيات
    };
    أرجع الناتج;
}

عام نوع route_middleware<S> = وسيط_مسار<S>;
عام نوع route_middleware_run<S> = تنفيذ_وسيط_مسار<S>;
عام نوع route_middleware_fn<S> = دالة_وسيط_مسار<S>;
عام نوع route_next<S> = التالي_مسار<S>;
عام نوع route_run<S> = تنفيذ_مسار<S>;
عام مرادف route_next_run = تابع_مسار;
عام مرادف route_middleware_from_fn = وسيط_مسار_من_دالة;
