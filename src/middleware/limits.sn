من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    استجابة_نص_ويب;

استورد routing.router;

// Rejects requests whose body is larger than الحد with 413.
//
// This is a policy filter: std.http has already read the body (up to its own
// limit, `أقصى_بايتات_جسم` in the server configuration) before middleware
// runs. To bound memory, lower the server limit in `إعداد`; use this
// middleware for smaller per-application limits.
عرف نفذ_حد_الجسم<S>(
    الحد: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    التالي: &التالي<S>
): استجابة_ويب<متجه ط8> {
    ليكن الحجم: طبيعي =
        الطول((*الطلب).الجسم) مثل طبيعي;
    إذا (الحجم > الحد) {
        ليكن النص: نص = «Request body is too large»;
        أرجع استجابة_نص_ويب(413, &النص);
    };
    أرجع تابع(التالي, الطلب);
}

عام عرف حد_الجسم<S>(الحد: طبيعي): وسيط<S> {
    ليكن التنفيذ: تنفيذ_وسيط<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        التالي: &التالي<S>
    ): استجابة_ويب<متجه ط8> -> نفذ_حد_الجسم(
        الحد,
        الحالة,
        الطلب,
        التالي
    );
    ليكن المعطيات: متجه نص = [];
    أرجع وسيط_بمعطيات(التنفيذ, المعطيات);
}

عام مرادف body_limit = حد_الجسم;
