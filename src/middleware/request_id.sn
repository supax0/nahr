من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    أول_قيمة_رأس_ويب,
    ضع_رأس_ويب;

استورد std.math.wrapping;
استورد std.os.entropy;

استورد response.headers;
استورد routing.router;

// Gives every request an `X-Request-Id`. A usable incoming id (1-128 visible
// ASCII characters) is kept; otherwise a random UUID (v4) is generated and set
// on the request the handler sees. The response carries the same id.

// Request IDs are UUID-shaped (version 4 layout) but made without a system
// call: a 64-bit key from the operating system's CSPRNG, taken once, and a
// process-wide counter, mixed by the splitmix64 finalizer (a bijection of 64
// bits). They are unique within a process, for tracing and log correlation.
// They are NOT secret: the finalizer can be inverted, so one ID seen by a
// client gives the key and with it the next IDs. Never use them as tokens,
// session IDs or anything an attacker must not guess. tower-http's
// MakeRequestUuid asks the OS for 16 random bytes per request instead.
// Compiler intrinsics bind only through private aliases (std.sync.atomic's
// way); the two words change only atomically.
مرادف احمل_ذريا_للمعرف = بدائي_ذري_حمل;
مرادف قارن_وبدل_ذريا_للمعرف = بدائي_ذري_قارن_وبدل;
مرادف اجلب_اجمع_ذريا_للمعرف = بدائي_ذري_جلب_جمع;
ليكن مفتاح_معرفات_الطلب: متغير ط64 = 0;
ليكن عداد_معرفات_الطلب: متغير ط64 = 0;

عرف امزج_معرف(القيمة: ط64): ط64 {
    ليكن ز: متغير ط64 = القيمة;
    ز := ضرب_ط64_ملتف(ز ^ (ز >> 30), 0xBF58476D1CE4E5B9);
    ز := ضرب_ط64_ملتف(ز ^ (ز >> 27), 0x94D049BB133111EB);
    أرجع ز ^ (ز >> 31);
}

عرف مفتاح_المعرفات(): ط64 {
    ليكن الحالي: ط64 = احمل_ذريا_للمعرف(&مفتاح_معرفات_الطلب, 2);
    إذا (الحالي != 0) { أرجع الحالي; };
    ليكن البايتات: متغير متجه ط8 = [0, 0, 0, 0, 0, 0, 0, 0];
    ليكن الجديد: متغير ط64 = 0x9E3779B97F4A7C15;
    طابق املأ_بايتات_عشوائية_النظام(&متغير البايتات) مع
    | نتيجة.نجح(_) -> {
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < 8) {
            الجديد := إزاحة_يسرى_ط64_ملتفة(الجديد, 8) ^ (البايتات[ف] مثل ط64);
            ف := ف + 1;
        }
    }
    | نتيجة.خطأ(_) -> { };
    إذا (الجديد == 0) { الجديد := 0x9E3779B97F4A7C15; };
    ليكن السابق: ط64 = قارن_وبدل_ذريا_للمعرف(&مفتاح_معرفات_الطلب, 0 مثل ط64, الجديد, 3, 2);
    إذا (السابق != 0) { أرجع السابق; };
    أرجع الجديد;
}

عرف ألحق_سداسيا(الناتج: &متغير متجه ط8, القيمة: ط64, الأرقام: ط64): فراغ {
    ليكن ف: متغير ط64 = الأرقام;
    طالما (ف > 0) {
        ف := ف - 1;
        ليكن الرقم: ط64 = (القيمة >> (ف * 4)) & 0xF;
        إذا (الرقم < 10) { ألحق(*الناتج, (0x30 + الرقم) مثل ط8); } وإلا { ألحق(*الناتج, (0x57 + الرقم) مثل ط8); };
    }
}

// A new request ID: xxxxxxxx-xxxx-4xxx-[89ab]xxx-xxxxxxxxxxxx.
عام عرف معرف_طلب_جديد(): نص {
    ليكن المفتاح: ط64 = مفتاح_المعرفات();
    ليكن الرقم: ط64 = اجلب_اجمع_ذريا_للمعرف(&عداد_معرفات_الطلب, 1 مثل ط64, 0);
    ليكن العالي: ط64 = (امزج_معرف(المفتاح ^ الرقم) & 0xFFFFFFFFFFFF0FFF) | 0x0000000000004000;
    ليكن المنخفض: ط64 = (امزج_معرف(العالي ^ المفتاح ^ 0xD6E8FEB86659FD93) & 0x3FFFFFFFFFFFFFFF) | 0x8000000000000000;
    ليكن الناتج: متغير متجه ط8 = [];
    احجز_سعة(الناتج, 36);
    ألحق_سداسيا(&متغير الناتج, العالي >> 32, 8);
    ألحق(الناتج, 0x2D);
    ألحق_سداسيا(&متغير الناتج, العالي >> 16, 4);
    ألحق(الناتج, 0x2D);
    ألحق_سداسيا(&متغير الناتج, العالي, 4);
    ألحق(الناتج, 0x2D);
    ألحق_سداسيا(&متغير الناتج, المنخفض >> 48, 4);
    ألحق(الناتج, 0x2D);
    ألحق_سداسيا(&متغير الناتج, المنخفض, 12);
    أرجع الناتج مثل نص;
}

عرف معرف_صالح(القيمة: &نص): منطقي {
    ليكن العدد: طبيعي = الطول(*القيمة) مثل طبيعي;
    إذا (العدد == 0 || العدد > 128) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن ب: ط8 = (*القيمة)[ف];
        إذا (ب < 0x21 || ب > 0x7E) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// The request's id: the incoming one when usable.
عام عرف معرف_الطلب_من(الطلب: &طلب_ويب<متجه ط8>): اختياري نص {
    ليكن الاسم: نص = «x-request-id»;
    طابق أول_قيمة_رأس_ويب(&(*الطلب).الرؤوس, &الاسم) مع
    | اختياري.موجود(القيمة) -> {
        إذا (معرف_صالح(&القيمة)) { أرجع اختياري.موجود(القيمة); };
        أرجع اختياري.لا_شيء();
    }
    | اختياري.لا_شيء -> { أرجع اختياري.لا_شيء(); };
}

عرف نفذ_معرف_الطلب<S>(
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    التالي: &التالي<S>
): استجابة_ويب<متجه ط8> {
    ليكن الاسم: نص = «x-request-id»;
    ليكن الاستجابة: متغير استجابة_ويب<متجه ط8>;
    ليكن المعرف: متغير نص = «»;
    طابق معرف_الطلب_من(الطلب) مع
    | اختياري.موجود(القيمة) -> {
        المعرف := القيمة;
        الاستجابة := تابع(التالي, الطلب);
    }
    | اختياري.لا_شيء -> {
        المعرف := معرف_طلب_جديد();
        ليكن المعدل: متغير طلب_ويب<متجه ط8> = استنسخ(الطلب);
        ليكن تجاهل: منطقي = ضع_رأس_ويب(&متغير المعدل.الرؤوس, &الاسم, &المعرف);
        الاستجابة := تابع(التالي, &المعدل);
    };
    ليكن تجاهل_الرد: منطقي = عين_رأسا(&متغير الاستجابة, &الاسم, &المعرف);
    أرجع الاستجابة;
}

عام عرف معرف_الطلب<S>(): وسيط<S> {
    ليكن التنفيذ: تنفيذ_وسيط<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        التالي: &التالي<S>
    ): استجابة_ويب<متجه ط8> -> نفذ_معرف_الطلب(الحالة, الطلب, التالي);
    ليكن المعطيات: متجه نص = [];
    أرجع وسيط_بمعطيات(التنفيذ, المعطيات);
}

عام مرادف request_id = معرف_الطلب;
عام مرادف request_id_of = معرف_الطلب_من;
عام مرادف new_request_id = معرف_طلب_جديد;
