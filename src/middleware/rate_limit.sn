من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    استجابة_نص_ويب,
    أول_قيمة_رأس_ويب;

من std.sync استورد
    مشترك,
    أنشئ_مشترك,
    اقرأ_مشترك,
    قفل,
    أنشئ_قفل,
    نفذ_مع_القفل;

من std.time استورد
    وقت_رتيب_نانو;

استورد std.text.compare;
استورد std.collections.text_index_map;
استورد std.collections.map;
استورد std.text.number;
استورد response.headers;
استورد routing.router;

// Fixed-window rate limiting: at most الحد requests per key in each window of
// النافذة seconds; the next ones get 429 Too Many Requests with Retry-After
// (RFC 6585 §4, RFC 9110 §10.2.3).
//
// The counters live in the middleware itself (an Arc around a Mutex), shared
// by every worker thread of `شغل_متوازيا`. They are per process: several
// processes or machines each count on their own.
//
// The key decides who shares a budget: `مفتاح_بالعنوان` (one budget per
// client IP address, the usual choice), `مفتاح_عام` (one budget for everyone)
// or `مفتاح_بالرأس(«x-api-key»)`. Behind a reverse proxy every request comes
// from the proxy's address, so key on the header the proxy sets
// (x-forwarded-for, x-real-ip) instead; a header the client sets itself can
// be changed by the client.

عام نوع مفتاح_معدل<S> = دالة(&S, &طلب_ويب<متجه ط8>): نص;

// One key's window: requests counted so far and when the window began.
عام نوع حالة_مفتاح_معدل = {
    العدد: طبيعي,
    البداية: عدد
};

// Keys in a hash map, as governor's keyed limiter: a request costs one
// lookup (and one insert for a new key), whatever the number of clients.
// The map gives each key's slot in الحالات; slots of expired keys, swept at
// most once per window, are reused, so the table stays bounded by the
// clients seen in the last window.
عام نوع جدول_معدل = {
    الفهارس: خريطة_نص_فهرس,
    الحالات: متجه حالة_مفتاح_معدل,
    الحرة: متجه طبيعي,
    آخر_كنس: عدد
};

عرف الآن(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عرف جدول_معدل_جديد(اللحظة: عدد): جدول_معدل {
    ليكن الحالات: متجه حالة_مفتاح_معدل = [];
    ليكن الحرة: متجه طبيعي = [];
    ليكن الناتج: جدول_معدل = {
        الفهارس: أنشئ_خريطة_نص_فهرس(),
        الحالات: الحالات,
        الحرة: الحرة,
        آخر_كنس: اللحظة
    };
    أرجع الناتج;
}

عرف اكنس_المنتهية(الجدول: &متغير جدول_معدل, النافذة: عدد, اللحظة: عدد): فراغ {
    إذا (اللحظة - (*الجدول).آخر_كنس < النافذة) { أرجع; };
    (*الجدول).آخر_كنس := اللحظة;
    ليكن المداخل: متجه مدخل_خريطة_نص_فهرس = مداخل_خريطة_نص_فهرس(&(*الجدول).الفهارس);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المداخل) مثل طبيعي)) {
        ليكن الخانة: طبيعي = المداخل[ف].القيمة;
        إذا (اللحظة - (*الجدول).الحالات[الخانة].البداية >= النافذة) {
            ليكن تجاهل: اختياري طبيعي = احذف_من_خريطة_نص_فهرس(&متغير (*الجدول).الفهارس, &المداخل[ف].المفتاح);
            ألحق((*الجدول).الحرة, الخانة);
        };
        ف := ف + 1;
    }
}

// Counts one request for المفتاح; answers 0 to let it through, or the
// seconds to wait (Retry-After).
عرف عد_طلبا(
    الجدول: &متغير جدول_معدل,
    المفتاح: &نص,
    الحد: طبيعي,
    النافذة: عدد,
    اللحظة: عدد
): طبيعي {
    إذا (الحد == 0) { أرجع 1; };
    اكنس_المنتهية(الجدول, النافذة, اللحظة);
    ليكن الخانة: متغير طبيعي = 0;
    ليكن الحالة: متغير حالة_مفتاح_معدل = { العدد: 0, البداية: اللحظة };
    طابق ابحث_في_خريطة_نص_فهرس(&(*الجدول).الفهارس, المفتاح) مع
    | اختياري.موجود(الموجودة) -> {
        الخانة := الموجودة;
        ليكن القديمة: حالة_مفتاح_معدل = (*الجدول).الحالات[الموجودة];
        إذا (اللحظة - القديمة.البداية < النافذة) { الحالة := القديمة; };
    }
    | اختياري.لا_شيء -> {
        طابق أزل_الأخير((*الجدول).الحرة) مع
        | اختياري.موجود(الحرة) -> { الخانة := الحرة; }
        | اختياري.لا_شيء -> {
            الخانة := الطول((*الجدول).الحالات) مثل طبيعي;
            ألحق((*الجدول).الحالات, الحالة);
        };
        ليكن تجاهل: نتيجة اختياري طبيعي, خطأ_إدراج_الخريطة =
            أدرج_في_خريطة_نص_فهرس(&متغير (*الجدول).الفهارس, استنسخ(المفتاح), الخانة);
    };
    إذا (الحالة.العدد >= الحد) {
        (*الجدول).الحالات[الخانة] := الحالة;
        ليكن المتبقي: عدد = النافذة - (اللحظة - الحالة.البداية);
        ليكن الانتظار: متغير طبيعي = ((المتبقي + 999999999) / 1000000000) مثل طبيعي;
        إذا (الانتظار == 0) { الانتظار := 1; };
        أرجع الانتظار;
    };
    الحالة.العدد := الحالة.العدد + 1;
    (*الجدول).الحالات[الخانة] := الحالة;
    أرجع 0;
}

عرف رد_كثرة_الطلبات(الانتظار: طبيعي): استجابة_ويب<متجه ط8> {
    ليكن النص: نص = «Too Many Requests»;
    ليكن الاستجابة: متغير استجابة_ويب<متجه ط8> = استجابة_نص_ويب(429, &النص);
    ليكن الاسم: نص = «retry-after»;
    ليكن القيمة: نص = طبيعي_إلى_نص(الانتظار);
    ليكن تجاهل: منطقي = عين_رأسا(&متغير الاستجابة, &الاسم, &القيمة);
    أرجع الاستجابة;
}

عرف نفذ_حد_المعدل<S>(
    المخزن: &مشترك<قفل<جدول_معدل> >,
    المفتاح: مفتاح_معدل<S>,
    الحد: طبيعي,
    النافذة: عدد,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    التالي: &التالي<S>
): استجابة_ويب<متجه ط8> {
    ليكن المفتاح_الحالي: نص = المفتاح(الحالة, الطلب);
    ليكن اللحظة: عدد = الآن();
    ليكن الانتظار: طبيعي = نفذ_مع_القفل(
        اقرأ_مشترك(المخزن),
        دالة(الجدول: &متغير جدول_معدل): طبيعي ->
            عد_طلبا(الجدول, &المفتاح_الحالي, الحد, النافذة, اللحظة)
    );
    إذا (الانتظار > 0) { أرجع رد_كثرة_الطلبات(الانتظار); };
    أرجع تابع(التالي, الطلب);
}

// At most الحد requests per key in each window of النافذة_بالثواني seconds.
عام عرف حد_المعدل<S>(
    الحد: طبيعي,
    النافذة_بالثواني: طبيعي,
    المفتاح: مفتاح_معدل<S>
): وسيط<S> {
    ليكن الجدول: جدول_معدل = جدول_معدل_جديد(الآن());
    ليكن المخزن: مشترك<قفل<جدول_معدل> > = أنشئ_مشترك(أنشئ_قفل(الجدول));
    ليكن النافذة: عدد = (النافذة_بالثواني مثل عدد) * 1000000000;
    ليكن التنفيذ: تنفيذ_وسيط<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        التالي: &التالي<S>
    ): استجابة_ويب<متجه ط8> -> نفذ_حد_المعدل(
        &المخزن, المفتاح, الحد, النافذة, الحالة, الطلب, التالي
    );
    ليكن المعطيات: متجه نص = [];
    أرجع وسيط_بمعطيات(التنفيذ, المعطيات);
}

// One budget shared by every request.
عام عرف مفتاح_عام<S>(): مفتاح_معدل<S> {
    أرجع دالة(الحالة: &S, الطلب: &طلب_ويب<متجه ط8>): نص -> «*»;
}

عرف قيمة_رأس_أو_فارغ(الطلب: &طلب_ويب<متجه ط8>, الاسم: &نص): نص {
    طابق أول_قيمة_رأس_ويب(&(*الطلب).الرؤوس, الاسم) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

// One budget per value of the header الاسم (requests without it share one).
عام عرف مفتاح_بالرأس<S>(الاسم: &نص): مفتاح_معدل<S> {
    ليكن اسم_الرأس: نص = استنسخ(الاسم);
    أرجع دالة(الحالة: &S, الطلب: &طلب_ويب<متجه ط8>): نص ->
        قيمة_رأس_أو_فارغ(الطلب, &اسم_الرأس);
}

// The client's IP address, without the port ("[::1]:5000" -> "[::1]").
عرف عنوان_العميل(الطلب: &طلب_ويب<متجه ط8>): نص {
    ليكن العنوان: &نص = &(*الطلب).العنوان_البعيد;
    ليكن العدد: طبيعي = الطول(*العنوان) مثل طبيعي;
    ليكن النقطتان: متغير طبيعي = العدد;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا ((*العنوان)[ف] == 0x3A) { النقطتان := ف; };
        ف := ف + 1;
    }
    ليكن الخرج: متغير متجه ط8 = [];
    احجز_سعة(الخرج, النقطتان);
    ف := 0;
    طالما (ف < النقطتان) { ألحق(الخرج, (*العنوان)[ف]); ف := ف + 1; }
    أرجع الخرج مثل نص;
}

// One budget per client IP address.
عام عرف مفتاح_بالعنوان<S>(): مفتاح_معدل<S> {
    أرجع دالة(الحالة: &S, الطلب: &طلب_ويب<متجه ط8>): نص -> عنوان_العميل(الطلب);
}

عام نوع rate_limit_key<S> = مفتاح_معدل<S>;
عام مرادف client_address_key = مفتاح_بالعنوان;
عام مرادف rate_limit = حد_المعدل;
عام مرادف global_key = مفتاح_عام;
عام مرادف header_key = مفتاح_بالرأس;
