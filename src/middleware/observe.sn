من std.http استورد
    طلب_ويب,
    استجابة_ويب;

استورد routing.router;

// Called after every request with the request and its final response.
عام نوع مراقب_طلب<S> = دالة(
    &S,
    &طلب_ويب<متجه ط8>,
    &استجابة_ويب<متجه ط8>
): فراغ;

عرف نفذ_مراقبة<S>(
    المراقب: مراقب_طلب<S>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    التالي: &التالي<S>
): استجابة_ويب<متجه ط8> {
    دع الاستجابة: استجابة_ويب<متجه ط8> = تابع(التالي, الطلب);
    المراقب(
        الحالة,
        الطلب,
        &الاستجابة
    );
    أرجع الاستجابة;
}

عام عرف راقب<S>(المراقب: مراقب_طلب<S>): وسيط<S> {
    دع التنفيذ: تنفيذ_وسيط<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        التالي: &التالي<S>
    ): استجابة_ويب<متجه ط8> -> نفذ_مراقبة(
        المراقب,
        الحالة,
        الطلب,
        التالي
    );
    دع المعطيات: متجه نص = [];
    أرجع وسيط_بمعطيات(التنفيذ, المعطيات);
}

عام نوع request_observer<S> = مراقب_طلب<S>;
عام مرادف observe = راقب;
