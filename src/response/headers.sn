من std.http استورد
    استجابة_ويب,
    رأس_ويب,
    ضع_رأس_ويب,
    قيم_رأس_ويب,
    أول_قيمة_رأس_ويب;

استورد std.text.transform;
استورد std.text.search;

// Public response name owned by the framework surface. The wire model stays
// owned by std.http.
عام نوع استجابة = استجابة_ويب<متجه ط8>;

عام عرف عين_رأسا(
    الاستجابة: &متغير استجابة,
    الاسم: &نص,
    القيمة: &نص
): منطقي {
    أرجع ضع_رأس_ويب(
        &متغير (*الاستجابة).الرؤوس,
        الاسم,
        القيمة
    );
}

عام عرف عين_نوع_المحتوى(
    الاستجابة: &متغير استجابة,
    النوع: &نص
): منطقي {
    دع الاسم: نص = «content-type»;
    أرجع عين_رأسا(الاستجابة, &الاسم, النوع);
}

// The items of a comma-separated header list (RFC 9110 §5.6.1) across every
// line of that header, trimmed, without empty items.
عام عرف عناصر_قائمة_رأس(
    الرؤوس: &متجه رأس_ويب,
    الاسم: &نص
): متجه نص {
    دع الناتج: متغير متجه نص = [];
    دع الأسطر: متجه نص = قيم_رأس_ويب(الرؤوس, الاسم);
    دع الفاصل: نص = «,»;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(الأسطر) مثل طبيعي)) {
        دع الأجزاء: متجه نص = قسم_النص(&الأسطر[ف], &الفاصل);
        دع ج: متغير طبيعي = 0;
        طالما (ج < (الطول(الأجزاء) مثل طبيعي)) {
            دع العنصر: نص = قص_النص(&الأجزاء[ج]);
            إذا ((الطول(العنصر) مثل طبيعي) > 0) {
                ألحق(الناتج, العنصر);
            };
            ج := ج + 1;
        }
        ف := ف + 1;
    }
    أرجع الناتج;
}

// Whether a header list already holds الرمز (ASCII case-insensitive).
عام عرف قائمة_رأس_تحتوي(
    الرؤوس: &متجه رأس_ويب,
    الاسم: &نص,
    الرمز: &نص
): منطقي {
    دع العناصر: متجه نص = عناصر_قائمة_رأس(الرؤوس, الاسم);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العناصر) مثل طبيعي)) {
        إذا (نصان_متساويان_بلا_حالة_أسكي(&العناصر[ف], الرمز)) {
            أرجع صواب;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Adds الرمز to the response's Vary list without dropping what other
// middleware already put there (Vary is a list, RFC 9110 §12.5.5).
عام عرف أضف_إلى_التغيير(
    الاستجابة: &متغير استجابة,
    الرمز: &نص
): منطقي {
    دع الاسم: نص = «vary»;
    دع النجمة: نص = «*»;
    إذا (قائمة_رأس_تحتوي(&(*الاستجابة).الرؤوس, &الاسم, الرمز)
        || قائمة_رأس_تحتوي(&(*الاستجابة).الرؤوس, &الاسم, &النجمة)) {
        أرجع صواب;
    };
    دع العناصر: متغير متجه نص =
        عناصر_قائمة_رأس(&(*الاستجابة).الرؤوس, &الاسم);
    ألحق(العناصر, استنسخ(الرمز));
    دع الفاصل: نص = «, »;
    دع القيمة: نص = صل_النصوص(&العناصر, &الفاصل);
    أرجع عين_رأسا(الاستجابة, &الاسم, &القيمة);
}

عام مرادف response = استجابة;
عام مرادف header_list_items = عناصر_قائمة_رأس;
عام مرادف header_list_contains = قائمة_رأس_تحتوي;
عام مرادف add_vary = أضف_إلى_التغيير;
عام مرادف set_header = عين_رأسا;
عام مرادف set_content_type = عين_نوع_المحتوى;
