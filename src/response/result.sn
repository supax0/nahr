من std.http استورد
    استجابة_ويب;

استورد response.headers;

عام نوع محول_خطأ<E> = دالة(
    &E
): استجابة_ويب<متجه ط8>;

عام عرف من_نتيجة<E>(
    النتيجة: نتيجة استجابة_ويب<متجه ط8>, E,
    المحول: محول_خطأ<E>
): استجابة {
    طابق النتيجة مع
    | نتيجة.نجح(الاستجابة) -> {
        أرجع الاستجابة;
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع المحول(&الخطأ);
    };
}

عام عرف بحالة(
    الاستجابة: استجابة,
    الحالة: طبيعي
): استجابة {
    ليكن الناتج: متغير استجابة = الاستجابة;
    الناتج.الحالة := الحالة;
    أرجع الناتج;
}

عام نوع error_mapper<E> = محول_خطأ<E>;
عام مرادف from_result = من_نتيجة;
عام مرادف with_status = بحالة;
