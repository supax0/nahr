من std.http استورد
    استجابة_بايتات_ويب,
    استجابة_نص_ويب;

من std.fs استورد
    اقرأ_بايتات_ملف;

من std.mime استورد
    نوع_وسائط,
    نوع_وسائط_لمسار_أو_افتراضي,
    نص_نوع_الوسائط;

من std.fs استورد
    فئة_خطأ_نظام,
    صنف_خطأ_نظام;

استورد std.text.transform;
استورد std.text.compare;
استورد response.headers;

عام عرف رد_ملف(
    المسار: &نص
): نتيجة استجابة, عدد {
    طابق اقرأ_بايتات_ملف(المسار) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(البايتات) -> {
        ليكن نوع_الوسائط: نوع_وسائط =
            نوع_وسائط_لمسار_أو_افتراضي(المسار);
        ليكن النوع: نص = نص_نوع_الوسائط(&نوع_الوسائط);
        أرجع نتيجة.نجح(
            استجابة_بايتات_ويب(
                200,
                البايتات,
                &النوع
            )
        );
    };
}

// Whether a request-supplied relative path stays inside its directory: no
// absolute path, no drive or backslash, no NUL, and no "." or ".." segment.
عام عرف مسار_نسبي_آمن(المسار: &نص): منطقي {
    ليكن العدد: طبيعي = الطول(*المسار) مثل طبيعي;
    إذا (العدد == 0) { أرجع خطأ; };
    إذا ((*المسار)[0] == 0x2F) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن ب: ط8 = (*المسار)[ف];
        إذا (ب == 0x00 || ب == 0x5C || ب == 0x3A) { أرجع خطأ; };
        ف := ف + 1;
    }
    ليكن الفاصل: نص = «/»;
    ليكن الأجزاء: متجه نص = قسم_النص(المسار, &الفاصل);
    ليكن نقطة: نص = «.»;
    ليكن نقطتان: نص = «..»;
    ف := 0;
    طالما (ف < (الطول(الأجزاء) مثل طبيعي)) {
        إذا (نصان_متساويان(&الأجزاء[ف], &نقطة)
            || نصان_متساويان(&الأجزاء[ف], &نقطتان)) {
            أرجع خطأ;
        };
        ف := ف + 1;
    }
    أرجع صواب;
}

// Serves النسبي (typically a `{*path}` route parameter) from inside الدليل.
// Paths that could leave the directory, and missing files, are 404; a
// permission failure is 403; other read failures are 500.
عام عرف رد_ملف_من_دليل(
    الدليل: &نص,
    النسبي: &نص
): استجابة {
    إذا (!مسار_نسبي_آمن(النسبي)) {
        ليكن النص: نص = «Not Found»;
        أرجع استجابة_نص_ويب(404, &النص);
    };
    ليكن الأجزاء: متجه نص = [استنسخ(الدليل), استنسخ(النسبي)];
    ليكن الفاصل: نص = «/»;
    ليكن المسار: نص = صل_النصوص(&الأجزاء, &الفاصل);
    طابق رد_ملف(&المسار) مع
    | نتيجة.نجح(الاستجابة) -> { أرجع الاستجابة; }
    | نتيجة.خطأ(الرمز) -> {
        طابق صنف_خطأ_نظام(الرمز) مع
        | فئة_خطأ_نظام.غير_موجود -> {
            ليكن النص: نص = «Not Found»;
            أرجع استجابة_نص_ويب(404, &النص);
        }
        | فئة_خطأ_نظام.ليس_دليلا -> {
            ليكن النص: نص = «Not Found»;
            أرجع استجابة_نص_ويب(404, &النص);
        }
        | فئة_خطأ_نظام.هو_دليل -> {
            ليكن النص: نص = «Not Found»;
            أرجع استجابة_نص_ويب(404, &النص);
        }
        | فئة_خطأ_نظام.مرفوض_الإذن -> {
            ليكن النص: نص = «Forbidden»;
            أرجع استجابة_نص_ويب(403, &النص);
        }
        | _ -> {
            ليكن النص: نص = «Internal Server Error»;
            أرجع استجابة_نص_ويب(500, &النص);
        };
    };
}

عام مرادف file_response = رد_ملف;
عام مرادف safe_relative_path = مسار_نسبي_آمن;
عام مرادف file_response_from_dir = رد_ملف_من_دليل;
