من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    استجابة_نص_ويب;

استورد extract.typed;

عام نوع مدقق<T, E> = دالة(
    &T
): نتيجة منطقي, E;

عام نوع محول_رفض_تحقق<E> = دالة(
    &E
): استجابة_ويب<متجه ط8>;

عرف نفذ_استخراج_متحقق<S, T, E>(
    الداخلي: تنفيذ_مستخرج<S, T>,
    المدقق: مدقق<T, E>,
    عند_الرفض: محول_رفض_تحقق<E>,
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة T, استجابة_ويب<متجه ط8> {
    طابق الداخلي(المعطيات, الإزاحة, الحالة, الطلب, المعاملات) مع
    | نتيجة.خطأ(الاستجابة) -> {
        أرجع نتيجة.خطأ(الاستجابة);
    }
    | نتيجة.نجح(القيمة) -> {
        طابق المدقق(&القيمة) مع
        | نتيجة.نجح(صالح) -> {
            إذا (صالح) { أرجع نتيجة.نجح(القيمة); };
            أرجع نتيجة.خطأ(رفض_تحقق_افتراضي());
        }
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(عند_الرفض(&الخطأ));
        };
    };
}

عرف رفض_تحقق_افتراضي(): استجابة_ويب<متجه ط8> {
    دع الرسالة: نص = «Validation failed»;
    أرجع استجابة_نص_ويب(422, &الرسالة);
}

// Runs المستخرج, then المدقق on its value. The wrapped extractor keeps its
// own text arguments.
عام عرف تحقق_مستخرجا<S, T, E>(
    المستخرج: مستخرج<S, T>,
    المدقق: مدقق<T, E>,
    عند_الرفض: محول_رفض_تحقق<E>
): مستخرج<S, T> {
    دع الداخلي: تنفيذ_مستخرج<S, T> = المستخرج.التنفيذ;
    دع التنفيذ: تنفيذ_مستخرج<S, T> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة T, استجابة_ويب<متجه ط8> -> نفذ_استخراج_متحقق(
        الداخلي,
        المدقق,
        عند_الرفض,
        المعطيات,
        الإزاحة,
        الحالة,
        الطلب,
        المعاملات
    );
    دع الناتج: مستخرج<S, T> = {
        التنفيذ: التنفيذ,
        المعطيات: استنسخ(&المستخرج.المعطيات)
    };
    أرجع الناتج;
}

عام نوع validator<T, E> = مدقق<T, E>;
عام نوع validation_rejection_mapper<E> = محول_رفض_تحقق<E>;
عام مرادف validate_extractor = تحقق_مستخرجا;
