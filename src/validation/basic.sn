استورد std.text.search;

عام نوع خطأ_تحقق =
    | أقصر_من_الحد
    | أطول_من_الحد
    | أصغر_من_الحد
    | أكبر_من_الحد
;

// Length bounds count characters (Unicode scalar values), not bytes: "علي"
// has length 3. الأعلى = 0 means no upper bound.
عام عرف تحقق_نصا(
    القيمة: &نص,
    الأدنى: طبيعي,
    الأعلى: طبيعي
): نتيجة منطقي, خطأ_تحقق {
    دع العدد: طبيعي = عدد_محارف_النص(القيمة);
    إذا (العدد < الأدنى) {
        أرجع نتيجة.خطأ(خطأ_تحقق.أقصر_من_الحد());
    };
    إذا ((الأعلى > 0) && (العدد > الأعلى)) {
        أرجع نتيجة.خطأ(خطأ_تحقق.أطول_من_الحد());
    };
    أرجع نتيجة.نجح(صواب);
}

عام عرف تحقق_عددا(
    القيمة: عدد,
    الأدنى: عدد,
    الأعلى: عدد
): نتيجة منطقي, خطأ_تحقق {
    إذا (القيمة < الأدنى) {
        أرجع نتيجة.خطأ(خطأ_تحقق.أصغر_من_الحد());
    };
    إذا (القيمة > الأعلى) {
        أرجع نتيجة.خطأ(خطأ_تحقق.أكبر_من_الحد());
    };
    أرجع نتيجة.نجح(صواب);
}

عام مرادف validation_error = خطأ_تحقق;
عام مرادف validate_text = تحقق_نصا;
عام مرادف validate_int = تحقق_عددا;
عام مرادف validation_error.too_short = خطأ_تحقق.أقصر_من_الحد;
عام مرادف validation_error.too_long = خطأ_تحقق.أطول_من_الحد;
عام مرادف validation_error.too_small = خطأ_تحقق.أصغر_من_الحد;
عام مرادف validation_error.too_large = خطأ_تحقق.أكبر_من_الحد;
