من std.text استورد من_بايتات;

استورد std.text.number;

// The values a template sees. A handler builds them from its own types (there
// is no reflection) and passes a context: named values, like the dict given to
// Jinja's render or the data given to Go's Execute.
//
//     دع السياق: متغير سياق_قالب = [];
//     عين_قيمة(&متغير السياق, «title», قيمة_نص(«Home»));
//
// نصية is escaped when it is printed; آمنة is HTML the program trusts and is
// printed as it is (Jinja's Markup, Go's template.HTML).
عام نوع قيمة_قالب =
    | نصية بنوع نص
    | آمنة بنوع نص
    | عددية بنوع عدد
    | منطقية بنوع منطقي
    | قائمة بنوع متجه قيمة_قالب
    | كائن بنوع متجه حقل_قالب
    | فارغة
;

عام نوع حقل_قالب = {
    الاسم: نص,
    القيمة: قيمة_قالب
};

// The variables a template is rendered with.
عام نوع سياق_قالب = متجه حقل_قالب;

عام عرف قيمة_نص(النص: نص): قيمة_قالب { أرجع قيمة_قالب.نصية(النص); }
عام عرف قيمة_آمنة(النص: نص): قيمة_قالب { أرجع قيمة_قالب.آمنة(النص); }
عام عرف قيمة_عدد(العدد: عدد): قيمة_قالب { أرجع قيمة_قالب.عددية(العدد); }
عام عرف قيمة_منطقية(القيمة: منطقي): قيمة_قالب { أرجع قيمة_قالب.منطقية(القيمة); }
عام عرف قيمة_قائمة(العناصر: متجه قيمة_قالب): قيمة_قالب { أرجع قيمة_قالب.قائمة(العناصر); }
عام عرف قيمة_كائن(الحقول: متجه حقل_قالب): قيمة_قالب { أرجع قيمة_قالب.كائن(الحقول); }
عام عرف قيمة_فارغة(): قيمة_قالب { أرجع قيمة_قالب.فارغة(); }

عام عرف حقل(الاسم: نص, القيمة: قيمة_قالب): حقل_قالب {
    ليكن الناتج: حقل_قالب = { الاسم: الاسم, القيمة: القيمة };
    أرجع الناتج;
}

// Sets الاسم in a context or an object's fields, replacing an earlier value.
عام عرف عين_قيمة(الحقول: &متغير متجه حقل_قالب, الاسم: نص, القيمة: قيمة_قالب): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الحقول) مثل طبيعي)) {
        إذا (بايتات_متساوية(&(*الحقول)[ف].الاسم, &الاسم)) {
            (*الحقول)[ف].القيمة := القيمة;
            أرجع;
        };
        ف := ف + 1;
    }
    ليكن الجديد: حقل_قالب = { الاسم: الاسم, القيمة: القيمة };
    ألحق(*الحقول, الجديد);
}

// A list value made from a vector of any type, one element at a time.
عام عرف قائمة_بـ<T>(العناصر: &متجه T, التحويل: دالة(&T): قيمة_قالب): قيمة_قالب {
    ليكن الناتج: متغير متجه قيمة_قالب = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العناصر) مثل طبيعي)) {
        ألحق(الناتج, التحويل(&(*العناصر)[ف]));
        ف := ف + 1;
    }
    أرجع قيمة_قالب.قائمة(الناتج);
}

// A list of text values.
عام عرف قائمة_نصوص(النصوص: &متجه نص): قيمة_قالب {
    ليكن الناتج: متغير متجه قيمة_قالب = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النصوص) مثل طبيعي)) {
        ألحق(الناتج, قيمة_قالب.نصية(استنسخ(&(*النصوص)[ف])));
        ف := ف + 1;
    }
    أرجع قيمة_قالب.قائمة(الناتج);
}

عرف بايتات_متساوية(الأول: &نص, الثاني: &نص): منطقي {
    ليكن العدد: طبيعي = الطول(*الأول) مثل طبيعي;
    إذا (العدد != (الطول(*الثاني) مثل طبيعي)) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا ((*الأول)[ف] != (*الثاني)[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

// ---- HTML escaping ----

// Appends النص to الخرج with & < > " ' escaped, as Jinja's autoescape and
// Go's html/template do in text and quoted attribute values.
عام عرف ألحق_مهربا(الخرج: &متغير متجه ط8, النص: &نص): فراغ {
    ليكن العدد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن ب: ط8 = (*النص)[ف];
        إذا (ب == 0x26) {
            ألحق(*الخرج, 0x26); ألحق(*الخرج, 0x61); ألحق(*الخرج, 0x6D); ألحق(*الخرج, 0x70); ألحق(*الخرج, 0x3B);
        } وإلا إذا (ب == 0x3C) {
            ألحق(*الخرج, 0x26); ألحق(*الخرج, 0x6C); ألحق(*الخرج, 0x74); ألحق(*الخرج, 0x3B);
        } وإلا إذا (ب == 0x3E) {
            ألحق(*الخرج, 0x26); ألحق(*الخرج, 0x67); ألحق(*الخرج, 0x74); ألحق(*الخرج, 0x3B);
        } وإلا إذا (ب == 0x22) {
            ألحق(*الخرج, 0x26); ألحق(*الخرج, 0x23); ألحق(*الخرج, 0x33); ألحق(*الخرج, 0x34); ألحق(*الخرج, 0x3B);
        } وإلا إذا (ب == 0x27) {
            ألحق(*الخرج, 0x26); ألحق(*الخرج, 0x23); ألحق(*الخرج, 0x33); ألحق(*الخرج, 0x39); ألحق(*الخرج, 0x3B);
        } وإلا {
            ألحق(*الخرج, ب);
        };
        ف := ف + 1;
    }
}

// Appends النص to الخرج as it is.
عام عرف ألحق_كما_هو(الخرج: &متغير متجه ط8, النص: &نص): فراغ {
    ليكن العدد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق(*الخرج, (*النص)[ف]);
        ف := ف + 1;
    }
}

// النص with & < > " ' escaped for HTML.
عام عرف اهرب_html(النص: &نص): نص {
    ليكن الخرج: متغير متجه ط8 = [];
    ألحق_مهربا(&متغير الخرج, النص);
    أرجع من_بايتات(&الخرج);
}

// The text a value prints as, before escaping: numbers in decimal, booleans
// as true/false, empty for فارغة, lists and objects.
عام عرف نص_القيمة(القيمة: &قيمة_قالب): نص {
    طابق *القيمة مع
    | قيمة_قالب.نصية(النص) -> { أرجع استنسخ(&النص); }
    | قيمة_قالب.آمنة(النص) -> { أرجع استنسخ(&النص); }
    | قيمة_قالب.عددية(العدد) -> { أرجع عدد_إلى_نص(العدد); }
    | قيمة_قالب.منطقية(القيمة) -> {
        إذا (القيمة) { أرجع «true»; };
        أرجع «false»;
    }
    | قيمة_قالب.قائمة(_) -> { أرجع «»; }
    | قيمة_قالب.كائن(_) -> { أرجع «»; }
    | قيمة_قالب.فارغة -> { أرجع «»; };
}

// Jinja's truth: false, 0, empty text, empty lists and objects and فارغة are
// false; everything else is true.
عام عرف قيمة_صادقة(القيمة: &قيمة_قالب): منطقي {
    طابق *القيمة مع
    | قيمة_قالب.نصية(النص) -> { أرجع الطول(النص) > 0; }
    | قيمة_قالب.آمنة(النص) -> { أرجع الطول(النص) > 0; }
    | قيمة_قالب.عددية(العدد) -> { أرجع العدد != 0; }
    | قيمة_قالب.منطقية(القيمة) -> { أرجع القيمة; }
    | قيمة_قالب.قائمة(العناصر) -> { أرجع الطول(العناصر) > 0; }
    | قيمة_قالب.كائن(الحقول) -> { أرجع الطول(الحقول) > 0; }
    | قيمة_قالب.فارغة -> { أرجع خطأ; };
}

عام نوع template_value = قيمة_قالب;
عام نوع template_field = حقل_قالب;
عام نوع template_context = سياق_قالب;
عام مرادف text_value = قيمة_نص;
عام مرادف safe_value = قيمة_آمنة;
عام مرادف int_value = قيمة_عدد;
عام مرادف bool_value = قيمة_منطقية;
عام مرادف list_value = قيمة_قائمة;
عام مرادف object_value = قيمة_كائن;
عام مرادف none_value = قيمة_فارغة;
عام مرادف field = حقل;
عام مرادف set_value = عين_قيمة;
عام مرادف list_of = قائمة_بـ;
عام مرادف text_list = قائمة_نصوص;
عام مرادف escape_html = اهرب_html;
