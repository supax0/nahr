من std.text استورد من_بايتات;

استورد std.text.number;
استورد template.value;

// Parses Jinja's syntax (the language of FastAPI's and Flask's templates;
// axum apps use it through minijinja):
//
//     {{ expr }}                     printed, HTML-escaped unless safe
//     {% if expr %} … {% elif expr %} … {% else %} … {% endif %}
//     {% for name in expr %} … {% else %} … {% endfor %}
//     {% include "file.html" %}
//     {% extends "base.html" %}  {% block name %} … {% endblock %}
//     {# comment #}
//     {%- … -%}  {{- … -}}          trim the whitespace next to the tag
//
// Expressions: names and paths (user.name, items.0), "text" and 'text',
// integers, true/false/none, not/and/or, == != < <= > >=, parentheses, and
// filters: x|safe, x|escape (e), x|length, x|default(y), x|join(", "),
// x|upper, x|lower, x|trim.

عام نوع خطأ_قالب = {
    القالب: نص,
    السطر: طبيعي,
    الرسالة: نص
};

عام نوع تعبير_قالب =
    | مسار بنوع متجه نص
    | ثابت بنوع قيمة_قالب
    | نفي بنوع متجه تعبير_قالب
    | ثنائي بنوع ثنائي_قالب
    | مرشح بنوع مرشح_قالب
;

// العامل: 1 or, 2 and, 3 ==, 4 !=, 5 <, 6 <=, 7 >, 8 >=.
عام نوع ثنائي_قالب = { العامل: طبيعي, الطرفان: متجه تعبير_قالب };

// الوسائط[0] is the filtered value.
عام نوع مرشح_قالب = { الاسم: نص, الوسائط: متجه تعبير_قالب, السطر: طبيعي };

عام نوع عقدة_قالب =
    | حرفي بنوع نص
    | إخراج بنوع إخراج_قالب
    | شرط بنوع شرط_قالب
    | حلقة بنوع حلقة_قالب
    | تضمين بنوع تضمين_قالب
    | كتلة بنوع كتلة_قالب
;

عام نوع إخراج_قالب = { التعبير: تعبير_قالب, السطر: طبيعي };
عام نوع فرع_قالب = { الشرط: تعبير_قالب, الجسم: متجه عقدة_قالب };
عام نوع شرط_قالب = { الفروع: متجه فرع_قالب, البديل: متجه عقدة_قالب };
عام نوع حلقة_قالب = {
    المتغير: نص,
    المصدر: تعبير_قالب,
    الجسم: متجه عقدة_قالب,
    البديل: متجه عقدة_قالب,
    السطر: طبيعي
};
عام نوع تضمين_قالب = { الاسم: نص, السطر: طبيعي };
عام نوع كتلة_قالب = { الاسم: نص, الجسم: متجه عقدة_قالب };

عام نوع قالب_مترجم = {
    الاسم: نص,
    العقد: متجه عقدة_قالب,
    // The template named by {% extends %}, or empty.
    الأب: نص
};

عرف خطأ_في(القالب: &نص, السطر: طبيعي, الرسالة: نص): خطأ_قالب {
    ليكن الخطأ: خطأ_قالب = { القالب: استنسخ(القالب), السطر: السطر, الرسالة: الرسالة };
    أرجع الخطأ;
}

// ---- splitting the source into text, {{ }} and {% %} ----

// النوع: 1 text, 2 output, 3 tag.
نوع مقطع = { النوع: ط8, المحتوى: نص, السطر: طبيعي };

عرف جزء(النص: &نص, البداية: طبيعي, النهاية: طبيعي): نص {
    ليكن الخرج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < النهاية) {
        ألحق(الخرج, (*النص)[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الخرج);
}

عرف فراغ_بايت(ب: ط8): منطقي {
    أرجع ب == 0x20 || ب == 0x09 || ب == 0x0A || ب == 0x0D;
}

عرف مقصوص(النص: &نص): نص {
    ليكن البداية: متغير طبيعي = 0;
    ليكن النهاية: متغير طبيعي = الطول(*النص) مثل طبيعي;
    طالما (البداية < النهاية && فراغ_بايت((*النص)[البداية])) { البداية := البداية + 1; }
    طالما (النهاية > البداية && فراغ_بايت((*النص)[النهاية - 1])) { النهاية := النهاية - 1; }
    أرجع جزء(النص, البداية, النهاية);
}

عرف قص_النهاية(النص: &نص): نص {
    ليكن النهاية: متغير طبيعي = الطول(*النص) مثل طبيعي;
    طالما (النهاية > 0 && فراغ_بايت((*النص)[النهاية - 1])) { النهاية := النهاية - 1; }
    أرجع جزء(النص, 0, النهاية);
}

عرف قص_البداية(النص: &نص): نص {
    ليكن البداية: متغير طبيعي = 0;
    ليكن العدد: طبيعي = الطول(*النص) مثل طبيعي;
    طالما (البداية < العدد && فراغ_بايت((*النص)[البداية])) { البداية := البداية + 1; }
    أرجع جزء(النص, البداية, العدد);
}

عرف أضف_نصا(المقاطع: &متغير متجه مقطع, النص: نص, السطر: طبيعي, قص_بدايته: منطقي): فراغ {
    ليكن القيمة: متغير نص = النص;
    إذا (قص_بدايته) { القيمة := قص_البداية(&القيمة); };
    إذا (الطول(القيمة) == 0) { أرجع; };
    ليكن المقطع: مقطع = { النوع: 1, المحتوى: القيمة, السطر: السطر };
    ألحق(*المقاطع, المقطع);
}

// Strips the whitespace at the end of the last text segment ({%- and {{-).
عرف قص_آخر_نص(المقاطع: &متغير متجه مقطع): فراغ {
    ليكن العدد: طبيعي = الطول(*المقاطع) مثل طبيعي;
    إذا (العدد == 0) { أرجع; };
    إذا ((*المقاطع)[العدد - 1].النوع != 1) { أرجع; };
    ليكن المقصوص: نص = قص_النهاية(&(*المقاطع)[العدد - 1].المحتوى);
    إذا (الطول(المقصوص) == 0) {
        ليكن تجاهل: اختياري مقطع = أزل_الأخير(*المقاطع);
    } وإلا {
        (*المقاطع)[العدد - 1].المحتوى := المقصوص;
    };
}

عرف قسم_المصدر(الاسم: &نص, المصدر: &نص): نتيجة متجه مقطع, خطأ_قالب {
    ليكن المقاطع: متغير متجه مقطع = [];
    ليكن العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    ليكن بداية_النص: متغير طبيعي = 0;
    ليكن سطر_النص: متغير طبيعي = 1;
    ليكن السطر: متغير طبيعي = 1;
    ليكن قص_التالي: متغير منطقي = خطأ;
    طالما (ف < العدد) {
        ليكن ب: ط8 = (*المصدر)[ف];
        ليكن التالي: متغير ط8 = 0;
        إذا (ف + 1 < العدد) { التالي := (*المصدر)[ف + 1]; };
        إذا (ب == 0x7B && (التالي == 0x7B || التالي == 0x25 || التالي == 0x23)) {
            أضف_نصا(&متغير المقاطع, جزء(المصدر, بداية_النص, ف), سطر_النص, قص_التالي);
            قص_التالي := خطأ;
            ليكن سطر_الوسم: طبيعي = السطر;
            // The closer: }} for {{, %} for {%, #} for {#.
            ليكن الغالق: متغير ط8 = 0x7D;
            إذا (التالي == 0x25) { الغالق := 0x25; };
            إذا (التالي == 0x23) { الغالق := 0x23; };
            ليكن البداية: متغير طبيعي = ف + 2;
            إذا (البداية < العدد && (*المصدر)[البداية] == 0x2D) {
                قص_آخر_نص(&متغير المقاطع);
                البداية := البداية + 1;
            };
            ليكن ي: متغير طبيعي = البداية;
            ليكن وجد: متغير منطقي = خطأ;
            طالما (ي + 1 < العدد && !وجد) {
                إذا ((*المصدر)[ي] == الغالق && (*المصدر)[ي + 1] == 0x7D) {
                    وجد := صواب;
                } وإلا {
                    إذا ((*المصدر)[ي] == 0x0A) { السطر := السطر + 1; };
                    ي := ي + 1;
                };
            }
            إذا (!وجد) {
                إذا (التالي == 0x23) { أرجع نتيجة.خطأ(خطأ_في(الاسم, سطر_الوسم, «comment {# is not closed with #}»)); };
                إذا (التالي == 0x25) { أرجع نتيجة.خطأ(خطأ_في(الاسم, سطر_الوسم, «tag {% is not closed with %}»)); };
                أرجع نتيجة.خطأ(خطأ_في(الاسم, سطر_الوسم, «{{ is not closed with }}»));
            };
            ليكن النهاية: متغير طبيعي = ي;
            إذا (النهاية > البداية && (*المصدر)[النهاية - 1] == 0x2D) {
                قص_التالي := صواب;
                النهاية := النهاية - 1;
            };
            إذا (التالي != 0x23) {
                ليكن المحتوى_الخام: نص = جزء(المصدر, البداية, النهاية);
                ليكن النوع: متغير ط8 = 2;
                إذا (التالي == 0x25) { النوع := 3; };
                ليكن المقطع: مقطع = { النوع: النوع, المحتوى: مقصوص(&المحتوى_الخام), السطر: سطر_الوسم };
                ألحق(المقاطع, المقطع);
            };
            ف := ي + 2;
            بداية_النص := ف;
            سطر_النص := السطر;
        } وإلا {
            إذا (ب == 0x0A) { السطر := السطر + 1; };
            ف := ف + 1;
        };
    }
    أضف_نصا(&متغير المقاطع, جزء(المصدر, بداية_النص, العدد), سطر_النص, قص_التالي);
    أرجع نتيجة.نجح(المقاطع);
}

// ---- expressions ----

// النوع: 0 end, 1 name, 2 string, 3 integer, 4 operator.
نوع رمز_تعبير = { النوع: ط8, النص: نص, العدد: عدد };

نوع محلل_تعبير = {
    الرموز: متجه رمز_تعبير,
    الموضع: طبيعي,
    القالب: نص,
    السطر: طبيعي
};

عرف بايت_اسم(ب: ط8): منطقي {
    أرجع (ب >= 0x61 && ب <= 0x7A) || (ب >= 0x41 && ب <= 0x5A)
        || (ب >= 0x30 && ب <= 0x39) || ب == 0x5F || ب >= 0x80;
}

عرف رمز(النوع: ط8, النص: نص, العدد: عدد): رمز_تعبير {
    ليكن الناتج: رمز_تعبير = { النوع: النوع, النص: النص, العدد: العدد };
    أرجع الناتج;
}

عرف رمز_بايتين(الأول: ط8, الثاني: ط8): نص {
    ليكن ب: متجه ط8 = [الأول, الثاني];
    أرجع من_بايتات(&ب);
}

عرف رمز_بايت(الأول: ط8): نص {
    ليكن ب: متجه ط8 = [الأول];
    أرجع من_بايتات(&ب);
}

عرف رمز_التعبير(القالب: &نص, السطر: طبيعي, النص: &نص): نتيجة متجه رمز_تعبير, خطأ_قالب {
    ليكن الرموز: متغير متجه رمز_تعبير = [];
    ليكن العدد: طبيعي = الطول(*النص) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ليكن ب: ط8 = (*النص)[ف];
        إذا (فراغ_بايت(ب)) {
            ف := ف + 1;
        } وإلا إذا (ب >= 0x30 && ب <= 0x39) {
            ليكن القيمة: متغير عدد = 0;
            طالما (ف < العدد && (*النص)[ف] >= 0x30 && (*النص)[ف] <= 0x39) {
                القيمة := القيمة * 10 + (((*النص)[ف] - 0x30) مثل عدد);
                ف := ف + 1;
            }
            ألحق(الرموز, رمز(3, «», القيمة));
        } وإلا إذا (بايت_اسم(ب)) {
            ليكن البداية: طبيعي = ف;
            طالما (ف < العدد && بايت_اسم((*النص)[ف])) { ف := ف + 1; }
            ألحق(الرموز, رمز(1, جزء(النص, البداية, ف), 0));
        } وإلا إذا (ب == 0x22 || ب == 0x27) {
            ليكن الخرج: متغير متجه ط8 = [];
            ف := ف + 1;
            ليكن مغلق: متغير منطقي = خطأ;
            طالما (ف < العدد && !مغلق) {
                ليكن ح: ط8 = (*النص)[ف];
                إذا (ح == ب) {
                    مغلق := صواب;
                } وإلا إذا (ح == 0x5C && ف + 1 < العدد) {
                    ف := ف + 1;
                    ليكن الهارب: ط8 = (*النص)[ف];
                    إذا (الهارب == 0x6E) { ألحق(الخرج, 0x0A); }
                    وإلا إذا (الهارب == 0x74) { ألحق(الخرج, 0x09); }
                    وإلا { ألحق(الخرج, الهارب); };
                } وإلا {
                    ألحق(الخرج, ح);
                };
                ف := ف + 1;
            }
            إذا (!مغلق) { أرجع نتيجة.خطأ(خطأ_في(القالب, السطر, «unterminated string»)); };
            ألحق(الرموز, رمز(2, من_بايتات(&الخرج), 0));
        } وإلا {
            ليكن التالي: متغير ط8 = 0;
            إذا (ف + 1 < العدد) { التالي := (*النص)[ف + 1]; };
            إذا ((ب == 0x3D || ب == 0x21 || ب == 0x3C || ب == 0x3E) && التالي == 0x3D) {
                ألحق(الرموز, رمز(4, رمز_بايتين(ب, التالي), 0));
                ف := ف + 2;
            } وإلا إذا (ب == 0x3C || ب == 0x3E || ب == 0x28 || ب == 0x29 || ب == 0x2E || ب == 0x7C || ب == 0x2C) {
                ألحق(الرموز, رمز(4, رمز_بايت(ب), 0));
                ف := ف + 1;
            } وإلا {
                ليكن الأجزاء: متجه نص = [«unexpected character '», رمز_بايت(ب), «' in expression»];
                أرجع نتيجة.خطأ(خطأ_في(القالب, السطر, ضم(&الأجزاء)));
            };
        };
    }
    ألحق(الرموز, رمز(0, «», 0));
    أرجع نتيجة.نجح(الرموز);
}

عرف ضم(الأجزاء: &متجه نص): نص {
    ليكن الخرج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأجزاء) مثل طبيعي)) {
        ألحق_كما_هو(&متغير الخرج, &(*الأجزاء)[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الخرج);
}

عرف نص_يساوي(النص: &نص, المطلوب: نص): منطقي {
    ليكن العدد: طبيعي = الطول(*النص) مثل طبيعي;
    إذا (العدد != (الطول(المطلوب) مثل طبيعي)) { أرجع خطأ; };
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا ((*النص)[ف] != المطلوب[ف]) { أرجع خطأ; };
        ف := ف + 1;
    }
    أرجع صواب;
}

عرف الحالي(المحلل: &محلل_تعبير): رمز_تعبير {
    أرجع استنسخ(&(*المحلل).الرموز[(*المحلل).الموضع]);
}

// Whether the current token is the operator or name الرمز.
عرف عند(المحلل: &محلل_تعبير, النوع: ط8, الرمز: نص): منطقي {
    ليكن ر: &رمز_تعبير = &(*المحلل).الرموز[(*المحلل).الموضع];
    أرجع (*ر).النوع == النوع && نص_يساوي(&(*ر).النص, الرمز);
}

عرف تقدم(المحلل: &متغير محلل_تعبير): فراغ {
    إذا ((*المحلل).الرموز[(*المحلل).الموضع].النوع != 0) {
        (*المحلل).الموضع := (*المحلل).الموضع + 1;
    };
}

عرف خطأ_محلل(المحلل: &محلل_تعبير, الرسالة: نص): خطأ_قالب {
    أرجع خطأ_في(&(*المحلل).القالب, (*المحلل).السطر, الرسالة);
}

عرف ثنائي_من(العامل: طبيعي, اليسار: تعبير_قالب, اليمين: تعبير_قالب): تعبير_قالب {
    ليكن الطرفان: متجه تعبير_قالب = [اليسار, اليمين];
    ليكن الناتج: ثنائي_قالب = { العامل: العامل, الطرفان: الطرفان };
    أرجع تعبير_قالب.ثنائي(الناتج);
}

عرف حلل_أو(المحلل: &متغير محلل_تعبير): نتيجة تعبير_قالب, خطأ_قالب {
    ليكن اليسار: متغير تعبير_قالب;
    طابق حلل_و(المحلل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(ت) -> { اليسار := ت; };
    طالما (عند(المحلل, 1, «or»)) {
        تقدم(المحلل);
        طابق حلل_و(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ت) -> { اليسار := ثنائي_من(1, اليسار, ت); };
    }
    أرجع نتيجة.نجح(اليسار);
}

عرف حلل_و(المحلل: &متغير محلل_تعبير): نتيجة تعبير_قالب, خطأ_قالب {
    ليكن اليسار: متغير تعبير_قالب;
    طابق حلل_نفي(المحلل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(ت) -> { اليسار := ت; };
    طالما (عند(المحلل, 1, «and»)) {
        تقدم(المحلل);
        طابق حلل_نفي(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ت) -> { اليسار := ثنائي_من(2, اليسار, ت); };
    }
    أرجع نتيجة.نجح(اليسار);
}

عرف حلل_نفي(المحلل: &متغير محلل_تعبير): نتيجة تعبير_قالب, خطأ_قالب {
    إذا (عند(المحلل, 1, «not»)) {
        تقدم(المحلل);
        طابق حلل_نفي(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ت) -> {
            ليكن الداخل: متجه تعبير_قالب = [ت];
            أرجع نتيجة.نجح(تعبير_قالب.نفي(الداخل));
        };
    };
    أرجع حلل_مقارنة(المحلل);
}

عرف عامل_مقارنة(المحلل: &محلل_تعبير): طبيعي {
    إذا (عند(المحلل, 4, «==»)) { أرجع 3; };
    إذا (عند(المحلل, 4, «!=»)) { أرجع 4; };
    إذا (عند(المحلل, 4, «<»)) { أرجع 5; };
    إذا (عند(المحلل, 4, «<=»)) { أرجع 6; };
    إذا (عند(المحلل, 4, «>»)) { أرجع 7; };
    إذا (عند(المحلل, 4, «>=»)) { أرجع 8; };
    أرجع 0;
}

عرف حلل_مقارنة(المحلل: &متغير محلل_تعبير): نتيجة تعبير_قالب, خطأ_قالب {
    ليكن اليسار: متغير تعبير_قالب;
    طابق حلل_مرشحات(المحلل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(ت) -> { اليسار := ت; };
    ليكن العامل: متغير طبيعي = عامل_مقارنة(المحلل);
    طالما (العامل != 0) {
        تقدم(المحلل);
        طابق حلل_مرشحات(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ت) -> { اليسار := ثنائي_من(العامل, اليسار, ت); };
        العامل := عامل_مقارنة(المحلل);
    }
    أرجع نتيجة.نجح(اليسار);
}

عرف حلل_مرشحات(المحلل: &متغير محلل_تعبير): نتيجة تعبير_قالب, خطأ_قالب {
    ليكن القيمة: متغير تعبير_قالب;
    طابق حلل_أولي(المحلل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(ت) -> { القيمة := ت; };
    طالما (عند(المحلل, 4, «|»)) {
        تقدم(المحلل);
        ليكن الاسم: رمز_تعبير = الحالي(المحلل);
        إذا (الاسم.النوع != 1) { أرجع نتيجة.خطأ(خطأ_محلل(المحلل, «expected a filter name after |»)); };
        تقدم(المحلل);
        ليكن الوسائط: متغير متجه تعبير_قالب = [القيمة];
        إذا (عند(المحلل, 4, «(»)) {
            تقدم(المحلل);
            إذا (!عند(المحلل, 4, «)»)) {
                ليكن مستمر: متغير منطقي = صواب;
                طالما (مستمر) {
                    طابق حلل_أو(المحلل) مع
                    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                    | نتيجة.نجح(ت) -> { ألحق(الوسائط, ت); };
                    إذا (عند(المحلل, 4, «,»)) { تقدم(المحلل); } وإلا { مستمر := خطأ; };
                }
            };
            إذا (!عند(المحلل, 4, «)»)) { أرجع نتيجة.خطأ(خطأ_محلل(المحلل, «expected ) after filter arguments»)); };
            تقدم(المحلل);
        };
        ليكن المرشح: مرشح_قالب = { الاسم: استنسخ(&الاسم.النص), الوسائط: الوسائط, السطر: (*المحلل).السطر };
        القيمة := تعبير_قالب.مرشح(المرشح);
    }
    أرجع نتيجة.نجح(القيمة);
}

عرف حلل_أولي(المحلل: &متغير محلل_تعبير): نتيجة تعبير_قالب, خطأ_قالب {
    ليكن ر: رمز_تعبير = الحالي(المحلل);
    إذا (ر.النوع == 2) {
        تقدم(المحلل);
        أرجع نتيجة.نجح(تعبير_قالب.ثابت(قيمة_قالب.نصية(استنسخ(&ر.النص))));
    };
    إذا (ر.النوع == 3) {
        تقدم(المحلل);
        أرجع نتيجة.نجح(تعبير_قالب.ثابت(قيمة_قالب.عددية(ر.العدد)));
    };
    إذا (عند(المحلل, 4, «(»)) {
        تقدم(المحلل);
        ليكن الداخل: متغير تعبير_قالب;
        طابق حلل_أو(المحلل) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ت) -> { الداخل := ت; };
        إذا (!عند(المحلل, 4, «)»)) { أرجع نتيجة.خطأ(خطأ_محلل(المحلل, «expected )»)); };
        تقدم(المحلل);
        أرجع نتيجة.نجح(الداخل);
    };
    إذا (ر.النوع == 1) {
        إذا (نص_يساوي(&ر.النص, «true») || نص_يساوي(&ر.النص, «True»)) {
            تقدم(المحلل); أرجع نتيجة.نجح(تعبير_قالب.ثابت(قيمة_قالب.منطقية(صواب)));
        };
        إذا (نص_يساوي(&ر.النص, «false») || نص_يساوي(&ر.النص, «False»)) {
            تقدم(المحلل); أرجع نتيجة.نجح(تعبير_قالب.ثابت(قيمة_قالب.منطقية(خطأ)));
        };
        إذا (نص_يساوي(&ر.النص, «none») || نص_يساوي(&ر.النص, «None»)) {
            تقدم(المحلل); أرجع نتيجة.نجح(تعبير_قالب.ثابت(قيمة_قالب.فارغة()));
        };
        ليكن الأجزاء: متغير متجه نص = [استنسخ(&ر.النص)];
        تقدم(المحلل);
        طالما (عند(المحلل, 4, «.»)) {
            تقدم(المحلل);
            ليكن التالي: رمز_تعبير = الحالي(المحلل);
            إذا (التالي.النوع == 1) {
                ألحق(الأجزاء, استنسخ(&التالي.النص));
            } وإلا إذا (التالي.النوع == 3) {
                ألحق(الأجزاء, عدد_إلى_نص(التالي.العدد));
            } وإلا {
                أرجع نتيجة.خطأ(خطأ_محلل(المحلل, «expected a name after .»));
            };
            تقدم(المحلل);
        }
        أرجع نتيجة.نجح(تعبير_قالب.مسار(الأجزاء));
    };
    إذا (ر.النوع == 0) { أرجع نتيجة.خطأ(خطأ_محلل(المحلل, «expected an expression»)); };
    ليكن الأجزاء: متجه نص = [«unexpected '», استنسخ(&ر.النص), «' in expression»];
    أرجع نتيجة.خطأ(خطأ_محلل(المحلل, ضم(&الأجزاء)));
}

عرف محلل_لـ(القالب: &نص, السطر: طبيعي, النص: &نص): نتيجة محلل_تعبير, خطأ_قالب {
    طابق رمز_التعبير(القالب, السطر, النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الرموز) -> {
        ليكن المحلل: محلل_تعبير = { الرموز: الرموز, الموضع: 0, القالب: استنسخ(القالب), السطر: السطر };
        أرجع نتيجة.نجح(المحلل);
    };
}

// A whole expression; anything after it is an error.
عرف حلل_تعبيرا_كاملا(المحلل: &متغير محلل_تعبير): نتيجة تعبير_قالب, خطأ_قالب {
    طابق حلل_أو(المحلل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(ت) -> {
        ليكن الباقي: رمز_تعبير = الحالي(المحلل);
        إذا (الباقي.النوع != 0) {
            ليكن الأجزاء: متجه نص = [«unexpected '», استنسخ(&الباقي.النص), «' after expression»];
            أرجع نتيجة.خطأ(خطأ_محلل(المحلل, ضم(&الأجزاء)));
        };
        أرجع نتيجة.نجح(ت);
    };
}

// ---- tags ----

نوع محلل_قالب = {
    المقاطع: متجه مقطع,
    الموضع: طبيعي,
    الاسم: نص,
    الأب: نص
};

// The first word of a tag and the rest after it.
عرف كلمة_الوسم(المحتوى: &نص): نص {
    ليكن العدد: طبيعي = الطول(*المحتوى) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد && بايت_اسم((*المحتوى)[ف])) { ف := ف + 1; }
    أرجع جزء(المحتوى, 0, ف);
}

عرف بعد_الكلمة(المحتوى: &نص): نص {
    ليكن العدد: طبيعي = الطول(*المحتوى) مثل طبيعي;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < العدد && بايت_اسم((*المحتوى)[ف])) { ف := ف + 1; }
    ليكن الباقي: نص = جزء(المحتوى, ف, العدد);
    أرجع مقصوص(&الباقي);
}

// Whether the segment at the position is a tag whose word is one of الكلمات.
عرف وسم_من(المحلل: &محلل_قالب, الكلمات: &متجه نص): منطقي {
    إذا ((*المحلل).الموضع >= (الطول((*المحلل).المقاطع) مثل طبيعي)) { أرجع خطأ; };
    ليكن المقطع: &مقطع = &(*المحلل).المقاطع[(*المحلل).الموضع];
    إذا ((*المقطع).النوع != 3) { أرجع خطأ; };
    ليكن الكلمة: نص = كلمة_الوسم(&(*المقطع).المحتوى);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الكلمات) مثل طبيعي)) {
        إذا (نص_يساوي(&الكلمة, استنسخ(&(*الكلمات)[ف]))) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف تعبير_من(المحلل: &محلل_قالب, النص: &نص, السطر: طبيعي): نتيجة تعبير_قالب, خطأ_قالب {
    طابق محلل_لـ(&(*المحلل).الاسم, السطر, النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(م) -> {
        ليكن المحلل_الفرعي: متغير محلل_تعبير = م;
        أرجع حلل_تعبيرا_كاملا(&متغير المحلل_الفرعي);
    };
}

// A quoted name: "file.html" or 'file.html'.
عرف اسم_مقتبس(المحلل: &محلل_قالب, النص: &نص, السطر: طبيعي, الوسم: نص): نتيجة نص, خطأ_قالب {
    طابق رمز_التعبير(&(*المحلل).الاسم, السطر, النص) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الرموز) -> {
        إذا (الطول(الرموز) == 2 && الرموز[0].النوع == 2) { أرجع نتيجة.نجح(استنسخ(&الرموز[0].النص)); };
        ليكن الأجزاء: متجه نص = [الوسم, « expects a quoted template name»];
        أرجع نتيجة.خطأ(خطأ_في(&(*المحلل).الاسم, السطر, ضم(&الأجزاء)));
    };
}

عرف وسم_غير_متوقع(المحلل: &محلل_قالب, المقطع: &مقطع): خطأ_قالب {
    ليكن الأجزاء: متجه نص = [«unexpected {% », استنسخ(&(*المقطع).المحتوى), « %}»];
    أرجع خطأ_في(&(*المحلل).الاسم, (*المقطع).السطر, ضم(&الأجزاء));
}

// Parses nodes until a tag whose word is in النهايات (left unconsumed) or the
// end of the template.
عرف حلل_عقدا(المحلل: &متغير محلل_قالب, النهايات: &متجه نص): نتيجة متجه عقدة_قالب, خطأ_قالب {
    ليكن العقد: متغير متجه عقدة_قالب = [];
    طالما ((*المحلل).الموضع < (الطول((*المحلل).المقاطع) مثل طبيعي)) {
        إذا (وسم_من(المحلل, النهايات)) { أرجع نتيجة.نجح(العقد); };
        ليكن المقطع: مقطع = استنسخ(&(*المحلل).المقاطع[(*المحلل).الموضع]);
        (*المحلل).الموضع := (*المحلل).الموضع + 1;
        إذا (المقطع.النوع == 1) {
            ألحق(العقد, عقدة_قالب.حرفي(استنسخ(&المقطع.المحتوى)));
        } وإلا إذا (المقطع.النوع == 2) {
            طابق تعبير_من(المحلل, &المقطع.المحتوى, المقطع.السطر) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(ت) -> {
                ليكن الإخراج: إخراج_قالب = { التعبير: ت, السطر: المقطع.السطر };
                ألحق(العقد, عقدة_قالب.إخراج(الإخراج));
            };
        } وإلا {
            ليكن الكلمة: نص = كلمة_الوسم(&المقطع.المحتوى);
            ليكن الباقي: نص = بعد_الكلمة(&المقطع.المحتوى);
            إذا (نص_يساوي(&الكلمة, «if»)) {
                طابق حلل_شرطا(المحلل, &الباقي, المقطع.السطر) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(ع) -> { ألحق(العقد, ع); };
            } وإلا إذا (نص_يساوي(&الكلمة, «for»)) {
                طابق حلل_حلقة(المحلل, &الباقي, المقطع.السطر) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(ع) -> { ألحق(العقد, ع); };
            } وإلا إذا (نص_يساوي(&الكلمة, «include»)) {
                طابق اسم_مقتبس(المحلل, &الباقي, المقطع.السطر, «include») مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الاسم) -> {
                    ليكن التضمين: تضمين_قالب = { الاسم: الاسم, السطر: المقطع.السطر };
                    ألحق(العقد, عقدة_قالب.تضمين(التضمين));
                };
            } وإلا إذا (نص_يساوي(&الكلمة, «extends»)) {
                طابق اسم_مقتبس(المحلل, &الباقي, المقطع.السطر, «extends») مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(الاسم) -> {
                    إذا (الطول((*المحلل).الأب) > 0) {
                        أرجع نتيجة.خطأ(خطأ_في(&(*المحلل).الاسم, المقطع.السطر, «a template can extend only one template»));
                    };
                    (*المحلل).الأب := الاسم;
                };
            } وإلا إذا (نص_يساوي(&الكلمة, «block»)) {
                طابق حلل_كتلة(المحلل, &الباقي, المقطع.السطر) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(ع) -> { ألحق(العقد, ع); };
            } وإلا {
                أرجع نتيجة.خطأ(وسم_غير_متوقع(المحلل, &المقطع));
            };
        };
    }
    إذا (الطول(*النهايات) > 0) {
        ليكن الأجزاء: متجه نص = [«missing {% », استنسخ(&(*النهايات)[الطول(*النهايات) - 1]), « %}»];
        أرجع نتيجة.خطأ(خطأ_في(&(*المحلل).الاسم, 0, ضم(&الأجزاء)));
    };
    أرجع نتيجة.نجح(العقد);
}

// The current tag (one of the ends just reached); consumes it.
عرف خذ_الوسم(المحلل: &متغير محلل_قالب): مقطع {
    ليكن المقطع: مقطع = استنسخ(&(*المحلل).المقاطع[(*المحلل).الموضع]);
    (*المحلل).الموضع := (*المحلل).الموضع + 1;
    أرجع المقطع;
}

عرف حلل_شرطا(المحلل: &متغير محلل_قالب, الشرط_الأول: &نص, السطر: طبيعي): نتيجة عقدة_قالب, خطأ_قالب {
    ليكن النهايات: متجه نص = [«elif», «else», «endif»];
    ليكن الفروع: متغير متجه فرع_قالب = [];
    ليكن البديل: متغير متجه عقدة_قالب = [];
    ليكن نص_الشرط: متغير نص = استنسخ(الشرط_الأول);
    ليكن سطر_الشرط: متغير طبيعي = السطر;
    ليكن انتهى: متغير منطقي = خطأ;
    طالما (!انتهى) {
        ليكن الشرط: متغير تعبير_قالب;
        طابق تعبير_من(المحلل, &نص_الشرط, سطر_الشرط) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ت) -> { الشرط := ت; };
        طابق حلل_عقدا(المحلل, &النهايات) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الجسم) -> {
            ليكن الفرع: فرع_قالب = { الشرط: الشرط, الجسم: الجسم };
            ألحق(الفروع, الفرع);
        };
        ليكن الوسم: مقطع = خذ_الوسم(المحلل);
        ليكن الكلمة: نص = كلمة_الوسم(&الوسم.المحتوى);
        إذا (نص_يساوي(&الكلمة, «elif»)) {
            نص_الشرط := بعد_الكلمة(&الوسم.المحتوى);
            سطر_الشرط := الوسم.السطر;
        } وإلا إذا (نص_يساوي(&الكلمة, «else»)) {
            ليكن النهاية: متجه نص = [«endif»];
            طابق حلل_عقدا(المحلل, &النهاية) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(الجسم) -> { البديل := الجسم; };
            ليكن تجاهل: مقطع = خذ_الوسم(المحلل);
            انتهى := صواب;
        } وإلا {
            انتهى := صواب;
        };
    }
    ليكن الناتج: شرط_قالب = { الفروع: الفروع, البديل: البديل };
    أرجع نتيجة.نجح(عقدة_قالب.شرط(الناتج));
}

عرف حلل_حلقة(المحلل: &متغير محلل_قالب, الرأس: &نص, السطر: طبيعي): نتيجة عقدة_قالب, خطأ_قالب {
    ليكن المتغير: نص = كلمة_الوسم(الرأس);
    ليكن الباقي: نص = بعد_الكلمة(الرأس);
    ليكن كلمة_في: نص = كلمة_الوسم(&الباقي);
    إذا (الطول(المتغير) == 0 || !نص_يساوي(&كلمة_في, «in»)) {
        أرجع نتيجة.خطأ(خطأ_في(&(*المحلل).الاسم, السطر, «for expects: for name in expression»));
    };
    ليكن نص_المصدر: نص = بعد_الكلمة(&الباقي);
    ليكن المصدر: متغير تعبير_قالب;
    طابق تعبير_من(المحلل, &نص_المصدر, السطر) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(ت) -> { المصدر := ت; };
    ليكن النهايات: متجه نص = [«else», «endfor»];
    ليكن الجسم: متغير متجه عقدة_قالب = [];
    طابق حلل_عقدا(المحلل, &النهايات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(ع) -> { الجسم := ع; };
    ليكن البديل: متغير متجه عقدة_قالب = [];
    ليكن الوسم: مقطع = خذ_الوسم(المحلل);
    ليكن كلمة_النهاية: نص = كلمة_الوسم(&الوسم.المحتوى);
    إذا (نص_يساوي(&كلمة_النهاية, «else»)) {
        ليكن النهاية: متجه نص = [«endfor»];
        طابق حلل_عقدا(المحلل, &النهاية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ع) -> { البديل := ع; };
        ليكن تجاهل: مقطع = خذ_الوسم(المحلل);
    };
    ليكن الحلقة: حلقة_قالب = {
        المتغير: المتغير,
        المصدر: المصدر,
        الجسم: الجسم,
        البديل: البديل,
        السطر: السطر
    };
    أرجع نتيجة.نجح(عقدة_قالب.حلقة(الحلقة));
}

عرف حلل_كتلة(المحلل: &متغير محلل_قالب, الرأس: &نص, السطر: طبيعي): نتيجة عقدة_قالب, خطأ_قالب {
    ليكن الاسم: نص = كلمة_الوسم(الرأس);
    إذا (الطول(الاسم) == 0) {
        أرجع نتيجة.خطأ(خطأ_في(&(*المحلل).الاسم, السطر, «block expects a name»));
    };
    ليكن النهايات: متجه نص = [«endblock»];
    طابق حلل_عقدا(المحلل, &النهايات) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(الجسم) -> {
        ليكن تجاهل: مقطع = خذ_الوسم(المحلل);
        ليكن الكتلة: كتلة_قالب = { الاسم: الاسم, الجسم: الجسم };
        أرجع نتيجة.نجح(عقدة_قالب.كتلة(الكتلة));
    };
}

// Parses المصدر as the template الاسم.
عام عرف ترجم_قالبا(الاسم: نص, المصدر: &نص): نتيجة قالب_مترجم, خطأ_قالب {
    طابق قسم_المصدر(&الاسم, المصدر) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المقاطع) -> {
        ليكن المحلل: متغير محلل_قالب = { المقاطع: المقاطع, الموضع: 0, الاسم: استنسخ(&الاسم), الأب: «» };
        ليكن لا_نهايات: متجه نص = [];
        طابق حلل_عقدا(&متغير المحلل, &لا_نهايات) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(العقد) -> {
            ليكن القالب: قالب_مترجم = { الاسم: الاسم, العقد: العقد, الأب: استنسخ(&المحلل.الأب) };
            أرجع نتيجة.نجح(القالب);
        };
    };
}

// "name:line: message", or "name: message" without a line.
عام عرف وصف_خطأ_قالب(الخطأ: &خطأ_قالب): نص {
    إذا ((*الخطأ).السطر == 0) {
        ليكن الأجزاء: متجه نص = [استنسخ(&(*الخطأ).القالب), «: », استنسخ(&(*الخطأ).الرسالة)];
        أرجع ضم(&الأجزاء);
    };
    ليكن الأجزاء: متجه نص = [
        استنسخ(&(*الخطأ).القالب), «:», طبيعي_إلى_نص((*الخطأ).السطر), «: », استنسخ(&(*الخطأ).الرسالة)
    ];
    أرجع ضم(&الأجزاء);
}

عام نوع template_error = خطأ_قالب;
عام نوع compiled_template = قالب_مترجم;
عام مرادف compile_template = ترجم_قالبا;
عام مرادف template_error_text = وصف_خطأ_قالب;
