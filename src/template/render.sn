من std.http استورد
    استجابة_بايتات_ويب,
    استجابة_نص_ويب;

من std.text استورد من_بايتات;

من std.fs استورد
    اقرأ_الملف,
    اقرأ_مدخلات_الدليل,
    نوع_مدخل_دليل;


استورد std.text.number;
استورد std.text.compare;
استورد std.text.transform;
استورد template.value;
استورد template.parse;
استورد response.headers;
استورد log.log;

// A set of named templates, like Jinja's Environment or Go's template set.
//
//     طابق حمل_قوالب(«templates») مع
//     | نتيجة.نجح(القوالب) -> { … }
//     | نتيجة.خطأ(الخطأ) -> { اطبع_سطر(وصف_خطأ_قالب(&الخطأ)); }
//
// Templates are parsed once, when they are loaded. With إعادة_التحميل (for
// development), each render reads the directory again, so edits show without
// a restart (Jinja's auto_reload). With صارم, an undefined name is an error
// (Jinja's StrictUndefined); otherwise it prints as empty.
عام نوع قوالب = {
    القوالب: متجه قالب_مترجم,
    الدليل: نص,
    إعادة_التحميل: منطقي,
    صارم: منطقي
};

عام عرف قوالب_جديدة(): قوالب {
    دع الناتج: قوالب = { القوالب: [], الدليل: «», إعادة_التحميل: خطأ, صارم: خطأ };
    أرجع الناتج;
}

عرف خطأ_عام(القالب: &نص, الأجزاء: &متجه نص): خطأ_قالب {
    دع الخطأ: خطأ_قالب = { القالب: استنسخ(القالب), السطر: 0, الرسالة: ضم_نصوص(الأجزاء) };
    أرجع الخطأ;
}

عرف خطأ_سطر(القالب: &نص, السطر: طبيعي, الأجزاء: &متجه نص): خطأ_قالب {
    دع الخطأ: خطأ_قالب = { القالب: استنسخ(القالب), السطر: السطر, الرسالة: ضم_نصوص(الأجزاء) };
    أرجع الخطأ;
}

عرف ضم_نصوص(الأجزاء: &متجه نص): نص {
    دع الخرج: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الأجزاء) مثل طبيعي)) {
        ألحق_كما_هو(&متغير الخرج, &(*الأجزاء)[ف]);
        ف := ف + 1;
    }
    أرجع من_بايتات(&الخرج);
}

// Adds (or replaces) the template الاسم parsed from المصدر.
عام عرف أضف_قالبا(المجموعة: &متغير قوالب, الاسم: نص, المصدر: نص): نتيجة طبيعي, خطأ_قالب {
    طابق ترجم_قالبا(الاسم, &المصدر) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القالب) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*المجموعة).القوالب) مثل طبيعي)) {
            إذا (نصان_متساويان(&(*المجموعة).القوالب[ف].الاسم, &القالب.الاسم)) {
                (*المجموعة).القوالب[ف] := القالب;
                أرجع نتيجة.نجح(ف);
            };
            ف := ف + 1;
        }
        ألحق((*المجموعة).القوالب, القالب);
        أرجع نتيجة.نجح(ف);
    };
}

عرف ضم_مسارين(الأول: &نص, الثاني: &نص): نص {
    إذا (الطول(*الأول) == 0) { أرجع استنسخ(الثاني); };
    إذا (الطول(*الثاني) == 0) { أرجع استنسخ(الأول); };
    دع الخرج: متغير متجه ط8 = [];
    ألحق_كما_هو(&متغير الخرج, الأول);
    ألحق(الخرج, 0x2F);
    ألحق_كما_هو(&متغير الخرج, الثاني);
    أرجع من_بايتات(&الخرج);
}

// Loads every file under الجذر/النسبي, recursively; hidden entries (a name
// starting with ".") are skipped.
عرف حمل_دليلا(المجموعة: &متغير قوالب, الجذر: &نص, النسبي: &نص): نتيجة طبيعي, خطأ_قالب {
    دع الكامل: نص = ضم_مسارين(الجذر, النسبي);
    دع المدخلات: متغير متجه مدخل_دليل_نهر = [];
    طابق اقرأ_مدخلات_الدليل(&الكامل) مع
    | نتيجة.خطأ(_) -> {
        دع الأجزاء: متجه نص = [«cannot read the template directory », الكامل];
        أرجع نتيجة.خطأ(خطأ_عام(الجذر, &الأجزاء));
    }
    | نتيجة.نجح(القائمة) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(القائمة) مثل طبيعي)) {
            دع نوعه: متغير ط8 = 0;
            طابق القائمة[ف].النوع مع
            | نوع_مدخل_دليل.ملف -> { نوعه := 1; }
            | نوع_مدخل_دليل.دليل -> { نوعه := 2; }
            | نوع_مدخل_دليل.وصلة_رمزية -> { نوعه := 1; }
            | نوع_مدخل_دليل.آخر -> { نوعه := 0; };
            دع المدخل: مدخل_دليل_نهر = { الاسم: استنسخ(&القائمة[ف].الاسم), النوع: نوعه };
            ألحق(المدخلات, المدخل);
            ف := ف + 1;
        }
    };
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المدخلات) مثل طبيعي)) {
        دع الاسم: نص = استنسخ(&المدخلات[ف].الاسم);
        دع مخفي: منطقي = الطول(الاسم) > 0 && الاسم[0] == 0x2E;
        دع اسمه: نص = ضم_مسارين(النسبي, &الاسم);
        إذا (!مخفي && المدخلات[ف].النوع == 2) {
            طابق حمل_دليلا(المجموعة, الجذر, &اسمه) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
        } وإلا إذا (!مخفي && المدخلات[ف].النوع == 1) {
            دع المسار: نص = ضم_مسارين(الجذر, &اسمه);
            طابق اقرأ_الملف(&المسار) مع
            | نتيجة.خطأ(_) -> {
                دع الأجزاء: متجه نص = [«cannot read the template file », المسار];
                أرجع نتيجة.خطأ(خطأ_عام(&اسمه, &الأجزاء));
            }
            | نتيجة.نجح(المصدر) -> {
                طابق أضف_قالبا(المجموعة, اسمه, المصدر) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
            };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(الطول((*المجموعة).القوالب) مثل طبيعي);
}

// النوع: 1 file, 2 directory, 0 other.
نوع مدخل_دليل_نهر = { الاسم: نص, النوع: ط8 };

// Loads and parses every template under الدليل. A parse error names the
// file and line.
عام عرف حمل_قوالب(الدليل: نص): نتيجة قوالب, خطأ_قالب {
    دع المجموعة: متغير قوالب = قوالب_جديدة();
    دع فارغ: نص = «»;
    طابق حمل_دليلا(&متغير المجموعة, &الدليل, &فارغ) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    المجموعة.الدليل := الدليل;
    أرجع نتيجة.نجح(المجموعة);
}

// ---- rendering ----

نوع حالة_عرض = {
    الخرج: متجه ط8,
    // Loop variables, innermost last.
    المحلية: متجه حقل_قالب,
    // The blocks of the templates being extended, most derived first.
    الكتل: متجه كتلة_قالب,
    العمق: طبيعي,
    صارم: منطقي
};

عرف جد_قالبا(المجموعة: &قوالب, الاسم: &نص): اختياري طبيعي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المجموعة).القوالب) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*المجموعة).القوالب[ف].الاسم, الاسم)) { أرجع اختياري.موجود(ف); };
        ف := ف + 1;
    }
    أرجع اختياري.لا_شيء();
}

عرف فيه_كتلة(الكتل: &متجه كتلة_قالب, الاسم: &نص): منطقي {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الكتل) مثل طبيعي)) {
        إذا (نصان_متساويان(&(*الكتل)[ف].الاسم, الاسم)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Adds the blocks defined anywhere in العقد that الكتل does not have yet.
عرف اجمع_الكتل(العقد: &متجه عقدة_قالب, الكتل: &متغير متجه كتلة_قالب): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العقد) مثل طبيعي)) {
        طابق (*العقد)[ف] مع
        | عقدة_قالب.كتلة(الكتلة) -> {
            إذا (!فيه_كتلة(الكتل, &الكتلة.الاسم)) { ألحق(*الكتل, استنسخ(&الكتلة)); };
            اجمع_الكتل(&الكتلة.الجسم, الكتل);
        }
        | عقدة_قالب.شرط(الشرط) -> {
            دع ي: متغير طبيعي = 0;
            طالما (ي < (الطول(الشرط.الفروع) مثل طبيعي)) {
                اجمع_الكتل(&الشرط.الفروع[ي].الجسم, الكتل);
                ي := ي + 1;
            }
            اجمع_الكتل(&الشرط.البديل, الكتل);
        }
        | عقدة_قالب.حلقة(الحلقة) -> {
            اجمع_الكتل(&الحلقة.الجسم, الكتل);
            اجمع_الكتل(&الحلقة.البديل, الكتل);
        }
        | _ -> { };
        ف := ف + 1;
    }
}

// Renders the template الاسم into the state: follows {% extends %} to the
// root template and renders it with the derived templates' blocks.
عرف اعرض_مسمى(
    المجموعة: &قوالب,
    السياق: &سياق_قالب,
    الاسم: &نص,
    السطر: طبيعي,
    الحالة: &متغير حالة_عرض
): نتيجة طبيعي, خطأ_قالب {
    إذا ((*الحالة).العمق > 32) {
        دع الأجزاء: متجه نص = [«templates nest more than 32 deep (an include or extends loop?)»];
        أرجع نتيجة.خطأ(خطأ_عام(الاسم, &الأجزاء));
    };
    دع الفهرس: متغير طبيعي = 0;
    طابق جد_قالبا(المجموعة, الاسم) مع
    | اختياري.موجود(ف) -> { الفهرس := ف; }
    | اختياري.لا_شيء -> {
        دع الأجزاء: متجه نص = [«template not found: », استنسخ(الاسم)];
        أرجع نتيجة.خطأ(خطأ_سطر(الاسم, السطر, &الأجزاء));
    };
    دع الكتل: متغير متجه كتلة_قالب = [];
    دع الخطوات: متغير طبيعي = 0;
    طالما (الطول((*المجموعة).القوالب[الفهرس].الأب) > 0) {
        اجمع_الكتل(&(*المجموعة).القوالب[الفهرس].العقد, &متغير الكتل);
        دع الأب: نص = استنسخ(&(*المجموعة).القوالب[الفهرس].الأب);
        طابق جد_قالبا(المجموعة, &الأب) مع
        | اختياري.موجود(ف) -> { الفهرس := ف; }
        | اختياري.لا_شيء -> {
            دع الأجزاء: متجه نص = [«extends a template that is not loaded: », الأب];
            أرجع نتيجة.خطأ(خطأ_عام(&(*المجموعة).القوالب[الفهرس].الاسم, &الأجزاء));
        };
        الخطوات := الخطوات + 1;
        إذا (الخطوات > 32) {
            دع الأجزاء: متجه نص = [«extends loops»];
            أرجع نتيجة.خطأ(خطأ_عام(الاسم, &الأجزاء));
        };
    }
    دع السابقة: متجه كتلة_قالب = استنسخ(&(*الحالة).الكتل);
    (*الحالة).الكتل := الكتل;
    (*الحالة).العمق := (*الحالة).العمق + 1;
    دع العقد: متجه عقدة_قالب = استنسخ(&(*المجموعة).القوالب[الفهرس].العقد);
    دع اسم_الجذر: نص = استنسخ(&(*المجموعة).القوالب[الفهرس].الاسم);
    دع النتيجة: نتيجة طبيعي, خطأ_قالب = اعرض_عقدا(المجموعة, السياق, &اسم_الجذر, &العقد, الحالة);
    (*الحالة).العمق := (*الحالة).العمق - 1;
    (*الحالة).الكتل := السابقة;
    أرجع النتيجة;
}

عرف اعرض_عقدا(
    المجموعة: &قوالب,
    السياق: &سياق_قالب,
    القالب: &نص,
    العقد: &متجه عقدة_قالب,
    الحالة: &متغير حالة_عرض
): نتيجة طبيعي, خطأ_قالب {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*العقد) مثل طبيعي)) {
        طابق (*العقد)[ف] مع
        | عقدة_قالب.حرفي(النص) -> { ألحق_كما_هو(&متغير (*الحالة).الخرج, &النص); }
        | عقدة_قالب.إخراج(الإخراج) -> {
            طابق قيم(السياق, القالب, &الإخراج.التعبير, الإخراج.السطر, الحالة) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(القيمة) -> { اكتب_قيمة(&القيمة, الحالة); };
        }
        | عقدة_قالب.شرط(الشرط) -> {
            دع اختير: متغير منطقي = خطأ;
            دع ي: متغير طبيعي = 0;
            طالما (!اختير && ي < (الطول(الشرط.الفروع) مثل طبيعي)) {
                طابق قيم(السياق, القالب, &الشرط.الفروع[ي].الشرط, 0, الحالة) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(القيمة) -> {
                    إذا (قيمة_صادقة(&القيمة)) {
                        اختير := صواب;
                        طابق اعرض_عقدا(المجموعة, السياق, القالب, &الشرط.الفروع[ي].الجسم, الحالة) مع
                        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                        | نتيجة.نجح(_) -> { };
                    };
                };
                ي := ي + 1;
            }
            إذا (!اختير) {
                طابق اعرض_عقدا(المجموعة, السياق, القالب, &الشرط.البديل, الحالة) مع
                | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
                | نتيجة.نجح(_) -> { };
            };
        }
        | عقدة_قالب.حلقة(الحلقة) -> {
            طابق اعرض_حلقة(المجموعة, السياق, القالب, &الحلقة, الحالة) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
        }
        | عقدة_قالب.تضمين(التضمين) -> {
            طابق اعرض_مسمى(المجموعة, السياق, &التضمين.الاسم, التضمين.السطر, الحالة) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
        }
        | عقدة_قالب.كتلة(الكتلة) -> {
            // The most derived definition of the block wins.
            دع الجسم: متغير متجه عقدة_قالب = استنسخ(&الكتلة.الجسم);
            دع ي: متغير طبيعي = 0;
            دع وجد: متغير منطقي = خطأ;
            طالما (!وجد && ي < (الطول((*الحالة).الكتل) مثل طبيعي)) {
                إذا (نصان_متساويان(&(*الحالة).الكتل[ي].الاسم, &الكتلة.الاسم)) {
                    الجسم := استنسخ(&(*الحالة).الكتل[ي].الجسم);
                    وجد := صواب;
                };
                ي := ي + 1;
            }
            طابق اعرض_عقدا(المجموعة, السياق, القالب, &الجسم, الحالة) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(_) -> { };
        };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(0);
}

عرف كائن_الحلقة(الموضع: طبيعي, العدد: طبيعي): قيمة_قالب {
    دع الحقول: متجه حقل_قالب = [
        حقل(«index», قيمة_قالب.عددية((الموضع + 1) مثل عدد)),
        حقل(«index0», قيمة_قالب.عددية(الموضع مثل عدد)),
        حقل(«revindex», قيمة_قالب.عددية((العدد - الموضع) مثل عدد)),
        حقل(«first», قيمة_قالب.منطقية(الموضع == 0)),
        حقل(«last», قيمة_قالب.منطقية(الموضع + 1 == العدد)),
        حقل(«length», قيمة_قالب.عددية(العدد مثل عدد))
    ];
    أرجع قيمة_قالب.كائن(الحقول);
}

// The items a for loop visits: a list's elements, or an object's fields as
// {key, value} objects (Jinja's dict.items()); anything else is empty.
عرف عناصر_الحلقة(القيمة: &قيمة_قالب): متجه قيمة_قالب {
    طابق *القيمة مع
    | قيمة_قالب.قائمة(العناصر) -> { أرجع استنسخ(&العناصر); }
    | قيمة_قالب.كائن(الحقول) -> {
        دع الناتج: متغير متجه قيمة_قالب = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول(الحقول) مثل طبيعي)) {
            دع الزوج: متجه حقل_قالب = [
                حقل(«key», قيمة_قالب.نصية(استنسخ(&الحقول[ف].الاسم))),
                حقل(«value», استنسخ(&الحقول[ف].القيمة))
            ];
            ألحق(الناتج, قيمة_قالب.كائن(الزوج));
            ف := ف + 1;
        }
        أرجع الناتج;
    }
    | _ -> {
        دع فارغة: متجه قيمة_قالب = [];
        أرجع فارغة;
    };
}

عرف اعرض_حلقة(
    المجموعة: &قوالب,
    السياق: &سياق_قالب,
    القالب: &نص,
    الحلقة: &حلقة_قالب,
    الحالة: &متغير حالة_عرض
): نتيجة طبيعي, خطأ_قالب {
    دع العناصر: متغير متجه قيمة_قالب = [];
    طابق قيم(السياق, القالب, &(*الحلقة).المصدر, (*الحلقة).السطر, الحالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { العناصر := عناصر_الحلقة(&القيمة); };
    دع العدد: طبيعي = الطول(العناصر) مثل طبيعي;
    إذا (العدد == 0) {
        أرجع اعرض_عقدا(المجموعة, السياق, القالب, &(*الحلقة).البديل, الحالة);
    };
    دع الأساس: طبيعي = الطول((*الحالة).المحلية) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        ألحق((*الحالة).المحلية, حقل(استنسخ(&(*الحلقة).المتغير), استنسخ(&العناصر[ف])));
        ألحق((*الحالة).المحلية, حقل(«loop», كائن_الحلقة(ف, العدد)));
        دع النتيجة: نتيجة طبيعي, خطأ_قالب = اعرض_عقدا(المجموعة, السياق, القالب, &(*الحلقة).الجسم, الحالة);
        اقتطع((*الحالة).المحلية, الأساس);
        طابق النتيجة مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(0);
}

عرف اكتب_قيمة(القيمة: &قيمة_قالب, الحالة: &متغير حالة_عرض): فراغ {
    طابق *القيمة مع
    | قيمة_قالب.آمنة(النص) -> { ألحق_كما_هو(&متغير (*الحالة).الخرج, &النص); }
    | _ -> {
        دع النص: نص = نص_القيمة(القيمة);
        ألحق_مهربا(&متغير (*الحالة).الخرج, &النص);
    };
}

// ---- expressions ----

عرف جد_في(الحقول: &متجه حقل_قالب, الاسم: &نص): اختياري قيمة_قالب {
    دع ف: متغير طبيعي = الطول(*الحقول) مثل طبيعي;
    طالما (ف > 0) {
        ف := ف - 1;
        إذا (نصان_متساويان(&(*الحقول)[ف].الاسم, الاسم)) {
            أرجع اختياري.موجود(استنسخ(&(*الحقول)[ف].القيمة));
        };
    }
    أرجع اختياري.لا_شيء();
}

// One step of a path: an object's field, or a list's element by number.
عرف خطوة(القيمة: &قيمة_قالب, الاسم: &نص): اختياري قيمة_قالب {
    طابق *القيمة مع
    | قيمة_قالب.كائن(الحقول) -> { أرجع جد_في(&الحقول, الاسم); }
    | قيمة_قالب.قائمة(العناصر) -> {
        طابق حلل_طبيعي(الاسم) مع
        | نتيجة.نجح(الفهرس) -> {
            إذا (الفهرس < (الطول(العناصر) مثل طبيعي)) { أرجع اختياري.موجود(استنسخ(&العناصر[الفهرس])); };
            أرجع اختياري.لا_شيء();
        }
        | نتيجة.خطأ(_) -> { أرجع اختياري.لا_شيء(); };
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عرف قيمة_مجهولة(القالب: &نص, السطر: طبيعي, الأجزاء: &متجه نص, الحالة: &متغير حالة_عرض): نتيجة قيمة_قالب, خطأ_قالب {
    إذا ((*الحالة).صارم) {
        دع النص: نص = ضم_نصوص(الأجزاء);
        دع الرسالة: متجه نص = [«undefined: », النص];
        أرجع نتيجة.خطأ(خطأ_سطر(القالب, السطر, &الرسالة));
    };
    أرجع نتيجة.نجح(قيمة_قالب.فارغة());
}

عرف قيم_مسارا(السياق: &سياق_قالب, القالب: &نص, الأجزاء: &متجه نص, السطر: طبيعي, الحالة: &متغير حالة_عرض): نتيجة قيمة_قالب, خطأ_قالب {
    دع القيمة: متغير قيمة_قالب = قيمة_قالب.فارغة();
    طابق جد_في(&(*الحالة).المحلية, &(*الأجزاء)[0]) مع
    | اختياري.موجود(ق) -> { القيمة := ق; }
    | اختياري.لا_شيء -> {
        طابق جد_في(السياق, &(*الأجزاء)[0]) مع
        | اختياري.موجود(ق) -> { القيمة := ق; }
        | اختياري.لا_شيء -> { أرجع قيمة_مجهولة(القالب, السطر, الأجزاء, الحالة); };
    };
    دع ف: متغير طبيعي = 1;
    طالما (ف < (الطول(*الأجزاء) مثل طبيعي)) {
        طابق خطوة(&القيمة, &(*الأجزاء)[ف]) مع
        | اختياري.موجود(ق) -> { القيمة := ق; }
        | اختياري.لا_شيء -> { أرجع قيمة_مجهولة(القالب, السطر, الأجزاء, الحالة); };
        ف := ف + 1;
    }
    أرجع نتيجة.نجح(القيمة);
}

عرف قيمتان_متساويتان(الأولى: &قيمة_قالب, الثانية: &قيمة_قالب): منطقي {
    طابق *الأولى مع
    | قيمة_قالب.عددية(أ) -> {
        طابق *الثانية مع
        | قيمة_قالب.عددية(ب) -> { أرجع أ == ب; }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_قالب.منطقية(أ) -> {
        طابق *الثانية مع
        | قيمة_قالب.منطقية(ب) -> { أرجع أ == ب; }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_قالب.فارغة -> {
        طابق *الثانية مع
        | قيمة_قالب.فارغة -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | قيمة_قالب.نصية(أ) -> { أرجع نص_يساوي_قيمة(&أ, الثانية); }
    | قيمة_قالب.آمنة(أ) -> { أرجع نص_يساوي_قيمة(&أ, الثانية); }
    | _ -> { أرجع خطأ; };
}

عرف نص_يساوي_قيمة(النص: &نص, القيمة: &قيمة_قالب): منطقي {
    طابق *القيمة مع
    | قيمة_قالب.نصية(ب) -> { أرجع نصان_متساويان(النص, &ب); }
    | قيمة_قالب.آمنة(ب) -> { أرجع نصان_متساويان(النص, &ب); }
    | _ -> { أرجع خطأ; };
}

// -1, 0 or 1 for numbers or texts; 2 when they cannot be ordered.
عرف رتب(الأولى: &قيمة_قالب, الثانية: &قيمة_قالب): عدد {
    طابق *الأولى مع
    | قيمة_قالب.عددية(أ) -> {
        طابق *الثانية مع
        | قيمة_قالب.عددية(ب) -> {
            إذا (أ < ب) { أرجع -1; };
            إذا (أ > ب) { أرجع 1; };
            أرجع 0;
        }
        | _ -> { أرجع 2; };
    }
    | قيمة_قالب.نصية(أ) -> {
        طابق *الثانية مع
        | قيمة_قالب.نصية(ب) -> { أرجع قارن_نصين_معجميا(&أ, &ب); }
        | _ -> { أرجع 2; };
    }
    | _ -> { أرجع 2; };
}

عرف قيم(
    السياق: &سياق_قالب,
    القالب: &نص,
    التعبير: &تعبير_قالب,
    السطر: طبيعي,
    الحالة: &متغير حالة_عرض
): نتيجة قيمة_قالب, خطأ_قالب {
    طابق *التعبير مع
    | تعبير_قالب.ثابت(القيمة) -> { أرجع نتيجة.نجح(استنسخ(&القيمة)); }
    | تعبير_قالب.مسار(الأجزاء) -> { أرجع قيم_مسارا(السياق, القالب, &الأجزاء, السطر, الحالة); }
    | تعبير_قالب.نفي(الداخل) -> {
        طابق قيم(السياق, القالب, &الداخل[0], السطر, الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ق) -> { أرجع نتيجة.نجح(قيمة_قالب.منطقية(!قيمة_صادقة(&ق))); };
    }
    | تعبير_قالب.ثنائي(الثنائي) -> {
        دع اليسار: متغير قيمة_قالب = قيمة_قالب.فارغة();
        طابق قيم(السياق, القالب, &الثنائي.الطرفان[0], السطر, الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ق) -> { اليسار := ق; };
        // or and and give one of their operands, as in Jinja and Python.
        إذا (الثنائي.العامل == 1 && قيمة_صادقة(&اليسار)) { أرجع نتيجة.نجح(اليسار); };
        إذا (الثنائي.العامل == 2 && !قيمة_صادقة(&اليسار)) { أرجع نتيجة.نجح(اليسار); };
        دع اليمين: متغير قيمة_قالب = قيمة_قالب.فارغة();
        طابق قيم(السياق, القالب, &الثنائي.الطرفان[1], السطر, الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ق) -> { اليمين := ق; };
        إذا (الثنائي.العامل == 1 || الثنائي.العامل == 2) { أرجع نتيجة.نجح(اليمين); };
        إذا (الثنائي.العامل == 3) { أرجع نتيجة.نجح(قيمة_قالب.منطقية(قيمتان_متساويتان(&اليسار, &اليمين))); };
        إذا (الثنائي.العامل == 4) { أرجع نتيجة.نجح(قيمة_قالب.منطقية(!قيمتان_متساويتان(&اليسار, &اليمين))); };
        دع الترتيب: عدد = رتب(&اليسار, &اليمين);
        إذا (الترتيب == 2) {
            دع الأجزاء: متجه نص = [«< <= > >= compare two numbers or two texts»];
            أرجع نتيجة.خطأ(خطأ_سطر(القالب, السطر, &الأجزاء));
        };
        إذا (الثنائي.العامل == 5) { أرجع نتيجة.نجح(قيمة_قالب.منطقية(الترتيب < 0)); };
        إذا (الثنائي.العامل == 6) { أرجع نتيجة.نجح(قيمة_قالب.منطقية(الترتيب <= 0)); };
        إذا (الثنائي.العامل == 7) { أرجع نتيجة.نجح(قيمة_قالب.منطقية(الترتيب > 0)); };
        أرجع نتيجة.نجح(قيمة_قالب.منطقية(الترتيب >= 0));
    }
    | تعبير_قالب.مرشح(المرشح) -> { أرجع طبق_مرشحا(السياق, القالب, &المرشح, الحالة); };
}

عرف عدد_المحارف(النص: &نص): عدد {
    دع العدد: متغير عدد = 0;
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        دع ب: ط8 = (*النص)[ف];
        إذا (ب < 0x80 || ب >= 0xC0) { العدد := العدد + 1; };
        ف := ف + 1;
    }
    أرجع العدد;
}

عرف طبق_مرشحا(
    السياق: &سياق_قالب,
    القالب: &نص,
    المرشح: &مرشح_قالب,
    الحالة: &متغير حالة_عرض
): نتيجة قيمة_قالب, خطأ_قالب {
    دع الاسم: &نص = &(*المرشح).الاسم;
    دع السطر: طبيعي = (*المرشح).السطر;
    // default works on undefined values, even in strict mode.
    دع الصارم: منطقي = (*الحالة).صارم;
    دع افتراضي: منطقي = نص_بايتات_يساوي(الاسم, «default») || نص_بايتات_يساوي(الاسم, «d»);
    إذا (افتراضي) { (*الحالة).صارم := خطأ; };
    دع القيم: متغير متجه قيمة_قالب = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المرشح).الوسائط) مثل طبيعي)) {
        طابق قيم(السياق, القالب, &(*المرشح).الوسائط[ف], السطر, الحالة) مع
        | نتيجة.خطأ(الخطأ) -> { (*الحالة).صارم := الصارم; أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(ق) -> { ألحق(القيم, ق); };
        ف := ف + 1;
    }
    (*الحالة).صارم := الصارم;
    دع المدخل: قيمة_قالب = استنسخ(&القيم[0]);
    إذا (افتراضي) {
        طابق المدخل مع
        | قيمة_قالب.فارغة -> {
            إذا (الطول(القيم) > 1) { أرجع نتيجة.نجح(استنسخ(&القيم[1])); };
            أرجع نتيجة.نجح(قيمة_قالب.نصية(«»));
        }
        | _ -> { أرجع نتيجة.نجح(المدخل); };
    };
    إذا (نص_بايتات_يساوي(الاسم, «safe»)) {
        طابق المدخل مع
        | قيمة_قالب.آمنة(_) -> { أرجع نتيجة.نجح(المدخل); }
        | _ -> { أرجع نتيجة.نجح(قيمة_قالب.آمنة(نص_القيمة(&المدخل))); };
    };
    إذا (نص_بايتات_يساوي(الاسم, «escape») || نص_بايتات_يساوي(الاسم, «e»)) {
        طابق المدخل مع
        | قيمة_قالب.آمنة(_) -> { أرجع نتيجة.نجح(المدخل); }
        | _ -> {
            دع النص: نص = نص_القيمة(&المدخل);
            أرجع نتيجة.نجح(قيمة_قالب.آمنة(اهرب_html(&النص)));
        };
    };
    إذا (نص_بايتات_يساوي(الاسم, «length») || نص_بايتات_يساوي(الاسم, «count»)) {
        طابق المدخل مع
        | قيمة_قالب.قائمة(العناصر) -> { أرجع نتيجة.نجح(قيمة_قالب.عددية(الطول(العناصر) مثل عدد)); }
        | قيمة_قالب.كائن(الحقول) -> { أرجع نتيجة.نجح(قيمة_قالب.عددية(الطول(الحقول) مثل عدد)); }
        | قيمة_قالب.نصية(النص) -> { أرجع نتيجة.نجح(قيمة_قالب.عددية(عدد_المحارف(&النص))); }
        | قيمة_قالب.آمنة(النص) -> { أرجع نتيجة.نجح(قيمة_قالب.عددية(عدد_المحارف(&النص))); }
        | _ -> { أرجع نتيجة.نجح(قيمة_قالب.عددية(0)); };
    };
    إذا (نص_بايتات_يساوي(الاسم, «join»)) {
        دع الفاصل: متغير نص = «»;
        إذا (الطول(القيم) > 1) { الفاصل := نص_القيمة(&القيم[1]); };
        دع العناصر: متجه قيمة_قالب = عناصر_الحلقة(&المدخل);
        دع الخرج: متغير متجه ط8 = [];
        دع ي: متغير طبيعي = 0;
        طالما (ي < (الطول(العناصر) مثل طبيعي)) {
            إذا (ي > 0) { ألحق_كما_هو(&متغير الخرج, &الفاصل); };
            دع النص: نص = نص_القيمة(&العناصر[ي]);
            ألحق_كما_هو(&متغير الخرج, &النص);
            ي := ي + 1;
        }
        أرجع نتيجة.نجح(قيمة_قالب.نصية(من_بايتات(&الخرج)));
    };
    إذا (نص_بايتات_يساوي(الاسم, «upper»)) {
        دع النص: نص = نص_القيمة(&المدخل);
        أرجع نتيجة.نجح(قيمة_قالب.نصية(حول_النص_إلى_كبير_أسكي(&النص)));
    };
    إذا (نص_بايتات_يساوي(الاسم, «lower»)) {
        دع النص: نص = نص_القيمة(&المدخل);
        أرجع نتيجة.نجح(قيمة_قالب.نصية(حول_النص_إلى_صغير_أسكي(&النص)));
    };
    إذا (نص_بايتات_يساوي(الاسم, «trim»)) {
        دع النص: نص = نص_القيمة(&المدخل);
        أرجع نتيجة.نجح(قيمة_قالب.نصية(قص_النص(&النص)));
    };
    دع الأجزاء: متجه نص = [«unknown filter: », استنسخ(الاسم)];
    أرجع نتيجة.خطأ(خطأ_سطر(القالب, السطر, &الأجزاء));
}

عرف نص_بايتات_يساوي(النص: &نص, المطلوب: نص): منطقي {
    أرجع نصان_متساويان(النص, &المطلوب);
}

// Renders the template الاسم with السياق.
عام عرف اعرض_قالبا(المجموعة: &قوالب, الاسم: &نص, السياق: &سياق_قالب): نتيجة نص, خطأ_قالب {
    إذا ((*المجموعة).إعادة_التحميل && الطول((*المجموعة).الدليل) > 0) {
        طابق حمل_قوالب(استنسخ(&(*المجموعة).الدليل)) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(الجديدة) -> {
            دع المحملة: متغير قوالب = الجديدة;
            المحملة.صارم := (*المجموعة).صارم;
            أرجع اعرض_من(&المحملة, الاسم, السياق);
        };
    };
    أرجع اعرض_من(المجموعة, الاسم, السياق);
}

عرف اعرض_من(المجموعة: &قوالب, الاسم: &نص, السياق: &سياق_قالب): نتيجة نص, خطأ_قالب {
    دع الحالة: متغير حالة_عرض = {
        الخرج: [],
        المحلية: [],
        الكتل: [],
        العمق: 0,
        صارم: (*المجموعة).صارم
    };
    طابق اعرض_مسمى(المجموعة, السياق, الاسم, 0, &متغير الحالة) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { أرجع نتيجة.نجح(من_بايتات(&الحالة.الخرج)); };
}

// Parses and renders one template text, for a small page without a set.
عام عرف اعرض_نص_قالب(المصدر: نص, السياق: &سياق_قالب): نتيجة نص, خطأ_قالب {
    دع المجموعة: متغير قوالب = قوالب_جديدة();
    طابق أضف_قالبا(&متغير المجموعة, «<string>», المصدر) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    دع الاسم: نص = «<string>»;
    أرجع اعرض_من(&المجموعة, &الاسم, السياق);
}

// An HTML response: الاسم rendered with السياق, with status الحالة. A render
// error is logged (ERROR) and answered 500, as FastAPI does for an
// exception in a template.
عام عرف رد_قالب_بحالة(الحالة: طبيعي, المجموعة: &قوالب, الاسم: نص, السياق: &سياق_قالب): استجابة {
    طابق اعرض_قالبا(المجموعة, &الاسم, السياق) مع
    | نتيجة.نجح(الصفحة) -> {
        دع النوع: نص = «text/html; charset=utf-8»;
        دع الجسم: متغير متجه ط8 = [];
        ألحق_كما_هو(&متغير الجسم, &الصفحة);
        أرجع استجابة_بايتات_ويب(الحالة, الجسم, &النوع);
    }
    | نتيجة.خطأ(الخطأ) -> {
        دع الأجزاء: متجه نص = [«template error: », وصف_خطأ_قالب(&الخطأ)];
        سجل_عطل(ضم_نصوص(&الأجزاء));
        دع النص: نص = «Internal Server Error»;
        أرجع استجابة_نص_ويب(500, &النص);
    };
}

// 200 with الاسم rendered with السياق.
عام عرف رد_قالب(المجموعة: &قوالب, الاسم: نص, السياق: &سياق_قالب): استجابة {
    أرجع رد_قالب_بحالة(200, المجموعة, الاسم, السياق);
}

عام نوع templates = قوالب;
عام مرادف new_templates = قوالب_جديدة;
عام مرادف add_template = أضف_قالبا;
عام مرادف load_templates = حمل_قوالب;
عام مرادف render_template = اعرض_قالبا;
عام مرادف render_template_text = اعرض_نص_قالب;
عام مرادف template_response = رد_قالب;
عام مرادف template_response_with_status = رد_قالب_بحالة;
