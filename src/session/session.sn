من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    استجابة_نص_ويب;

استورد extract.typed;
استورد response.headers;
استورد cookies.request;
استورد cookies.response;

عام نوع إعداد_جلسة = {
    اسم_الكعكة: نص,
    الكعكة: إعداد_كعكة
};

عام نوع محمل_جلسة<S, T> = دالة(
    &S,
    &نص
): اختياري T;

عام عرف إعداد_جلسة_افتراضي(): إعداد_جلسة {
    دع الكعكة: إعداد_كعكة = إعداد_كعكة_افتراضي();
    دع الإعداد: إعداد_جلسة = {
        اسم_الكعكة: «nahr_session»,
        الكعكة: الكعكة
    };
    أرجع الإعداد;
}

عرف رفض_جلسة(): استجابة_ويب<متجه ط8> {
    دع الرسالة: نص = «Session is required»;
    أرجع استجابة_نص_ويب(401, &الرسالة);
}

عرف نفذ_استخراج_جلسة<S, T>(
    الاسم: &نص,
    المحمل: محمل_جلسة<S, T>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة T, استجابة_ويب<متجه ط8> {
    طابق كعكة_باسم(الطلب, الاسم) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(رفض_جلسة());
    }
    | اختياري.موجود(المعرف) -> {
        طابق المحمل(الحالة, &المعرف) مع
        | اختياري.موجود(الجلسة) -> {
            أرجع نتيجة.نجح(الجلسة);
        }
        | اختياري.لا_شيء -> {
            أرجع نتيجة.خطأ(رفض_جلسة());
        };
    };
}

// The cookie name travels as the extractor's text argument; the loader is a
// plain function value and may be captured.
عام عرف استخرج_جلسة<S, T>(
    الإعداد: &إعداد_جلسة,
    المحمل: محمل_جلسة<S, T>
): مستخرج<S, T> {
    دع التنفيذ: دالة_استخراج_بمعطى<S, T> = دالة(
        الاسم: &نص,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة T, استجابة_ويب<متجه ط8> -> نفذ_استخراج_جلسة(
        الاسم,
        المحمل,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع مستخرج_بمعطى(التنفيذ, &(*الإعداد).اسم_الكعكة);
}

عام عرف عين_جلسة(
    الاستجابة: &متغير استجابة,
    المعرف: &نص,
    الإعداد: &إعداد_جلسة
): منطقي {
    أرجع عين_كعكة(
        الاستجابة,
        &(*الإعداد).اسم_الكعكة,
        المعرف,
        &(*الإعداد).الكعكة
    );
}

عام عرف احذف_جلسة(
    الاستجابة: &متغير استجابة,
    الإعداد: &إعداد_جلسة
): منطقي {
    أرجع احذف_كعكة(
        الاستجابة,
        &(*الإعداد).اسم_الكعكة,
        &(*الإعداد).الكعكة
    );
}

عام مرادف session_config = إعداد_جلسة;
عام نوع session_loader<S, T> = محمل_جلسة<S, T>;
عام مرادف default_session_config = إعداد_جلسة_افتراضي;
عام مرادف extract_session = استخرج_جلسة;
عام مرادف set_session = عين_جلسة;
عام مرادف clear_session = احذف_جلسة;
