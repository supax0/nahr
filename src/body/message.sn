من std.http استورد
    صنف_خطأ_جسم_ويب,
    نص_جسم_طلب_ويب,
    استجابة_نص_ويب,
    استجابة_بايتات_ويب,
    استجابة_فارغة_ويب,
    استجابة_إعادة_توجيه_ويب,
    ضع_رأس_ويب;

استورد handler.adapter;

استورد response.headers;

عام نوع خطأ_جسم = صنف_خطأ_جسم_ويب;

عام عرف نص_الطلب(
    الطلب: &طلب
): نتيجة نص, خطأ_جسم {
    أرجع نص_جسم_طلب_ويب(الطلب);
}

عام عرف رد_نصي(
    الحالة: طبيعي,
    النص: &نص
): استجابة {
    أرجع استجابة_نص_ويب(الحالة, النص);
}

عام عرف رد_صفحة(
    الحالة: طبيعي,
    النص: &نص
): استجابة {
    دع الاستجابة: متغير استجابة =
        استجابة_نص_ويب(الحالة, النص);
    دع الاسم: نص = «content-type»;
    دع القيمة: نص = «text/html; charset=utf-8»;
    دع تجاهل: منطقي = ضع_رأس_ويب(
        &متغير الاستجابة.الرؤوس,
        &الاسم,
        &القيمة
    );
    أرجع الاستجابة;
}

عام عرف رد_بايتات(
    الحالة: طبيعي,
    الجسم: متجه ط8,
    نوع_المحتوى: &نص
): استجابة {
    أرجع استجابة_بايتات_ويب(
        الحالة,
        الجسم,
        نوع_المحتوى
    );
}

عام عرف رد_فارغ(الحالة: طبيعي): استجابة {
    أرجع استجابة_فارغة_ويب(الحالة);
}

عام عرف إعادة_توجيه(
    الحالة: طبيعي,
    الموقع: &نص
): اختياري استجابة {
    أرجع استجابة_إعادة_توجيه_ويب(الحالة, الموقع);
}

عام مرادف body_error = خطأ_جسم;
عام مرادف request_text = نص_الطلب;
عام مرادف text_response = رد_نصي;
عام مرادف html_response = رد_صفحة;
عام مرادف bytes_response = رد_بايتات;
عام مرادف empty_response = رد_فارغ;
عام مرادف redirect = إعادة_توجيه;
