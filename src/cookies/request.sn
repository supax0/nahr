من std.http استورد
    زوج_كعكة_ويب,
    كعكات_طلب_ويب,
    أول_كعكة_ويب;

استورد handler.adapter;

عام نوع كعكة = زوج_كعكة_ويب;

عام عرف كعكات(الطلب: &طلب): متجه كعكة {
    أرجع كعكات_طلب_ويب(الطلب);
}

عام عرف كعكة_باسم(
    الطلب: &طلب,
    الاسم: &نص
): اختياري نص {
    دع القيم: متجه كعكة = كعكات_طلب_ويب(الطلب);
    أرجع أول_كعكة_ويب(&القيم, الاسم);
}

عام مرادف cookie = كعكة;
عام مرادف cookies = كعكات;
عام مرادف cookie_value = كعكة_باسم;
