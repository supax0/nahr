من std.http استورد
    سياسة_نفس_موقع_كعكة_ويب,
    أضف_كعكة_استجابة_ويب;

استورد response.headers;

عام نوع سياسة_نفس_الموقع =
    | غير_محدد
    | صارم
    | متساهل
    | لا_شيء
;

عام نوع إعداد_كعكة = {
    المسار: نص,
    المجال: نص,
    لديه_عمر_أقصى: منطقي,
    العمر_الأقصى_ثوان: عدد,
    آمنة: منطقي,
    http_فقط: منطقي,
    نفس_الموقع: سياسة_نفس_الموقع
};

عرف إلى_سياسة_ويب(
    السياسة: سياسة_نفس_الموقع
): سياسة_نفس_موقع_كعكة_ويب {
    طابق السياسة مع
    | سياسة_نفس_الموقع.صارم -> {
        أرجع سياسة_نفس_موقع_كعكة_ويب.صارم();
    }
    | سياسة_نفس_الموقع.متساهل -> {
        أرجع سياسة_نفس_موقع_كعكة_ويب.متساهل();
    }
    | سياسة_نفس_الموقع.لا_شيء -> {
        أرجع سياسة_نفس_موقع_كعكة_ويب.لا_شيء();
    }
    | _ -> {
        أرجع سياسة_نفس_موقع_كعكة_ويب.غير_محدد();
    };
}

عام عرف إعداد_كعكة_افتراضي(): إعداد_كعكة {
    دع الإعداد: إعداد_كعكة = {
        المسار: «/»,
        المجال: «»,
        لديه_عمر_أقصى: خطأ,
        العمر_الأقصى_ثوان: 0,
        آمنة: خطأ,
        http_فقط: صواب,
        نفس_الموقع: سياسة_نفس_الموقع.متساهل()
    };
    أرجع الإعداد;
}

عام عرف عين_كعكة(
    الاستجابة: &متغير استجابة,
    الاسم: &نص,
    القيمة: &نص,
    الإعداد: &إعداد_كعكة
): منطقي {
    // Browsers drop SameSite=None cookies that are not Secure
    // (draft-ietf-httpbis-rfc6265bis §5.6.7), so the cookie is refused here
    // instead of being sent and silently ignored.
    طابق (*الإعداد).نفس_الموقع مع
    | سياسة_نفس_الموقع.لا_شيء -> {
        إذا (!(*الإعداد).آمنة) { أرجع خطأ; };
    }
    | _ -> { };
    دع نفس_الموقع: سياسة_نفس_موقع_كعكة_ويب =
        إلى_سياسة_ويب((*الإعداد).نفس_الموقع);
    أرجع أضف_كعكة_استجابة_ويب(
        الاستجابة,
        الاسم,
        القيمة,
        &(*الإعداد).المسار,
        &(*الإعداد).المجال,
        (*الإعداد).لديه_عمر_أقصى,
        (*الإعداد).العمر_الأقصى_ثوان,
        (*الإعداد).آمنة,
        (*الإعداد).http_فقط,
        نفس_الموقع
    );
}

عام عرف احذف_كعكة(
    الاستجابة: &متغير استجابة,
    الاسم: &نص,
    الإعداد: &إعداد_كعكة
): منطقي {
    دع القيمة: نص = «»;
    دع نفس_الموقع: سياسة_نفس_موقع_كعكة_ويب =
        إلى_سياسة_ويب((*الإعداد).نفس_الموقع);
    أرجع أضف_كعكة_استجابة_ويب(
        الاستجابة,
        الاسم,
        &القيمة,
        &(*الإعداد).المسار,
        &(*الإعداد).المجال,
        صواب,
        0,
        (*الإعداد).آمنة,
        (*الإعداد).http_فقط,
        نفس_الموقع
    );
}

عام مرادف same_site = سياسة_نفس_الموقع;
عام مرادف cookie_config = إعداد_كعكة;
عام مرادف default_cookie_config = إعداد_كعكة_افتراضي;
عام مرادف set_cookie = عين_كعكة;
عام مرادف clear_cookie = احذف_كعكة;
عام مرادف same_site.unspecified = سياسة_نفس_الموقع.غير_محدد;
عام مرادف same_site.strict = سياسة_نفس_الموقع.صارم;
عام مرادف same_site.lax = سياسة_نفس_الموقع.متساهل;
عام مرادف same_site.none = سياسة_نفس_الموقع.لا_شيء;
