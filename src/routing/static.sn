من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    أول_قيمة_رأس_ويب,
    استجابة_فارغة_ويب;

من std.http استورد
    استجابة_بايتات_ويب,
    استجابة_نص_ويب,
    استجابة_إعادة_توجيه_ويب;

من std.fs استورد
    اقرأ_بايتات_ملف,
    حاول_مسار_دليل,
    فئة_خطأ_نظام,
    صنف_خطأ_نظام;

من std.mime استورد
    نوع_وسائط,
    نوع_وسائط_لمسار_أو_افتراضي,
    نص_نوع_الوسائط;

من std.text استورد من_بايتات, يحتوي_نصا;

من std.hash استورد
    هاش_فنڤ1أ_طبيعي_للبايتات;

استورد std.text.number;
استورد std.text.transform;
استورد std.text.compare;
استورد std.text.search;
استورد handler.adapter;
استورد middleware.chain;
استورد extract.path;
استورد response.headers;
استورد response.file;
استورد routing.router;

// Serves the files under a directory at a URL prefix:
//
//     اربط_ملفات(&متغير الموجه, &«/static», &«./public»)
//
// registers GET (and so HEAD) `/static/{*path}`. Paths that could leave the
// directory are 404. Every file gets a weak ETag from its length and content
// hash; a matching If-None-Match is answered 304 without a body.

// A weak validator for a body: W/"<length>-<fnv1a32>".
عام عرف وسم_ضعيف(الجسم: &متجه ط8): نص {
    ليكن الأجزاء: متجه نص = [
        «W/"»,
        طبيعي_إلى_نص(الطول(*الجسم) مثل طبيعي),
        «-»,
        طبيعي_إلى_نص(هاش_فنڤ1أ_طبيعي_للبايتات(الجسم)),
        «"»
    ];
    ليكن فارغ: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &فارغ);
}

عرف بلا_ضعف(الوسم: &نص): نص {
    ليكن ضعيف: نص = «W/»;
    طابق أزل_البادئة(الوسم, &ضعيف) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة; }
    | اختياري.لا_شيء -> { أرجع استنسخ(الوسم); };
}

// Whether If-None-Match names الوسم (weak comparison, RFC 9110 §13.1.2).
عرف يطابق_الوسم(الطلب: &طلب_ويب<متجه ط8>, الوسم: &نص): منطقي {
    ليكن الاسم: نص = «if-none-match»;
    ليكن العناصر: متجه نص = عناصر_قائمة_رأس(&(*الطلب).الرؤوس, &الاسم);
    ليكن النجمة: نص = «*»;
    ليكن المطلوب: نص = بلا_ضعف(الوسم);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العناصر) مثل طبيعي)) {
        إذا (نصان_متساويان(&العناصر[ف], &النجمة)) { أرجع صواب; };
        ليكن العنصر: نص = بلا_ضعف(&العناصر[ف]);
        إذا (نصان_متساويان(&العنصر, &المطلوب)) { أرجع صواب; };
        ف := ف + 1;
    }
    أرجع خطأ;
}

// Serves النسبي from الدليل with an ETag, or 304 when it matches.
عام عرف رد_ملف_ثابت(
    الطلب: &طلب_ويب<متجه ط8>,
    الدليل: &نص,
    النسبي: &نص
): استجابة_ويب<متجه ط8> {
    ليكن الاستجابة: متغير استجابة_ويب<متجه ط8> = رد_ملف_من_دليل(الدليل, النسبي);
    إذا ((الاستجابة.الحالة مثل طبيعي) != 200) { أرجع الاستجابة; };
    ليكن الوسم: نص = وسم_ضعيف(&الاستجابة.الجسم);
    ليكن اسم_الوسم: نص = «etag»;
    إذا (يطابق_الوسم(الطلب, &الوسم)) {
        ليكن غير_معدل: متغير استجابة_ويب<متجه ط8> = استجابة_فارغة_ويب(304);
        ليكن تجاهل: منطقي = عين_رأسا(&متغير غير_معدل, &اسم_الوسم, &الوسم);
        أرجع غير_معدل;
    };
    ليكن تجاهل_الوسم: منطقي = عين_رأسا(&متغير الاستجابة, &اسم_الوسم, &الوسم);
    أرجع الاستجابة;
}

// How a directory is served (tower-http's ServeDir, FastAPI's StaticFiles):
//
// - الفهرس: the file served for a directory, «index.html» by default; a
//   directory requested without its trailing slash is redirected (301) to it.
//   Empty: directories are 404.
// - التخزين: Cache-Control for every file, e.g. «public, max-age=31536000,
//   immutable» for fingerprinted assets. Empty: no header.
// - تخزين_الصفحات: Cache-Control for HTML files instead of التخزين, e.g.
//   «no-cache» so pages revalidate while assets stay cached.
// - مضغوطة: serve file.br or file.gz next to the file when the client
//   accepts br or gzip (precompressed at build time, as ServeDir's
//   precompressed_br/gzip and nginx gzip_static).
// - البديل: a file (relative to the directory) served with 200 for paths that
//   match no file, for single-page apps whose router runs in the browser.
عام نوع إعداد_ملفات = {
    الفهرس: نص,
    التخزين: نص,
    تخزين_الصفحات: نص,
    مضغوطة: منطقي,
    البديل: نص
};

عام عرف إعداد_ملفات_افتراضي(): إعداد_ملفات {
    ليكن الناتج: إعداد_ملفات = {
        الفهرس: «index.html»,
        التخزين: «»,
        تخزين_الصفحات: «»,
        مضغوطة: خطأ,
        البديل: «»
    };
    أرجع الناتج;
}

عرف ينتهي_بشرطة(النص: &نص): منطقي {
    ليكن العدد: طبيعي = الطول(*النص) مثل طبيعي;
    أرجع العدد > 0 && (*النص)[العدد - 1] == 0x2F;
}

عرف صل_اثنين(الأول: &نص, الثاني: &نص): نص {
    ليكن الأجزاء: متجه نص = [استنسخ(الأول), استنسخ(الثاني)];
    ليكن فارغ: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &فارغ);
}

عرف مسار_في(الدليل: &نص, النسبي: &نص): نص {
    ليكن الأجزاء: متجه نص = [استنسخ(الدليل), استنسخ(النسبي)];
    ليكن الفاصل: نص = «/»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

// The media type of a path; text types get charset=utf-8, as Go's
// http.ServeContent does, so Arabic pages and scripts decode correctly.
عام عرف نوع_ملف_بترميز(المسار: &نص): نص {
    ليكن النوع: نوع_وسائط = نوع_وسائط_لمسار_أو_افتراضي(المسار);
    ليكن النص: نص = نص_نوع_الوسائط(&النوع);
    ليكن نصي: نص = «text/»;
    ليكن ترميز: نص = «charset»;
    طابق أزل_البادئة(&النص, &نصي) مع
    | اختياري.موجود(_) -> {
        إذا (!يحتوي_نصا(&النص, &ترميز)) {
            ليكن اللاحقة: نص = «; charset=utf-8»;
            أرجع صل_اثنين(&النص, &اللاحقة);
        };
        أرجع النص;
    }
    | اختياري.لا_شيء -> { أرجع النص; };
}

// Whether Accept-Encoding allows الترميز (an item without q=0).
عام عرف يقبل_ترميزا(الطلب: &طلب_ويب<متجه ط8>, الترميز: &نص): منطقي {
    ليكن الاسم: نص = «accept-encoding»;
    ليكن العناصر: متجه نص = عناصر_قائمة_رأس(&(*الطلب).الرؤوس, &الاسم);
    ليكن فاصلة_منقوطة: نص = «;»;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(العناصر) مثل طبيعي)) {
        ليكن الأجزاء: متجه نص = قسم_النص(&العناصر[ف], &فاصلة_منقوطة);
        ليكن الرمز: نص = قص_النص(&الأجزاء[0]);
        إذا (نصان_متساويان_بلا_حالة_أسكي(&الرمز, الترميز)) {
            ليكن مرفوض: متغير منطقي = خطأ;
            ليكن ج: متغير طبيعي = 1;
            طالما (ج < (الطول(الأجزاء) مثل طبيعي)) {
                ليكن المعامل: نص = قص_النص(&الأجزاء[ج]);
                ليكن صفر: نص = «q=0»;
                ليكن صفر_عشري: نص = «q=0.»;
                إذا (نصان_متساويان(&المعامل, &صفر)) { مرفوض := صواب; };
                طابق أزل_البادئة(&المعامل, &صفر_عشري) مع
                | اختياري.موجود(الباقي) -> {
                    ليكن كله_أصفار: متغير منطقي = صواب;
                    ليكن ي: متغير طبيعي = 0;
                    طالما (ي < (الطول(الباقي) مثل طبيعي)) {
                        إذا (الباقي[ي] != 0x30) { كله_أصفار := خطأ; };
                        ي := ي + 1;
                    }
                    إذا (كله_أصفار) { مرفوض := صواب; };
                }
                | اختياري.لا_شيء -> { };
                ج := ج + 1;
            }
            أرجع !مرفوض;
        };
        ف := ف + 1;
    }
    أرجع خطأ;
}

عرف نص_الحالة(الرمز: طبيعي): نص {
    إذا (الرمز == 404) { أرجع «Not Found»; };
    إذا (الرمز == 403) { أرجع «Forbidden»; };
    أرجع «Internal Server Error»;
}

// 0 when the file was read; otherwise the status to answer.
عرف اقرأ_ملف_دليل(الدليل: &نص, النسبي: &نص, الخرج: &متغير متجه ط8): طبيعي {
    إذا (!مسار_نسبي_آمن(النسبي)) { أرجع 404; };
    ليكن المسار: نص = مسار_في(الدليل, النسبي);
    طابق اقرأ_بايتات_ملف(&المسار) مع
    | نتيجة.نجح(البايتات) -> { *الخرج := البايتات; أرجع 0; }
    | نتيجة.خطأ(الرمز) -> {
        طابق صنف_خطأ_نظام(الرمز) مع
        | فئة_خطأ_نظام.غير_موجود -> { أرجع 404; }
        | فئة_خطأ_نظام.ليس_دليلا -> { أرجع 404; }
        | فئة_خطأ_نظام.هو_دليل -> { أرجع 404; }
        | فئة_خطأ_نظام.مرفوض_الإذن -> { أرجع 403; }
        | _ -> { أرجع 500; };
    };
}

عرف هو_دليل(الدليل: &نص, النسبي: &نص): منطقي {
    إذا (!مسار_نسبي_آمن(النسبي)) { أرجع خطأ; };
    ليكن المسار: نص = مسار_في(الدليل, النسبي);
    طابق حاول_مسار_دليل(&المسار) مع
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; }
    | نتيجة.خطأ(_) -> { أرجع خطأ; };
}

// The request path (without the query) followed by "/" and the query.
عرف مع_شرطة(الهدف: &نص): نص {
    ليكن الخرج: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    ليكن العدد: طبيعي = الطول(*الهدف) مثل طبيعي;
    طالما (ف < العدد && (*الهدف)[ف] != 0x3F) { ألحق(الخرج, (*الهدف)[ف]); ف := ف + 1; }
    ألحق(الخرج, 0x2F);
    طالما (ف < العدد) { ألحق(الخرج, (*الهدف)[ف]); ف := ف + 1; }
    أرجع من_بايتات(&الخرج);
}

// Serves النسبي from الدليل with الإعداد: index files, the trailing-slash
// redirect, precompressed variants, Cache-Control, ETag and 304, and the
// single-page fallback.
عام عرف رد_ملفات(
    الطلب: &طلب_ويب<متجه ط8>,
    الدليل: &نص,
    النسبي: &نص,
    الإعداد: &إعداد_ملفات
): استجابة_ويب<متجه ط8> {
    ليكن الملف: متغير نص = استنسخ(النسبي);
    إذا (الطول(الملف) == 0 || ينتهي_بشرطة(&الملف)) {
        إذا (الطول((*الإعداد).الفهرس) == 0) {
            ليكن النص: نص = «Not Found»;
            أرجع استجابة_نص_ويب(404, &النص);
        };
        الملف := صل_اثنين(&الملف, &(*الإعداد).الفهرس);
    } وإلا إذا (الطول((*الإعداد).الفهرس) > 0 && هو_دليل(الدليل, &الملف)) {
        ليكن الموقع: نص = مع_شرطة(&(*الطلب).الهدف);
        طابق استجابة_إعادة_توجيه_ويب(301, &الموقع) مع
        | اختياري.موجود(الرد) -> { أرجع الرد; }
        | اختياري.لا_شيء -> { };
    };
    // A path that tries to leave the directory is 404, never the fallback.
    إذا (!مسار_نسبي_آمن(&الملف)) {
        ليكن النص: نص = «Not Found»;
        أرجع استجابة_نص_ويب(404, &النص);
    };
    ليكن الجسم: متغير متجه ط8 = [];
    ليكن الحالة: متغير طبيعي = اقرأ_ملف_دليل(الدليل, &الملف, &متغير الجسم);
    إذا (الحالة == 404 && الطول((*الإعداد).البديل) > 0) {
        الملف := استنسخ(&(*الإعداد).البديل);
        الحالة := اقرأ_ملف_دليل(الدليل, &الملف, &متغير الجسم);
    };
    إذا (الحالة != 0) {
        ليكن النص: نص = نص_الحالة(الحالة);
        أرجع استجابة_نص_ويب(الحالة, &النص);
    };
    ليكن النوع: نص = نوع_ملف_بترميز(&الملف);
    ليكن الترميز: متغير نص = «»;
    إذا ((*الإعداد).مضغوطة) {
        ليكن br: نص = «br»;
        ليكن gzip: نص = «gzip»;
        ليكن لاحقة_br: نص = «.br»;
        ليكن لاحقة_gz: نص = «.gz»;
        ليكن المضغوط: متغير متجه ط8 = [];
        إذا (يقبل_ترميزا(الطلب, &br)) {
            ليكن المسار: نص = صل_اثنين(&الملف, &لاحقة_br);
            إذا (اقرأ_ملف_دليل(الدليل, &المسار, &متغير المضغوط) == 0) {
                الجسم := المضغوط;
                الترميز := br;
            };
        };
        إذا (الطول(الترميز) == 0 && يقبل_ترميزا(الطلب, &gzip)) {
            ليكن المسار: نص = صل_اثنين(&الملف, &لاحقة_gz);
            ليكن مضغوط_gz: متغير متجه ط8 = [];
            إذا (اقرأ_ملف_دليل(الدليل, &المسار, &متغير مضغوط_gz) == 0) {
                الجسم := مضغوط_gz;
                الترميز := gzip;
            };
        };
    };
    ليكن الوسم: نص = وسم_ضعيف(&الجسم);
    ليكن الاستجابة: متغير استجابة_ويب<متجه ط8> = استجابة_بايتات_ويب(200, الجسم, &النوع);
    إذا (يطابق_الوسم(الطلب, &الوسم)) {
        الاستجابة := استجابة_فارغة_ويب(304);
    };
    ليكن اسم_الوسم: نص = «etag»;
    ليكن ت1: منطقي = عين_رأسا(&متغير الاستجابة, &اسم_الوسم, &الوسم);
    إذا ((*الإعداد).مضغوطة) {
        ليكن قبول: نص = «accept-encoding»;
        ليكن ت2: منطقي = أضف_إلى_التغيير(&متغير الاستجابة, &قبول);
    };
    إذا (الطول(الترميز) > 0 && الاستجابة.الحالة == 200) {
        ليكن اسم_الترميز: نص = «content-encoding»;
        ليكن ت3: منطقي = عين_رأسا(&متغير الاستجابة, &اسم_الترميز, &الترميز);
    };
    ليكن التخزين: متغير نص = استنسخ(&(*الإعداد).التخزين);
    ليكن html: نص = «text/html»;
    ليكن بادئة_html: اختياري نص = أزل_البادئة(&النوع, &html);
    إذا (الطول((*الإعداد).تخزين_الصفحات) > 0) {
        طابق بادئة_html مع
        | اختياري.موجود(_) -> { التخزين := استنسخ(&(*الإعداد).تخزين_الصفحات); }
        | اختياري.لا_شيء -> { };
    };
    إذا (الطول(التخزين) > 0) {
        ليكن اسم_التخزين: نص = «cache-control»;
        ليكن ت4: منطقي = عين_رأسا(&متغير الاستجابة, &اسم_التخزين, &التخزين);
    };
    أرجع الاستجابة;
}

// الإعداد travels in the handler's arguments as texts.
عرف معطيات_الإعداد(الدليل: &نص, الإعداد: &إعداد_ملفات): متجه نص {
    ليكن مضغوطة: متغير نص = «»;
    إذا ((*الإعداد).مضغوطة) { مضغوطة := «1»; };
    ليكن الناتج: متجه نص = [
        استنسخ(الدليل),
        استنسخ(&(*الإعداد).الفهرس),
        استنسخ(&(*الإعداد).التخزين),
        استنسخ(&(*الإعداد).تخزين_الصفحات),
        مضغوطة,
        استنسخ(&(*الإعداد).البديل)
    ];
    أرجع الناتج;
}

عرف إعداد_من_معطيات(المعطيات: &متجه نص, الإزاحة: طبيعي): إعداد_ملفات {
    ليكن الناتج: إعداد_ملفات = {
        الفهرس: استنسخ(&(*المعطيات)[الإزاحة + 1]),
        التخزين: استنسخ(&(*المعطيات)[الإزاحة + 2]),
        تخزين_الصفحات: استنسخ(&(*المعطيات)[الإزاحة + 3]),
        مضغوطة: الطول((*المعطيات)[الإزاحة + 4]) > 0,
        البديل: استنسخ(&(*المعطيات)[الإزاحة + 5])
    };
    أرجع الناتج;
}

عرف نفذ_ملفات<S>(
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    ليكن الإعداد: إعداد_ملفات = إعداد_من_معطيات(المعطيات, الإزاحة);
    ليكن الاسم: نص = «path»;
    ليكن النسبي: متغير نص = «»;
    طابق معامل_مسار(المعاملات, &الاسم) مع
    | نتيجة.نجح(القيمة) -> { النسبي := القيمة; }
    | نتيجة.خطأ(_) -> { };
    أرجع رد_ملفات(الطلب, &(*المعطيات)[الإزاحة], &النسبي, &الإعداد);
}

// Redirects البادئة to البادئة/ (the mount point without its slash).
عرف نفذ_إضافة_شرطة<S>(
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    ليكن الموقع: نص = مع_شرطة(&(*الطلب).الهدف);
    طابق استجابة_إعادة_توجيه_ويب(301, &الموقع) مع
    | اختياري.موجود(الرد) -> { أرجع الرد; }
    | اختياري.لا_شيء -> {
        ليكن النص: نص = «Not Found»;
        أرجع استجابة_نص_ويب(404, &النص);
    };
}

// A handler serving الدليل with الإعداد; its route pattern must end in
// `{*path}`.
عام عرف معالج_ملفات_بإعداد<S>(الدليل: &نص, الإعداد: &إعداد_ملفات): معالج<S> {
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> نفذ_ملفات(المعطيات, الإزاحة, الحالة, الطلب, المعاملات);
    ليكن المعطيات: متجه نص = معطيات_الإعداد(الدليل, الإعداد);
    أرجع معالج_بمعطيات(التنفيذ, المعطيات);
}

// A handler serving الدليل with the default settings.
عام عرف معالج_ملفات<S>(الدليل: &نص): معالج<S> {
    ليكن الإعداد: إعداد_ملفات = إعداد_ملفات_افتراضي();
    أرجع معالج_ملفات_بإعداد(الدليل, &الإعداد);
}

// Registers GET البادئة/{*path} serving الدليل with الإعداد (and, when
// directories have an index, GET البادئة redirecting to البادئة/). البادئة
// «/» serves the whole site from الدليل.
عام عرف اربط_ملفات_بإعداد<S>(
    الموجه: &متغير موجه<S>,
    البادئة: &نص,
    الدليل: &نص,
    الإعداد: &إعداد_ملفات
): نتيجة طبيعي, خطأ_توجيه {
    ليكن البادئة_مقصوصة: متغير نص = استنسخ(البادئة);
    ليكن شرطة: نص = «/»;
    طابق أزل_اللاحقة(البادئة, &شرطة) مع
    | اختياري.موجود(القيمة) -> { البادئة_مقصوصة := القيمة; }
    | اختياري.لا_شيء -> { };
    ليكن get: نص = «GET»;
    إذا (الطول(البادئة_مقصوصة) > 0 && الطول((*الإعداد).الفهرس) > 0) {
        ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
            المعطيات: &متجه نص,
            الإزاحة: طبيعي,
            الحالة: &S,
            الطلب: &طلب_ويب<متجه ط8>,
            المعاملات: &معاملات_مسار_ويب
        ): استجابة_ويب<متجه ط8> -> نفذ_إضافة_شرطة(المعطيات, الإزاحة, الحالة, الطلب, المعاملات);
        ليكن لا_معطيات: متجه نص = [];
        ليكن المعيد: معالج<S> = معالج_بمعطيات(التنفيذ, لا_معطيات);
        طابق سجل_مسارا(الموجه, &get, &البادئة_مقصوصة, المعيد) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
    };
    ليكن الجذر: نص = «/»;
    إذا (الطول(البادئة_مقصوصة) == 0) {
        // «/» itself: the catch-all does not match an empty rest.
        ليكن معالج_الجذر: معالج<S> = معالج_ملفات_بإعداد(الدليل, الإعداد);
        طابق سجل_مسارا(الموجه, &get, &الجذر, معالج_الجذر) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
    };
    ليكن الأجزاء: متجه نص = [البادئة_مقصوصة, «/{*path}»];
    ليكن فارغ: نص = «»;
    ليكن النمط: نص = صل_النصوص(&الأجزاء, &فارغ);
    ليكن المعالج: معالج<S> = معالج_ملفات_بإعداد(الدليل, الإعداد);
    أرجع سجل_مسارا(الموجه, &get, &النمط, المعالج);
}

// Registers GET البادئة/{*path} serving الدليل with the default settings.
عام عرف اربط_ملفات<S>(
    الموجه: &متغير موجه<S>,
    البادئة: &نص,
    الدليل: &نص
): نتيجة طبيعي, خطأ_توجيه {
    ليكن الإعداد: إعداد_ملفات = إعداد_ملفات_افتراضي();
    أرجع اربط_ملفات_بإعداد(الموجه, البادئة, الدليل, &الإعداد);
}

// ---- files compiled into the binary ----

// Serves المحتوى (the bytes, usually `ضمن_ملف(«public/app.js»)` /
// `embed_file("public/app.js")`) at GET المسار, with the content type of
// المسار's extension, a weak ETag and 304, and Cache-Control التخزين when it
// is not empty. Like Go's embed with http.FileServer: the binary carries its
// assets, so nothing has to be deployed next to it.
عام عرف اربط_ملفا_مضمنا_بتخزين<S>(
    الموجه: &متغير موجه<S>,
    المسار: &نص,
    المحتوى: نص,
    التخزين: نص
): نتيجة طبيعي, خطأ_توجيه {
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> رد_ملف_مضمن(الطلب, المعطيات, الإزاحة);
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(المحتوى) مثل طبيعي)) { ألحق(البايتات, المحتوى[ف]); ف := ف + 1; }
    ليكن الوسم: نص = وسم_ضعيف(&البايتات);
    ليكن المعطيات: متجه نص = [المحتوى, نوع_ملف_بترميز(المسار), الوسم, التخزين];
    ليكن المعالج: معالج<S> = معالج_بمعطيات(التنفيذ, المعطيات);
    ليكن get: نص = «GET»;
    أرجع سجل_مسارا(الموجه, &get, المسار, المعالج);
}

عام عرف اربط_ملفا_مضمنا<S>(
    الموجه: &متغير موجه<S>,
    المسار: &نص,
    المحتوى: نص
): نتيجة طبيعي, خطأ_توجيه {
    أرجع اربط_ملفا_مضمنا_بتخزين(الموجه, المسار, المحتوى, «»);
}

عرف رد_ملف_مضمن(الطلب: &طلب_ويب<متجه ط8>, المعطيات: &متجه نص, الإزاحة: طبيعي): استجابة_ويب<متجه ط8> {
    ليكن الوسم: &نص = &(*المعطيات)[الإزاحة + 2];
    ليكن الاستجابة: متغير استجابة_ويب<متجه ط8> = استجابة_فارغة_ويب(304);
    إذا (!يطابق_الوسم(الطلب, الوسم)) {
        ليكن المحتوى: &نص = &(*المعطيات)[الإزاحة];
        ليكن البايتات: متغير متجه ط8 = [];
        ليكن ف: متغير طبيعي = 0;
        طالما (ف < (الطول(*المحتوى) مثل طبيعي)) { ألحق(البايتات, (*المحتوى)[ف]); ف := ف + 1; }
        الاستجابة := استجابة_بايتات_ويب(200, البايتات, &(*المعطيات)[الإزاحة + 1]);
    };
    ليكن اسم_الوسم: نص = «etag»;
    ليكن ت1: منطقي = عين_رأسا(&متغير الاستجابة, &اسم_الوسم, الوسم);
    إذا (الطول((*المعطيات)[الإزاحة + 3]) > 0) {
        ليكن اسم_التخزين: نص = «cache-control»;
        ليكن ت2: منطقي = عين_رأسا(&متغير الاستجابة, &اسم_التخزين, &(*المعطيات)[الإزاحة + 3]);
    };
    أرجع الاستجابة;
}

عام مرادف serve_embedded = اربط_ملفا_مضمنا;
عام مرادف serve_embedded_with_cache = اربط_ملفا_مضمنا_بتخزين;
عام نوع static_config = إعداد_ملفات;
عام مرادف default_static_config = إعداد_ملفات_افتراضي;
عام مرادف static_files_response = رد_ملفات;
عام مرادف static_files_handler_with = معالج_ملفات_بإعداد;
عام مرادف serve_dir_with = اربط_ملفات_بإعداد;
عام مرادف file_content_type = نوع_ملف_بترميز;
عام مرادف accepts_encoding = يقبل_ترميزا;
عام مرادف weak_etag = وسم_ضعيف;
عام مرادف static_file_response = رد_ملف_ثابت;
عام مرادف static_files_handler = معالج_ملفات;
عام مرادف serve_dir = اربط_ملفات;
