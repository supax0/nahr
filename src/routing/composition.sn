استورد std.text.from_bytes;
استورد routing.router;

عام نوع خطأ_تركيب =
    | توجيه بنوع خطأ_توجيه
    | موجه_بوسطاء
    | بادئة_غير_صالحة
;

عرف بادئة_صالحة(البادئة: &نص): منطقي {
    دع القيمة: نص = *البادئة;
    دع العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    أرجع (العدد > 0) && (القيمة[0] == 0x2F);
}

عام عرف نمط_ببادئة(
    البادئة: &نص,
    النمط: &نص
): نتيجة نص, خطأ_تركيب {
    إذا (!بادئة_صالحة(البادئة)) {
        أرجع نتيجة.خطأ(خطأ_تركيب.بادئة_غير_صالحة());
    };

    دع قيمة_البادئة: نص = *البادئة;
    دع قيمة_النمط: نص = استنسخ(النمط);
    دع طول_البادئة: طبيعي =
        الطول(قيمة_البادئة) مثل طبيعي;
    دع طول_النمط: طبيعي =
        الطول(قيمة_النمط) مثل طبيعي;

    إذا ((طول_النمط == 0) || (قيمة_النمط[0] != 0x2F)) {
        أرجع نتيجة.خطأ(خطأ_تركيب.بادئة_غير_صالحة());
    };

    إذا ((طول_البادئة == 1) && (قيمة_البادئة[0] == 0x2F)) {
        أرجع نتيجة.نجح(قيمة_النمط);
    };

    // The sub-router's root is the prefix itself: "/api" + "/" -> "/api".
    إذا (طول_النمط == 1) {
        دع النهاية: متغير طبيعي = طول_البادئة;
        إذا (قيمة_البادئة[النهاية - 1] == 0x2F) { النهاية := النهاية - 1; };
        دع الجذر: متغير متجه ط8 = [];
        دع ف: متغير طبيعي = 0;
        طالما (ف < النهاية) {
            ألحق(الجذر, قيمة_البادئة[ف]);
            ف := ف + 1;
        }
        أرجع نتيجة.نجح(من_بايتات(&الجذر));
    };

    دع البايتات: متغير متجه ط8 = [];
    دع موضع: متغير طبيعي = 0;
    طالما (موضع < طول_البادئة) {
        ألحق(البايتات, قيمة_البادئة[موضع]);
        موضع := موضع + 1;
    }

    دع يبدأ_النمط: متغير طبيعي = 0;
    دع آخر_البادئة: متغير طبيعي = 0;
    إذا (طول_البادئة > 0) {
        آخر_البادئة := طول_البادئة - 1;
    };
    إذا ((طول_البادئة > 0)
        && (قيمة_البادئة[آخر_البادئة] == 0x2F)) {
        يبدأ_النمط := 1;
    };

    موضع := يبدأ_النمط;
    طالما (موضع < طول_النمط) {
        ألحق(البايتات, قيمة_النمط[موضع]);
        موضع := موضع + 1;
    }

    أرجع نتيجة.نجح(من_بايتات(&البايتات));
}

// Copies the routes of المصدر (patterns prefixed by البادئة when given) into
// الموجه. Every route is validated against a scratch copy first, so a
// conflict leaves الموجه unchanged.
عرف انسخ_المسارات<S>(
    الموجه: &متغير موجه<S>,
    المصدر: &موجه<S>,
    البادئة: &اختياري نص
): نتيجة طبيعي, خطأ_تركيب {
    إذا ((الطول((*المصدر).الوسطاء) مثل طبيعي) > 0) {
        أرجع نتيجة.خطأ(خطأ_تركيب.موجه_بوسطاء());
    };

    دع الأنماط: متغير متجه نص = [];
    دع العدد: طبيعي =
        الطول((*المصدر).الداخلي.الحالة.المسارات) مثل طبيعي;
    دع موضع: متغير طبيعي = 0;
    طالما (موضع < العدد) {
        دع المسار: &مسار_مسجل<S> =
            &(*المصدر).الداخلي.الحالة.المسارات[موضع];
        طابق *البادئة مع
        | اختياري.لا_شيء -> {
            ألحق(الأنماط, استنسخ(&(*المسار).النمط));
        }
        | اختياري.موجود(القيمة) -> {
            طابق نمط_ببادئة(&القيمة, &(*المسار).النمط) مع
            | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
            | نتيجة.نجح(النمط) -> { ألحق(الأنماط, النمط); };
        };
        موضع := موضع + 1;
    }

    // Dry run on a copy: the std router reports invalid or duplicate routes.
    دع التجربة: متغير موجه<S> = استنسخ(الموجه);
    موضع := 0;
    طالما (موضع < العدد) {
        دع المسار: &مسار_مسجل<S> =
            &(*المصدر).الداخلي.الحالة.المسارات[موضع];
        طابق سجل_مسارا(
            &متغير التجربة,
            &(*المسار).الطريقة,
            &الأنماط[موضع],
            استنسخ(&(*المسار).المعالج)
        ) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(خطأ_تركيب.توجيه(الخطأ));
        }
        | نتيجة.نجح(_) -> { };
        موضع := موضع + 1;
    }
    *الموجه := التجربة;
    أرجع نتيجة.نجح(العدد);
}

// Adds every route of الآخر to الموجه. Routers with global middleware can't
// be merged: that middleware would silently stop applying.
عام عرف ادمج<S>(
    الموجه: &متغير موجه<S>,
    الآخر: &موجه<S>
): نتيجة طبيعي, خطأ_تركيب {
    دع بلا_بادئة: اختياري نص = اختياري.لا_شيء();
    أرجع انسخ_المسارات(الموجه, الآخر, &بلا_بادئة);
}

// Mounts the routes of الفرعي under البادئة ("/api" + "/users" →
// "/api/users"; the sub-router's "/" becomes "/api").
عام عرف اربط<S>(
    الموجه: &متغير موجه<S>,
    البادئة: &نص,
    الفرعي: &موجه<S>
): نتيجة طبيعي, خطأ_تركيب {
    دع البادئة_الاختيارية: اختياري نص = اختياري.موجود(استنسخ(البادئة));
    أرجع انسخ_المسارات(الموجه, الفرعي, &البادئة_الاختيارية);
}

عام مرادف composition_error = خطأ_تركيب;
عام مرادف merge = ادمج;
عام مرادف nest = اربط;
عام مرادف prefixed_pattern = نمط_ببادئة;
عام مرادف composition_error.routing = خطأ_تركيب.توجيه;
عام مرادف composition_error.layered_router = خطأ_تركيب.موجه_بوسطاء;
عام مرادف composition_error.invalid_prefix = خطأ_تركيب.بادئة_غير_صالحة;
