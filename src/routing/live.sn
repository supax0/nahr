من std.http استورد
    موجه_ويب,
    أضف_مسار_ويب,
    وجه_طلب_ويب,
    طلب_ويب,
    استجابة_ويب,
    استجابة_فارغة_ويب,
    معاملات_مسار_ويب,
    معامل_مسار_ويب,
    رأس_ويب,
    ضع_رأس_ويب,
    أول_قيمة_رأس_ويب,
    ناقل_ويب,
    أغلق_ناقل_ويب;

من std.text استورد من_بايتات, نصان_متساويان, طبيعي_إلى_نص, حلل_طبيعي;
من std.sync استورد مشترك, استنسخ_مشترك, اقرأ_مشترك;
من std.thread استورد أطلق;
من std.os استورد خيوط_النظام_مدعومة;

استورد routing.router;
استورد handler.adapter;
استورد middleware.chain;
استورد live.connection;
استورد websocket.handshake;

// Live routes: a WebSocket that stays open after its handshake, and
// streamed responses (server-sent events, long downloads) written while the
// handler runs, as FastAPI's @app.websocket and StreamingResponse, axum's
// WebSocketUpgrade and Sse.
//
//     اربط_مقبس_ويب(&متغير الموجه, &«/ws», صدى);
//     اربط_أحداث(&متغير الموجه, &«/events», ساعة);
//
// The route answers like any other (middleware runs, so auth can refuse the
// upgrade); when its 101 or streamed head has gone out, std hands the socket
// to Nahr (std.http handover.sn), which calls the handler with the
// connection and closes the socket when it returns. Every Nahr server passes
// that hand-over to std.

// ---- registration ----

عرف رد_داخلي(النوع: ط8, الفهرس: طبيعي, المعاملات: &معاملات_مسار_ويب): استجابة_ويب<متجه ط8> {
    ليكن الاستجابة: متغير استجابة_ويب<متجه ط8> = استجابة_فارغة_ويب(200);
    ليكن اسم_النوع: نص = «x-nahr-live-kind»;
    ليكن قيمة_النوع: نص = طبيعي_إلى_نص(النوع مثل طبيعي);
    ليكن ت1: منطقي = ضع_رأس_ويب(&متغير الاستجابة.الرؤوس, &اسم_النوع, &قيمة_النوع);
    ليكن اسم_الفهرس: نص = «x-nahr-live-index»;
    ليكن قيمة_الفهرس: نص = طبيعي_إلى_نص(الفهرس);
    ليكن ت2: منطقي = ضع_رأس_ويب(&متغير الاستجابة.الرؤوس, &اسم_الفهرس, &قيمة_الفهرس);
    // The path parameters travel in the body: name NUL value NUL ...
    ليكن الجسم: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*المعاملات).القيم) مثل طبيعي)) {
        ليكن المعامل: &معامل_مسار_ويب = &(*المعاملات).القيم[ف];
        ألحق_بايتات(&متغير الجسم, &(*المعامل).الاسم);
        ألحق(الجسم, 0);
        ألحق_بايتات(&متغير الجسم, &(*المعامل).القيمة);
        ألحق(الجسم, 0);
        ف := ف + 1;
    }
    الاستجابة.الجسم := الجسم;
    أرجع الاستجابة;
}

عرف ألحق_بايتات(الخرج: &متغير متجه ط8, النص: &نص): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) { ألحق(*الخرج, (*النص)[ف]); ف := ف + 1; }
}

// Adds the route to the internal router and the live table.
عرف سجل_حيا<S>(
    الموجه: &متغير موجه<S>,
    الطريقة: &نص,
    النمط: &نص,
    النوع: ط8,
    الفهرس: طبيعي,
    النوع_الإعلامي: &نص
): نتيجة طبيعي, خطأ_توجيه {
    ليكن الداخلي: معالج_مسار_ويب_حي = دالة(
        الحالة: &طبيعي,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> رد_داخلي(النوع, الفهرس, المعاملات);
    طابق أضف_مسار_ويب(&متغير (*الموجه).الاتصالات, الطريقة, النمط, الداخلي) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    ليكن الحي: مسار_حي = {
        الطريقة: استنسخ(الطريقة),
        النمط: استنسخ(النمط),
        النوع: النوع,
        الفهرس: الفهرس,
        النوع_الإعلامي: استنسخ(النوع_الإعلامي)
    };
    ألحق((*الموجه).الحية, الحي);
    أرجع نتيجة.نجح(الفهرس);
}

عام نوع معالج_مسار_ويب_حي = دالة(&طبيعي, &طلب_ويب<متجه ط8>, &معاملات_مسار_ويب): استجابة_ويب<متجه ط8>;

// The handshake route: 101 Switching Protocols, or the RFC 6455 rejection
// (400, or 426 with Sec-WebSocket-Version for another version).
عرف نفذ_مصافحة<S>(
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    طابق تحقق_مصافحة_مقبس_ويب(الطلب) مع
    | نتيجة.نجح(المفتاح) -> { أرجع رد_مصافحة_مقبس_ويب(&المفتاح); }
    | نتيجة.خطأ(الخطأ) -> { أرجع رد_رفض_مصافحة_مقبس_ويب(&الخطأ); };
}

// A streamed head: 200, the content type, transfer-encoding chunked and no
// body, which tells std to hand the connection over after the head.
عرف نفذ_رأس_تدفق<S>(
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    ليكن الاستجابة: متغير استجابة_ويب<متجه ط8> = استجابة_فارغة_ويب(200);
    ليكن ct: نص = «content-type»;
    ليكن ت1: منطقي = ضع_رأس_ويب(&متغير الاستجابة.الرؤوس, &ct, &(*المعطيات)[الإزاحة]);
    ليكن te: نص = «transfer-encoding»;
    ليكن chunked: نص = «chunked»;
    ليكن ت2: منطقي = ضع_رأس_ويب(&متغير الاستجابة.الرؤوس, &te, &chunked);
    ليكن cc: نص = «cache-control»;
    ليكن no_cache: نص = «no-cache»;
    ليكن ت3: منطقي = ضع_رأس_ويب(&متغير الاستجابة.الرؤوس, &cc, &no_cache);
    // nginx buffers proxied responses unless told not to.
    ليكن xab: نص = «x-accel-buffering»;
    ليكن no: نص = «no»;
    ليكن ت4: منطقي = ضع_رأس_ويب(&متغير الاستجابة.الرؤوس, &xab, &no);
    أرجع الاستجابة;
}

// GET النمط as a WebSocket endpoint: the handshake is checked and answered,
// then الدالة runs with the open connection.
عام عرف اربط_مقبس_ويب<S>(
    الموجه: &متغير موجه<S>,
    النمط: &نص,
    الدالة: دالة_مقبس<S>
): نتيجة طبيعي, خطأ_توجيه {
    ليكن get: نص = «GET»;
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> نفذ_مصافحة(المعطيات, الإزاحة, الحالة, الطلب, المعاملات);
    ليكن لا_معطيات: متجه نص = [];
    ليكن المعالج: معالج<S> = معالج_بمعطيات(التنفيذ, لا_معطيات);
    طابق سجل_مسارا(الموجه, &get, النمط, المعالج) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    ليكن الفهرس: طبيعي = الطول((*الموجه).المقابس) مثل طبيعي;
    ألحق((*الموجه).المقابس, الدالة);
    ليكن فارغ: نص = «»;
    أرجع سجل_حيا(الموجه, &get, النمط, 1, الفهرس, &فارغ);
}

// الطريقة النمط as a streamed response of النوع_الإعلامي: الدالة writes the
// body piece by piece while the client receives it.
عام عرف اربط_تدفقا<S>(
    الموجه: &متغير موجه<S>,
    الطريقة: &نص,
    النمط: &نص,
    النوع_الإعلامي: &نص,
    الدالة: دالة_تدفق<S>
): نتيجة طبيعي, خطأ_توجيه {
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> نفذ_رأس_تدفق(المعطيات, الإزاحة, الحالة, الطلب, المعاملات);
    ليكن المعطيات: متجه نص = [استنسخ(النوع_الإعلامي)];
    ليكن المعالج: معالج<S> = معالج_بمعطيات(التنفيذ, المعطيات);
    طابق سجل_مسارا(الموجه, الطريقة, النمط, المعالج) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    ليكن الفهرس: طبيعي = الطول((*الموجه).التدفقات) مثل طبيعي;
    ألحق((*الموجه).التدفقات, الدالة);
    أرجع سجل_حيا(الموجه, الطريقة, النمط, 2, الفهرس, النوع_الإعلامي);
}

// GET النمط as server-sent events (text/event-stream).
عام عرف اربط_أحداث<S>(
    الموجه: &متغير موجه<S>,
    النمط: &نص,
    الدالة: دالة_تدفق<S>
): نتيجة طبيعي, خطأ_توجيه {
    ليكن get: نص = «GET»;
    ليكن النوع: نص = «text/event-stream; charset=utf-8»;
    أرجع اربط_تدفقا(الموجه, &get, النمط, &النوع, الدالة);
}

// ---- hand-over ----

عرف معاملات_من_جسم(الجسم: &متجه ط8): معاملات_مسار_ويب {
    ليكن القيم: متغير متجه معامل_مسار_ويب = [];
    ليكن الحالي: متغير متجه ط8 = [];
    ليكن الاسم: متغير نص = «»;
    ليكن في_القيمة: متغير منطقي = خطأ;
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*الجسم) مثل طبيعي)) {
        ليكن ب: ط8 = (*الجسم)[ف];
        إذا (ب == 0) {
            إذا (في_القيمة) {
                ليكن المعامل: معامل_مسار_ويب = { الاسم: استنسخ(&الاسم), القيمة: من_بايتات(&الحالي) };
                ألحق(القيم, المعامل);
                في_القيمة := خطأ;
            } وإلا {
                الاسم := من_بايتات(&الحالي);
                في_القيمة := صواب;
            };
            ليكن فارغ_جديد: متجه ط8 = [];
            الحالي := فارغ_جديد;
        } وإلا {
            ألحق(الحالي, ب);
        };
        ف := ف + 1;
    }
    ليكن الناتج: معاملات_مسار_ويب = { القيم: القيم };
    أرجع الناتج;
}

عرف رقم_رأس(الاستجابة: &استجابة_ويب<متجه ط8>, الاسم: نص): طبيعي {
    طابق أول_قيمة_رأس_ويب(&(*الاستجابة).الرؤوس, &الاسم) مع
    | اختياري.لا_شيء -> { أرجع 0; }
    | اختياري.موجود(القيمة) -> {
        طابق حلل_طبيعي(&القيمة) مع
        | نتيجة.نجح(الرقم) -> { أرجع الرقم; }
        | نتيجة.خطأ(_) -> { أرجع 0; };
    };
}

عرف شغل_مقبسا<S>(
    الحالة: مشترك<S>,
    الدالة: دالة_مقبس<S>,
    الطلب: طلب_ويب<متجه ط8>,
    المعاملات: معاملات_مسار_ويب,
    الناقل: ناقل_ويب,
    الباقي: متجه ط8
): فراغ {
    شغل_مقبسا_على(اقرأ_مشترك(&الحالة), الدالة, &الطلب, &المعاملات, &الناقل, الباقي);
    ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(الناقل);
}

عرف شغل_مقبسا_على<S>(
    الحالة: &S,
    الدالة: دالة_مقبس<S>,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب,
    الناقل: &ناقل_ويب,
    الباقي: متجه ط8
): فراغ {
    ليكن الاتصال: متغير اتصال_مقبس_ويب = اتصال_مقبس_من(الناقل, الباقي);
    الدالة(الحالة, الطلب, المعاملات, &متغير الاتصال);
    ليكن فارغ: نص = «»;
    أغلق_مقبسا(&متغير الاتصال, 1000, &فارغ);
}

عرف شغل_تدفقا<S>(
    الحالة: مشترك<S>,
    الدالة: دالة_تدفق<S>,
    الطلب: طلب_ويب<متجه ط8>,
    المعاملات: معاملات_مسار_ويب,
    الناقل: ناقل_ويب
): فراغ {
    شغل_تدفقا_على(اقرأ_مشترك(&الحالة), الدالة, &الطلب, &المعاملات, &الناقل);
    ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(الناقل);
}

عرف شغل_تدفقا_على<S>(
    الحالة: &S,
    الدالة: دالة_تدفق<S>,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب,
    الناقل: &ناقل_ويب
): فراغ {
    ليكن التدفق: متغير تدفق_ويب = تدفق_من(الناقل);
    الدالة(الحالة, الطلب, المعاملات, &متغير التدفق);
    أنه_التدفق(&متغير التدفق);
}

// The hand-over every Nahr server gives std: finds the live route of الطلب
// and runs its handler with the connection on a thread of its own, so the
// server's worker (which, in the event-driven server, also owns a share of
// the listening connections) goes back to serving at once. The session
// thread closes the socket when the handler returns. Without threads (WASI,
// the interpreter) the handler runs here.
عام عرف سلم_اتصالا<S>(
    الموجه: &موجه<S>,
    الطلب: &طلب_ويب<متجه ط8>,
    الاستجابة: &استجابة_ويب<متجه ط8>,
    الناقل: ناقل_ويب,
    الباقي: متجه ط8
): فراغ {
    ليكن الداخلي: استجابة_ويب<متجه ط8> = وجه_طلب_ويب(&(*الموجه).الاتصالات, الطلب);
    ليكن النوع: متغير طبيعي = 0;
    ليكن الفهرس: متغير طبيعي = 0;
    إذا (الداخلي.الحالة == 200) {
        النوع := رقم_رأس(&الداخلي, «x-nahr-live-kind»);
        الفهرس := رقم_رأس(&الداخلي, «x-nahr-live-index»);
    };
    ليكن مقبس: منطقي = النوع == 1 && (*الاستجابة).الحالة == 101
        && الفهرس < (الطول((*الموجه).المقابس) مثل طبيعي);
    ليكن تدفق: منطقي = النوع == 2 && الفهرس < (الطول((*الموجه).التدفقات) مثل طبيعي);
    إذا (!مقبس && !تدفق) {
        ليكن تجاهل: نتيجة عدد, عدد = أغلق_ناقل_ويب(الناقل);
        أرجع;
    };
    ليكن الحالة: مشترك<S> = استنسخ_مشترك(&(*الموجه).الداخلي.الحالة.الحالة);
    ليكن المعاملات: معاملات_مسار_ويب = معاملات_من_جسم(&الداخلي.الجسم);
    ليكن الطلب_المنسوخ: طلب_ويب<متجه ط8> = استنسخ(الطلب);
    إذا (مقبس) {
        ليكن الدالة: دالة_مقبس<S> = (*الموجه).المقابس[الفهرس];
        شغل_جلسة_مقبس(الحالة, الدالة, الطلب_المنسوخ, المعاملات, الناقل, الباقي);
    } وإلا {
        ليكن الدالة: دالة_تدفق<S> = (*الموجه).التدفقات[الفهرس];
        شغل_جلسة_تدفق(الحالة, الدالة, الطلب_المنسوخ, المعاملات, الناقل);
    };
}

// A spawned closure owns what it captures, so thread support is checked
// first; without it the session runs on the caller.
عرف شغل_جلسة_مقبس<S>(
    الحالة: مشترك<S>,
    الدالة: دالة_مقبس<S>,
    الطلب: طلب_ويب<متجه ط8>,
    المعاملات: معاملات_مسار_ويب,
    الناقل: ناقل_ويب,
    الباقي: متجه ط8
): فراغ {
    إذا (!خيوط_النظام_مدعومة()) {
        شغل_مقبسا(الحالة, الدالة, الطلب, المعاملات, الناقل, الباقي);
        أرجع;
    };
    // The closure owns its captures; the body reaches them by reference.
    طابق أطلق(دالة(): فراغ -> شغل_مقبسا(
        استنسخ_مشترك(&الحالة), الدالة, استنسخ(&الطلب), استنسخ(&المعاملات), استنسخ(&الناقل), استنسخ(&الباقي)
    )) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { };
}

عرف شغل_جلسة_تدفق<S>(
    الحالة: مشترك<S>,
    الدالة: دالة_تدفق<S>,
    الطلب: طلب_ويب<متجه ط8>,
    المعاملات: معاملات_مسار_ويب,
    الناقل: ناقل_ويب
): فراغ {
    إذا (!خيوط_النظام_مدعومة()) {
        شغل_تدفقا(الحالة, الدالة, الطلب, المعاملات, الناقل);
        أرجع;
    };
    طابق أطلق(دالة(): فراغ -> شغل_تدفقا(
        استنسخ_مشترك(&الحالة), الدالة, استنسخ(&الطلب), استنسخ(&المعاملات), استنسخ(&الناقل)
    )) مع
    | نتيجة.نجح(_) -> { }
    | نتيجة.خطأ(_) -> { };
}

عام مرادف websocket_route = اربط_مقبس_ويب;
عام مرادف stream_route = اربط_تدفقا;
عام مرادف sse_route = اربط_أحداث;
عام مرادف hand_over_connection = سلم_اتصالا;
