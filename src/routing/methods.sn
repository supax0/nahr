    دع الطريقة: نص = «TRACE»;
    أرجع سجل_مسارا(الموجه, &الطريقة, النمط, المعالج);
}

عام مرادف get = جلب;
عام مرادف post = أرسل;
عام مرادف put = استبدل;
عام مرادف patch = عدل;
عام مرادف delete = احذف;
عام مرادف head = رأس;
عام مرادف options = خيارات;
عام مرادف connect = اتصل;
عام مرادف trace = تتبع;
