استورد handler.adapter;

استورد routing.router;

عام عرف جلب<S>(
    الموجه: &متغير موجه<S>,
    النمط: &نص,
    المعالج: معالج<S>
): نتيجة طبيعي, خطأ_توجيه {
    دع الطريقة: نص = «GET»;
    أرجع سجل_مسارا(الموجه, &الطريقة, النمط, المعالج);
}

عام عرف أرسل<S>(
    الموجه: &متغير موجه<S>,
