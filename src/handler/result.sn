من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب;

استورد handler.adapter;

عام نوع محول_نجاح<R> = دالة(R): استجابة_ويب<متجه ط8>;
عام نوع محول_فشل<E> = دالة(&E): استجابة_ويب<متجه ط8>;

عام نوع معالج_نتيجة<S, R, E> = دالة(
    &S,
    &طلب_ويب<متجه ط8>,
    &معاملات_مسار_ويب
): نتيجة R, E;

عرف نفذ_معالج_نتيجة<S, R, E>(
    المعالج: معالج_نتيجة<S, R, E>,
    عند_النجاح: محول_نجاح<R>,
    عند_الفشل: محول_فشل<E>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    طابق المعالج(الحالة, الطلب, المعاملات) مع
    | نتيجة.نجح(القيمة) -> {
        أرجع عند_النجاح(القيمة);
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع عند_الفشل(&الخطأ);
    };
}

عام عرف حول_معالج_نتيجة<S, R, E>(
    المعالج: معالج_نتيجة<S, R, E>,
    عند_النجاح: محول_نجاح<R>,
    عند_الفشل: محول_فشل<E>
): معالج<S> {
    ليكن المغلف: دالة_معالج<S> = دالة(
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> نفذ_معالج_نتيجة(
        المعالج,
        عند_النجاح,
        عند_الفشل,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع من_دالة(المغلف);
}

عام نوع success_mapper<R> = محول_نجاح<R>;
عام نوع failure_mapper<E> = محول_فشل<E>;
عام نوع result_handler<S, R, E> = معالج_نتيجة<S, R, E>;
عام مرادف adapt_result_handler = حول_معالج_نتيجة;
