من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب;

استورد handler.adapter;
استورد extract.typed;
استورد middleware.chain;

عام نوع معالج_قيمة<S, T> = دالة(
    &S,
    T
): استجابة_ويب<متجه ط8>;

عام نوع معالج_قيمتين<S, A, B> = دالة(
    &S,
    A,
    B
): استجابة_ويب<متجه ط8>;

عام نوع معالج_ثلاث_قيم<S, A, B, C> = دالة(
    &S,
    A,
    B,
    C
): استجابة_ويب<متجه ط8>;

// The handler's arguments are its extractors' arguments, in order; each
// extractor runs at its own offset.
عرف نفذ_مع_استخراج<S, T>(
    المستخرج: تنفيذ_مستخرج<S, T>,
    المعالج: معالج_قيمة<S, T>,
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    طابق المستخرج(المعطيات, الإزاحة, الحالة, الطلب, المعاملات) مع
    | نتيجة.خطأ(الاستجابة) -> { أرجع الاستجابة; }
    | نتيجة.نجح(القيمة) -> { أرجع المعالج(الحالة, القيمة); };
}

عام عرف مع_استخراج<S, T>(
    المستخرج: مستخرج<S, T>,
    المعالج: معالج_قيمة<S, T>
): معالج<S> {
    ليكن تنفيذ_المستخرج: تنفيذ_مستخرج<S, T> = المستخرج.التنفيذ;
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> نفذ_مع_استخراج(
        تنفيذ_المستخرج,
        المعالج,
        المعطيات,
        الإزاحة,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع معالج_بمعطيات(التنفيذ, استنسخ(&المستخرج.المعطيات));
}

عرف نفذ_مع_استخراجين<S, A, B>(
    الأول: تنفيذ_مستخرج<S, A>,
    الثاني: تنفيذ_مستخرج<S, B>,
    عدد_الأول: طبيعي,
    المعالج: معالج_قيمتين<S, A, B>,
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    ليكن القيمة_الأولى: A;
    طابق الأول(المعطيات, الإزاحة, الحالة, الطلب, المعاملات) مع
    | نتيجة.خطأ(الاستجابة) -> { أرجع الاستجابة; }
    | نتيجة.نجح(القيمة) -> { القيمة_الأولى := القيمة; };

    ليكن القيمة_الثانية: B;
    طابق الثاني(
        المعطيات,
        الإزاحة + عدد_الأول,
        الحالة,
        الطلب,
        المعاملات
    ) مع
    | نتيجة.خطأ(الاستجابة) -> { أرجع الاستجابة; }
    | نتيجة.نجح(القيمة) -> { القيمة_الثانية := القيمة; };

    أرجع المعالج(الحالة, القيمة_الأولى, القيمة_الثانية);
}

عام عرف مع_استخراجين<S, A, B>(
    الأول: مستخرج<S, A>,
    الثاني: مستخرج<S, B>,
    المعالج: معالج_قيمتين<S, A, B>
): معالج<S> {
    ليكن تنفيذ_الأول: تنفيذ_مستخرج<S, A> = الأول.التنفيذ;
    ليكن تنفيذ_الثاني: تنفيذ_مستخرج<S, B> = الثاني.التنفيذ;
    ليكن عدد_الأول: طبيعي = الطول(الأول.المعطيات) مثل طبيعي;
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> نفذ_مع_استخراجين(
        تنفيذ_الأول,
        تنفيذ_الثاني,
        عدد_الأول,
        المعالج,
        المعطيات,
        الإزاحة,
        الحالة,
        الطلب,
        المعاملات
    );
    ليكن المعطيات: متغير متجه نص = [];
    ألحق_معطيات(&متغير المعطيات, &الأول.المعطيات);
    ألحق_معطيات(&متغير المعطيات, &الثاني.المعطيات);
    أرجع معالج_بمعطيات(التنفيذ, المعطيات);
}

عرف نفذ_مع_ثلاثة_استخراجات<S, A, B, C>(
    الأول: تنفيذ_مستخرج<S, A>,
    الثاني: تنفيذ_مستخرج<S, B>,
    الثالث: تنفيذ_مستخرج<S, C>,
    عدد_الأول: طبيعي,
    عدد_الثاني: طبيعي,
    المعالج: معالج_ثلاث_قيم<S, A, B, C>,
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    ليكن القيمة_الأولى: A;
    طابق الأول(المعطيات, الإزاحة, الحالة, الطلب, المعاملات) مع
    | نتيجة.خطأ(الاستجابة) -> { أرجع الاستجابة; }
    | نتيجة.نجح(القيمة) -> { القيمة_الأولى := القيمة; };

    ليكن القيمة_الثانية: B;
    طابق الثاني(
        المعطيات,
        الإزاحة + عدد_الأول,
        الحالة,
        الطلب,
        المعاملات
    ) مع
    | نتيجة.خطأ(الاستجابة) -> { أرجع الاستجابة; }
    | نتيجة.نجح(القيمة) -> { القيمة_الثانية := القيمة; };

    ليكن القيمة_الثالثة: C;
    طابق الثالث(
        المعطيات,
        الإزاحة + عدد_الأول + عدد_الثاني,
        الحالة,
        الطلب,
        المعاملات
    ) مع
    | نتيجة.خطأ(الاستجابة) -> { أرجع الاستجابة; }
    | نتيجة.نجح(القيمة) -> { القيمة_الثالثة := القيمة; };

    أرجع المعالج(
        الحالة,
        القيمة_الأولى,
        القيمة_الثانية,
        القيمة_الثالثة
    );
}

عام عرف مع_ثلاثة_استخراجات<S, A, B, C>(
    الأول: مستخرج<S, A>,
    الثاني: مستخرج<S, B>,
    الثالث: مستخرج<S, C>,
    المعالج: معالج_ثلاث_قيم<S, A, B, C>
): معالج<S> {
    ليكن تنفيذ_الأول: تنفيذ_مستخرج<S, A> = الأول.التنفيذ;
    ليكن تنفيذ_الثاني: تنفيذ_مستخرج<S, B> = الثاني.التنفيذ;
    ليكن تنفيذ_الثالث: تنفيذ_مستخرج<S, C> = الثالث.التنفيذ;
    ليكن عدد_الأول: طبيعي = الطول(الأول.المعطيات) مثل طبيعي;
    ليكن عدد_الثاني: طبيعي = الطول(الثاني.المعطيات) مثل طبيعي;
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> نفذ_مع_ثلاثة_استخراجات(
        تنفيذ_الأول,
        تنفيذ_الثاني,
        تنفيذ_الثالث,
        عدد_الأول,
        عدد_الثاني,
        المعالج,
        المعطيات,
        الإزاحة,
        الحالة,
        الطلب,
        المعاملات
    );
    ليكن المعطيات: متغير متجه نص = [];
    ألحق_معطيات(&متغير المعطيات, &الأول.المعطيات);
    ألحق_معطيات(&متغير المعطيات, &الثاني.المعطيات);
    ألحق_معطيات(&متغير المعطيات, &الثالث.المعطيات);
    أرجع معالج_بمعطيات(التنفيذ, المعطيات);
}

عام نوع extracted_handler<S, T> = معالج_قيمة<S, T>;
عام نوع extracted_handler2<S, A, B> = معالج_قيمتين<S, A, B>;
عام نوع extracted_handler3<S, A, B, C> = معالج_ثلاث_قيم<S, A, B, C>;
عام مرادف with_extractor = مع_استخراج;
عام مرادف with_extractors = مع_استخراجين;
عام مرادف with_three_extractors = مع_ثلاثة_استخراجات;
