من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب;

استورد response.headers;
استورد extract.path;
استورد middleware.chain;
استورد extension.context;
استورد extract.typed;

عام نوع طلب = طلب_ويب<متجه ط8>;

// Canonical handler function shape.
عام نوع دالة_معالج<S> = دالة(
    &S,
    &طلب_ويب<متجه ط8>,
    &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8>;

// A route handler. `التنفيذ` receives the handler's text arguments (for
// example the names its extractors read) and the offset where they start.
// SultanC closures capture plain values only, so this configuration travels
// as data rather than inside a closure.
عام نوع معالج<S> = {
    التنفيذ: تنفيذ_مسار<S>,
    المعطيات: متجه نص
};

عام نوع معالج_بسيط = دالة(): استجابة_ويب<متجه ط8>;
عام نوع معالج_حالة<S> = دالة(&S): استجابة_ويب<متجه ط8>;
عام نوع معالج_طلب<S> = دالة(
    &S,
    &طلب_ويب<متجه ط8>
): استجابة_ويب<متجه ط8>;
عام نوع معالج_مسار<S> = دالة(
    &S,
    &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8>;
عام نوع معالج_سياق<S> = دالة(
    &S,
    &متغير سياق_طلب
): استجابة_ويب<متجه ط8>;

// Builds a handler from a run function and its arguments.
عام عرف معالج_بمعطيات<S>(
    التنفيذ: تنفيذ_مسار<S>,
    المعطيات: متجه نص
): معالج<S> {
    ليكن الناتج: معالج<S> = {
        التنفيذ: التنفيذ,
        المعطيات: المعطيات
    };
    أرجع الناتج;
}

عرف معالج_بلا_معطيات<S>(التنفيذ: تنفيذ_مسار<S>): معالج<S> {
    ليكن المعطيات: متجه نص = [];
    أرجع معالج_بمعطيات(التنفيذ, المعطيات);
}

عام عرف استدع<S>(
    المعالج: &معالج<S>,
    الحالة: &S,
    الطلب: &طلب,
    المعاملات: &معاملات_مسار
): استجابة {
    ليكن التنفيذ: تنفيذ_مسار<S> = (*المعالج).التنفيذ;
    أرجع التنفيذ(
        &(*المعالج).المعطيات,
        0,
        الحالة,
        الطلب,
        المعاملات
    );
}

عرف نفذ_دالة_معالج<S>(
    الدالة: دالة_معالج<S>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    أرجع الدالة(الحالة, الطلب, المعاملات);
}

عام عرف من_دالة<S>(الدالة: دالة_معالج<S>): معالج<S> {
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> نفذ_دالة_معالج(
        الدالة,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع معالج_بلا_معطيات(التنفيذ);
}

عرف نفذ_مع_سياق<S>(
    المعالج: معالج_سياق<S>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    ليكن السياق: متغير سياق_طلب =
        أنشئ_سياقا(الطلب, المعاملات);
    أرجع المعالج(
        الحالة,
        &متغير السياق
    );
}

عام عرف من_سياق<S>(المعالج: معالج_سياق<S>): معالج<S> {
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> نفذ_مع_سياق(
        المعالج,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع معالج_بلا_معطيات(التنفيذ);
}

عام عرف من_بسيط<S>(المعالج: معالج_بسيط): معالج<S> {
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> المعالج();
    أرجع معالج_بلا_معطيات(التنفيذ);
}

عام عرف من_حالة<S>(المعالج: معالج_حالة<S>): معالج<S> {
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> المعالج(الحالة);
    أرجع معالج_بلا_معطيات(التنفيذ);
}

عام عرف من_طلب<S>(المعالج: معالج_طلب<S>): معالج<S> {
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> المعالج(الحالة, الطلب);
    أرجع معالج_بلا_معطيات(التنفيذ);
}

عام عرف من_مسار<S>(المعالج: معالج_مسار<S>): معالج<S> {
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> المعالج(الحالة, المعاملات);
    أرجع معالج_بلا_معطيات(التنفيذ);
}

عرف نفذ_مع_وسيط<S>(
    الوسيط: تنفيذ_وسيط_مسار<S>,
    الداخلي: تنفيذ_مسار<S>,
    عدد_الوسيط: طبيعي,
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): استجابة_ويب<متجه ط8> {
    ليكن التالي: التالي_مسار<S> = {
        التنفيذ: الداخلي,
        المعطيات: المعطيات,
        الإزاحة: الإزاحة + عدد_الوسيط
    };
    أرجع الوسيط(
        المعطيات,
        الإزاحة,
        الحالة,
        الطلب,
        المعاملات,
        &التالي
    );
}

// Wraps a handler with route middleware. The middleware runs first and
// decides whether to continue through `تابع_مسار`.
عام عرف مع_وسيط<S>(
    المعالج: معالج<S>,
    الوسيط: وسيط_مسار<S>
): معالج<S> {
    ليكن تنفيذ_الوسيط: تنفيذ_وسيط_مسار<S> = الوسيط.التنفيذ;
    ليكن تنفيذ_الداخلي: تنفيذ_مسار<S> = المعالج.التنفيذ;
    ليكن عدد_الوسيط: طبيعي = الطول(الوسيط.المعطيات) مثل طبيعي;
    ليكن التنفيذ: تنفيذ_مسار<S> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): استجابة_ويب<متجه ط8> -> نفذ_مع_وسيط(
        تنفيذ_الوسيط,
        تنفيذ_الداخلي,
        عدد_الوسيط,
        المعطيات,
        الإزاحة,
        الحالة,
        الطلب,
        المعاملات
    );
    ليكن المعطيات: متغير متجه نص = [];
    ألحق_معطيات(&متغير المعطيات, &الوسيط.المعطيات);
    ألحق_معطيات(&متغير المعطيات, &المعالج.المعطيات);
    أرجع معالج_بمعطيات(التنفيذ, المعطيات);
}

عام مرادف request = طلب;
عام نوع handler<S> = معالج<S>;
عام نوع handler_fn<S> = دالة_معالج<S>;
عام مرادف simple_handler = معالج_بسيط;
عام نوع state_handler<S> = معالج_حالة<S>;
عام نوع request_handler<S> = معالج_طلب<S>;
عام نوع path_handler<S> = معالج_مسار<S>;
عام نوع context_handler<S> = معالج_سياق<S>;
عام مرادف handler_with_arguments = معالج_بمعطيات;
عام مرادف call = استدع;
عام مرادف from_fn = من_دالة;
عام مرادف from_simple = من_بسيط;
عام مرادف from_state = من_حالة;
عام مرادف from_request = من_طلب;
عام مرادف from_path = من_مسار;
عام مرادف from_context = من_سياق;
عام مرادف with_middleware = مع_وسيط;
