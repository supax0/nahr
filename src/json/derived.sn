من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    استجابة_نص_ويب,
    استجابة_بايتات_ويب,
    نص_جسم_طلب_ويب,
    أول_قيمة_رأس_ويب;

من std.text استورد من_بايتات, حول_النص_إلى_صغير_أسكي, يحتوي_نصا;

استورد json.writer;

// Types with `@@json` (compile-time derived JSON, as serde's derive and
// pydantic's models) get `to_json__T(&value): string` and
// `from_json__T(&text): result T, string` from the compiler. These helpers
// put them on requests and responses:
//
//     @@json
//     type item = { name: string, price: int, tags: vector string };
//
//     match read_json_with(req, from_json__item) with
//     | result.ok(value) -> { return json_response_of(201, &value, to_json__item); }
//     | result.err(rejection) -> { return rejection; };

// The request's JSON body decoded by المفكك. A missing or non-JSON
// Content-Type is 415; a body that does not decode is 422 with
// {"detail": the decoder's message} (it names the field path), as FastAPI
// answers a validation error.
عام عرف اقرأ_جسون_بـ<T>(
    الطلب: &طلب_ويب<متجه ط8>,
    المفكك: دالة(&نص): نتيجة T, نص
): نتيجة T, استجابة_ويب<متجه ط8> {
    دع الاسم: نص = «content-type»;
    دع جسون: متغير منطقي = خطأ;
    طابق أول_قيمة_رأس_ويب(&(*الطلب).الرؤوس, &الاسم) مع
    | اختياري.موجود(القيمة) -> {
        دع الصغير: نص = حول_النص_إلى_صغير_أسكي(&القيمة);
        دع التطبيق: نص = «application/json»;
        دع اللاحقة: نص = «+json»;
        جسون := يحتوي_نصا(&الصغير, &التطبيق) || يحتوي_نصا(&الصغير, &اللاحقة);
    }
    | اختياري.لا_شيء -> { };
    إذا (!جسون) {
        دع النص: نص = «Unsupported media type: expected application/json»;
        أرجع نتيجة.خطأ(استجابة_نص_ويب(415, &النص));
    };
    طابق نص_جسم_طلب_ويب(الطلب) مع
    | نتيجة.خطأ(_) -> {
        دع النص: نص = «The request body is not valid UTF-8»;
        أرجع نتيجة.خطأ(استجابة_نص_ويب(400, &النص));
    }
    | نتيجة.نجح(النص) -> {
        طابق المفكك(&النص) مع
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); }
        | نتيجة.خطأ(الرسالة) -> {
            دع الكاتب: متغير كاتب_جسون = كاتب_جسون_جديد();
            ابدأ_كائنا(&متغير الكاتب);
            دع المفتاح: نص = «detail»;
            اكتب_مفتاحا(&متغير الكاتب, &المفتاح);
            اكتب_نصا(&متغير الكاتب, &الرسالة);
            أنه_كائنا(&متغير الكاتب);
            أرجع نتيجة.خطأ(رد_كاتب_جسون(422, &الكاتب));
        };
    };
}

// A JSON response from a value and its encoder (to_json__T).
عام عرف رد_جسون_من<T>(
    الحالة: طبيعي,
    القيمة: &T,
    المرمز: دالة(&T): نص
): استجابة_ويب<متجه ط8> {
    دع النص: نص = المرمز(القيمة);
    دع البايتات: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(النص) مثل طبيعي)) { ألحق(البايتات, النص[ف]); ف := ف + 1; }
    دع النوع: نص = «application/json»;
    أرجع استجابة_بايتات_ويب(الحالة, البايتات, &النوع);
}

عام مرادف read_json_with = اقرأ_جسون_بـ;
عام مرادف json_response_of = رد_جسون_من;
