من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    استجابة_نص_ويب,
    نتيجة_جسون_طلب_ويب,
    صنف_خطأ_جسم_ويب,
    جسون_جسم_طلب_ويب;

من std.json استورد
    وثيقة_جسون,
    خطأ_جسون,
    صنف_خطأ_جسون;

استورد handler.adapter;
استورد response.headers;
استورد extract.typed;
استورد extract.body;
استورد json.writer;

عام نوع نتيجة_جسون = نتيجة_جسون_طلب_ويب;

عام نوع مفكك_جسون<T, E> = دالة(
    &وثيقة_جسون
): نتيجة T, E;

عام نوع نتيجة_جسون_مفككة<T, E> =
    | قيمة بنوع T
    | خطأ_جسم بنوع صنف_خطأ_جسم_ويب
    | خطأ_جسون بنوع خطأ_جسون
    | خطأ_تحويل بنوع E
;

عام عرف جسون_الطلب(
    الطلب: &طلب
): نتيجة_جسون {
    أرجع جسون_جسم_طلب_ويب(الطلب);
}

عام عرف جسون_كـ<T, E>(
    الطلب: &طلب,
    المفكك: مفكك_جسون<T, E>
): نتيجة_جسون_مفككة<T, E> {
    طابق جسون_جسم_طلب_ويب(الطلب) مع
    | نتيجة_جسون_طلب_ويب.خطأ_جسم(الخطأ) -> {
        أرجع نتيجة_جسون_مفككة.خطأ_جسم(الخطأ);
    }
    | نتيجة_جسون_طلب_ويب.خطأ_جسون(الخطأ) -> {
        أرجع نتيجة_جسون_مفككة.خطأ_جسون(الخطأ);
    }
    | نتيجة_جسون_طلب_ويب.جسون(الوثيقة) -> {
        طابق المفكك(&الوثيقة) مع
        | نتيجة.نجح(القيمة) -> {
            أرجع نتيجة_جسون_مفككة.قيمة(القيمة);
        }
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_جسون_مفككة.خطأ_تحويل(الخطأ);
        };
    };
}

// A std.json document as a JSON response. Serialized by Nahr's writer.
عام عرف رد_جسون(
    الحالة: طبيعي,
    الوثيقة: &وثيقة_جسون
): نتيجة استجابة, صنف_خطأ_جسون {
    دع الكاتب: متغير كاتب_جسون = كاتب_جسون_جديد();
    اكتب_قيمة_جسون(&متغير الكاتب, الوثيقة, &(*الوثيقة).الجذر);
    إذا (!كاتب_جسون_سليم(&الكاتب)) {
        أرجع نتيجة.خطأ(صنف_خطأ_جسون.يوتيف8_غير_صالح());
    };
    أرجع نتيجة.نجح(رد_كاتب_جسون(الحالة, &الكاتب));
}

عام نوع محول_خطأ_تحويل_جسون<E> = دالة(
    &E
): استجابة_ويب<متجه ط8>;

عرف نفذ_استخراج_جسون<S, T, E>(
    المفكك: مفكك_جسون<T, E>,
    عند_فشل_التحويل: محول_خطأ_تحويل_جسون<E>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة T, استجابة_ويب<متجه ط8> {
    طابق جسون_كـ(الطلب, المفكك) مع
    | نتيجة_جسون_مفككة.قيمة(القيمة) -> {
        أرجع نتيجة.نجح(القيمة);
    }
    | نتيجة_جسون_مفككة.خطأ_تحويل(الخطأ) -> {
        أرجع نتيجة.خطأ(عند_فشل_التحويل(&الخطأ));
    }
    | نتيجة_جسون_مفككة.خطأ_جسم(الخطأ) -> {
        دع الرسالة: نص = «Invalid JSON body»;
        أرجع نتيجة.خطأ(رفض_جسم(&الخطأ, &الرسالة));
    }
    | _ -> {
        دع الرسالة: نص = «Invalid JSON body»;
        أرجع نتيجة.خطأ(
            استجابة_نص_ويب(400, &الرسالة)
        );
    };
}

عام عرف استخرج_جسونا<S, T, E>(
    المفكك: مفكك_جسون<T, E>,
    عند_فشل_التحويل: محول_خطأ_تحويل_جسون<E>
): مستخرج<S, T> {
    دع المستخرج: دالة_استخراج<S, T> = دالة(
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة T, استجابة_ويب<متجه ط8> ->
        نفذ_استخراج_جسون(
            المفكك,
            عند_فشل_التحويل,
            الحالة,
            الطلب,
            المعاملات
        );
    أرجع مستخرج_من_دالة(المستخرج);
}

عام مرادف json_result = نتيجة_جسون;
عام نوع json_decoder<T, E> = مفكك_جسون<T, E>;
عام نوع decoded_json_result<T, E> = نتيجة_جسون_مفككة<T, E>;
عام مرادف json = جسون_الطلب;
عام مرادف json_as = جسون_كـ;
عام نوع json_decode_error_mapper<E> = محول_خطأ_تحويل_جسون<E>;
عام مرادف extract_json = استخرج_جسونا;
عام مرادف json_response = رد_جسون;
