من std.http استورد
    استجابة_بايتات_ويب;

من std.json استورد
    وثيقة_جسون,
    قيمة_جسون;

استورد std.encoding.utf8;
استورد std.text.number;
استورد std.text.from_bytes;
استورد response.headers;

// A streaming JSON writer. It writes straight into bytes, inserts commas, and
// escapes strings, so a handler can answer with JSON without building a
// `وثيقة_جسون` tree:
//
//     دع ك: متغير كاتب_جسون = كاتب_جسون_جديد();
//     ابدأ_كائنا(&متغير ك);
//     اكتب_مفتاحا(&متغير ك, &«name»); اكتب_نصا(&متغير ك, &الاسم);
//     اكتب_مفتاحا(&متغير ك, &«age»);  اكتب_عددا(&متغير ك, 30);
//     أنه_كائنا(&متغير ك);
//     أرجع رد_كاتب_جسون(200, &ك);
//
// Misuse (a value where a key is expected, unbalanced containers, invalid
// UTF-8 in a string) marks the writer as failed; `رد_كاتب_جسون` then answers
// 500 instead of sending broken JSON.
// Appends النص as a JSON string (RFC 8259 §7): quote, backslash and control
// characters are escaped; the text must be valid UTF-8. Nahr does not use
// std.json's escaper here, which escapes these characters twice in the
// 2026-11-05 tree.
عام عرف ألحق_نص_جسون(الناتج: &متغير متجه ط8, النص: &نص): منطقي {
    دع سداسي: متجه ط8 = [0x30, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37,
        0x38, 0x39, 0x61, 0x62, 0x63, 0x64, 0x65, 0x66];
    ألحق(*الناتج, 0x22);
    دع العدد: طبيعي = الطول(*النص) مثل طبيعي;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع ب: ط8 = (*النص)[ف];
        إذا (ب == 0x22 || ب == 0x5C) {
            ألحق(*الناتج, 0x5C);
            ألحق(*الناتج, ب);
            ف := ف + 1;
        } وإلا إذا (ب == 0x0A) {
            ألحق(*الناتج, 0x5C); ألحق(*الناتج, 0x6E); ف := ف + 1;
        } وإلا إذا (ب == 0x0D) {
            ألحق(*الناتج, 0x5C); ألحق(*الناتج, 0x72); ف := ف + 1;
        } وإلا إذا (ب == 0x09) {
            ألحق(*الناتج, 0x5C); ألحق(*الناتج, 0x74); ف := ف + 1;
        } وإلا إذا (ب < 0x20) {
            ألحق(*الناتج, 0x5C); ألحق(*الناتج, 0x75);
            ألحق(*الناتج, 0x30); ألحق(*الناتج, 0x30);
            ألحق(*الناتج, سداسي[((ب >> 4) & 0x0F) مثل طبيعي]);
            ألحق(*الناتج, سداسي[(ب & 0x0F) مثل طبيعي]);
            ف := ف + 1;
        } وإلا إذا (ب < 0x80) {
            ألحق(*الناتج, ب);
            ف := ف + 1;
        } وإلا {
            دع المفكوك: فك_يوتيف8 = فك_محرف_يوتيف8(النص, ف);
            إذا (!المفكوك.صالح || المفكوك.العرض == 0) { أرجع خطأ; };
            دع النهاية: طبيعي = ف + المفكوك.العرض;
            طالما (ف < النهاية) { ألحق(*الناتج, (*النص)[ف]); ف := ف + 1; }
        };
    }
    ألحق(*الناتج, 0x22);
    أرجع صواب;
}

عام نوع كاتب_جسون = {
    البايتات: متجه ط8,
    // One entry per open container: 1 = object, 2 = array.
    الحاويات: متجه ط8,
    // Whether the open container already holds an item.
    فيه_عناصر: متجه منطقي,
    // Inside an object, a key was written and its value is due.
    ينتظر_قيمة: منطقي,
    // A complete top-level value has been written.
    اكتمل: منطقي,
    فشل: منطقي
};

عام عرف كاتب_جسون_جديد(): كاتب_جسون {
    دع البايتات: متجه ط8 = [];
    دع الحاويات: متجه ط8 = [];
    دع فيه_عناصر: متجه منطقي = [];
    دع الناتج: كاتب_جسون = {
        البايتات: البايتات,
        الحاويات: الحاويات,
        فيه_عناصر: فيه_عناصر,
        ينتظر_قيمة: خطأ,
        اكتمل: خطأ,
        فشل: خطأ
    };
    أرجع الناتج;
}

عرف عمق(الكاتب: &كاتب_جسون): طبيعي {
    أرجع الطول((*الكاتب).الحاويات) مثل طبيعي;
}

عرف في_كائن(الكاتب: &كاتب_جسون): منطقي {
    دع العمق: طبيعي = عمق(الكاتب);
    أرجع العمق > 0 && (*الكاتب).الحاويات[العمق - 1] == 1;
}

// Prepares the position for a value: a comma between array items, nothing
// after a key, and failure where a value isn't allowed.
عرف قبل_قيمة(الكاتب: &متغير كاتب_جسون): منطقي {
    إذا ((*الكاتب).فشل) { أرجع خطأ; };
    دع العمق: طبيعي = عمق(الكاتب);
    إذا (العمق == 0) {
        إذا ((*الكاتب).اكتمل) { (*الكاتب).فشل := صواب; أرجع خطأ; };
        أرجع صواب;
    };
    إذا (في_كائن(الكاتب)) {
        إذا (!(*الكاتب).ينتظر_قيمة) { (*الكاتب).فشل := صواب; أرجع خطأ; };
        (*الكاتب).ينتظر_قيمة := خطأ;
        أرجع صواب;
    };
    إذا ((*الكاتب).فيه_عناصر[العمق - 1]) {
        ألحق((*الكاتب).البايتات, 0x2C);
    };
    (*الكاتب).فيه_عناصر[العمق - 1] := صواب;
    أرجع صواب;
}

عرف بعد_قيمة(الكاتب: &متغير كاتب_جسون): فراغ {
    إذا (عمق(الكاتب) == 0) { (*الكاتب).اكتمل := صواب; };
}

عرف ألحق_نص_خام(الكاتب: &متغير كاتب_جسون, النص: &نص): فراغ {
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) {
        ألحق((*الكاتب).البايتات, (*النص)[ف]);
        ف := ف + 1;
    }
}

عام عرف اكتب_مفتاحا(الكاتب: &متغير كاتب_جسون, المفتاح: &نص): فراغ {
    إذا ((*الكاتب).فشل) { أرجع; };
    دع العمق: طبيعي = عمق(الكاتب);
    إذا (!في_كائن(الكاتب) || (*الكاتب).ينتظر_قيمة) {
        (*الكاتب).فشل := صواب;
        أرجع;
    };
    إذا ((*الكاتب).فيه_عناصر[العمق - 1]) {
        ألحق((*الكاتب).البايتات, 0x2C);
    };
    (*الكاتب).فيه_عناصر[العمق - 1] := صواب;
    إذا (!ألحق_نص_جسون(&متغير (*الكاتب).البايتات, المفتاح)) {
        (*الكاتب).فشل := صواب;
        أرجع;
    };
    ألحق((*الكاتب).البايتات, 0x3A);
    (*الكاتب).ينتظر_قيمة := صواب;
}

عرف افتح(الكاتب: &متغير كاتب_جسون, النوع: ط8, الرمز: ط8): فراغ {
    إذا (!قبل_قيمة(الكاتب)) { أرجع; };
    ألحق((*الكاتب).البايتات, الرمز);
    ألحق((*الكاتب).الحاويات, النوع);
    ألحق((*الكاتب).فيه_عناصر, خطأ);
}

عرف أغلق(الكاتب: &متغير كاتب_جسون, النوع: ط8, الرمز: ط8): فراغ {
    إذا ((*الكاتب).فشل) { أرجع; };
    دع العمق: طبيعي = عمق(الكاتب);
    إذا (العمق == 0 || (*الكاتب).الحاويات[العمق - 1] != النوع
        || (*الكاتب).ينتظر_قيمة) {
        (*الكاتب).فشل := صواب;
        أرجع;
    };
    ألحق((*الكاتب).البايتات, الرمز);
    اقتطع((*الكاتب).الحاويات, العمق - 1);
    اقتطع((*الكاتب).فيه_عناصر, العمق - 1);
    بعد_قيمة(الكاتب);
}

عام عرف ابدأ_كائنا(الكاتب: &متغير كاتب_جسون): فراغ { افتح(الكاتب, 1, 0x7B); }
عام عرف أنه_كائنا(الكاتب: &متغير كاتب_جسون): فراغ { أغلق(الكاتب, 1, 0x7D); }
عام عرف ابدأ_مصفوفة(الكاتب: &متغير كاتب_جسون): فراغ { افتح(الكاتب, 2, 0x5B); }
عام عرف أنه_مصفوفة(الكاتب: &متغير كاتب_جسون): فراغ { أغلق(الكاتب, 2, 0x5D); }

عام عرف اكتب_نصا(الكاتب: &متغير كاتب_جسون, القيمة: &نص): فراغ {
    إذا (!قبل_قيمة(الكاتب)) { أرجع; };
    إذا (!ألحق_نص_جسون(&متغير (*الكاتب).البايتات, القيمة)) {
        (*الكاتب).فشل := صواب;
        أرجع;
    };
    بعد_قيمة(الكاتب);
}

عام عرف اكتب_عددا(الكاتب: &متغير كاتب_جسون, القيمة: عدد): فراغ {
    إذا (!قبل_قيمة(الكاتب)) { أرجع; };
    دع النص: نص = عدد_إلى_نص(القيمة);
    ألحق_نص_خام(الكاتب, &النص);
    بعد_قيمة(الكاتب);
}

عام عرف اكتب_طبيعيا(الكاتب: &متغير كاتب_جسون, القيمة: طبيعي): فراغ {
    إذا (!قبل_قيمة(الكاتب)) { أرجع; };
    دع النص: نص = طبيعي_إلى_نص(القيمة);
    ألحق_نص_خام(الكاتب, &النص);
    بعد_قيمة(الكاتب);
}

عام عرف اكتب_منطقيا(الكاتب: &متغير كاتب_جسون, القيمة: منطقي): فراغ {
    إذا (!قبل_قيمة(الكاتب)) { أرجع; };
    دع النص: متغير نص = «false»;
    إذا (القيمة) { النص := «true»; };
    ألحق_نص_خام(الكاتب, &النص);
    بعد_قيمة(الكاتب);
}

عام عرف اكتب_عدما(الكاتب: &متغير كاتب_جسون): فراغ {
    إذا (!قبل_قيمة(الكاتب)) { أرجع; };
    دع النص: نص = «null»;
    ألحق_نص_خام(الكاتب, &النص);
    بعد_قيمة(الكاتب);
}

// Key and value in one call, for the common object fields.
عام عرف اكتب_حقلا_نصيا(الكاتب: &متغير كاتب_جسون, المفتاح: &نص, القيمة: &نص): فراغ {
    اكتب_مفتاحا(الكاتب, المفتاح);
    اكتب_نصا(الكاتب, القيمة);
}

عام عرف اكتب_حقلا_عدديا(الكاتب: &متغير كاتب_جسون, المفتاح: &نص, القيمة: عدد): فراغ {
    اكتب_مفتاحا(الكاتب, المفتاح);
    اكتب_عددا(الكاتب, القيمة);
}

عام عرف اكتب_حقلا_منطقيا(الكاتب: &متغير كاتب_جسون, المفتاح: &نص, القيمة: منطقي): فراغ {
    اكتب_مفتاحا(الكاتب, المفتاح);
    اكتب_منطقيا(الكاتب, القيمة);
}

// Whether the writer holds exactly one complete, valid JSON value.
عام عرف كاتب_جسون_سليم(الكاتب: &كاتب_جسون): منطقي {
    أرجع !(*الكاتب).فشل && (*الكاتب).اكتمل && عمق(الكاتب) == 0;
}

عام عرف نص_كاتب_جسون(الكاتب: &كاتب_جسون): اختياري نص {
    إذا (!كاتب_جسون_سليم(الكاتب)) { أرجع اختياري.لا_شيء(); };
    أرجع اختياري.موجود(من_بايتات(&(*الكاتب).البايتات));
}

عرف رد_جسون_فاشل(): استجابة {
    دع النوع: نص = «application/json; charset=utf-8»;
    دع الجسم: متجه ط8 = بايتات_من_نص(«{"error":{"status":500,"message":"Internal Server Error"}}»);
    أرجع استجابة_بايتات_ويب(500, الجسم, &النوع);
}

// The writer's JSON as a response, or 500 when the writer failed.
عام عرف رد_كاتب_جسون(الحالة: طبيعي, الكاتب: &كاتب_جسون): استجابة {
    إذا (!كاتب_جسون_سليم(الكاتب)) { أرجع رد_جسون_فاشل(); };
    دع النوع: نص = «application/json; charset=utf-8»;
    أرجع استجابة_بايتات_ويب(الحالة, استنسخ(&(*الكاتب).البايتات), &النوع);
}

// Writes one application value as JSON.
عام نوع مرمز_جسون<T> = دالة(&T, &متغير كاتب_جسون): فراغ;

// A typed JSON response: المرمز writes القيمة.
عام عرف رد_جسون_بـ<T>(
    الحالة: طبيعي,
    القيمة: &T,
    المرمز: مرمز_جسون<T>
): استجابة {
    دع الكاتب: متغير كاتب_جسون = كاتب_جسون_جديد();
    المرمز(القيمة, &متغير الكاتب);
    أرجع رد_كاتب_جسون(الحالة, &الكاتب);
}

// Writes a vector as a JSON array, each item through المرمز.
عام عرف اكتب_مصفوفة_بـ<T>(
    الكاتب: &متغير كاتب_جسون,
    القيم: &متجه T,
    المرمز: مرمز_جسون<T>
): فراغ {
    ابدأ_مصفوفة(&متغير *الكاتب);
    دع ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*القيم) مثل طبيعي)) {
        المرمز(&(*القيم)[ف], &متغير *الكاتب);
        ف := ف + 1;
    }
    أنه_مصفوفة(&متغير *الكاتب);
}

// Writes a std.json value (and what it references in الوثيقة) to الكاتب.
عام عرف اكتب_قيمة_جسون(
    الكاتب: &متغير كاتب_جسون,
    الوثيقة: &وثيقة_جسون,
    القيمة: &قيمة_جسون
): فراغ {
    طابق *القيمة مع
    | قيمة_جسون.عدم -> { اكتب_عدما(الكاتب); }
    | قيمة_جسون.منطق(ق) -> { اكتب_منطقيا(الكاتب, ق); }
    | قيمة_جسون.رقم(النص) -> {
        إذا (!قبل_قيمة(الكاتب)) { أرجع; };
        ألحق_نص_خام(الكاتب, &النص);
        بعد_قيمة(الكاتب);
    }
    | قيمة_جسون.سلسلة(النص) -> { اكتب_نصا(الكاتب, &النص); }
    | قيمة_جسون.مصفوفة(الفهرس) -> {
        ابدأ_مصفوفة(الكاتب);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الوثيقة).المصفوفات[الفهرس].القيم) مثل طبيعي)) {
            اكتب_قيمة_جسون(الكاتب, الوثيقة, &(*الوثيقة).المصفوفات[الفهرس].القيم[ف]);
            ف := ف + 1;
        }
        أنه_مصفوفة(الكاتب);
    }
    | قيمة_جسون.كائن(الفهرس) -> {
        ابدأ_كائنا(الكاتب);
        دع ف: متغير طبيعي = 0;
        طالما (ف < (الطول((*الوثيقة).الكائنات[الفهرس].المداخل) مثل طبيعي)) {
            اكتب_مفتاحا(الكاتب, &(*الوثيقة).الكائنات[الفهرس].المداخل[ف].المفتاح);
            اكتب_قيمة_جسون(الكاتب, الوثيقة, &(*الوثيقة).الكائنات[الفهرس].المداخل[ف].القيمة);
            ف := ف + 1;
        }
        أنه_كائنا(الكاتب);
    };
}

// A std.json document as compact JSON text, escaped correctly.
عام عرف وثيقة_جسون_إلى_نص(الوثيقة: &وثيقة_جسون): اختياري نص {
    دع الكاتب: متغير كاتب_جسون = كاتب_جسون_جديد();
    اكتب_قيمة_جسون(&متغير الكاتب, الوثيقة, &(*الوثيقة).الجذر);
    أرجع نص_كاتب_جسون(&الكاتب);
}

عام مرادف json_writer = كاتب_جسون;
عام مرادف write_json_value = اكتب_قيمة_جسون;
عام مرادف json_document_text = وثيقة_جسون_إلى_نص;
عام مرادف append_json_string = ألحق_نص_جسون;
عام مرادف new_json_writer = كاتب_جسون_جديد;
عام مرادف json_begin_object = ابدأ_كائنا;
عام مرادف json_end_object = أنه_كائنا;
عام مرادف json_begin_array = ابدأ_مصفوفة;
عام مرادف json_end_array = أنه_مصفوفة;
عام مرادف json_key = اكتب_مفتاحا;
عام مرادف json_string = اكتب_نصا;
عام مرادف json_int = اكتب_عددا;
عام مرادف json_uint = اكتب_طبيعيا;
عام مرادف json_bool = اكتب_منطقيا;
عام مرادف json_null = اكتب_عدما;
عام مرادف json_string_field = اكتب_حقلا_نصيا;
عام مرادف json_int_field = اكتب_حقلا_عدديا;
عام مرادف json_bool_field = اكتب_حقلا_منطقيا;
عام مرادف json_writer_ok = كاتب_جسون_سليم;
عام مرادف json_writer_text = نص_كاتب_جسون;
عام مرادف json_writer_response = رد_كاتب_جسون;
عام نوع json_encoder<T> = مرمز_جسون<T>;
عام مرادف json_response_with = رد_جسون_بـ;
عام مرادف json_array_with = اكتب_مصفوفة_بـ;
