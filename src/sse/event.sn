استورد std.text.number;
استورد std.text.from_bytes;

عام نوع حدث = {
    البيانات: نص,
    له_نوع: منطقي,
    النوع: نص,
    له_معرف: منطقي,
    المعرف: نص,
    له_إعادة_محاولة: منطقي,
    إعادة_المحاولة_مللي: طبيعي,
    له_تعليق: منطقي,
    التعليق: نص
};

عام نوع خطأ_حدث =
    | محرف_غير_صالح
;

عرف ألحق_نصا(
    الناتج: &متغير متجه ط8,
    النص: &نص
): فراغ {
    ليكن القيمة: نص = *النص;
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(القيمة) مثل طبيعي)) {
        ألحق((*الناتج), القيمة[الموضع]);
        الموضع := الموضع + 1;
    }
}

عرف حقل_سطر_صالح(القيمة: &نص): منطقي {
    ليكن النص: نص = *القيمة;
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(النص) مثل طبيعي)) {
        ليكن البايت: ط8 = النص[الموضع];
        إذا ((البايت == 0x0A) || (البايت == 0x0D) || (البايت == 0x00)) {
            أرجع خطأ;
        };
        الموضع := الموضع + 1;
    }
    أرجع صواب;
}

عرف ألحق_حقل(
    الناتج: &متغير متجه ط8,
    الاسم: &نص,
    القيمة: &نص
): فراغ {
    ألحق_نصا(الناتج, الاسم);
    ليكن فاصل: نص = «: »;
    ألحق_نصا(الناتج, &فاصل);
    ألحق_نصا(الناتج, القيمة);
    ليكن نهاية: نص = "\n";
    ألحق_نصا(الناتج, &نهاية);
}

عرف نص_من_مدى(
    القيمة: &نص,
    البداية: طبيعي,
    النهاية: طبيعي
): نص {
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن الموضع: متغير طبيعي = البداية;
    طالما (الموضع < النهاية) {
        ألحق(البايتات, (*القيمة)[الموضع]);
        الموضع := الموضع + 1;
    }
    أرجع من_بايتات(&البايتات);
}

عرف ألحق_بيانات(
    الناتج: &متغير متجه ط8,
    البيانات: &نص
): فراغ {
    ليكن اسم: نص = «data»;
    ليكن العدد: طبيعي = الطول(*البيانات) مثل طبيعي;
    ليكن البداية: متغير طبيعي = 0;
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < العدد) {
        ليكن البايت: ط8 = (*البيانات)[الموضع];
        إذا ((البايت == 0x0A) || (البايت == 0x0D)) {
            ليكن السطر: نص = نص_من_مدى(البيانات, البداية, الموضع);
            ألحق_حقل(الناتج, &اسم, &السطر);
            إذا (البايت == 0x0D) {
                ليكن التالي: طبيعي = الموضع + 1;
                إذا ((التالي < العدد) && ((*البيانات)[التالي] == 0x0A)) {
                    الموضع := التالي;
                };
            };
            البداية := الموضع + 1;
        };
        الموضع := الموضع + 1;
    }
    ليكن السطر_الأخير: نص = نص_من_مدى(البيانات, البداية, العدد);
    ألحق_حقل(الناتج, &اسم, &السطر_الأخير);
}

عام عرف أنشئ_حدثا(البيانات: &نص): حدث {
    ليكن الناتج: حدث = {
        البيانات: استنسخ(البيانات),
        له_نوع: خطأ,
        النوع: «»,
        له_معرف: خطأ,
        المعرف: «»,
        له_إعادة_محاولة: خطأ,
        إعادة_المحاولة_مللي: 0,
        له_تعليق: خطأ,
        التعليق: «»
    };
    أرجع الناتج;
}

عام عرف عين_نوع_حدث(
    الحدث: &متغير حدث,
    النوع: &نص
): منطقي {
    إذا (!حقل_سطر_صالح(النوع)) { أرجع خطأ; };
    (*الحدث).النوع := استنسخ(النوع);
    (*الحدث).له_نوع := صواب;
    أرجع صواب;
}

عام عرف عين_معرف_حدث(
    الحدث: &متغير حدث,
    المعرف: &نص
): منطقي {
    إذا (!حقل_سطر_صالح(المعرف)) { أرجع خطأ; };
    (*الحدث).المعرف := استنسخ(المعرف);
    (*الحدث).له_معرف := صواب;
    أرجع صواب;
}

عام عرف عين_إعادة_محاولة_حدث(
    الحدث: &متغير حدث,
    المللي: طبيعي
): فراغ {
    (*الحدث).إعادة_المحاولة_مللي := المللي;
    (*الحدث).له_إعادة_محاولة := صواب;
}

عام عرف عين_تعليق_حدث(
    الحدث: &متغير حدث,
    التعليق: &نص
): منطقي {
    إذا (!حقل_سطر_صالح(التعليق)) { أرجع خطأ; };
    (*الحدث).التعليق := استنسخ(التعليق);
    (*الحدث).له_تعليق := صواب;
    أرجع صواب;
}

// Encodes one event. The fields of `حدث` are public, so the single-line
// fields are checked again here: a CR, LF or NUL in them would inject extra
// fields into the stream.
عام عرف نسق_حدثا(الحدث: &حدث): نتيجة متجه ط8, خطأ_حدث {
    إذا (((*الحدث).له_تعليق && !حقل_سطر_صالح(&(*الحدث).التعليق))
        || ((*الحدث).له_معرف && !حقل_سطر_صالح(&(*الحدث).المعرف))
        || ((*الحدث).له_نوع && !حقل_سطر_صالح(&(*الحدث).النوع))) {
        أرجع نتيجة.خطأ(خطأ_حدث.محرف_غير_صالح());
    };
    ليكن الناتج: متغير متجه ط8 = [];

    إذا ((*الحدث).له_تعليق) {
        ليكن بادئة: نص = «: »;
        ألحق_نصا(&متغير الناتج, &بادئة);
        ألحق_نصا(&متغير الناتج, &(*الحدث).التعليق);
        ليكن نهاية: نص = "\n";
        ألحق_نصا(&متغير الناتج, &نهاية);
    };

    إذا ((*الحدث).له_معرف) {
        ليكن اسم: نص = «id»;
        ألحق_حقل(&متغير الناتج, &اسم, &(*الحدث).المعرف);
    };

    إذا ((*الحدث).له_نوع) {
        ليكن اسم: نص = «event»;
        ألحق_حقل(&متغير الناتج, &اسم, &(*الحدث).النوع);
    };

    إذا ((*الحدث).له_إعادة_محاولة) {
        ليكن الاسم: نص = «retry»;
        ليكن النص: نص = طبيعي_إلى_نص((*الحدث).إعادة_المحاولة_مللي);
        ألحق_حقل(&متغير الناتج, &الاسم, &النص);
    };

    ألحق_بيانات(&متغير الناتج, &(*الحدث).البيانات);
    ليكن نهاية_الحدث: نص = "\n";
    ألحق_نصا(&متغير الناتج, &نهاية_الحدث);
    أرجع نتيجة.نجح(الناتج);
}

عام مرادف sse_event = حدث;
عام مرادف sse_event_error = خطأ_حدث;
عام مرادف new_sse_event = أنشئ_حدثا;
عام مرادف sse_event_set_type = عين_نوع_حدث;
عام مرادف sse_event_set_id = عين_معرف_حدث;
عام مرادف sse_event_set_retry = عين_إعادة_محاولة_حدث;
عام مرادف sse_event_set_comment = عين_تعليق_حدث;
عام مرادف encode_sse_event = نسق_حدثا;
عام مرادف sse_event_error.invalid_character = خطأ_حدث.محرف_غير_صالح;
