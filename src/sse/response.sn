من std.http استورد
    استجابة_بايتات_ويب,
    ضع_رأس_ويب;

استورد response.headers;
استورد sse.event;

عام نوع خطأ_رد_أحداث = خطأ_حدث;

عرف ألحق_بايتات(
    الناتج: &متغير متجه ط8,
    المصدر: &متجه ط8
): فراغ {
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(*المصدر) مثل طبيعي)) {
        ألحق((*الناتج), (*المصدر)[الموضع]);
        الموضع := الموضع + 1;
    }
}

عام عرف رد_أحداث_مخزنة(
    الأحداث: &متجه حدث
): نتيجة استجابة, خطأ_رد_أحداث {
    ليكن الجسم: متغير متجه ط8 = [];
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(*الأحداث) مثل طبيعي)) {
        طابق نسق_حدثا(&(*الأحداث)[الموضع]) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(المرمز) -> {
            ألحق_بايتات(&متغير الجسم, &المرمز);
        };
        الموضع := الموضع + 1;
    }

    ليكن النوع: نص = «text/event-stream; charset=utf-8»;
    ليكن الاستجابة: متغير استجابة =
        استجابة_بايتات_ويب(200, الجسم, &النوع);

    ليكن اسم_التخزين: نص = «cache-control»;
    ليكن منع_التخزين: نص = «no-cache»;
    ليكن تجاهل_التخزين: منطقي = ضع_رأس_ويب(
        &متغير الاستجابة.الرؤوس,
        &اسم_التخزين,
        &منع_التخزين
    );

    أرجع نتيجة.نجح(الاستجابة);
}

عام عرف رد_حدث_مخزن(
    الحدث: &حدث
): نتيجة استجابة, خطأ_رد_أحداث {
    طابق نسق_حدثا(الحدث) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(الجسم) -> {
        ليكن النوع: نص = «text/event-stream; charset=utf-8»;
        ليكن الاستجابة: متغير استجابة =
            استجابة_بايتات_ويب(200, الجسم, &النوع);
        ليكن اسم_التخزين: نص = «cache-control»;
        ليكن منع_التخزين: نص = «no-cache»;
        ليكن تجاهل_التخزين: منطقي = ضع_رأس_ويب(
            &متغير الاستجابة.الرؤوس,
            &اسم_التخزين,
            &منع_التخزين
        );
        أرجع نتيجة.نجح(الاستجابة);
    };
}

عام مرادف buffered_sse_error = خطأ_رد_أحداث;
عام مرادف buffered_sse_response = رد_أحداث_مخزنة;
عام مرادف buffered_sse_event_response = رد_حدث_مخزن;
