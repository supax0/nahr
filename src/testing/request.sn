من std.http استورد
    إصدار_ويب,
    طلب_ويب,
    رأس_ويب,
    ضع_رأس_ويب,
    بايتات_ويب_من_نص,
    سياق_طلب_ويب_فارغ;

استورد handler.adapter;

عام عرف أنشئ_طلبا(
    الطريقة: &نص,
    الهدف: &نص
): طلب {
    دع الرؤوس: متجه رأس_ويب = [];
    دع الرؤوس_اللاحقة: متجه رأس_ويب = [];
    دع الجسم: متجه ط8 = [];
    دع الطلب: طلب = {
        الطريقة: استنسخ(الطريقة),
        الهدف: استنسخ(الهدف),
        الإصدار: إصدار_ويب.واحد_واحد(),
        الرؤوس: الرؤوس,
        الرؤوس_اللاحقة: الرؤوس_اللاحقة,
        الجسم: الجسم,
        العنوان_البعيد: «127.0.0.1:50000»,
        السياق: سياق_طلب_ويب_فارغ()
    };
    أرجع الطلب;
}

// The client address the request appears to come from ("ip:port"), as a
// server fills it from the accepted socket. Test requests start with
// 127.0.0.1:50000.
عام عرف عين_عنوان_طلب(الطلب: &متغير طلب, العنوان: &نص): فراغ {
    (*الطلب).العنوان_البعيد := استنسخ(العنوان);
}

عام عرف عين_رأس_طلب(
    الطلب: &متغير طلب,
    الاسم: &نص,
    القيمة: &نص
): منطقي {
    أرجع ضع_رأس_ويب(
        &متغير (*الطلب).الرؤوس,
        الاسم,
        القيمة
    );
}

عام عرف عين_جسم_نصي(
    الطلب: &متغير طلب,
    النص: &نص
): فراغ {
    (*الطلب).الجسم := بايتات_ويب_من_نص(النص);
}

عام مرادف test_request = أنشئ_طلبا;
عام مرادف test_request_header = عين_رأس_طلب;
عام مرادف test_request_text = عين_جسم_نصي;
عام مرادف test_request_remote = عين_عنوان_طلب;
