من std.http استورد
    حالة_استجابة_ويب,
    جسم_استجابة_ويب,
    أول_قيمة_رأس_ويب;

استورد std.text.from_bytes;
استورد response.headers;

عام عرف حالة_الرد(الاستجابة: &استجابة): طبيعي {
    أرجع حالة_استجابة_ويب(الاستجابة);
}

عام عرف نص_الرد(الاستجابة: &استجابة): نص {
    دع الجسم: متجه ط8 = جسم_استجابة_ويب(الاستجابة);
    أرجع من_بايتات(&الجسم);
}

عام عرف رأس_الرد(الاستجابة: &استجابة, الاسم: &نص): اختياري نص {
    أرجع أول_قيمة_رأس_ويب(&(*الاستجابة).الرؤوس, الاسم);
}

// The header value, or "" when it is absent.
عام عرف رأس_الرد_أو_فارغ(الاستجابة: &استجابة, الاسم: &نص): نص {
    طابق رأس_الرد(الاستجابة, الاسم) مع
    | اختياري.موجود(القيمة) -> { أرجع القيمة; }
    | اختياري.لا_شيء -> { أرجع «»; };
}

عام مرادف response_status = حالة_الرد;
عام مرادف response_header = رأس_الرد;
عام مرادف response_header_or_empty = رأس_الرد_أو_فارغ;
عام مرادف response_text = نص_الرد;
