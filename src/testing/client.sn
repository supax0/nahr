استورد routing.router;
استورد handler.adapter;
استورد response.headers;
استورد testing.request;

عام عرف اختبر<S>(
    الموجه: &موجه<S>,
    الطلب: &طلب
): استجابة {
    أرجع وجه_الطلب(الموجه, الطلب);
}

عام عرف اختبر_جلب<S>(
    الموجه: &موجه<S>,
    الهدف: &نص
): استجابة {
    ليكن الطريقة: نص = «GET»;
    ليكن الطلب: طلب = أنشئ_طلبا(&الطريقة, الهدف);
    أرجع وجه_الطلب(الموجه, &الطلب);
}

عام عرف اختبر_إرسال<S>(
    الموجه: &موجه<S>,
    الهدف: &نص,
    الجسم: &نص
): استجابة {
    ليكن الطريقة: نص = «POST»;
    ليكن الطلب: متغير طلب = أنشئ_طلبا(&الطريقة, الهدف);
    عين_جسم_نصي(&متغير الطلب, الجسم);
    أرجع وجه_الطلب(الموجه, &الطلب);
}

عام مرادف dispatch_test = اختبر;
عام مرادف test_get = اختبر_جلب;
عام مرادف test_post = اختبر_إرسال;
