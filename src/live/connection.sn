من std.http استورد
    ناقل_ويب,
    اقرأ_ناقل_ويب,
    اكتب_ناقل_ويب,
    اكتب_جزءا_متدفقا_ويب1,
    أنه_استجابة_متدفقة_ويب1;

من std.text استورد من_بايتات;

استورد websocket.frame;
استورد websocket.message;
استورد sse.event;

// A live connection after std handed it over (std.http handover.sn): a
// WebSocket after its 101, or a streamed (chunked) response such as
// server-sent events. Nahr owns the socket around the handler and closes it
// when the handler returns; these records only refer to it.

// ---- WebSocket ----

عام نوع اتصال_مقبس_ويب = {
    الناقل: &ناقل_ويب,
    // Bytes read but not parsed yet (the server's leftovers first).
    المخزن: متجه ط8,
    المجمع: مجمع_رسالة,
    مغلق: منطقي
};

عام نوع خطأ_اتصال_مقبس =
    // The peer closed (a close frame was received and answered, or the
    // socket ended).
    | مغلق
    // A protocol error; the connection was closed with this code.
    | بروتوكول بنوع طبيعي
    | شبكة بنوع عدد
;

عام عرف اتصال_مقبس_من(الناقل: &ناقل_ويب, الباقي: متجه ط8): اتصال_مقبس_ويب {
    ليكن الناتج: اتصال_مقبس_ويب = {
        الناقل: الناقل,
        المخزن: الباقي,
        المجمع: أنشئ_مجمع_رسالة(),
        مغلق: خطأ
    };
    أرجع الناتج;
}

// Writes every byte; false when the peer is gone.
عرف اكتب_كل(الناقل: &ناقل_ويب, البايتات: &متجه ط8): منطقي {
    ليكن الكل: عدد = الطول(*البايتات) مثل عدد;
    ليكن المكتوب: متغير عدد = 0;
    طالما (المكتوب < الكل) {
        طابق اكتب_ناقل_ويب(الناقل, البايتات, المكتوب, الكل - المكتوب) مع
        | نتيجة.خطأ(_) -> { أرجع خطأ; }
        | نتيجة.نجح(العدد) -> {
            إذا (العدد <= 0) { أرجع خطأ; };
            المكتوب := المكتوب + العدد;
        };
    }
    أرجع صواب;
}

عرف أرسل_إطارا(الاتصال: &متغير اتصال_مقبس_ويب, الإطار: &إطار): منطقي {
    إذا ((*الاتصال).مغلق) { أرجع خطأ; };
    طابق رمز_إطار_خادم(الإطار) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(البايتات) -> { أرجع اكتب_كل((*الاتصال).الناقل, &البايتات); };
}

// Sends a text message; false once the connection is closed or gone.
عام عرف أرسل_نصا_مقبس(الاتصال: &متغير اتصال_مقبس_ويب, النص: &نص): منطقي {
    ليكن الإطار: إطار = إطار_نصي(النص);
    أرجع أرسل_إطارا(الاتصال, &الإطار);
}

// Sends a binary message.
عام عرف أرسل_بايتات_مقبس(الاتصال: &متغير اتصال_مقبس_ويب, البايتات: متجه ط8): منطقي {
    ليكن الإطار: إطار = إطار_ثنائي(البايتات);
    أرجع أرسل_إطارا(الاتصال, &الإطار);
}

عرف إطار_إغلاق(الرمز: طبيعي, السبب: &نص): إطار {
    ليكن الحمولة: متغير متجه ط8 = [];
    ألحق(الحمولة, ((الرمز >> 8) & 255) مثل ط8);
    ألحق(الحمولة, (الرمز & 255) مثل ط8);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*السبب) مثل طبيعي) && ف < 120) { ألحق(الحمولة, (*السبب)[ف]); ف := ف + 1; }
    ليكن الإطار: إطار = { نهائي: صواب, النوع: نوع_إطار.إغلاق(), الحمولة: الحمولة };
    أرجع الإطار;
}

// Sends a close frame with الرمز (1000 normal, 1001 going away, ...) and
// marks the connection closed.
عام عرف أغلق_مقبسا(الاتصال: &متغير اتصال_مقبس_ويب, الرمز: طبيعي, السبب: &نص): فراغ {
    إذا ((*الاتصال).مغلق) { أرجع; };
    ليكن الإطار: إطار = إطار_إغلاق(الرمز, السبب);
    ليكن تجاهل: منطقي = أرسل_إطارا(الاتصال, &الإطار);
    (*الاتصال).مغلق := صواب;
}

عرف أسقط_المستهلك(المخزن: &متغير متجه ط8, المستهلك: طبيعي): فراغ {
    ليكن الباقي: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = المستهلك;
    طالما (ف < (الطول(*المخزن) مثل طبيعي)) { ألحق(الباقي, (*المخزن)[ف]); ف := ف + 1; }
    *المخزن := الباقي;
}

// Reads more bytes; false when the socket ended.
عرف اقرأ_المزيد(الاتصال: &متغير اتصال_مقبس_ويب): نتيجة منطقي, عدد {
    ليكن المؤقت: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < 8192) { ألحق(المؤقت, 0); ف := ف + 1; }
    طابق اقرأ_ناقل_ويب((*الاتصال).الناقل, &متغير المؤقت, 0, 8192) مع
    | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(الرمز); }
    | نتيجة.نجح(العدد) -> {
        إذا (العدد <= 0) { أرجع نتيجة.نجح(خطأ); };
        ليكن ي: متغير طبيعي = 0;
        طالما (ي < (العدد مثل طبيعي)) { ألحق((*الاتصال).المخزن, المؤقت[ي]); ي := ي + 1; }
        أرجع نتيجة.نجح(صواب);
    };
}

// The next text or binary message (or the peer's close). Pings are answered
// with pongs and pongs are skipped; a close is answered and ends the
// connection; a protocol error closes it with the matching code (RFC 6455).
عام عرف استقبل_رسالة_مقبس(الاتصال: &متغير اتصال_مقبس_ويب): نتيجة رسالة, خطأ_اتصال_مقبس {
    طالما (!(*الاتصال).مغلق) {
        طابق حلل_إطار_عميل(&(*الاتصال).المخزن) مع
        | نتيجة.خطأ(خطأ_إطار.غير_مكتمل) -> {
            طابق اقرأ_المزيد(الاتصال) مع
            | نتيجة.خطأ(الرمز) -> { (*الاتصال).مغلق := صواب; أرجع نتيجة.خطأ(خطأ_اتصال_مقبس.شبكة(الرمز)); }
            | نتيجة.نجح(قرأ) -> {
                إذا (!قرأ) { (*الاتصال).مغلق := صواب; أرجع نتيجة.خطأ(خطأ_اتصال_مقبس.مغلق()); };
            };
        }
        | نتيجة.خطأ(_) -> {
            ليكن السبب: نص = «protocol error»;
            أغلق_مقبسا(الاتصال, 1002, &السبب);
            أرجع نتيجة.خطأ(خطأ_اتصال_مقبس.بروتوكول(1002));
        }
        | نتيجة.نجح(المحلل) -> {
            أسقط_المستهلك(&متغير (*الاتصال).المخزن, المحلل.المستهلك);
            طابق ادفع_إطارا(&متغير (*الاتصال).المجمع, &المحلل.الإطار) مع
            | نتيجة.خطأ(الخطأ) -> {
                ليكن الرمز: طبيعي = رمز_إغلاق_لخطأ(&الخطأ);
                ليكن السبب: نص = «protocol error»;
                أغلق_مقبسا(الاتصال, الرمز, &السبب);
                أرجع نتيجة.خطأ(خطأ_اتصال_مقبس.بروتوكول(الرمز));
            }
            | نتيجة.نجح(اختياري.لا_شيء) -> { }
            | نتيجة.نجح(اختياري.موجود(الرسالة)) -> {
                طابق الرسالة.النوع مع
                | نوع_رسالة.نبض -> {
                    ليكن الرد: إطار = إطار_رد_نبض(استنسخ(&الرسالة.الحمولة));
                    ليكن تجاهل: منطقي = أرسل_إطارا(الاتصال, &الرد);
                }
                | نوع_رسالة.رد_نبض -> { }
                | نوع_رسالة.إغلاق -> {
                    // Echo the close (RFC 6455 §5.5.1).
                    ليكن الصدى: إطار = { نهائي: صواب, النوع: نوع_إطار.إغلاق(), الحمولة: استنسخ(&الرسالة.الحمولة) };
                    ليكن تجاهل: منطقي = أرسل_إطارا(الاتصال, &الصدى);
                    (*الاتصال).مغلق := صواب;
                    أرجع نتيجة.خطأ(خطأ_اتصال_مقبس.مغلق());
                }
                | _ -> { أرجع نتيجة.نجح(الرسالة); };
            };
        };
    }
    أرجع نتيجة.خطأ(خطأ_اتصال_مقبس.مغلق());
}

// A text message's payload as text.
عام عرف نص_رسالة(الرسالة: &رسالة): نص {
    أرجع من_بايتات(&(*الرسالة).الحمولة);
}

// Whether the message is text (not binary).
عام عرف رسالة_نصية(الرسالة: &رسالة): منطقي {
    طابق (*الرسالة).النوع مع
    | نوع_رسالة.نص -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

// ---- streamed responses ----

عام نوع تدفق_ويب = {
    الناقل: &ناقل_ويب,
    مغلق: منطقي
};

عام عرف تدفق_من(الناقل: &ناقل_ويب): تدفق_ويب {
    ليكن الناتج: تدفق_ويب = { الناقل: الناقل, مغلق: خطأ };
    أرجع الناتج;
}

// Sends one chunk of the body; false once the client is gone (stop then).
عام عرف أرسل_جزءا(التدفق: &متغير تدفق_ويب, البايتات: &متجه ط8): منطقي {
    إذا ((*التدفق).مغلق) { أرجع خطأ; };
    طابق اكتب_جزءا_متدفقا_ويب1((*التدفق).الناقل, البايتات) مع
    | نتيجة.خطأ(_) -> { (*التدفق).مغلق := صواب; أرجع خطأ; }
    | نتيجة.نجح(_) -> { أرجع صواب; };
}

عام عرف أرسل_نصا_متدفقا(التدفق: &متغير تدفق_ويب, النص: &نص): منطقي {
    ليكن البايتات: متغير متجه ط8 = [];
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) { ألحق(البايتات, (*النص)[ف]); ف := ف + 1; }
    أرجع أرسل_جزءا(التدفق, &البايتات);
}

// Sends one server-sent event (text/event-stream).
عام عرف أرسل_حدثا(التدفق: &متغير تدفق_ويب, الحدث: &حدث): منطقي {
    طابق نسق_حدثا(الحدث) مع
    | نتيجة.خطأ(_) -> { أرجع خطأ; }
    | نتيجة.نجح(البايتات) -> { أرجع أرسل_جزءا(التدفق, &البايتات); };
}

// Ends the body (the last, empty chunk).
عام عرف أنه_التدفق(التدفق: &متغير تدفق_ويب): فراغ {
    إذا ((*التدفق).مغلق) { أرجع; };
    ليكن تجاهل: نتيجة طبيعي, عدد = أنه_استجابة_متدفقة_ويب1((*التدفق).الناقل);
    (*التدفق).مغلق := صواب;
}

عام نوع websocket_connection = اتصال_مقبس_ويب;
عام مرادف websocket_connection_error = خطأ_اتصال_مقبس;
عام مرادف websocket_send_text = أرسل_نصا_مقبس;
عام مرادف websocket_send_bytes = أرسل_بايتات_مقبس;
عام مرادف websocket_close = أغلق_مقبسا;
عام مرادف websocket_receive = استقبل_رسالة_مقبس;
عام مرادف message_text = نص_رسالة;
عام مرادف is_text_message = رسالة_نصية;
عام نوع response_stream = تدفق_ويب;
عام مرادف stream_send = أرسل_جزءا;
عام مرادف stream_send_text = أرسل_نصا_متدفقا;
عام مرادف stream_send_event = أرسل_حدثا;
عام مرادف stream_end = أنه_التدفق;
