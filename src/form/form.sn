من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    استجابة_نص_ويب,
    زوج_استعلام_ويب,
    صنف_خطأ_جسم_ويب,
    نموذج_جسم_طلب_ويب;

استورد handler.adapter;
استورد extract.typed;
استورد extract.body;

عام نوع حقل_نموذج = زوج_استعلام_ويب;
عام نوع خطأ_نموذج = صنف_خطأ_جسم_ويب;

عام نوع مفكك_نموذج<T, E> = دالة(
    &متجه حقل_نموذج
): نتيجة T, E;

عام نوع نتيجة_نموذج_مفككة<T, E> =
    | قيمة بنوع T
    | خطأ_جسم بنوع خطأ_نموذج
    | خطأ_تحويل بنوع E
;

عام عرف نموذج_الطلب(
    الطلب: &طلب
): نتيجة متجه حقل_نموذج, خطأ_نموذج {
    أرجع نموذج_جسم_طلب_ويب(الطلب);
}

عام عرف نموذج_كـ<T, E>(
    الطلب: &طلب,
    المفكك: مفكك_نموذج<T, E>
): نتيجة_نموذج_مفككة<T, E> {
    طابق نموذج_جسم_طلب_ويب(الطلب) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة_نموذج_مفككة.خطأ_جسم(الخطأ);
    }
    | نتيجة.نجح(الحقول) -> {
        طابق المفكك(&الحقول) مع
        | نتيجة.نجح(القيمة) -> {
            أرجع نتيجة_نموذج_مفككة.قيمة(القيمة);
        }
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة_نموذج_مفككة.خطأ_تحويل(الخطأ);
        };
    };
}

عام نوع محول_خطأ_تحويل_نموذج<E> = دالة(
    &E
): استجابة_ويب<متجه ط8>;

عرف نفذ_استخراج_نموذج<S, T, E>(
    المفكك: مفكك_نموذج<T, E>,
    عند_فشل_التحويل: محول_خطأ_تحويل_نموذج<E>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة T, استجابة_ويب<متجه ط8> {
    طابق نموذج_كـ(الطلب, المفكك) مع
    | نتيجة_نموذج_مفككة.قيمة(القيمة) -> {
        أرجع نتيجة.نجح(القيمة);
    }
    | نتيجة_نموذج_مفككة.خطأ_تحويل(الخطأ) -> {
        أرجع نتيجة.خطأ(عند_فشل_التحويل(&الخطأ));
    }
    | نتيجة_نموذج_مفككة.خطأ_جسم(الخطأ) -> {
        دع الرسالة: نص = «Invalid form body»;
        أرجع نتيجة.خطأ(رفض_جسم(&الخطأ, &الرسالة));
    };
}

عام عرف استخرج_نموذجا<S, T, E>(
    المفكك: مفكك_نموذج<T, E>,
    عند_فشل_التحويل: محول_خطأ_تحويل_نموذج<E>
): مستخرج<S, T> {
    دع المستخرج: دالة_استخراج<S, T> = دالة(
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة T, استجابة_ويب<متجه ط8> ->
        نفذ_استخراج_نموذج(
            المفكك,
            عند_فشل_التحويل,
            الحالة,
            الطلب,
            المعاملات
        );
    أرجع مستخرج_من_دالة(المستخرج);
}

عام مرادف form_field = حقل_نموذج;
عام مرادف form_error = خطأ_نموذج;
عام نوع form_decoder<T, E> = مفكك_نموذج<T, E>;
عام نوع decoded_form_result<T, E> = نتيجة_نموذج_مفككة<T, E>;
عام مرادف form = نموذج_الطلب;
عام مرادف form_as = نموذج_كـ;
عام نوع form_decode_error_mapper<E> = محول_خطأ_تحويل_نموذج<E>;
عام مرادف extract_form = استخرج_نموذجا;
