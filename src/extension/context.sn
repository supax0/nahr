من std.http استورد
    طلب_ويب,
    معاملات_مسار_ويب,
    انسخ_نص_ويب;

استورد std.text.compare;

عام نوع قيمة_سياق =
    | نصية بنوع نص
    | عددية بنوع عدد
    | طبيعية بنوع طبيعي
    | منطقية بنوع منطقي
;

عام نوع سمة_سياق = {
    الاسم: نص,
    القيمة: قيمة_سياق
};

// Borrows the request and its path parameters for the duration of one
// handler call; only the attributes are owned.
عام نوع سياق_طلب = {
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب,
    السمات: متجه سمة_سياق
};

عرف انسخ_قيمة_سياق(القيمة: &قيمة_سياق): قيمة_سياق {
    طابق *القيمة مع
    | قيمة_سياق.نصية(النص) -> {
        أرجع قيمة_سياق.نصية(انسخ_نص_ويب(&النص));
    }
    | قيمة_سياق.عددية(العدد) -> {
        أرجع قيمة_سياق.عددية(العدد);
    }
    | قيمة_سياق.طبيعية(العدد) -> {
        أرجع قيمة_سياق.طبيعية(العدد);
    }
    | قيمة_سياق.منطقية(المنطقي) -> {
        أرجع قيمة_سياق.منطقية(المنطقي);
    };
}

عام عرف أنشئ_سياقا(
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): سياق_طلب {
    ليكن السمات: متجه سمة_سياق = [];
    ليكن السياق: سياق_طلب = {
        الطلب: الطلب,
        المعاملات: المعاملات,
        السمات: السمات
    };
    أرجع السياق;
}

عام عرف عين_سمة(
    السياق: &متغير سياق_طلب,
    الاسم: &نص,
    القيمة: قيمة_سياق
): فراغ {
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول((*السياق).السمات) مثل طبيعي)) {
        إذا (نصان_متساويان(
            &(*السياق).السمات[الموضع].الاسم,
            الاسم
        )) {
            (*السياق).السمات[الموضع].القيمة := القيمة;
            أرجع;
        };
        الموضع := الموضع + 1;
    }

    ليكن السمة: سمة_سياق = {
        الاسم: انسخ_نص_ويب(الاسم),
        القيمة: القيمة
    };
    ألحق((*السياق).السمات, السمة);
}

عام عرف سمة(
    السياق: &سياق_طلب,
    الاسم: &نص
): اختياري قيمة_سياق {
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول((*السياق).السمات) مثل طبيعي)) {
        إذا (نصان_متساويان(
            &(*السياق).السمات[الموضع].الاسم,
            الاسم
        )) {
            أرجع اختياري.موجود(
                انسخ_قيمة_سياق(
                    &(*السياق).السمات[الموضع].القيمة
                )
            );
        };
        الموضع := الموضع + 1;
    }
    أرجع اختياري.لا_شيء();
}

عام عرف سمة_نص(
    السياق: &سياق_طلب,
    الاسم: &نص
): اختياري نص {
    طابق سمة(السياق, الاسم) مع
    | اختياري.موجود(قيمة_سياق.نصية(القيمة)) -> {
        أرجع اختياري.موجود(القيمة);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام عرف سمة_عدد(
    السياق: &سياق_طلب,
    الاسم: &نص
): اختياري عدد {
    طابق سمة(السياق, الاسم) مع
    | اختياري.موجود(قيمة_سياق.عددية(القيمة)) -> {
        أرجع اختياري.موجود(القيمة);
    }
    | _ -> { أرجع اختياري.لا_شيء(); };
}

عام مرادف context_value = قيمة_سياق;
عام مرادف context_entry = سمة_سياق;
عام مرادف request_context = سياق_طلب;
عام مرادف new_context = أنشئ_سياقا;
عام مرادف set_context = عين_سمة;
عام مرادف context_get = سمة;
عام مرادف context_text = سمة_نص;
عام مرادف context_int = سمة_عدد;
عام مرادف context_value.text = قيمة_سياق.نصية;
عام مرادف context_value.int = قيمة_سياق.عددية;
عام مرادف context_value.uint = قيمة_سياق.طبيعية;
عام مرادف context_value.bool = قيمة_سياق.منطقية;
