من std.text استورد من_بايتات, نصان_متساويان, صل_النصوص, طبيعي_إلى_نص, عدد_إلى_نص;
من std.env استورد متغير_بيئة;
من std.io استورد اطبع_سطر_خطأ;
من std.time استورد
    وقت_نظام_نانو,
    وقت_رتيب_نانو,
    تاريخ_ووقت,
    تاريخ_من_ثواني_يونكس,
    نسق_آر_إف_سي3339;
من std.http استورد طلب_ويب, استجابة_ويب, إصدار_ويب;
من std.os استورد هل_الخطأ_طرفية;

// Diagnostics in uvicorn's format, the server FastAPI runs on:
//
//     INFO:     Nahr running on http://127.0.0.1:8000 (Press CTRL+C to quit)
//     INFO:     "GET /notes HTTP/1.1" 303 See Other 0.41ms
//     WARNING:  …
//     ERROR:    could not listen on 127.0.0.1:8000: address already in use
//
// Lines go to standard error. The level name is colored on a terminal, and
// the access line's status by class, as uvicorn does. Settings come from the
// environment, so a deployed binary is configured without a rebuild:
//
//     NAHR_LOG_LEVEL   debug | info (default) | warning | error
//     NAHR_ACCESS_LOG  0 turns the per-request lines off (uvicorn's
//                      --no-access-log); 1 (default) keeps them
//     NAHR_LOG_COLOR   auto (default) | always | never; NO_COLOR also turns
//                      colors off (no-color.org)
//     NAHR_LOG_TIME    1 starts each line with the UTC time (RFC 3339),
//                      as Go's log and Rust's tracing do
//
// "auto" colors when standard error is a terminal and TERM is not "dumb".

عام نوع مستوى_سجل =
    | تصحيح
    | معلومة
    | تحذير
    | عطل
;

عام نوع إعداد_سجل = {
    // 0 debug, 1 info, 2 warning, 3 error.
    الحد: طبيعي,
    الطلبات: منطقي,
    الألوان: منطقي,
    الوقت: منطقي
};

عرف رتبة(المستوى: مستوى_سجل): طبيعي {
    طابق المستوى مع
    | مستوى_سجل.تصحيح -> { أرجع 0; }
    | مستوى_سجل.معلومة -> { أرجع 1; }
    | مستوى_سجل.تحذير -> { أرجع 2; }
    | مستوى_سجل.عطل -> { أرجع 3; };
}

عرف بيئة(الاسم: نص): نص {
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { أرجع القيمة; }
    | _ -> { أرجع «»; };
}

عرف يساوي(النص: &نص, الآخر: نص): منطقي { أرجع نصان_متساويان(النص, &الآخر); }

// The settings from the environment (see above).
عام عرف إعداد_سجل_من_البيئة(): إعداد_سجل {
    ليكن المستوى: نص = بيئة(«NAHR_LOG_LEVEL»);
    ليكن الحد: متغير طبيعي = 1;
    إذا (يساوي(&المستوى, «debug») || يساوي(&المستوى, «DEBUG»)) { الحد := 0; };
    إذا (يساوي(&المستوى, «warning») || يساوي(&المستوى, «WARNING») || يساوي(&المستوى, «warn»)) { الحد := 2; };
    إذا (يساوي(&المستوى, «error») || يساوي(&المستوى, «ERROR»)) { الحد := 3; };
    ليكن الطلبات: نص = بيئة(«NAHR_ACCESS_LOG»);
    ليكن اللون: نص = بيئة(«NAHR_LOG_COLOR»);
    ليكن الطرفية: نص = بيئة(«TERM»);
    ليكن بلا_لون: نص = بيئة(«NO_COLOR»);
    ليكن الألوان: متغير منطقي = هل_الخطأ_طرفية() && !يساوي(&الطرفية, «dumb»);
    إذا (الطول(بلا_لون) > 0) { الألوان := خطأ; };
    إذا (يساوي(&اللون, «always»)) { الألوان := صواب; };
    إذا (يساوي(&اللون, «never»)) { الألوان := خطأ; };
    ليكن الوقت: نص = بيئة(«NAHR_LOG_TIME»);
    ليكن الناتج: إعداد_سجل = {
        الحد: الحد,
        الطلبات: !يساوي(&الطلبات, «0») && !يساوي(&الطلبات, «false»),
        الألوان: الألوان,
        الوقت: يساوي(&الوقت, «1») || يساوي(&الوقت, «true»)
    };
    أرجع الناتج;
}

عام عرف مستوى_مفعل(الإعداد: &إعداد_سجل, المستوى: مستوى_سجل): منطقي {
    أرجع رتبة(المستوى) >= (*الإعداد).الحد;
}

// ---- building a line ----

عرف ألحق_نصا(الخرج: &متغير متجه ط8, النص: &نص): فراغ {
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول(*النص) مثل طبيعي)) { ألحق(*الخرج, (*النص)[ف]); ف := ف + 1; }
}

// ESC [ الرمز m: an SGR color code (32 green, 33 yellow, 31 red, 36 cyan,
// 1 bold, 91 bright red, 0 reset).
عرف ألحق_لونا(الخرج: &متغير متجه ط8, الرمز: نص): فراغ {
    ألحق(*الخرج, 0x1B);
    ألحق(*الخرج, 0x5B);
    ألحق_نصا(الخرج, &الرمز);
    ألحق(*الخرج, 0x6D);
}

عرف اسم_المستوى(المستوى: مستوى_سجل): نص {
    طابق المستوى مع
    | مستوى_سجل.تصحيح -> { أرجع «DEBUG»; }
    | مستوى_سجل.معلومة -> { أرجع «INFO»; }
    | مستوى_سجل.تحذير -> { أرجع «WARNING»; }
    | مستوى_سجل.عطل -> { أرجع «ERROR»; };
}

عرف لون_المستوى(المستوى: مستوى_سجل): نص {
    طابق المستوى مع
    | مستوى_سجل.تصحيح -> { أرجع «36»; }
    | مستوى_سجل.معلومة -> { أرجع «32»; }
    | مستوى_سجل.تحذير -> { أرجع «33»; }
    | مستوى_سجل.عطل -> { أرجع «31»; };
}

// The current UTC time as RFC 3339, or empty.
عرف الوقت_الآن(): نص {
    طابق وقت_نظام_نانو() مع
    | نتيجة.خطأ(_) -> { أرجع «»; }
    | نتيجة.نجح(النانو) -> {
        طابق تاريخ_من_ثواني_يونكس(النانو / 1000000000, 0) مع
        | اختياري.لا_شيء -> { أرجع «»; }
        | اختياري.موجود(التاريخ) -> {
            طابق نسق_آر_إف_سي3339(&التاريخ) مع
            | اختياري.موجود(النص) -> { أرجع النص; }
            | اختياري.لا_شيء -> { أرجع «»; };
        };
    };
}

// "INFO:     " (the level and a colon, padded to ten columns, uvicorn's
// levelprefix), optionally after the time.
عرف بادئة(الإعداد: &إعداد_سجل, المستوى: مستوى_سجل, الخرج: &متغير متجه ط8): فراغ {
    إذا ((*الإعداد).الوقت) {
        ليكن الوقت: نص = الوقت_الآن();
        ألحق_نصا(الخرج, &الوقت);
        ألحق(*الخرج, 0x20);
    };
    ليكن الاسم: نص = اسم_المستوى(المستوى);
    إذا ((*الإعداد).الألوان) { ألحق_لونا(الخرج, لون_المستوى(المستوى)); };
    ألحق_نصا(الخرج, &الاسم);
    إذا ((*الإعداد).الألوان) { ألحق_لونا(الخرج, «0»); };
    ألحق(*الخرج, 0x3A);
    ليكن ف: متغير طبيعي = (الطول(الاسم) مثل طبيعي) + 1;
    طالما (ف < 10) { ألحق(*الخرج, 0x20); ف := ف + 1; }
}

// Writes الرسالة at المستوى when the settings let it through.
عام عرف سجل_بإعداد(الإعداد: &إعداد_سجل, المستوى: مستوى_سجل, الرسالة: نص): فراغ {
    إذا (!مستوى_مفعل(الإعداد, المستوى)) { أرجع; };
    ليكن الخرج: متغير متجه ط8 = [];
    بادئة(الإعداد, المستوى, &متغير الخرج);
    ألحق_نصا(&متغير الخرج, &الرسالة);
    ليكن تجاهل: نتيجة عدد, عدد = اطبع_سطر_خطأ(من_بايتات(&الخرج));
}

// With the settings from the environment.
عام عرف سجل_رسالة(المستوى: مستوى_سجل, الرسالة: نص): فراغ {
    ليكن الإعداد: إعداد_سجل = إعداد_سجل_من_البيئة();
    سجل_بإعداد(&الإعداد, المستوى, الرسالة);
}

عام عرف سجل_تصحيح(الرسالة: نص): فراغ { سجل_رسالة(مستوى_سجل.تصحيح(), الرسالة); }
عام عرف سجل_معلومة(الرسالة: نص): فراغ { سجل_رسالة(مستوى_سجل.معلومة(), الرسالة); }
عام عرف سجل_تحذير(الرسالة: نص): فراغ { سجل_رسالة(مستوى_سجل.تحذير(), الرسالة); }
عام عرف سجل_عطل(الرسالة: نص): فراغ { سجل_رسالة(مستوى_سجل.عطل(), الرسالة); }

// ---- access lines ----

// The reason phrase of a status (RFC 9110 §15).
عام عرف عبارة_الحالة(الحالة: طبيعي): نص {
    إذا (الحالة == 100) { أرجع «Continue»; };
    إذا (الحالة == 101) { أرجع «Switching Protocols»; };
    إذا (الحالة == 200) { أرجع «OK»; };
    إذا (الحالة == 201) { أرجع «Created»; };
    إذا (الحالة == 202) { أرجع «Accepted»; };
    إذا (الحالة == 204) { أرجع «No Content»; };
    إذا (الحالة == 206) { أرجع «Partial Content»; };
    إذا (الحالة == 301) { أرجع «Moved Permanently»; };
    إذا (الحالة == 302) { أرجع «Found»; };
    إذا (الحالة == 303) { أرجع «See Other»; };
    إذا (الحالة == 304) { أرجع «Not Modified»; };
    إذا (الحالة == 307) { أرجع «Temporary Redirect»; };
    إذا (الحالة == 308) { أرجع «Permanent Redirect»; };
    إذا (الحالة == 400) { أرجع «Bad Request»; };
    إذا (الحالة == 401) { أرجع «Unauthorized»; };
    إذا (الحالة == 403) { أرجع «Forbidden»; };
    إذا (الحالة == 404) { أرجع «Not Found»; };
    إذا (الحالة == 405) { أرجع «Method Not Allowed»; };
    إذا (الحالة == 406) { أرجع «Not Acceptable»; };
    إذا (الحالة == 408) { أرجع «Request Timeout»; };
    إذا (الحالة == 409) { أرجع «Conflict»; };
    إذا (الحالة == 410) { أرجع «Gone»; };
    إذا (الحالة == 411) { أرجع «Length Required»; };
    إذا (الحالة == 412) { أرجع «Precondition Failed»; };
    إذا (الحالة == 413) { أرجع «Content Too Large»; };
    إذا (الحالة == 414) { أرجع «URI Too Long»; };
    إذا (الحالة == 415) { أرجع «Unsupported Media Type»; };
    إذا (الحالة == 422) { أرجع «Unprocessable Content»; };
    إذا (الحالة == 426) { أرجع «Upgrade Required»; };
    إذا (الحالة == 429) { أرجع «Too Many Requests»; };
    إذا (الحالة == 431) { أرجع «Request Header Fields Too Large»; };
    إذا (الحالة == 500) { أرجع «Internal Server Error»; };
    إذا (الحالة == 501) { أرجع «Not Implemented»; };
    إذا (الحالة == 502) { أرجع «Bad Gateway»; };
    إذا (الحالة == 503) { أرجع «Service Unavailable»; };
    إذا (الحالة == 504) { أرجع «Gateway Timeout»; };
    أرجع «»;
}

عرف نص_الإصدار(الإصدار: &إصدار_ويب): نص {
    طابق *الإصدار مع
    | إصدار_ويب.واحد_صفر -> { أرجع «HTTP/1.0»; }
    | إصدار_ويب.واحد_واحد -> { أرجع «HTTP/1.1»; }
    | إصدار_ويب.اثنان -> { أرجع «HTTP/2»; }
    | إصدار_ويب.ثلاثة -> { أرجع «HTTP/3»; };
}

// 1234567 ns -> "1.23ms"; under a millisecond, "0.41ms".
عام عرف نص_المدة(النانو: عدد): نص {
    ليكن المئويات: عدد = النانو / 10000;
    ليكن الصحيح: عدد = المئويات / 100;
    ليكن الكسر: عدد = المئويات % 100;
    ليكن الخرج: متغير متجه ط8 = [];
    ليكن ص: نص = عدد_إلى_نص(الصحيح);
    ألحق_نصا(&متغير الخرج, &ص);
    ألحق(الخرج, 0x2E);
    إذا (الكسر < 10) { ألحق(الخرج, 0x30); };
    ليكن ك: نص = عدد_إلى_نص(الكسر);
    ألحق_نصا(&متغير الخرج, &ك);
    ألحق(الخرج, 0x6D); ألحق(الخرج, 0x73);
    أرجع من_بايتات(&الخرج);
}

عرف لون_الحالة(الحالة: طبيعي): نص {
    إذا (الحالة >= 500) { أرجع «91»; };
    إذا (الحالة >= 400) { أرجع «31»; };
    إذا (الحالة >= 300) { أرجع «33»; };
    إذا (الحالة >= 200) { أرجع «32»; };
    أرجع «1»;
}

// One access line, uvicorn's, plus the time the request took (as tower-http's
// trace layer logs it):
//     INFO:     127.0.0.1:52345 - "GET /path HTTP/1.1" 200 OK 0.41ms
// The access log can be paused while the program runs, for example during a
// load test, when one line per request would slow the server and flood the
// terminal; the program logs a summary instead. Compiler intrinsics bind
// only through private aliases (std.sync.atomic's way).
مرادف احمل_ذريا_للسجل = بدائي_ذري_حمل;
مرادف قارن_وبدل_ذريا_للسجل = بدائي_ذري_قارن_وبدل;
ليكن سجل_الوصول_موقوف: متغير ط64 = 0;

عرف اضبط_إيقاف_السجل(القيمة: ط64): فراغ {
    ليكن الحالي: ط64 = احمل_ذريا_للسجل(&سجل_الوصول_موقوف, 2);
    ليكن تجاهل: ط64 = قارن_وبدل_ذريا_للسجل(&سجل_الوصول_موقوف, الحالي, القيمة, 3, 2);
}

// Stops the per-request lines until استأنف_سجل_الوصول.
عام عرف أوقف_سجل_الوصول_مؤقتا(): فراغ { اضبط_إيقاف_السجل(1 مثل ط64); }
عام عرف استأنف_سجل_الوصول(): فراغ { اضبط_إيقاف_السجل(0 مثل ط64); }
عام عرف سجل_الوصول_موقوف_الآن(): منطقي { أرجع احمل_ذريا_للسجل(&سجل_الوصول_موقوف, 2) != (0 مثل ط64); }

عام عرف سجل_طلبا(
    الإعداد: &إعداد_سجل,
    الطلب: &طلب_ويب<متجه ط8>,
    الحالة: طبيعي,
    النانو: عدد
): فراغ {
    إذا (!(*الإعداد).الطلبات || !مستوى_مفعل(الإعداد, مستوى_سجل.معلومة())) { أرجع; };
    إذا (سجل_الوصول_موقوف_الآن()) { أرجع; };
    ليكن الخرج: متغير متجه ط8 = [];
    بادئة(الإعداد, مستوى_سجل.معلومة(), &متغير الخرج);
    إذا (الطول((*الطلب).العنوان_البعيد) > 0) {
        ألحق_نصا(&متغير الخرج, &(*الطلب).العنوان_البعيد);
        ألحق(الخرج, 0x20); ألحق(الخرج, 0x2D); ألحق(الخرج, 0x20);
    };
    إذا ((*الإعداد).الألوان) { ألحق_لونا(&متغير الخرج, «1»); };
    ألحق(الخرج, 0x22);
    ألحق_نصا(&متغير الخرج, &(*الطلب).الطريقة);
    ألحق(الخرج, 0x20);
    ألحق_نصا(&متغير الخرج, &(*الطلب).الهدف);
    ألحق(الخرج, 0x20);
    ليكن الإصدار: نص = نص_الإصدار(&(*الطلب).الإصدار);
    ألحق_نصا(&متغير الخرج, &الإصدار);
    ألحق(الخرج, 0x22);
    إذا ((*الإعداد).الألوان) { ألحق_لونا(&متغير الخرج, «0»); };
    ألحق(الخرج, 0x20);
    إذا ((*الإعداد).الألوان) { ألحق_لونا(&متغير الخرج, لون_الحالة(الحالة)); };
    ليكن الرقم: نص = طبيعي_إلى_نص(الحالة);
    ألحق_نصا(&متغير الخرج, &الرقم);
    ليكن العبارة: نص = عبارة_الحالة(الحالة);
    إذا (الطول(العبارة) > 0) {
        ألحق(الخرج, 0x20);
        ألحق_نصا(&متغير الخرج, &العبارة);
    };
    إذا ((*الإعداد).الألوان) { ألحق_لونا(&متغير الخرج, «0»); };
    ألحق(الخرج, 0x20);
    ليكن المدة: نص = نص_المدة(النانو);
    ألحق_نصا(&متغير الخرج, &المدة);
    ليكن تجاهل: نتيجة عدد, عدد = اطبع_سطر_خطأ(من_بايتات(&الخرج));
}

عام عرف الآن_نانو(): عدد {
    طابق وقت_رتيب_نانو() مع
    | نتيجة.نجح(القيمة) -> { أرجع القيمة; }
    | نتيجة.خطأ(_) -> { أرجع 0; };
}

عام مرادف log_level = مستوى_سجل;
عام مرادف log_level.debug = مستوى_سجل.تصحيح;
عام مرادف log_level.info = مستوى_سجل.معلومة;
عام مرادف log_level.warning = مستوى_سجل.تحذير;
عام مرادف log_level.error = مستوى_سجل.عطل;
عام نوع log_config = إعداد_سجل;
عام مرادف log_config_from_env = إعداد_سجل_من_البيئة;
عام مرادف log_enabled = مستوى_مفعل;
عام مرادف log_with = سجل_بإعداد;
عام مرادف log_message = سجل_رسالة;
عام مرادف log_debug = سجل_تصحيح;
عام مرادف log_info = سجل_معلومة;
عام مرادف log_warning = سجل_تحذير;
عام مرادف log_error = سجل_عطل;
عام مرادف log_request = سجل_طلبا;
عام مرادف pause_access_log = أوقف_سجل_الوصول_مؤقتا;
عام مرادف resume_access_log = استأنف_سجل_الوصول;
عام مرادف access_log_paused = سجل_الوصول_موقوف_الآن;
عام مرادف status_reason = عبارة_الحالة;
عام مرادف duration_text = نص_المدة;
