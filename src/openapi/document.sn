استورد std.text.compare;
استورد std.text.substring;
استورد openapi.model;

عام نوع خطأ_توثيق =
    | عملية_مكررة
    | معرف_عملية_مكرر
    | بلا_استجابات
    | مسار_بقية_غير_مدعوم
    | معامل_مسار_ناقص
    | مخطط_مكرر
    | أمن_مكرر
;


عرف نفس_موضع_المعامل(
    الأول: موضع_معامل_واجهة,
    الثاني: موضع_معامل_واجهة
): منطقي {
    طابق الأول مع
    | موضع_معامل_واجهة.مسار -> {
        طابق الثاني مع
        | موضع_معامل_واجهة.مسار -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | موضع_معامل_واجهة.استعلام -> {
        طابق الثاني مع
        | موضع_معامل_واجهة.استعلام -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    }
    | موضع_معامل_واجهة.رأس -> {
        طابق الثاني مع
        | موضع_معامل_واجهة.رأس -> { أرجع صواب; }
        | _ -> { أرجع خطأ; };
    };
}

عرف معامل_مسار_موجود(
    العملية: &عملية_واجهة,
    الاسم: &نص
): منطقي {
    دع الموضع: متغير طبيعي = 0;
    طالما (
        الموضع < (الطول((*العملية).المعاملات) مثل طبيعي)
    ) {
        دع المعامل: &معامل_واجهة =
            &(*العملية).المعاملات[الموضع];
        إذا (نفس_موضع_المعامل(
            (*المعامل).الموضع,
            موضع_معامل_واجهة.مسار()
        ) && (*المعامل).مطلوب
            && نصان_متساويان(&(*المعامل).الاسم, الاسم)) {
            أرجع صواب;
        };
        الموضع := الموضع + 1;
    }
    أرجع خطأ;
}

عرف تحقق_معاملات_المسار(
    العملية: &عملية_واجهة
): نتيجة منطقي, خطأ_توثيق {
    دع المسار: نص = (*العملية).المسار;
    دع العدد: طبيعي = الطول(المسار) مثل طبيعي;
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < العدد) {
        إذا (المسار[الموضع] == 0x7B) {
            دع بداية_الاسم: طبيعي = الموضع + 1;
            إذا (بداية_الاسم < العدد) {
                إذا (المسار[بداية_الاسم] == 0x2A) {
                    أرجع نتيجة.خطأ(
                        خطأ_توثيق.مسار_بقية_غير_مدعوم()
                    );
                };
            };
            دع النهاية: متغير طبيعي = بداية_الاسم;
            طالما ((النهاية < العدد) && (المسار[النهاية] != 0x7D)) {
                النهاية := النهاية + 1;
            }
            إذا ((النهاية >= العدد) || (النهاية == بداية_الاسم)) {
                أرجع نتيجة.خطأ(خطأ_توثيق.معامل_مسار_ناقص());
            };
            طابق مقطع_نص(
                &المسار,
                بداية_الاسم,
                النهاية - بداية_الاسم
            ) مع
            | اختياري.لا_شيء -> {
                أرجع نتيجة.خطأ(خطأ_توثيق.معامل_مسار_ناقص());
            }
            | اختياري.موجود(الاسم) -> {
                إذا (!معامل_مسار_موجود(العملية, &الاسم)) {
                    أرجع نتيجة.خطأ(
                        خطأ_توثيق.معامل_مسار_ناقص()
                    );
                };
            };
            الموضع := النهاية;
        };
        الموضع := الموضع + 1;
    }
    أرجع نتيجة.نجح(صواب);
}

عرف معرف_عملية_موجود(
    الوثيقة: &وثيقة_واجهة,
    العملية: &عملية_واجهة
): منطقي {
    طابق (*العملية).معرف_العملية مع
    | اختياري.لا_شيء -> { أرجع خطأ; }
    | اختياري.موجود(المعرف) -> {
        دع الموضع: متغير طبيعي = 0;
        طالما (الموضع < (الطول((*الوثيقة).العمليات) مثل طبيعي)) {
            طابق (*الوثيقة).العمليات[الموضع].معرف_العملية مع
            | اختياري.موجود(الحالي) -> {
                إذا (نصان_متساويان(&المعرف, &الحالي)) {
                    أرجع صواب;
                };
            }
            | اختياري.لا_شيء -> { };
            الموضع := الموضع + 1;
        }
    };
    أرجع خطأ;
}

عرف نفس_العملية(
    العملية: &عملية_واجهة,
    الطريقة: &نص,
    المسار: &نص
): منطقي {
    أرجع نصان_متساويان(&(*العملية).الطريقة, الطريقة)
        && نصان_متساويان(&(*العملية).المسار, المسار);
}

عام عرف تحقق_عملية(
    الوثيقة: &وثيقة_واجهة,
    العملية: &عملية_واجهة
): نتيجة منطقي, خطأ_توثيق {
    إذا ((الطول((*العملية).الاستجابات) مثل طبيعي) == 0) {
        أرجع نتيجة.خطأ(خطأ_توثيق.بلا_استجابات());
    };
    طابق تحقق_معاملات_المسار(العملية) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };
    إذا (معرف_عملية_موجود(الوثيقة, العملية)) {
        أرجع نتيجة.خطأ(خطأ_توثيق.معرف_عملية_مكرر());
    };
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول((*الوثيقة).العمليات) مثل طبيعي)) {
        إذا (نفس_العملية(
            &(*الوثيقة).العمليات[الموضع],
            &(*العملية).الطريقة,
            &(*العملية).المسار
        )) {
            أرجع نتيجة.خطأ(خطأ_توثيق.عملية_مكررة());
        };
        الموضع := الموضع + 1;
    }
    أرجع نتيجة.نجح(صواب);
}


عام عرف سجل_عملية(
    الوثيقة: &متغير وثيقة_واجهة,
    العملية: عملية_واجهة
): نتيجة طبيعي, خطأ_توثيق {
    طابق تحقق_عملية(الوثيقة, &العملية) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(_) -> { };

    دع الفهرس: طبيعي = الطول((*الوثيقة).العمليات) مثل طبيعي;
    ألحق((*الوثيقة).العمليات, العملية);
    أرجع نتيجة.نجح(الفهرس);
}

عام عرف سجل_مخططا(
    الوثيقة: &متغير وثيقة_واجهة,
    المخطط: تعريف_مخطط_واجهة
): نتيجة طبيعي, خطأ_توثيق {
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول((*الوثيقة).المخططات) مثل طبيعي)) {
        إذا (نصان_متساويان(
            &(*الوثيقة).المخططات[الموضع].الاسم,
            &المخطط.الاسم
        )) {
            أرجع نتيجة.خطأ(خطأ_توثيق.مخطط_مكرر());
        };
        الموضع := الموضع + 1;
    }
    دع الفهرس: طبيعي = الطول((*الوثيقة).المخططات) مثل طبيعي;
    ألحق((*الوثيقة).المخططات, المخطط);
    أرجع نتيجة.نجح(الفهرس);
}

عام عرف سجل_أمنا(
    الوثيقة: &متغير وثيقة_واجهة,
    الأمن: مخطط_أمن_واجهة
): نتيجة طبيعي, خطأ_توثيق {
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول((*الوثيقة).مخططات_الأمن) مثل طبيعي)) {
        إذا (نصان_متساويان(
            &(*الوثيقة).مخططات_الأمن[الموضع].الاسم,
            &الأمن.الاسم
        )) {
            أرجع نتيجة.خطأ(خطأ_توثيق.أمن_مكرر());
        };
        الموضع := الموضع + 1;
    }
    دع الفهرس: طبيعي = الطول((*الوثيقة).مخططات_الأمن) مثل طبيعي;
    ألحق((*الوثيقة).مخططات_الأمن, الأمن);
    أرجع نتيجة.نجح(الفهرس);
}

عام عرف لخص(
    العملية: &متغير عملية_واجهة,
    الملخص: &نص
): فراغ {
    (*العملية).الملخص := اختياري.موجود(استنسخ(الملخص));
}

عام عرف اشرح(
    العملية: &متغير عملية_واجهة,
    الوصف: &نص
): فراغ {
    (*العملية).الوصف := اختياري.موجود(استنسخ(الوصف));
}

عام عرف سم_عملية(
    العملية: &متغير عملية_واجهة,
    المعرف: &نص
): فراغ {
    (*العملية).معرف_العملية := اختياري.موجود(استنسخ(المعرف));
}

عام عرف صنف(
    العملية: &متغير عملية_واجهة,
    الوسم: &نص
): فراغ {
    ألحق((*العملية).الوسوم, استنسخ(الوسم));
}

عام عرف ضمن_معاملا(
    العملية: &متغير عملية_واجهة,
    المعامل: معامل_واجهة
): فراغ {
    ألحق((*العملية).المعاملات, المعامل);
}

عام عرف عين_جسم_طلب(
    العملية: &متغير عملية_واجهة,
    الجسم: جسم_طلب_واجهة
): فراغ {
    (*العملية).جسم_الطلب := اختياري.موجود(الجسم);
}

عام عرف ضمن_استجابة(
    العملية: &متغير عملية_واجهة,
    الاستجابة: استجابة_واجهة
): فراغ {
    ألحق((*العملية).الاستجابات, الاستجابة);
}

عام عرف اطلب_أمنا(
    العملية: &متغير عملية_واجهة,
    الاسم: &نص
): فراغ {
    ألحق((*العملية).الأمن, استنسخ(الاسم));
}

عام عرف اهجر(العملية: &متغير عملية_واجهة): فراغ {
    (*العملية).مهجورة := صواب;
}

عام مرادف documentation_error = خطأ_توثيق;
عام مرادف register_operation = سجل_عملية;
عام مرادف register_schema = سجل_مخططا;
عام مرادف register_security = سجل_أمنا;
عام مرادف summarize = لخص;
عام مرادف describe = اشرح;
عام مرادف operation_id = سم_عملية;
عام مرادف tag = صنف;
عام مرادف parameter = ضمن_معاملا;
عام مرادف request_body = عين_جسم_طلب;
عام مرادف add_response = ضمن_استجابة;
عام مرادف require_security = اطلب_أمنا;
عام مرادف deprecate = اهجر;
عام مرادف documentation_error.duplicate_operation = خطأ_توثيق.عملية_مكررة;
عام مرادف documentation_error.duplicate_operation_id = خطأ_توثيق.معرف_عملية_مكرر;
عام مرادف documentation_error.missing_responses = خطأ_توثيق.بلا_استجابات;
عام مرادف documentation_error.catch_all_path = خطأ_توثيق.مسار_بقية_غير_مدعوم;
عام مرادف documentation_error.missing_path_parameter = خطأ_توثيق.معامل_مسار_ناقص;
عام مرادف documentation_error.duplicate_schema = خطأ_توثيق.مخطط_مكرر;
عام مرادف documentation_error.duplicate_security = خطأ_توثيق.أمن_مكرر;


عام عرف ضمن_خاصية(
    المخطط: &متغير تعريف_مخطط_واجهة,
    الخاصية: خاصية_مخطط_واجهة
): فراغ {
    ألحق((*المخطط).الخصائص, الخاصية);
}

عام عرف صف_خاصية(
    الاسم: &نص,
    المخطط: مخطط_واجهة,
    مطلوبة: منطقي
): خاصية_مخطط_واجهة {
    دع الناتج: خاصية_مخطط_واجهة = {
        الاسم: استنسخ(الاسم),
        المخطط: المخطط,
        مطلوبة: مطلوبة
    };
    أرجع الناتج;
}


عام عرف اشرح_الواجهة(
    الوثيقة: &متغير وثيقة_واجهة,
    الوصف: &نص
): فراغ {
    (*الوثيقة).المعلومات.الوصف := اختياري.موجود(استنسخ(الوصف));
}

عام عرف اشرح_مخططا(
    المخطط: &متغير مخطط_واجهة,
    الوصف: &نص
): فراغ {
    (*المخطط).الوصف := اختياري.موجود(استنسخ(الوصف));
}

عام عرف اشرح_تعريف_مخطط(
    المخطط: &متغير تعريف_مخطط_واجهة,
    الوصف: &نص
): فراغ {
    (*المخطط).الوصف := اختياري.موجود(استنسخ(الوصف));
}

عام عرف اشرح_معاملا(
    المعامل: &متغير معامل_واجهة,
    الوصف: &نص
): فراغ {
    (*المعامل).الوصف := اختياري.موجود(استنسخ(الوصف));
}

عام عرف صف_أمن_الحامل(
    الأمن: &متغير مخطط_أمن_واجهة,
    الوصف: &نص,
    الصيغة: &نص
): فراغ {
    (*الأمن).الوصف := اختياري.موجود(استنسخ(الوصف));
    (*الأمن).صيغة_الحامل := اختياري.موجود(استنسخ(الصيغة));
}

عام مرادف describe_api = اشرح_الواجهة;
عام مرادف describe_schema = اشرح_مخططا;
عام مرادف describe_schema_definition = اشرح_تعريف_مخطط;
عام مرادف describe_parameter = اشرح_معاملا;
عام مرادف describe_bearer_security = صف_أمن_الحامل;

عام مرادف validate_operation = تحقق_عملية;
عام مرادف schema_property = صف_خاصية;
عام مرادف property = ضمن_خاصية;
