من std.json استورد
    قيمة_جسون,
    مدخل_كائن_جسون,
    مصفوفة_جسون,
    كائن_جسون,
    وثيقة_جسون,
    صنف_خطأ_جسون,
    جسون_إلى_نص;

استورد std.collections.text_index_map;
استورد std.text.compare;
استورد std.text.builder;
استورد openapi.model;
استورد json.writer;

عرف مدخل(
    المفتاح: نص,
    القيمة: قيمة_جسون
): مدخل_كائن_جسون {
    دع الناتج: مدخل_كائن_جسون = {
        المفتاح: المفتاح,
        القيمة: القيمة
    };
    أرجع الناتج;
}

عرف قيمة_نصية(النص: نص): قيمة_جسون {
    أرجع قيمة_جسون.سلسلة(النص);
}

عرف أدرج_مصفوفة(
    الوثيقة: &متغير وثيقة_جسون,
    القيم: متجه قيمة_جسون
): قيمة_جسون {
    دع الفهرس: طبيعي = الطول((*الوثيقة).المصفوفات) مثل طبيعي;
    دع المصفوفة: مصفوفة_جسون = { القيم: القيم };
    ألحق((*الوثيقة).المصفوفات, المصفوفة);
    أرجع قيمة_جسون.مصفوفة(الفهرس);
}

عرف أدرج_كائنا(
    الوثيقة: &متغير وثيقة_جسون,
    المداخل: متجه مدخل_كائن_جسون
): قيمة_جسون {
    دع الفهرس: طبيعي = الطول((*الوثيقة).الكائنات) مثل طبيعي;
    دع خريطة_فارغة: خريطة_نص_فهرس = أنشئ_خريطة_نص_فهرس();
    دع الكائن: كائن_جسون = {
        المداخل: المداخل,
        الفهرس: خريطة_فارغة
    };
    ألحق((*الوثيقة).الكائنات, الكائن);
    أرجع قيمة_جسون.كائن(الفهرس);
}

عرف مرجع_مخطط(الاسم: &نص): نص {
    دع الباني: متغير باني_نص = أنشئ_باني_نص();
    دع البداية: نص = «#/components/schemas/»;
    ألحق_نصا_بباني_النص(&متغير الباني, &البداية);
    ألحق_نصا_بباني_النص(&متغير الباني, الاسم);
    أرجع نص_باني_النص(&الباني);
}

عرف طريقة_واجهة(الطريقة: &نص): نص {
    دع جلب: نص = «GET»;
    إذا (نصان_متساويان(الطريقة, &جلب)) { أرجع «get»; };
    دع إرسال: نص = «POST»;
    إذا (نصان_متساويان(الطريقة, &إرسال)) { أرجع «post»; };
    دع استبدال: نص = «PUT»;
    إذا (نصان_متساويان(الطريقة, &استبدال)) { أرجع «put»; };
    دع تعديل: نص = «PATCH»;
    إذا (نصان_متساويان(الطريقة, &تعديل)) { أرجع «patch»; };
    دع حذف: نص = «DELETE»;
    إذا (نصان_متساويان(الطريقة, &حذف)) { أرجع «delete»; };
    دع رأس: نص = «HEAD»;
    إذا (نصان_متساويان(الطريقة, &رأس)) { أرجع «head»; };
    دع خيارات: نص = «OPTIONS»;
    إذا (نصان_متساويان(الطريقة, &خيارات)) { أرجع «options»; };
    دع تتبع: نص = «TRACE»;
    إذا (نصان_متساويان(الطريقة, &تتبع)) { أرجع «trace»; };
    دع استعلام: نص = «QUERY»;
    إذا (نصان_متساويان(الطريقة, &استعلام)) { أرجع «query»; };
    أرجع استنسخ(الطريقة);
}


عرف طريقة_قياسية(الطريقة: &نص): منطقي {
    دع القيم: متجه نص = [
        «GET»,
        «PUT»,
        «POST»,
        «DELETE»,
        «OPTIONS»,
        «HEAD»,
        «PATCH»,
        «TRACE»,
        «QUERY»
    ];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(القيم) مثل طبيعي)) {
        إذا (نصان_متساويان(الطريقة, &القيم[الموضع])) {
            أرجع صواب;
        };
        الموضع := الموضع + 1;
    }
    أرجع خطأ;
}

عرف مسار_واجهة(المسار: &نص): نص {
    أرجع استنسخ(المسار);
}

عرف موضع_معامل(الموضع: موضع_معامل_واجهة): نص {
    طابق الموضع مع
    | موضع_معامل_واجهة.مسار -> { أرجع «path»; }
    | موضع_معامل_واجهة.استعلام -> { أرجع «query»; }
    | موضع_معامل_واجهة.رأس -> { أرجع «header»; };
}

عرف قيمة_مخطط(
    الوثيقة: &متغير وثيقة_جسون,
    المخطط: &مخطط_واجهة
): قيمة_جسون {
    دع المداخل: متغير متجه مدخل_كائن_جسون = [];

    طابق (*المخطط).المرجع مع
    | اختياري.موجود(الاسم) -> {
        دع المفتاح: نص = «$ref»;
        دع المرجع: نص = مرجع_مخطط(&الاسم);
        ألحق(المداخل, مدخل(المفتاح, قيمة_نصية(المرجع)));
        أرجع أدرج_كائنا(الوثيقة, المداخل);
    }
    | اختياري.لا_شيء -> { };

    دع مفتاح_النوع: نص = «type»;
    ألحق(
        المداخل,
        مدخل(مفتاح_النوع, قيمة_نصية(استنسخ(&(*المخطط).النوع)))
    );

    طابق (*المخطط).الصيغة مع
    | اختياري.موجود(الصيغة) -> {
        دع المفتاح: نص = «format»;
        ألحق(المداخل, مدخل(المفتاح, قيمة_نصية(استنسخ(&الصيغة))));
    }
    | اختياري.لا_شيء -> { };

    طابق (*المخطط).الوصف مع
    | اختياري.موجود(الوصف) -> {
        دع المفتاح: نص = «description»;
        ألحق(المداخل, مدخل(المفتاح, قيمة_نصية(استنسخ(&الوصف))));
    }
    | اختياري.لا_شيء -> { };

    طابق (*المخطط).عناصر_مرجع مع
    | اختياري.موجود(الاسم) -> {
        دع مداخل_العناصر: متجه مدخل_كائن_جسون = [
            مدخل(
                «$ref»,
                قيمة_نصية(مرجع_مخطط(&الاسم))
            )
        ];
        دع العناصر: قيمة_جسون =
            أدرج_كائنا(الوثيقة, مداخل_العناصر);
        دع المفتاح: نص = «items»;
        ألحق(المداخل, مدخل(المفتاح, العناصر));
    }
    | اختياري.لا_شيء -> { };

    أرجع أدرج_كائنا(الوثيقة, المداخل);
}

عرف قيمة_معامل(
    الوثيقة: &متغير وثيقة_جسون,
    المعامل: &معامل_واجهة
): قيمة_جسون {
    دع المداخل: متغير متجه مدخل_كائن_جسون = [];
    دع مفتاح_الاسم: نص = «name»;
    ألحق(
        المداخل,
        مدخل(مفتاح_الاسم, قيمة_نصية(استنسخ(&(*المعامل).الاسم)))
    );
    دع مفتاح_الموضع: نص = «in»;
    دع نص_الموضع: نص = موضع_معامل((*المعامل).الموضع);
    ألحق(
        المداخل,
        مدخل(مفتاح_الموضع, قيمة_نصية(نص_الموضع))
    );
    طابق (*المعامل).الوصف مع
    | اختياري.موجود(الوصف) -> {
        دع المفتاح: نص = «description»;
        ألحق(المداخل, مدخل(المفتاح, قيمة_نصية(استنسخ(&الوصف))));
    }
    | اختياري.لا_شيء -> { };
    دع مفتاح_مطلوب: نص = «required»;
    ألحق(
        المداخل,
        مدخل(
            مفتاح_مطلوب,
            قيمة_جسون.منطق((*المعامل).مطلوب)
        )
    );
    دع مفتاح_المخطط: نص = «schema»;
    ألحق(
        المداخل,
        مدخل(
            مفتاح_المخطط,
            قيمة_مخطط(الوثيقة, &(*المعامل).المخطط)
        )
    );
    أرجع أدرج_كائنا(الوثيقة, المداخل);
}

عرف قيمة_جسم_طلب(
    الوثيقة: &متغير وثيقة_جسون,
    الجسم: &جسم_طلب_واجهة
): قيمة_جسون {
    دع مداخل_النوع: متجه مدخل_كائن_جسون = [
        مدخل(
            «schema»,
            قيمة_مخطط(الوثيقة, &(*الجسم).المخطط)
        )
    ];
    دع قيمة_النوع: قيمة_جسون =
        أدرج_كائنا(الوثيقة, مداخل_النوع);
    دع مداخل_المحتوى: متجه مدخل_كائن_جسون = [
        مدخل(استنسخ(&(*الجسم).نوع_المحتوى), قيمة_النوع)
    ];
    دع المحتوى: قيمة_جسون =
        أدرج_كائنا(الوثيقة, مداخل_المحتوى);
    دع المداخل: متجه مدخل_كائن_جسون = [
        مدخل(«required», قيمة_جسون.منطق((*الجسم).مطلوب)),
        مدخل(«content», المحتوى)
    ];
    أرجع أدرج_كائنا(الوثيقة, المداخل);
}

عرف قيمة_استجابة(
    الوثيقة: &متغير وثيقة_جسون,
    الاستجابة: &استجابة_واجهة
): قيمة_جسون {
    دع المداخل: متغير متجه مدخل_كائن_جسون = [
        مدخل(«description», قيمة_نصية(استنسخ(&(*الاستجابة).الوصف)))
    ];
    طابق (*الاستجابة).نوع_المحتوى مع
    | اختياري.موجود(نوع_المحتوى) -> {
        طابق (*الاستجابة).المخطط مع
        | اختياري.موجود(المخطط) -> {
            دع مداخل_النوع: متجه مدخل_كائن_جسون = [
                مدخل(«schema», قيمة_مخطط(الوثيقة, &المخطط))
            ];
            دع قيمة_النوع: قيمة_جسون =
                أدرج_كائنا(الوثيقة, مداخل_النوع);
            دع مداخل_المحتوى: متجه مدخل_كائن_جسون = [
                مدخل(استنسخ(&نوع_المحتوى), قيمة_النوع)
            ];
            دع المحتوى: قيمة_جسون =
                أدرج_كائنا(الوثيقة, مداخل_المحتوى);
            ألحق(المداخل, مدخل(«content», المحتوى));
        }
        | اختياري.لا_شيء -> { };
    }
    | اختياري.لا_شيء -> { };
    أرجع أدرج_كائنا(الوثيقة, المداخل);
}

عرف قيمة_عملية(
    الوثيقة: &متغير وثيقة_جسون,
    العملية: &عملية_واجهة
): قيمة_جسون {
    دع المداخل: متغير متجه مدخل_كائن_جسون = [];

    طابق (*العملية).معرف_العملية مع
    | اختياري.موجود(المعرف) -> {
        ألحق(
            المداخل,
            مدخل(«operationId», قيمة_نصية(استنسخ(&المعرف)))
        );
    }
    | اختياري.لا_شيء -> { };
    طابق (*العملية).الملخص مع
    | اختياري.موجود(الملخص) -> {
        ألحق(المداخل, مدخل(«summary», قيمة_نصية(استنسخ(&الملخص))));
    }
    | اختياري.لا_شيء -> { };
    طابق (*العملية).الوصف مع
    | اختياري.موجود(الوصف) -> {
        ألحق(المداخل, مدخل(«description», قيمة_نصية(استنسخ(&الوصف))));
    }
    | اختياري.لا_شيء -> { };

    إذا ((الطول((*العملية).الوسوم) مثل طبيعي) > 0) {
        دع القيم: متغير متجه قيمة_جسون = [];
        دع الموضع: متغير طبيعي = 0;
        طالما (الموضع < (الطول((*العملية).الوسوم) مثل طبيعي)) {
            ألحق(
                القيم,
                قيمة_نصية(استنسخ(&(*العملية).الوسوم[الموضع]))
            );
            الموضع := الموضع + 1;
        }
        ألحق(
            المداخل,
            مدخل(«tags», أدرج_مصفوفة(الوثيقة, القيم))
        );
    };

    إذا ((الطول((*العملية).المعاملات) مثل طبيعي) > 0) {
        دع القيم: متغير متجه قيمة_جسون = [];
        دع الموضع: متغير طبيعي = 0;
        طالما (
            الموضع < (الطول((*العملية).المعاملات) مثل طبيعي)
        ) {
            ألحق(
                القيم,
                قيمة_معامل(
                    الوثيقة,
                    &(*العملية).المعاملات[الموضع]
                )
            );
            الموضع := الموضع + 1;
        }
        ألحق(
            المداخل,
            مدخل(«parameters», أدرج_مصفوفة(الوثيقة, القيم))
        );
    };

    طابق (*العملية).جسم_الطلب مع
    | اختياري.موجود(الجسم) -> {
        ألحق(
            المداخل,
            مدخل(«requestBody», قيمة_جسم_طلب(الوثيقة, &الجسم))
        );
    }
    | اختياري.لا_شيء -> { };

    دع مداخل_الاستجابات: متغير متجه مدخل_كائن_جسون = [];
    دع موضع_الاستجابة: متغير طبيعي = 0;
    طالما (
        موضع_الاستجابة
            < (الطول((*العملية).الاستجابات) مثل طبيعي)
    ) {
        دع الاستجابة: &استجابة_واجهة =
            &(*العملية).الاستجابات[موضع_الاستجابة];
        ألحق(
            مداخل_الاستجابات,
            مدخل(
                استنسخ(&(*الاستجابة).الحالة),
                قيمة_استجابة(الوثيقة, الاستجابة)
            )
        );
        موضع_الاستجابة := موضع_الاستجابة + 1;
    }
    ألحق(
        المداخل,
        مدخل(
            «responses»,
            أدرج_كائنا(الوثيقة, مداخل_الاستجابات)
        )
    );

    إذا ((الطول((*العملية).الأمن) مثل طبيعي) > 0) {
        دع متطلبات: متغير متجه قيمة_جسون = [];
        دع موضع_الأمن: متغير طبيعي = 0;
        طالما (موضع_الأمن < (الطول((*العملية).الأمن) مثل طبيعي)) {
            دع فارغ: متجه قيمة_جسون = [];
            دع قيمة_النطاقات: قيمة_جسون =
                أدرج_مصفوفة(الوثيقة, فارغ);
            دع مداخل_المتطلب: متجه مدخل_كائن_جسون = [
                مدخل(
                    استنسخ(&(*العملية).الأمن[موضع_الأمن]),
                    قيمة_النطاقات
                )
            ];
            ألحق(
                متطلبات,
                أدرج_كائنا(الوثيقة, مداخل_المتطلب)
            );
            موضع_الأمن := موضع_الأمن + 1;
        }
        ألحق(
            المداخل,
            مدخل(«security», أدرج_مصفوفة(الوثيقة, متطلبات))
        );
    };

    إذا ((*العملية).مهجورة) {
        ألحق(
            المداخل,
            مدخل(«deprecated», قيمة_جسون.منطق(صواب))
        );
    };

    أرجع أدرج_كائنا(الوثيقة, المداخل);
}

عرف قيمة_تعريف_مخطط(
    الوثيقة: &متغير وثيقة_جسون,
    التعريف: &تعريف_مخطط_واجهة
): قيمة_جسون {
    دع المداخل: متغير متجه مدخل_كائن_جسون = [
        مدخل(«type», قيمة_نصية(«object»))
    ];
    طابق (*التعريف).الوصف مع
    | اختياري.موجود(الوصف) -> {
        ألحق(المداخل, مدخل(«description», قيمة_نصية(استنسخ(&الوصف))));
    }
    | اختياري.لا_شيء -> { };

    دع مداخل_الخصائص: متغير متجه مدخل_كائن_جسون = [];
    دع المطلوبة: متغير متجه قيمة_جسون = [];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول((*التعريف).الخصائص) مثل طبيعي)) {
        دع الخاصية: &خاصية_مخطط_واجهة =
            &(*التعريف).الخصائص[الموضع];
        ألحق(
            مداخل_الخصائص,
            مدخل(
                استنسخ(&(*الخاصية).الاسم),
                قيمة_مخطط(الوثيقة, &(*الخاصية).المخطط)
            )
        );
        إذا ((*الخاصية).مطلوبة) {
            ألحق(المطلوبة, قيمة_نصية(استنسخ(&(*الخاصية).الاسم)));
        };
        الموضع := الموضع + 1;
    }
    ألحق(
        المداخل,
        مدخل(
            «properties»,
            أدرج_كائنا(الوثيقة, مداخل_الخصائص)
        )
    );
    إذا ((الطول(المطلوبة) مثل طبيعي) > 0) {
        ألحق(
            المداخل,
            مدخل(«required», أدرج_مصفوفة(الوثيقة, المطلوبة))
        );
    };
    أرجع أدرج_كائنا(الوثيقة, المداخل);
}

عرف قيمة_أمن(
    الوثيقة: &متغير وثيقة_جسون,
    الأمن: &مخطط_أمن_واجهة
): قيمة_جسون {
    دع المداخل: متغير متجه مدخل_كائن_جسون = [
        مدخل(«type», قيمة_نصية(«http»)),
        مدخل(«scheme», قيمة_نصية(«bearer»))
    ];
    طابق (*الأمن).الوصف مع
    | اختياري.موجود(الوصف) -> {
        ألحق(المداخل, مدخل(«description», قيمة_نصية(استنسخ(&الوصف))));
    }
    | اختياري.لا_شيء -> { };
    طابق (*الأمن).صيغة_الحامل مع
    | اختياري.موجود(الصيغة) -> {
        ألحق(
            المداخل,
            مدخل(«bearerFormat», قيمة_نصية(استنسخ(&الصيغة)))
        );
    }
    | اختياري.لا_شيء -> { };
    أرجع أدرج_كائنا(الوثيقة, المداخل);
}

عرف قيمة_المكونات(
    الوثيقة: &متغير وثيقة_جسون,
    المصدر: &وثيقة_واجهة
): اختياري قيمة_جسون {
    دع المداخل: متغير متجه مدخل_كائن_جسون = [];

    إذا ((الطول((*المصدر).المخططات) مثل طبيعي) > 0) {
        دع مداخل_المخططات: متغير متجه مدخل_كائن_جسون = [];
        دع الموضع: متغير طبيعي = 0;
        طالما (الموضع < (الطول((*المصدر).المخططات) مثل طبيعي)) {
            دع المخطط: &تعريف_مخطط_واجهة =
                &(*المصدر).المخططات[الموضع];
            ألحق(
                مداخل_المخططات,
                مدخل(
                    استنسخ(&(*المخطط).الاسم),
                    قيمة_تعريف_مخطط(الوثيقة, المخطط)
                )
            );
            الموضع := الموضع + 1;
        }
        ألحق(
            المداخل,
            مدخل(
                «schemas»,
                أدرج_كائنا(الوثيقة, مداخل_المخططات)
            )
        );
    };

    إذا ((الطول((*المصدر).مخططات_الأمن) مثل طبيعي) > 0) {
        دع مداخل_الأمن: متغير متجه مدخل_كائن_جسون = [];
        دع الموضع: متغير طبيعي = 0;
        طالما (
            الموضع < (الطول((*المصدر).مخططات_الأمن) مثل طبيعي)
        ) {
            دع الأمن: &مخطط_أمن_واجهة =
                &(*المصدر).مخططات_الأمن[الموضع];
            ألحق(
                مداخل_الأمن,
                مدخل(استنسخ(&(*الأمن).الاسم), قيمة_أمن(الوثيقة, الأمن))
            );
            الموضع := الموضع + 1;
        }
        ألحق(
            المداخل,
            مدخل(
                «securitySchemes»,
                أدرج_كائنا(الوثيقة, مداخل_الأمن)
            )
        );
    };

    إذا ((الطول(المداخل) مثل طبيعي) == 0) {
        أرجع اختياري.لا_شيء();
    };
    أرجع اختياري.موجود(أدرج_كائنا(الوثيقة, المداخل));
}

عرف سبق_المسار(
    العمليات: &متجه عملية_واجهة,
    الموضع: طبيعي
): منطقي {
    دع العملية: &عملية_واجهة = &(*العمليات)[الموضع];
    دع السابق: متغير طبيعي = 0;
    طالما (السابق < الموضع) {
        إذا (نصان_متساويان(
            &(*العملية).المسار,
            &(*العمليات)[السابق].المسار
        )) {
            أرجع صواب;
        };
        السابق := السابق + 1;
    }
    أرجع خطأ;
}

عرف قيمة_المسارات(
    الوثيقة: &متغير وثيقة_جسون,
    المصدر: &وثيقة_واجهة
): قيمة_جسون {
    دع المداخل: متغير متجه مدخل_كائن_جسون = [];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول((*المصدر).العمليات) مثل طبيعي)) {
        إذا (!سبق_المسار(&(*المصدر).العمليات, الموضع)) {
            دع العملية_الأولى: &عملية_واجهة =
                &(*المصدر).العمليات[الموضع];
            دع مداخل_المسار: متغير متجه مدخل_كائن_جسون = [];
            دع مداخل_الإضافية: متغير متجه مدخل_كائن_جسون = [];
            دع الباحث: متغير طبيعي = الموضع;
            طالما (
                الباحث < (الطول((*المصدر).العمليات) مثل طبيعي)
            ) {
                دع العملية: &عملية_واجهة =
                    &(*المصدر).العمليات[الباحث];
                إذا (نصان_متساويان(
                    &(*العملية_الأولى).المسار,
                    &(*العملية).المسار
                )) {
                    دع القيمة: قيمة_جسون =
                        قيمة_عملية(الوثيقة, العملية);
                    إذا (طريقة_قياسية(&(*العملية).الطريقة)) {
                        دع الطريقة: نص =
                            طريقة_واجهة(&(*العملية).الطريقة);
                        ألحق(
                            مداخل_المسار,
                            مدخل(الطريقة, القيمة)
                        );
                    } وإلا {
                        ألحق(
                            مداخل_الإضافية,
                            مدخل(استنسخ(&(*العملية).الطريقة), القيمة)
                        );
                    };
                };
                الباحث := الباحث + 1;
            }
            إذا ((الطول(مداخل_الإضافية) مثل طبيعي) > 0) {
                ألحق(
                    مداخل_المسار,
                    مدخل(
                        «additionalOperations»,
                        أدرج_كائنا(الوثيقة, مداخل_الإضافية)
                    )
                );
            };
            دع المسار: نص = مسار_واجهة(&(*العملية_الأولى).المسار);
            ألحق(
                المداخل,
                مدخل(
                    المسار,
                    أدرج_كائنا(الوثيقة, مداخل_المسار)
                )
            );
        };
        الموضع := الموضع + 1;
    }
    أرجع أدرج_كائنا(الوثيقة, المداخل);
}

عام عرف وثيقة_جسون_واجهة(
    المصدر: &وثيقة_واجهة
): وثيقة_جسون {
    دع المصفوفات: متجه مصفوفة_جسون = [];
    دع الكائنات: متجه كائن_جسون = [];
    دع الوثيقة: متغير وثيقة_جسون = {
        الجذر: قيمة_جسون.عدم(),
        المصفوفات: المصفوفات,
        الكائنات: الكائنات
    };

    دع مداخل_المعلومات: متغير متجه مدخل_كائن_جسون = [
        مدخل(
            «title»,
            قيمة_نصية(استنسخ(&(*المصدر).المعلومات.العنوان))
        ),
        مدخل(
            «version»,
            قيمة_نصية(استنسخ(&(*المصدر).المعلومات.الإصدار))
        )
    ];
    طابق (*المصدر).المعلومات.الوصف مع
    | اختياري.موجود(الوصف) -> {
        ألحق(
            مداخل_المعلومات,
            مدخل(«description», قيمة_نصية(استنسخ(&الوصف)))
        );
    }
    | اختياري.لا_شيء -> { };
    دع المعلومات: قيمة_جسون =
        أدرج_كائنا(&متغير الوثيقة, مداخل_المعلومات);

    دع الجذر: متغير متجه مدخل_كائن_جسون = [
        مدخل(«openapi», قيمة_نصية(«3.2.0»)),
        مدخل(«info», المعلومات),
        مدخل(«paths», قيمة_المسارات(&متغير الوثيقة, المصدر))
    ];

    طابق قيمة_المكونات(&متغير الوثيقة, المصدر) مع
    | اختياري.موجود(المكونات) -> {
        ألحق(الجذر, مدخل(«components», المكونات));
    }
    | اختياري.لا_شيء -> { };

    الوثيقة.الجذر := أدرج_كائنا(&متغير الوثيقة, الجذر);
    أرجع الوثيقة;
}

عام عرف واجهة_إلى_جسون(
    الوثيقة: &وثيقة_واجهة
): نتيجة نص, صنف_خطأ_جسون {
    دع جسون: وثيقة_جسون = وثيقة_جسون_واجهة(الوثيقة);
    طابق وثيقة_جسون_إلى_نص(&جسون) مع
    | اختياري.موجود(النص) -> { أرجع نتيجة.نجح(النص); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(صنف_خطأ_جسون.يوتيف8_غير_صالح()); };
}

عام مرادف openapi_json_document = وثيقة_جسون_واجهة;
عام مرادف openapi_json = واجهة_إلى_جسون;
