عام نوع موضع_معامل_واجهة =
    | مسار
    | استعلام
    | رأس
;

عام نوع مخطط_واجهة = {
    النوع: نص,
    الصيغة: اختياري نص,
    الوصف: اختياري نص,
    المرجع: اختياري نص,
    عناصر_مرجع: اختياري نص
};

عام نوع خاصية_مخطط_واجهة = {
    الاسم: نص,
    المخطط: مخطط_واجهة,
    مطلوبة: منطقي
};

عام نوع تعريف_مخطط_واجهة = {
    الاسم: نص,
    الوصف: اختياري نص,
    الخصائص: متجه خاصية_مخطط_واجهة
};

عام نوع معامل_واجهة = {
    الاسم: نص,
    الموضع: موضع_معامل_واجهة,
    الوصف: اختياري نص,
    مطلوب: منطقي,
    المخطط: مخطط_واجهة
};

عام نوع جسم_طلب_واجهة = {
    نوع_المحتوى: نص,
    مطلوب: منطقي,
    المخطط: مخطط_واجهة
};

عام نوع استجابة_واجهة = {
    الحالة: نص,
    الوصف: نص,
    نوع_المحتوى: اختياري نص,
    المخطط: اختياري مخطط_واجهة
};

عام نوع عملية_واجهة = {
    الطريقة: نص,
    المسار: نص,
    معرف_العملية: اختياري نص,
    الملخص: اختياري نص,
    الوصف: اختياري نص,
    الوسوم: متجه نص,
    المعاملات: متجه معامل_واجهة,
    جسم_الطلب: اختياري جسم_طلب_واجهة,
    الاستجابات: متجه استجابة_واجهة,
    الأمن: متجه نص,
    مهجورة: منطقي
};

عام نوع مخطط_أمن_واجهة = {
    الاسم: نص,
    الوصف: اختياري نص,
    صيغة_الحامل: اختياري نص
};

عام نوع معلومات_واجهة = {
    العنوان: نص,
    الإصدار: نص,
    الوصف: اختياري نص
};

عام نوع وثيقة_واجهة = {
    المعلومات: معلومات_واجهة,
    العمليات: متجه عملية_واجهة,
    المخططات: متجه تعريف_مخطط_واجهة,
    مخططات_الأمن: متجه مخطط_أمن_واجهة
};

عام عرف مخطط_بسيط(
    النوع: &نص
): مخطط_واجهة {
    ليكن الناتج: مخطط_واجهة = {
        النوع: استنسخ(النوع),
        الصيغة: اختياري.لا_شيء(),
        الوصف: اختياري.لا_شيء(),
        المرجع: اختياري.لا_شيء(),
        عناصر_مرجع: اختياري.لا_شيء()
    };
    أرجع الناتج;
}

عام عرف مخطط_نصي(): مخطط_واجهة {
    ليكن النوع: نص = «string»;
    أرجع مخطط_بسيط(&النوع);
}

عام عرف مخطط_عدد_صحيح(): مخطط_واجهة {
    ليكن النوع: نص = «integer»;
    ليكن الناتج: متغير مخطط_واجهة = مخطط_بسيط(&النوع);
    الناتج.الصيغة := اختياري.موجود(«int64»);
    أرجع الناتج;
}

عام عرف مخطط_رقمي(): مخطط_واجهة {
    ليكن النوع: نص = «number»;
    أرجع مخطط_بسيط(&النوع);
}

عام عرف مخطط_منطقي(): مخطط_واجهة {
    ليكن النوع: نص = «boolean»;
    أرجع مخطط_بسيط(&النوع);
}

عام عرف مخطط_كائن(): مخطط_واجهة {
    ليكن النوع: نص = «object»;
    أرجع مخطط_بسيط(&النوع);
}

عام عرف مخطط_مرجع(الاسم: &نص): مخطط_واجهة {
    ليكن النوع: نص = «»;
    ليكن الناتج: مخطط_واجهة = {
        النوع: النوع,
        الصيغة: اختياري.لا_شيء(),
        الوصف: اختياري.لا_شيء(),
        المرجع: اختياري.موجود(استنسخ(الاسم)),
        عناصر_مرجع: اختياري.لا_شيء()
    };
    أرجع الناتج;
}

عام عرف مخطط_مصفوفة_مرجع(الاسم: &نص): مخطط_واجهة {
    ليكن النوع: نص = «array»;
    ليكن الناتج: مخطط_واجهة = {
        النوع: النوع,
        الصيغة: اختياري.لا_شيء(),
        الوصف: اختياري.لا_شيء(),
        المرجع: اختياري.لا_شيء(),
        عناصر_مرجع: اختياري.موجود(استنسخ(الاسم))
    };
    أرجع الناتج;
}

عام عرف صف_عملية(
    الطريقة: &نص,
    المسار: &نص
): عملية_واجهة {
    ليكن الوسوم: متجه نص = [];
    ليكن المعاملات: متجه معامل_واجهة = [];
    ليكن الاستجابات: متجه استجابة_واجهة = [];
    ليكن الأمن: متجه نص = [];
    ليكن الناتج: عملية_واجهة = {
        الطريقة: استنسخ(الطريقة),
        المسار: استنسخ(المسار),
        معرف_العملية: اختياري.لا_شيء(),
        الملخص: اختياري.لا_شيء(),
        الوصف: اختياري.لا_شيء(),
        الوسوم: الوسوم,
        المعاملات: المعاملات,
        جسم_الطلب: اختياري.لا_شيء(),
        الاستجابات: الاستجابات,
        الأمن: الأمن,
        مهجورة: خطأ
    };
    أرجع الناتج;
}

عام عرف أنشئ_وثيقة(
    العنوان: &نص,
    الإصدار: &نص
): وثيقة_واجهة {
    ليكن المعلومات: معلومات_واجهة = {
        العنوان: استنسخ(العنوان),
        الإصدار: استنسخ(الإصدار),
        الوصف: اختياري.لا_شيء()
    };
    ليكن العمليات: متجه عملية_واجهة = [];
    ليكن المخططات: متجه تعريف_مخطط_واجهة = [];
    ليكن مخططات_الأمن: متجه مخطط_أمن_واجهة = [];
    ليكن الناتج: وثيقة_واجهة = {
        المعلومات: المعلومات,
        العمليات: العمليات,
        المخططات: المخططات,
        مخططات_الأمن: مخططات_الأمن
    };
    أرجع الناتج;
}

عام مرادف parameter_location = موضع_معامل_واجهة;
عام مرادف api_schema = مخطط_واجهة;
عام مرادف api_schema_property = خاصية_مخطط_واجهة;
عام مرادف api_schema_definition = تعريف_مخطط_واجهة;
عام مرادف api_parameter = معامل_واجهة;
عام مرادف api_request_body = جسم_طلب_واجهة;
عام مرادف api_response = استجابة_واجهة;
عام مرادف api_operation = عملية_واجهة;
عام مرادف api_security_scheme = مخطط_أمن_واجهة;
عام مرادف api_info = معلومات_واجهة;
عام مرادف api_document = وثيقة_واجهة;
عام مرادف string_schema = مخطط_نصي;
عام مرادف integer_schema = مخطط_عدد_صحيح;
عام مرادف number_schema = مخطط_رقمي;
عام مرادف boolean_schema = مخطط_منطقي;
عام مرادف object_schema = مخطط_كائن;
عام مرادف schema_ref = مخطط_مرجع;
عام مرادف array_schema_ref = مخطط_مصفوفة_مرجع;
عام مرادف operation = صف_عملية;
عام مرادف new_document = أنشئ_وثيقة;
عام مرادف parameter_location.path = موضع_معامل_واجهة.مسار;
عام مرادف parameter_location.query = موضع_معامل_واجهة.استعلام;
عام مرادف parameter_location.header = موضع_معامل_واجهة.رأس;

عام عرف صف_جلب(المسار: &نص): عملية_واجهة {
    ليكن الطريقة: نص = «GET»;
    أرجع صف_عملية(&الطريقة, المسار);
}

عام عرف صف_إرسال(المسار: &نص): عملية_واجهة {
    ليكن الطريقة: نص = «POST»;
    أرجع صف_عملية(&الطريقة, المسار);
}

عام عرف صف_استبدال(المسار: &نص): عملية_واجهة {
    ليكن الطريقة: نص = «PUT»;
    أرجع صف_عملية(&الطريقة, المسار);
}

عام عرف صف_تعديل(المسار: &نص): عملية_واجهة {
    ليكن الطريقة: نص = «PATCH»;
    أرجع صف_عملية(&الطريقة, المسار);
}

عام عرف صف_حذف(المسار: &نص): عملية_واجهة {
    ليكن الطريقة: نص = «DELETE»;
    أرجع صف_عملية(&الطريقة, المسار);
}

عام عرف معامل_مسار(
    الاسم: &نص,
    المخطط: مخطط_واجهة
): معامل_واجهة {
    ليكن الناتج: معامل_واجهة = {
        الاسم: استنسخ(الاسم),
        الموضع: موضع_معامل_واجهة.مسار(),
        الوصف: اختياري.لا_شيء(),
        مطلوب: صواب,
        المخطط: المخطط
    };
    أرجع الناتج;
}

عام عرف معامل_استعلام(
    الاسم: &نص,
    مطلوب: منطقي,
    المخطط: مخطط_واجهة
): معامل_واجهة {
    ليكن الناتج: معامل_واجهة = {
        الاسم: استنسخ(الاسم),
        الموضع: موضع_معامل_واجهة.استعلام(),
        الوصف: اختياري.لا_شيء(),
        مطلوب: مطلوب,
        المخطط: المخطط
    };
    أرجع الناتج;
}

عام عرف معامل_رأس(
    الاسم: &نص,
    مطلوب: منطقي,
    المخطط: مخطط_واجهة
): معامل_واجهة {
    ليكن الناتج: معامل_واجهة = {
        الاسم: استنسخ(الاسم),
        الموضع: موضع_معامل_واجهة.رأس(),
        الوصف: اختياري.لا_شيء(),
        مطلوب: مطلوب,
        المخطط: المخطط
    };
    أرجع الناتج;
}

عام عرف جسم_طلب(
    نوع_المحتوى: &نص,
    مطلوب: منطقي,
    المخطط: مخطط_واجهة
): جسم_طلب_واجهة {
    ليكن الناتج: جسم_طلب_واجهة = {
        نوع_المحتوى: استنسخ(نوع_المحتوى),
        مطلوب: مطلوب,
        المخطط: المخطط
    };
    أرجع الناتج;
}

عام عرف استجابة_بمحتوى(
    الحالة: &نص,
    الوصف: &نص,
    نوع_المحتوى: &نص,
    المخطط: مخطط_واجهة
): استجابة_واجهة {
    ليكن الناتج: استجابة_واجهة = {
        الحالة: استنسخ(الحالة),
        الوصف: استنسخ(الوصف),
        نوع_المحتوى: اختياري.موجود(استنسخ(نوع_المحتوى)),
        المخطط: اختياري.موجود(المخطط)
    };
    أرجع الناتج;
}

عام عرف استجابة_فقط(
    الحالة: &نص,
    الوصف: &نص
): استجابة_واجهة {
    ليكن الناتج: استجابة_واجهة = {
        الحالة: استنسخ(الحالة),
        الوصف: استنسخ(الوصف),
        نوع_المحتوى: اختياري.لا_شيء(),
        المخطط: اختياري.لا_شيء()
    };
    أرجع الناتج;
}

عام عرف تعريف_مخطط(الاسم: &نص): تعريف_مخطط_واجهة {
    ليكن الخصائص: متجه خاصية_مخطط_واجهة = [];
    ليكن الناتج: تعريف_مخطط_واجهة = {
        الاسم: استنسخ(الاسم),
        الوصف: اختياري.لا_شيء(),
        الخصائص: الخصائص
    };
    أرجع الناتج;
}

عام عرف أمن_حامل(الاسم: &نص): مخطط_أمن_واجهة {
    ليكن الناتج: مخطط_أمن_واجهة = {
        الاسم: استنسخ(الاسم),
        الوصف: اختياري.لا_شيء(),
        صيغة_الحامل: اختياري.لا_شيء()
    };
    أرجع الناتج;
}

عام مرادف get_operation = صف_جلب;
عام مرادف post_operation = صف_إرسال;
عام مرادف put_operation = صف_استبدال;
عام مرادف patch_operation = صف_تعديل;
عام مرادف delete_operation = صف_حذف;
عام مرادف path_parameter = معامل_مسار;
عام مرادف query_parameter = معامل_استعلام;
عام مرادف header_parameter = معامل_رأس;
عام مرادف api_request = جسم_طلب;
عام مرادف content_response = استجابة_بمحتوى;
عام مرادف status_response = استجابة_فقط;
عام مرادف schema_definition = تعريف_مخطط;
عام مرادف bearer_security = أمن_حامل;
