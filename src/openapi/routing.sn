استورد handler.adapter;
استورد routing.router;
استورد routing.composition;
استورد openapi.model;
استورد openapi.document;

عام نوع خطأ_مسار_موثق =
    | توجيه بنوع خطأ_توجيه
    | توثيق بنوع خطأ_توثيق
    | تركيب بنوع خطأ_تركيب
;

عام عرف سجل_موثقا<S>(
    الموجه: &متغير موجه<S>,
    الوثيقة: &متغير وثيقة_واجهة,
    العملية: عملية_واجهة,
    المعالج: معالج<S>
): نتيجة طبيعي, خطأ_مسار_موثق {
    طابق تحقق_عملية(الوثيقة, &العملية) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_مسار_موثق.توثيق(الخطأ));
    }
    | نتيجة.نجح(_) -> { };

    ليكن موضع_المسار: متغير طبيعي = 0;
    طابق سجل_مسارا(
        الموجه,
        &العملية.الطريقة,
        &العملية.المسار,
        المعالج
    ) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_مسار_موثق.توجيه(الخطأ));
    }
    | نتيجة.نجح(الموضع) -> {
        موضع_المسار := الموضع;
    };

    طابق سجل_عملية(الوثيقة, العملية) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(خطأ_مسار_موثق.توثيق(الخطأ));
    }
    | نتيجة.نجح(_) -> { };

    أرجع نتيجة.نجح(موضع_المسار);
}

// Nests الفرعي under البادئة (as `اربط`) and adds its documented operations,
// schemas and security schemes to الوثيقة with the same prefix, so the
// published paths match the served ones. Nothing changes on failure.
عام عرف اربط_موثقا<S>(
    الموجه: &متغير موجه<S>,
    الوثيقة: &متغير وثيقة_واجهة,
    البادئة: &نص,
    الفرعي: &موجه<S>,
    وثيقة_الفرعي: &وثيقة_واجهة
): نتيجة طبيعي, خطأ_مسار_موثق {
    ليكن الجديدة: متغير وثيقة_واجهة = استنسخ(الوثيقة);
    ليكن ف: متغير طبيعي = 0;
    طالما (ف < (الطول((*وثيقة_الفرعي).العمليات) مثل طبيعي)) {
        ليكن العملية: متغير عملية_واجهة = استنسخ(&(*وثيقة_الفرعي).العمليات[ف]);
        طابق نمط_ببادئة(البادئة, &العملية.المسار) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسار_موثق.تركيب(الخطأ)); }
        | نتيجة.نجح(المسار) -> { العملية.المسار := المسار; };
        طابق سجل_عملية(&متغير الجديدة, العملية) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسار_موثق.توثيق(الخطأ)); }
        | نتيجة.نجح(_) -> { };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*وثيقة_الفرعي).المخططات) مثل طبيعي)) {
        طابق سجل_مخططا(&متغير الجديدة, استنسخ(&(*وثيقة_الفرعي).المخططات[ف])) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسار_موثق.توثيق(الخطأ)); }
        | نتيجة.نجح(_) -> { };
        ف := ف + 1;
    }
    ف := 0;
    طالما (ف < (الطول((*وثيقة_الفرعي).مخططات_الأمن) مثل طبيعي)) {
        طابق سجل_أمنا(&متغير الجديدة, استنسخ(&(*وثيقة_الفرعي).مخططات_الأمن[ف])) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسار_موثق.توثيق(الخطأ)); }
        | نتيجة.نجح(_) -> { };
        ف := ف + 1;
    }
    طابق اربط(الموجه, البادئة, الفرعي) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(خطأ_مسار_موثق.تركيب(الخطأ)); }
    | نتيجة.نجح(العدد) -> {
        *الوثيقة := الجديدة;
        أرجع نتيجة.نجح(العدد);
    };
}

عام مرادف documented_route_error = خطأ_مسار_موثق;
عام مرادف nest_documented = اربط_موثقا;
عام مرادف documented_route_error.composition = خطأ_مسار_موثق.تركيب;
عام مرادف documented_route = سجل_موثقا;
عام مرادف documented_route_error.routing = خطأ_مسار_موثق.توجيه;
عام مرادف documented_route_error.documentation = خطأ_مسار_موثق.توثيق;
