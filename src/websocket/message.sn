استورد std.encoding.utf8;
استورد websocket.frame;

عام نوع نوع_رسالة =
    | نص
    | ثنائي
    | إغلاق
    | نبض
    | رد_نبض
;

عام نوع رسالة = {
    النوع: نوع_رسالة,
    الحمولة: متجه ط8
};

// Reassembles fragmented data messages. الحد_الأقصى bounds the assembled
// payload in bytes (0 means no bound).
عام نوع مجمع_رسالة = {
    نشط: منطقي,
    نصي: منطقي,
    الحمولة: متجه ط8,
    الحد_الأقصى: طبيعي
};

عام نوع خطأ_رسالة =
    | استمرار_بلا_بداية
    | رسالة_جديدة_أثناء_التجزئة
    | يوتيف8_غير_صالح
    | رسالة_كبيرة
    | رمز_إغلاق_غير_صالح
;

// The default bound of an assembled message: 64 MiB.
عام عرف حد_الرسالة_الافتراضي(): طبيعي {
    أرجع 67108864;
}

عام عرف أنشئ_مجمع_رسالة_بحد(الحد_الأقصى: طبيعي): مجمع_رسالة {
    دع الحمولة: متجه ط8 = [];
    دع الناتج: مجمع_رسالة = {
        نشط: خطأ,
        نصي: خطأ,
        الحمولة: الحمولة,
        الحد_الأقصى: الحد_الأقصى
    };
    أرجع الناتج;
}

عام عرف أنشئ_مجمع_رسالة(): مجمع_رسالة {
    أرجع أنشئ_مجمع_رسالة_بحد(حد_الرسالة_الافتراضي());
}

عرف يتجاوز_الحد(المجمع: &مجمع_رسالة, الإضافي: طبيعي): منطقي {
    إذا ((*المجمع).الحد_الأقصى == 0) { أرجع خطأ; };
    دع الحالي: طبيعي = الطول((*المجمع).الحمولة) مثل طبيعي;
    أرجع الحالي + الإضافي > (*المجمع).الحد_الأقصى;
}

// Close status codes a peer may send (RFC 6455 §7.4.1, §7.4.2 and the IANA
// registry): 1000-1003, 1007-1014 and the application range 3000-4999.
// 1004-1006 and 1015 must never appear on the wire.
عام عرف رمز_إغلاق_مقبول(الرمز: طبيعي): منطقي {
    إذا (الرمز >= 1000 && الرمز <= 1003) { أرجع صواب; };
    إذا (الرمز >= 1007 && الرمز <= 1014) { أرجع صواب; };
    أرجع الرمز >= 3000 && الرمز <= 4999;
}

// A close payload is empty, or a 2-byte status code followed by a UTF-8
// reason (RFC 6455 §5.5.1). One byte is a protocol error.
عرف تحقق_حمولة_إغلاق(الحمولة: &متجه ط8): نتيجة منطقي, خطأ_رسالة {
    دع العدد: طبيعي = الطول(*الحمولة) مثل طبيعي;
    إذا (العدد == 0) { أرجع نتيجة.نجح(صواب); };
    إذا (العدد == 1) { أرجع نتيجة.خطأ(خطأ_رسالة.رمز_إغلاق_غير_صالح()); };
    دع الرمز: طبيعي =
        (((*الحمولة)[0] مثل طبيعي) * 256) + ((*الحمولة)[1] مثل طبيعي);
    إذا (!رمز_إغلاق_مقبول(الرمز)) {
        أرجع نتيجة.خطأ(خطأ_رسالة.رمز_إغلاق_غير_صالح());
    };
    دع السبب: متغير متجه ط8 = [];
    دع ف: متغير طبيعي = 2;
    طالما (ف < العدد) {
        ألحق(السبب, (*الحمولة)[ف]);
        ف := ف + 1;
    }
    إذا (!حمولة_نصية_صالحة(&السبب)) {
        أرجع نتيجة.خطأ(خطأ_رسالة.يوتيف8_غير_صالح());
    };
    أرجع نتيجة.نجح(صواب);
}

// The close code to send when a message fails (RFC 6455 §7.4.1): 1007 for
// invalid UTF-8, 1009 for a message over the bound, 1002 otherwise.
عام عرف رمز_إغلاق_لخطأ(الخطأ: &خطأ_رسالة): طبيعي {
    طابق *الخطأ مع
    | خطأ_رسالة.يوتيف8_غير_صالح -> { أرجع 1007; }
    | خطأ_رسالة.رسالة_كبيرة -> { أرجع 1009; }
    | _ -> { أرجع 1002; };
}

عرف انسخ_حمولة(
    المصدر: &متجه ط8
): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الناتج, (*المصدر)[الموضع]);
        الموضع := الموضع + 1;
    }
    أرجع الناتج;
}

عرف ألحق_حمولة(
    الناتج: &متغير متجه ط8,
    المصدر: &متجه ط8
): فراغ {
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(*الناتج, (*المصدر)[الموضع]);
        الموضع := الموضع + 1;
    }
}

عرف حمولة_نصية_صالحة(الحمولة: &متجه ط8): منطقي {
    دع الموضع: متغير طبيعي = 0;
    دع العدد: طبيعي = الطول(*الحمولة) مثل طبيعي;
    طالما (الموضع < العدد) {
        دع المفكوك: فك_يوتيف8 =
            فك_محرف_يوتيف8_من_بايتات(الحمولة, الموضع);
        إذا (!المفكوك.صالح || (المفكوك.العرض == 0)) {
            أرجع خطأ;
        };
        الموضع := الموضع + المفكوك.العرض;
    }
    أرجع صواب;
}

عرف رسالة_بيانات(
    نصية: منطقي,
    الحمولة: متجه ط8
): نتيجة رسالة, خطأ_رسالة {
    إذا (نصية && !حمولة_نصية_صالحة(&الحمولة)) {
        أرجع نتيجة.خطأ(خطأ_رسالة.يوتيف8_غير_صالح());
    };
    دع النوع: متغير نوع_رسالة = نوع_رسالة.ثنائي();
    إذا (نصية) { النوع := نوع_رسالة.نص(); };
    دع الرسالة: رسالة = {
        النوع: النوع,
        الحمولة: الحمولة
    };
    أرجع نتيجة.نجح(الرسالة);
}

عام عرف ادفع_إطارا(
    المجمع: &متغير مجمع_رسالة,
    الإطار: &إطار
): نتيجة اختياري رسالة, خطأ_رسالة {
    طابق (*الإطار).النوع مع
    | نوع_إطار.نبض -> {
        دع الرسالة: رسالة = {
            النوع: نوع_رسالة.نبض(),
            الحمولة: انسخ_حمولة(&(*الإطار).الحمولة)
        };
        أرجع نتيجة.نجح(اختياري.موجود(الرسالة));
    }
    | نوع_إطار.رد_نبض -> {
        دع الرسالة: رسالة = {
            النوع: نوع_رسالة.رد_نبض(),
            الحمولة: انسخ_حمولة(&(*الإطار).الحمولة)
        };
        أرجع نتيجة.نجح(اختياري.موجود(الرسالة));
    }
    | نوع_إطار.إغلاق -> {
        طابق تحقق_حمولة_إغلاق(&(*الإطار).الحمولة) مع
        | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
        | نتيجة.نجح(_) -> { };
        دع الرسالة: رسالة = {
            النوع: نوع_رسالة.إغلاق(),
            الحمولة: انسخ_حمولة(&(*الإطار).الحمولة)
        };
        أرجع نتيجة.نجح(اختياري.موجود(الرسالة));
    }
    | نوع_إطار.نص -> {
        إذا ((*المجمع).نشط) {
            أرجع نتيجة.خطأ(
                خطأ_رسالة.رسالة_جديدة_أثناء_التجزئة()
            );
        };
        إذا ((*الإطار).نهائي) {
            طابق رسالة_بيانات(
                صواب,
                انسخ_حمولة(&(*الإطار).الحمولة)
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة.خطأ(الخطأ);
            }
            | نتيجة.نجح(الرسالة) -> {
                أرجع نتيجة.نجح(اختياري.موجود(الرسالة));
            };
        };
        إذا (يتجاوز_الحد(المجمع, الطول((*الإطار).الحمولة) مثل طبيعي)) {
            أرجع نتيجة.خطأ(خطأ_رسالة.رسالة_كبيرة());
        };
        (*المجمع).نشط := صواب;
        (*المجمع).نصي := صواب;
        (*المجمع).الحمولة := انسخ_حمولة(&(*الإطار).الحمولة);
        أرجع نتيجة.نجح(اختياري.لا_شيء());
    }
    | نوع_إطار.ثنائي -> {
        إذا ((*المجمع).نشط) {
            أرجع نتيجة.خطأ(
                خطأ_رسالة.رسالة_جديدة_أثناء_التجزئة()
            );
        };
        إذا ((*الإطار).نهائي) {
            طابق رسالة_بيانات(
                خطأ,
                انسخ_حمولة(&(*الإطار).الحمولة)
            ) مع
            | نتيجة.خطأ(الخطأ) -> {
                أرجع نتيجة.خطأ(الخطأ);
            }
            | نتيجة.نجح(الرسالة) -> {
                أرجع نتيجة.نجح(اختياري.موجود(الرسالة));
            };
        };
        إذا (يتجاوز_الحد(المجمع, الطول((*الإطار).الحمولة) مثل طبيعي)) {
            أرجع نتيجة.خطأ(خطأ_رسالة.رسالة_كبيرة());
        };
        (*المجمع).نشط := صواب;
        (*المجمع).نصي := خطأ;
        (*المجمع).الحمولة := انسخ_حمولة(&(*الإطار).الحمولة);
        أرجع نتيجة.نجح(اختياري.لا_شيء());
    }
    | نوع_إطار.استمرار -> {
        إذا (!(*المجمع).نشط) {
            أرجع نتيجة.خطأ(خطأ_رسالة.استمرار_بلا_بداية());
        };
        إذا (يتجاوز_الحد(المجمع, الطول((*الإطار).الحمولة) مثل طبيعي)) {
            أرجع نتيجة.خطأ(خطأ_رسالة.رسالة_كبيرة());
        };
        ألحق_حمولة(
            &متغير (*المجمع).الحمولة,
            &(*الإطار).الحمولة
        );
        إذا (!(*الإطار).نهائي) {
            أرجع نتيجة.نجح(اختياري.لا_شيء());
        };
        دع نصية: منطقي = (*المجمع).نصي;
        دع الحمولة: متجه ط8 = انسخ_حمولة(&(*المجمع).الحمولة);
        (*المجمع).نشط := خطأ;
        (*المجمع).نصي := خطأ;
        دع فارغة: متجه ط8 = [];
        (*المجمع).الحمولة := فارغة;
        طابق رسالة_بيانات(نصية, الحمولة) مع
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(الخطأ);
        }
        | نتيجة.نجح(الرسالة) -> {
            أرجع نتيجة.نجح(اختياري.موجود(الرسالة));
        };
    };
}

عام مرادف websocket_message_kind = نوع_رسالة;
عام مرادف websocket_message = رسالة;
عام مرادف websocket_message_assembler = مجمع_رسالة;
عام مرادف websocket_message_error = خطأ_رسالة;
عام مرادف new_websocket_message_assembler = أنشئ_مجمع_رسالة;
عام مرادف push_websocket_frame = ادفع_إطارا;
عام مرادف new_websocket_message_assembler_with_limit = أنشئ_مجمع_رسالة_بحد;
عام مرادف default_websocket_message_limit = حد_الرسالة_الافتراضي;
عام مرادف websocket_close_code_allowed = رمز_إغلاق_مقبول;
عام مرادف websocket_close_code_for_error = رمز_إغلاق_لخطأ;
عام مرادف websocket_message_kind.text = نوع_رسالة.نص;
عام مرادف websocket_message_kind.binary = نوع_رسالة.ثنائي;
عام مرادف websocket_message_kind.close = نوع_رسالة.إغلاق;
عام مرادف websocket_message_kind.ping = نوع_رسالة.نبض;
عام مرادف websocket_message_kind.pong = نوع_رسالة.رد_نبض;
عام مرادف websocket_message_error.continuation_without_start =
    خطأ_رسالة.استمرار_بلا_بداية;
عام مرادف websocket_message_error.new_message_during_fragmentation =
    خطأ_رسالة.رسالة_جديدة_أثناء_التجزئة;
عام مرادف websocket_message_error.invalid_utf8 =
    خطأ_رسالة.يوتيف8_غير_صالح;
عام مرادف websocket_message_error.message_too_large =
    خطأ_رسالة.رسالة_كبيرة;
عام مرادف websocket_message_error.invalid_close_code =
    خطأ_رسالة.رمز_إغلاق_غير_صالح;
