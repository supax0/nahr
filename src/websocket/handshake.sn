من std.http استورد
    إصدار_ويب,
    طلب_ويب,
    استجابة_ويب,
    رأس_ويب,
    أول_قيمة_رأس_ويب,
    قيم_رأس_ويب,
    ضع_رأس_ويب,
    اسما_رأس_ويب_متساويان,
    استجابة_نص_ويب;

استورد std.encoding.base64;
استورد std.text.compare;
استورد std.text.transform;

عام نوع خطأ_مصافحة_مقبس_ويب =
    | طريقة_غير_صالحة
    | ترقية_مفقودة
    | اتصال_ترقية_مفقود
    | مضيف_مفقود
    | مفتاح_مفقود
    | مفتاح_غير_صالح
    | إصدار_طلب_غير_صالح
    | إصدار_غير_مدعوم
;

عرف حصر32(القيمة: طبيعي): طبيعي {
    أرجع القيمة & 0xFFFFFFFF;
}

عرف دور_يسارا32(
    القيمة: طبيعي,
    العدد: طبيعي
): طبيعي {
    دع اليسار: طبيعي = حصر32(القيمة << العدد);
    دع اليمين: طبيعي = القيمة >> (32 - العدد);
    أرجع حصر32(اليسار | اليمين);
}

عرف ألحق_طول64_كبير(
    الناتج: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    دع التحولات: متجه طبيعي = [56, 48, 40, 32, 24, 16, 8, 0];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < 8) {
        دع التحول: طبيعي = التحولات[الموضع];
        دع البايت: ط8 = ((القيمة >> التحول) & 0xFF) مثل ط8;
        ألحق((*الناتج), البايت);
        الموضع := الموضع + 1;
    }
}

عرف اقرأ_كلمة32_كبيرة(
    المصدر: &متجه ط8,
    البداية: طبيعي
): طبيعي {
    دع موضع1: طبيعي = البداية + 1;
    دع موضع2: طبيعي = البداية + 2;
    دع موضع3: طبيعي = البداية + 3;
    دع القيمة0: طبيعي = ((*المصدر)[البداية] مثل طبيعي) << 24;
    دع القيمة1: طبيعي = ((*المصدر)[موضع1] مثل طبيعي) << 16;
    دع القيمة2: طبيعي = ((*المصدر)[موضع2] مثل طبيعي) << 8;
    دع القيمة3: طبيعي = (*المصدر)[موضع3] مثل طبيعي;
    أرجع حصر32(القيمة0 | القيمة1 | القيمة2 | القيمة3);
}

عرف بصمة_شا1(المصدر: &متجه ط8): متجه ط8 {
    دع الرسالة: متغير متجه ط8 = [];
    دع موضع_نسخ: متغير طبيعي = 0;
    طالما (موضع_نسخ < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(الرسالة, (*المصدر)[موضع_نسخ]);
        موضع_نسخ := موضع_نسخ + 1;
    }

    دع طول_البتات: طبيعي =
        (الطول(*المصدر) مثل طبيعي) * 8;
    ألحق(الرسالة, 0x80);
    طالما (((الطول(الرسالة) مثل طبيعي) % 64) != 56) {
        ألحق(الرسالة, 0);
    }
    ألحق_طول64_كبير(&متغير الرسالة, طول_البتات);

    دع حالة0: متغير طبيعي = 0x67452301;
    دع حالة1: متغير طبيعي = 0xEFCDAB89;
    دع حالة2: متغير طبيعي = 0x98BADCFE;
    دع حالة3: متغير طبيعي = 0x10325476;
    دع حالة4: متغير طبيعي = 0xC3D2E1F0;

    دع بداية_الكتلة: متغير طبيعي = 0;
    طالما (بداية_الكتلة < (الطول(الرسالة) مثل طبيعي)) {
        دع الكلمات: متغير متجه طبيعي = [];
        دع فهرس_الكلمة: متغير طبيعي = 0;
        طالما (فهرس_الكلمة < 16) {
            دع موضع_الكلمة: طبيعي =
                بداية_الكتلة + (فهرس_الكلمة * 4);
            ألحق(
                الكلمات,
                اقرأ_كلمة32_كبيرة(&الرسالة, موضع_الكلمة)
            );
            فهرس_الكلمة := فهرس_الكلمة + 1;
        }
        طالما (فهرس_الكلمة < 80) {
            دع موضع3: طبيعي = فهرس_الكلمة - 3;
            دع موضع8: طبيعي = فهرس_الكلمة - 8;
            دع موضع14: طبيعي = فهرس_الكلمة - 14;
            دع موضع16: طبيعي = فهرس_الكلمة - 16;
            دع المختلط: طبيعي =
                الكلمات[موضع3]
                ^ الكلمات[موضع8]
                ^ الكلمات[موضع14]
                ^ الكلمات[موضع16];
            ألحق(الكلمات, دور_يسارا32(المختلط, 1));
            فهرس_الكلمة := فهرس_الكلمة + 1;
        }

        دع السجل0: متغير طبيعي = حالة0;
        دع السجل1: متغير طبيعي = حالة1;
        دع السجل2: متغير طبيعي = حالة2;
        دع السجل3: متغير طبيعي = حالة3;
        دع السجل4: متغير طبيعي = حالة4;
        دع الجولة: متغير طبيعي = 0;
        طالما (الجولة < 80) {
            دع دالة_الجولة: متغير طبيعي = 0;
            دع ثابت_الجولة: متغير طبيعي = 0;
            إذا (الجولة < 20) {
                دالة_الجولة :=
                    (السجل1 & السجل2) | ((~السجل1) & السجل3);
                ثابت_الجولة := 0x5A827999;
            } وإلا إذا (الجولة < 40) {
                دالة_الجولة := السجل1 ^ السجل2 ^ السجل3;
                ثابت_الجولة := 0x6ED9EBA1;
            } وإلا إذا (الجولة < 60) {
                دالة_الجولة :=
                    (السجل1 & السجل2)
                    | (السجل1 & السجل3)
                    | (السجل2 & السجل3);
                ثابت_الجولة := 0x8F1BBCDC;
            } وإلا {
                دالة_الجولة := السجل1 ^ السجل2 ^ السجل3;
                ثابت_الجولة := 0xCA62C1D6;
            };

            دع المؤقت: طبيعي = حصر32(
                دور_يسارا32(السجل0, 5)
                + دالة_الجولة
                + السجل4
                + ثابت_الجولة
                + الكلمات[الجولة]
            );
            السجل4 := السجل3;
            السجل3 := السجل2;
            السجل2 := دور_يسارا32(السجل1, 30);
            السجل1 := السجل0;
            السجل0 := المؤقت;
            الجولة := الجولة + 1;
        }

        حالة0 := حصر32(حالة0 + السجل0);
        حالة1 := حصر32(حالة1 + السجل1);
        حالة2 := حصر32(حالة2 + السجل2);
        حالة3 := حصر32(حالة3 + السجل3);
        حالة4 := حصر32(حالة4 + السجل4);
        بداية_الكتلة := بداية_الكتلة + 64;
    }

    دع الناتج: متغير متجه ط8 = [];
    دع القيم: متجه طبيعي = [حالة0, حالة1, حالة2, حالة3, حالة4];
    دع فهرس_القيمة: متغير طبيعي = 0;
    طالما (فهرس_القيمة < 5) {
        دع القيمة: طبيعي = القيم[فهرس_القيمة];
        ألحق(الناتج, ((القيمة >> 24) & 0xFF) مثل ط8);
        ألحق(الناتج, ((القيمة >> 16) & 0xFF) مثل ط8);
        ألحق(الناتج, ((القيمة >> 8) & 0xFF) مثل ط8);
        ألحق(الناتج, (القيمة & 0xFF) مثل ط8);
        فهرس_القيمة := فهرس_القيمة + 1;
    }
    أرجع الناتج;
}

عرف بايتات_من_نص(القيمة: &نص): متجه ط8 {
    دع الناتج: متغير متجه ط8 = [];
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(*القيمة) مثل طبيعي)) {
        ألحق(الناتج, (*القيمة)[الموضع]);
        الموضع := الموضع + 1;
    }
    أرجع الناتج;
}

عرف يحتوي_رمز_رأس(
    الطلب: &طلب_ويب<متجه ط8>,
    الاسم: &نص,
    الرمز: &نص
): منطقي {
    دع القيم: متجه نص = قيم_رأس_ويب(&(*الطلب).الرؤوس, الاسم);
    دع فاصل: نص = «,»;
    دع موضع_القيمة: متغير طبيعي = 0;
    طالما (موضع_القيمة < (الطول(القيم) مثل طبيعي)) {
        دع الأجزاء: متجه نص = قسم_النص(&القيم[موضع_القيمة], &فاصل);
        دع موضع_الجزء: متغير طبيعي = 0;
        طالما (موضع_الجزء < (الطول(الأجزاء) مثل طبيعي)) {
            دع الجزء: نص = قص_النص(&الأجزاء[موضع_الجزء]);
            إذا (اسما_رأس_ويب_متساويان(&الجزء, الرمز)) {
                أرجع صواب;
            };
            موضع_الجزء := موضع_الجزء + 1;
        }
        موضع_القيمة := موضع_القيمة + 1;
    }
    أرجع خطأ;
}

عام عرف تحقق_مصافحة_مقبس_ويب(
    الطلب: &طلب_ويب<متجه ط8>
): نتيجة نص, خطأ_مصافحة_مقبس_ويب {
    دع طريقة_جلب: نص = «GET»;
    إذا (!نصان_متساويان(&(*الطلب).الطريقة, &طريقة_جلب)) {
        أرجع نتيجة.خطأ(خطأ_مصافحة_مقبس_ويب.طريقة_غير_صالحة());
    };

    طابق (*الطلب).الإصدار مع
    | إصدار_ويب.واحد_واحد -> { }
    | _ -> {
        أرجع نتيجة.خطأ(
            خطأ_مصافحة_مقبس_ويب.إصدار_طلب_غير_صالح()
        );
    };

    دع اسم_المضيف: نص = «host»;
    طابق أول_قيمة_رأس_ويب(&(*الطلب).الرؤوس, &اسم_المضيف) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_مصافحة_مقبس_ويب.مضيف_مفقود());
    }
    | اختياري.موجود(القيمة) -> {
        دع المقصوص: نص = قص_النص(&القيمة);
        إذا ((الطول(المقصوص) مثل طبيعي) == 0) {
            أرجع نتيجة.خطأ(
                خطأ_مصافحة_مقبس_ويب.مضيف_مفقود()
            );
        };
    };

    دع اسم_الترقية: نص = «upgrade»;
    دع قيمة_مقبس_ويب: نص = «websocket»;
    إذا (!يحتوي_رمز_رأس(الطلب, &اسم_الترقية, &قيمة_مقبس_ويب)) {
        أرجع نتيجة.خطأ(خطأ_مصافحة_مقبس_ويب.ترقية_مفقودة());
    };

    دع اسم_الاتصال: نص = «connection»;
    دع قيمة_الترقية: نص = «upgrade»;
    إذا (!يحتوي_رمز_رأس(الطلب, &اسم_الاتصال, &قيمة_الترقية)) {
        أرجع نتيجة.خطأ(
            خطأ_مصافحة_مقبس_ويب.اتصال_ترقية_مفقود()
        );
    };

    دع اسم_المفتاح: نص = «sec-websocket-key»;
    دع قيم_المفتاح: متجه نص =
        قيم_رأس_ويب(&(*الطلب).الرؤوس, &اسم_المفتاح);
    إذا ((الطول(قيم_المفتاح) مثل طبيعي) == 0) {
        أرجع نتيجة.خطأ(خطأ_مصافحة_مقبس_ويب.مفتاح_مفقود());
    };
    إذا ((الطول(قيم_المفتاح) مثل طبيعي) != 1) {
        أرجع نتيجة.خطأ(خطأ_مصافحة_مقبس_ويب.مفتاح_غير_صالح());
    };
    دع المفتاح: نص = قص_النص(&قيم_المفتاح[0]);

    طابق فك_قاعدة64(&المفتاح) مع
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(خطأ_مصافحة_مقبس_ويب.مفتاح_غير_صالح());
    }
    | نتيجة.نجح(المفكوك) -> {
        إذا ((الطول(المفكوك) مثل طبيعي) != 16) {
            أرجع نتيجة.خطأ(
                خطأ_مصافحة_مقبس_ويب.مفتاح_غير_صالح()
            );
        };
    };

    دع اسم_الإصدار: نص = «sec-websocket-version»;
    دع قيم_الإصدار: متجه نص =
        قيم_رأس_ويب(&(*الطلب).الرؤوس, &اسم_الإصدار);
    إذا ((الطول(قيم_الإصدار) مثل طبيعي) != 1) {
        أرجع نتيجة.خطأ(
            خطأ_مصافحة_مقبس_ويب.إصدار_غير_مدعوم()
        );
    };
    دع إصدار13: نص = «13»;
    دع الإصدار: نص = قص_النص(&قيم_الإصدار[0]);
    إذا (!نصان_متساويان(&الإصدار, &إصدار13)) {
        أرجع نتيجة.خطأ(
            خطأ_مصافحة_مقبس_ويب.إصدار_غير_مدعوم()
        );
    };

    أرجع نتيجة.نجح(المفتاح);
}

عام عرف مفتاح_قبول_مقبس_ويب(المفتاح: &نص): نص {
    دع الملحق: نص = «258EAFA5-E914-47DA-95CA-C5AB0DC85B11»;
    دع المصدر: متغير متجه ط8 = بايتات_من_نص(المفتاح);
    دع بايتات_الملحق: متجه ط8 = بايتات_من_نص(&الملحق);
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(بايتات_الملحق) مثل طبيعي)) {
        ألحق(المصدر, بايتات_الملحق[الموضع]);
        الموضع := الموضع + 1;
    }
    دع البصمة: متجه ط8 = بصمة_شا1(&المصدر);
    أرجع رمز_قاعدة64(&البصمة);
}

عام عرف رد_مصافحة_مقبس_ويب(
    المفتاح: &نص
): استجابة_ويب<متجه ط8> {
    دع الرؤوس: متغير متجه رأس_ويب = [];
    دع الرؤوس_اللاحقة: متجه رأس_ويب = [];
    دع الجسم: متجه ط8 = [];
    دع الاستجابة: متغير استجابة_ويب<متجه ط8> = {
        الإصدار: إصدار_ويب.واحد_واحد(),
        الحالة: 101,
        الرؤوس: الرؤوس,
        الرؤوس_اللاحقة: الرؤوس_اللاحقة,
        الجسم: الجسم
    };

    دع اسم_الترقية: نص = «upgrade»;
    دع قيمة_مقبس_ويب: نص = «websocket»;
    دع تجاهل_ترقية: منطقي = ضع_رأس_ويب(
        &متغير الاستجابة.الرؤوس,
        &اسم_الترقية,
        &قيمة_مقبس_ويب
    );

    دع اسم_الاتصال: نص = «connection»;
    دع قيمة_الترقية: نص = «Upgrade»;
    دع تجاهل_اتصال: منطقي = ضع_رأس_ويب(
        &متغير الاستجابة.الرؤوس,
        &اسم_الاتصال,
        &قيمة_الترقية
    );

    دع اسم_القبول: نص = «sec-websocket-accept»;
    دع القبول: نص = مفتاح_قبول_مقبس_ويب(المفتاح);
    دع تجاهل_قبول: منطقي = ضع_رأس_ويب(
        &متغير الاستجابة.الرؤوس,
        &اسم_القبول,
        &القبول
    );

    أرجع الاستجابة;
}

عام مرادف websocket_handshake_error = خطأ_مصافحة_مقبس_ويب;
عام مرادف validate_websocket_handshake = تحقق_مصافحة_مقبس_ويب;
عام مرادف websocket_accept_key = مفتاح_قبول_مقبس_ويب;
عام مرادف websocket_handshake_response = رد_مصافحة_مقبس_ويب;
عام مرادف websocket_handshake_error.invalid_method =
    خطأ_مصافحة_مقبس_ويب.طريقة_غير_صالحة;
عام مرادف websocket_handshake_error.missing_upgrade =
    خطأ_مصافحة_مقبس_ويب.ترقية_مفقودة;
عام مرادف websocket_handshake_error.missing_connection_upgrade =
    خطأ_مصافحة_مقبس_ويب.اتصال_ترقية_مفقود;
عام مرادف websocket_handshake_error.missing_host =
    خطأ_مصافحة_مقبس_ويب.مضيف_مفقود;
عام مرادف websocket_handshake_error.missing_key =
    خطأ_مصافحة_مقبس_ويب.مفتاح_مفقود;
عام مرادف websocket_handshake_error.invalid_key =
    خطأ_مصافحة_مقبس_ويب.مفتاح_غير_صالح;
عام مرادف websocket_handshake_error.invalid_http_version =
    خطأ_مصافحة_مقبس_ويب.إصدار_طلب_غير_صالح;
عام مرادف websocket_handshake_error.unsupported_version =
    خطأ_مصافحة_مقبس_ويب.إصدار_غير_مدعوم;

// The response to a rejected upgrade. An unsupported Sec-WebSocket-Version is
// 426 Upgrade Required with `Sec-WebSocket-Version: 13` (RFC 6455 §4.2.2,
// §4.4); a request that isn't GET is 405; every other failure is 400.
عام عرف رد_رفض_مصافحة_مقبس_ويب(
    الخطأ: &خطأ_مصافحة_مقبس_ويب
): استجابة_ويب<متجه ط8> {
    طابق *الخطأ مع
    | خطأ_مصافحة_مقبس_ويب.إصدار_غير_مدعوم -> {
        دع النص: نص = «Upgrade Required»;
        دع الاستجابة: متغير استجابة_ويب<متجه ط8> = استجابة_نص_ويب(426, &النص);
        دع الاسم: نص = «sec-websocket-version»;
        دع القيمة: نص = «13»;
        دع تجاهل: منطقي = ضع_رأس_ويب(&متغير الاستجابة.الرؤوس, &الاسم, &القيمة);
        أرجع الاستجابة;
    }
    | خطأ_مصافحة_مقبس_ويب.طريقة_غير_صالحة -> {
        دع النص: نص = «Method Not Allowed»;
        دع الاستجابة: متغير استجابة_ويب<متجه ط8> = استجابة_نص_ويب(405, &النص);
        دع الاسم: نص = «allow»;
        دع القيمة: نص = «GET»;
        دع تجاهل: منطقي = ضع_رأس_ويب(&متغير الاستجابة.الرؤوس, &الاسم, &القيمة);
        أرجع الاستجابة;
    }
    | _ -> {
        دع النص: نص = «Bad WebSocket handshake»;
        أرجع استجابة_نص_ويب(400, &النص);
    };
}

عام مرادف websocket_handshake_rejection = رد_رفض_مصافحة_مقبس_ويب;
