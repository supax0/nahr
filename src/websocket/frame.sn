عام نوع نوع_إطار =
    | استمرار
    | نص
    | ثنائي
    | إغلاق
    | نبض
    | رد_نبض
;

عام نوع إطار = {
    نهائي: منطقي,
    النوع: نوع_إطار,
    الحمولة: متجه ط8
};

عام نوع إطار_محلل = {
    الإطار: إطار,
    المستهلك: طبيعي
};

عام نوع خطأ_إطار =
    | غير_مكتمل
    | بت_محجوز
    | شفرة_غير_صالحة
    | قناع_مطلوب
    | إطار_تحكم_مجزأ
    | حمولة_تحكم_كبيرة
    | طول_غير_صالح
;

عرف شفرة_نوع_إطار(النوع: نوع_إطار): ط8 {
    طابق النوع مع
    | نوع_إطار.استمرار -> { أرجع 0x0; }
    | نوع_إطار.نص -> { أرجع 0x1; }
    | نوع_إطار.ثنائي -> { أرجع 0x2; }
    | نوع_إطار.إغلاق -> { أرجع 0x8; }
    | نوع_إطار.نبض -> { أرجع 0x9; }
    | نوع_إطار.رد_نبض -> { أرجع 0xA; };
}

عرف نوع_إطار_من_شفرة(الشفرة: ط8): اختياري نوع_إطار {
    إذا (الشفرة == 0x0) { أرجع اختياري.موجود(نوع_إطار.استمرار()); };
    إذا (الشفرة == 0x1) { أرجع اختياري.موجود(نوع_إطار.نص()); };
    إذا (الشفرة == 0x2) { أرجع اختياري.موجود(نوع_إطار.ثنائي()); };
    إذا (الشفرة == 0x8) { أرجع اختياري.موجود(نوع_إطار.إغلاق()); };
    إذا (الشفرة == 0x9) { أرجع اختياري.موجود(نوع_إطار.نبض()); };
    إذا (الشفرة == 0xA) { أرجع اختياري.موجود(نوع_إطار.رد_نبض()); };
    أرجع اختياري.لا_شيء();
}

عرف إطار_تحكم(النوع: نوع_إطار): منطقي {
    طابق النوع مع
    | نوع_إطار.إغلاق -> { أرجع صواب; }
    | نوع_إطار.نبض -> { أرجع صواب; }
    | نوع_إطار.رد_نبض -> { أرجع صواب; }
    | _ -> { أرجع خطأ; };
}

عرف ألحق_طول16(
    الناتج: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    ألحق(*الناتج, ((القيمة >> 8) & 0xFF) مثل ط8);
    ألحق(*الناتج, (القيمة & 0xFF) مثل ط8);
}

عرف ألحق_طول64(
    الناتج: &متغير متجه ط8,
    القيمة: طبيعي
): فراغ {
    ليكن التحولات: متجه طبيعي = [56, 48, 40, 32, 24, 16, 8, 0];
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < 8) {
        ليكن التحول: طبيعي = التحولات[الموضع];
        ألحق(*الناتج, ((القيمة >> التحول) & 0xFF) مثل ط8);
        الموضع := الموضع + 1;
    }
}

عام عرف رمز_إطار_خادم(
    الإطار: &إطار
): نتيجة متجه ط8, خطأ_إطار {
    ليكن طول_الحمولة: طبيعي =
        الطول((*الإطار).الحمولة) مثل طبيعي;
    إذا (إطار_تحكم((*الإطار).النوع)) {
        إذا (!(*الإطار).نهائي) {
            أرجع نتيجة.خطأ(خطأ_إطار.إطار_تحكم_مجزأ());
        };
        إذا (طول_الحمولة > 125) {
            أرجع نتيجة.خطأ(خطأ_إطار.حمولة_تحكم_كبيرة());
        };
    };
    طابق (*الإطار).النوع مع
    | نوع_إطار.إغلاق -> {
        إذا (طول_الحمولة == 1) {
            أرجع نتيجة.خطأ(خطأ_إطار.طول_غير_صالح());
        };
    }
    | _ -> { };

    ليكن الناتج: متغير متجه ط8 = [];
    ليكن الأول: متغير ط8 = شفرة_نوع_إطار((*الإطار).النوع);
    إذا ((*الإطار).نهائي) { الأول := الأول | 0x80; };
    ألحق(الناتج, الأول);

    إذا (طول_الحمولة < 126) {
        ألحق(الناتج, طول_الحمولة مثل ط8);
    } وإلا إذا (طول_الحمولة <= 65535) {
        ألحق(الناتج, 126);
        ألحق_طول16(&متغير الناتج, طول_الحمولة);
    } وإلا {
        ألحق(الناتج, 127);
        ألحق_طول64(&متغير الناتج, طول_الحمولة);
    };

    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < طول_الحمولة) {
        ألحق(الناتج, (*الإطار).الحمولة[الموضع]);
        الموضع := الموضع + 1;
    }
    أرجع نتيجة.نجح(الناتج);
}

عرف اقرأ_طول16(
    المصدر: &متجه ط8,
    البداية: طبيعي
): طبيعي {
    ليكن الموضع1: طبيعي = البداية + 1;
    ليكن الأعلى: طبيعي = (*المصدر)[البداية] مثل طبيعي;
    ليكن الأدنى: طبيعي = (*المصدر)[الموضع1] مثل طبيعي;
    أرجع (الأعلى << 8) | الأدنى;
}

عرف اقرأ_طول64(
    المصدر: &متجه ط8,
    البداية: طبيعي
): طبيعي {
    ليكن القيمة: متغير طبيعي = 0;
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < 8) {
        ليكن موضع_المصدر: طبيعي = البداية + الموضع;
        القيمة := (القيمة << 8)
            | ((*المصدر)[موضع_المصدر] مثل طبيعي);
        الموضع := الموضع + 1;
    }
    أرجع القيمة;
}

عام عرف حلل_إطار_عميل(
    المصدر: &متجه ط8
): نتيجة إطار_محلل, خطأ_إطار {
    ليكن العدد: طبيعي = الطول(*المصدر) مثل طبيعي;
    إذا (العدد < 2) { أرجع نتيجة.خطأ(خطأ_إطار.غير_مكتمل()); };

    ليكن الأول: ط8 = (*المصدر)[0];
    ليكن الثاني: ط8 = (*المصدر)[1];
    إذا ((الأول & 0x70) != 0) {
        أرجع نتيجة.خطأ(خطأ_إطار.بت_محجوز());
    };

    ليكن نهائي: منطقي = (الأول & 0x80) != 0;
    ليكن شفرة: ط8 = الأول & 0x0F;
    ليكن النوع: متغير نوع_إطار;
    طابق نوع_إطار_من_شفرة(شفرة) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_إطار.شفرة_غير_صالحة());
    }
    | اختياري.موجود(القيمة) -> { النوع := القيمة; };

    إذا ((الثاني & 0x80) == 0) {
        أرجع نتيجة.خطأ(خطأ_إطار.قناع_مطلوب());
    };

    ليكن مؤشر: متغير طبيعي = 2;
    ليكن رمز_الطول: طبيعي = (الثاني & 0x7F) مثل طبيعي;
    ليكن طول_الحمولة: متغير طبيعي = رمز_الطول;
    إذا (رمز_الطول == 126) {
        إذا ((مؤشر + 2) > العدد) {
            أرجع نتيجة.خطأ(خطأ_إطار.غير_مكتمل());
        };
        طول_الحمولة := اقرأ_طول16(المصدر, مؤشر);
        إذا (طول_الحمولة < 126) {
            أرجع نتيجة.خطأ(خطأ_إطار.طول_غير_صالح());
        };
        مؤشر := مؤشر + 2;
    } وإلا إذا (رمز_الطول == 127) {
        إذا ((مؤشر + 8) > العدد) {
            أرجع نتيجة.خطأ(خطأ_إطار.غير_مكتمل());
        };
        إذا (((*المصدر)[مؤشر] & 0x80) != 0) {
            أرجع نتيجة.خطأ(خطأ_إطار.طول_غير_صالح());
        };
        طول_الحمولة := اقرأ_طول64(المصدر, مؤشر);
        إذا (طول_الحمولة <= 65535) {
            أرجع نتيجة.خطأ(خطأ_إطار.طول_غير_صالح());
        };
        مؤشر := مؤشر + 8;
    };

    إذا (إطار_تحكم(النوع)) {
        إذا (!نهائي) {
            أرجع نتيجة.خطأ(خطأ_إطار.إطار_تحكم_مجزأ());
        };
        إذا (طول_الحمولة > 125) {
            أرجع نتيجة.خطأ(خطأ_إطار.حمولة_تحكم_كبيرة());
        };
    };
    طابق النوع مع
    | نوع_إطار.إغلاق -> {
        إذا (طول_الحمولة == 1) {
            أرجع نتيجة.خطأ(خطأ_إطار.طول_غير_صالح());
        };
    }
    | _ -> { };

    إذا ((مؤشر + 4) > العدد) {
        أرجع نتيجة.خطأ(خطأ_إطار.غير_مكتمل());
    };
    ليكن موضع_قناع1: طبيعي = مؤشر + 1;
    ليكن موضع_قناع2: طبيعي = مؤشر + 2;
    ليكن موضع_قناع3: طبيعي = مؤشر + 3;
    ليكن قناع0: ط8 = (*المصدر)[مؤشر];
    ليكن قناع1: ط8 = (*المصدر)[موضع_قناع1];
    ليكن قناع2: ط8 = (*المصدر)[موضع_قناع2];
    ليكن قناع3: ط8 = (*المصدر)[موضع_قناع3];
    مؤشر := مؤشر + 4;

    إذا (طول_الحمولة > (العدد - مؤشر)) {
        أرجع نتيجة.خطأ(خطأ_إطار.غير_مكتمل());
    };

    ليكن الحمولة: متغير متجه ط8 = [];
    ليكن موضع_الحمولة: متغير طبيعي = 0;
    طالما (موضع_الحمولة < طول_الحمولة) {
        ليكن موضع_المصدر: طبيعي = مؤشر + موضع_الحمولة;
        ليكن ترتيب_القناع: طبيعي = موضع_الحمولة % 4;
        ليكن قيمة_القناع: متغير ط8 = قناع0;
        إذا (ترتيب_القناع == 1) { قيمة_القناع := قناع1; }
        وإلا إذا (ترتيب_القناع == 2) { قيمة_القناع := قناع2; }
        وإلا إذا (ترتيب_القناع == 3) { قيمة_القناع := قناع3; };
        ألحق(
            الحمولة,
            (*المصدر)[موضع_المصدر] ^ قيمة_القناع
        );
        موضع_الحمولة := موضع_الحمولة + 1;
    }

    ليكن الإطار: إطار = {
        نهائي: نهائي,
        النوع: النوع,
        الحمولة: الحمولة
    };
    ليكن المحلل: إطار_محلل = {
        الإطار: الإطار,
        المستهلك: مؤشر + طول_الحمولة
    };
    أرجع نتيجة.نجح(المحلل);
}

عام عرف إطار_نصي(النص: &نص): إطار {
    ليكن الحمولة: متغير متجه ط8 = [];
    ليكن الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(*النص) مثل طبيعي)) {
        ألحق(الحمولة, (*النص)[الموضع]);
        الموضع := الموضع + 1;
    }
    ليكن الناتج: إطار = {
        نهائي: صواب,
        النوع: نوع_إطار.نص(),
        الحمولة: الحمولة
    };
    أرجع الناتج;
}

عام عرف إطار_ثنائي(الحمولة: متجه ط8): إطار {
    ليكن الناتج: إطار = {
        نهائي: صواب,
        النوع: نوع_إطار.ثنائي(),
        الحمولة: الحمولة
    };
    أرجع الناتج;
}

عام عرف إطار_نبض(الحمولة: متجه ط8): إطار {
    ليكن الناتج: إطار = {
        نهائي: صواب,
        النوع: نوع_إطار.نبض(),
        الحمولة: الحمولة
    };
    أرجع الناتج;
}

عام عرف إطار_رد_نبض(الحمولة: متجه ط8): إطار {
    ليكن الناتج: إطار = {
        نهائي: صواب,
        النوع: نوع_إطار.رد_نبض(),
        الحمولة: الحمولة
    };
    أرجع الناتج;
}

عام مرادف websocket_frame_kind = نوع_إطار;
عام مرادف websocket_frame = إطار;
عام مرادف parsed_websocket_frame = إطار_محلل;
عام مرادف websocket_frame_error = خطأ_إطار;
عام مرادف encode_websocket_server_frame = رمز_إطار_خادم;
عام مرادف parse_websocket_client_frame = حلل_إطار_عميل;
عام مرادف websocket_text_frame = إطار_نصي;
عام مرادف websocket_binary_frame = إطار_ثنائي;
عام مرادف websocket_ping_frame = إطار_نبض;
عام مرادف websocket_pong_frame = إطار_رد_نبض;
عام مرادف websocket_frame_kind.continuation = نوع_إطار.استمرار;
عام مرادف websocket_frame_kind.text = نوع_إطار.نص;
عام مرادف websocket_frame_kind.binary = نوع_إطار.ثنائي;
عام مرادف websocket_frame_kind.close = نوع_إطار.إغلاق;
عام مرادف websocket_frame_kind.ping = نوع_إطار.نبض;
عام مرادف websocket_frame_kind.pong = نوع_إطار.رد_نبض;
عام مرادف websocket_frame_error.incomplete = خطأ_إطار.غير_مكتمل;
عام مرادف websocket_frame_error.reserved_bit = خطأ_إطار.بت_محجوز;
عام مرادف websocket_frame_error.invalid_opcode = خطأ_إطار.شفرة_غير_صالحة;
عام مرادف websocket_frame_error.mask_required = خطأ_إطار.قناع_مطلوب;
عام مرادف websocket_frame_error.fragmented_control =
    خطأ_إطار.إطار_تحكم_مجزأ;
عام مرادف websocket_frame_error.control_payload_too_large =
    خطأ_إطار.حمولة_تحكم_كبيرة;
عام مرادف websocket_frame_error.invalid_length = خطأ_إطار.طول_غير_صالح;
