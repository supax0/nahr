من std.http استورد
    إعداد_خادم_ويب,
    خطأ_خادم_ويب,
    حدود_ويب,
    طلب_ويب,
    استجابة_ويب,
    خدمة_ويب,
    ناقل_ويب,
    إعداد_خادم_ويب_افتراضي,
    خدم_اتصال_ويب_مع_تسليم,
    خدم_اتصال_ويب_آمن_مع_تسليم,
    مسلم_اتصال_ويب;

من std.tls استورد
    إعداد_خادم_تي_إل_إس,
    انسخ_إعداد_خادم_تي_إل_إس,
    اضبط_بروتوكولات_خادم_تي_إل_إس,
    أنشئ_هوية_خادم_تي_إل_إس,
    أنشئ_إعداد_خادم_تي_إل_إس;

من std.fs استورد
    اقرأ_بايتات_ملف;

من std.net استورد
    عنوان_مقبس,
    خيار_مقبس,
    مستمع_تي_سي_بي,
    تدفق_تي_سي_بي,
    حلل_عنوان_مقبس,
    اربط_مستمع_تي_سي_بي_بخيارات,
    اقبل_تي_سي_بي,
    اضبط_خيار_تدفق_تي_سي_بي,
    أغلق_تدفق_تي_سي_بي;

من std.sync استورد
    مشترك,
    أنشئ_مشترك,
    استنسخ_مشترك,
    اقرأ_مشترك;

من std.thread استورد
    مقبض_خيط,
    أطلق,
    انضم,
    عدد_المعالجات_المتاحة;

من std.time استورد
    نم_نانو;

استورد std.text.number;
استورد std.text.transform;
استورد routing.router;
استورد serve.server;
استورد log.log;
استورد serve.shutdown;

// Serves connections on several OS threads (std.thread), as a thread-pool
// server: العمال threads share one listening socket and each accepts and
// serves its own connections, so a slow request no longer holds up the others.
//
// The router moves into an Arc (`مشترك`) the workers share. Handlers receive
// `&S` from several threads at once, so state that changes must use std.sync
// (atomics, `قفل`).
//
// Threads run on Linux, macOS, FreeBSD and Windows. The interpreter runs one OS
// thread, so under `sultanc run` use `شغل_على`.

// How the pool runs. العمال = 0 picks the number of CPUs. Timeouts are in
// milliseconds per read or write on a connection (0 = none): an idle
// keep-alive client is dropped after مهلة_القراءة instead of holding a worker.
عام نوع إعداد_توازي = {
    العمال: طبيعي,
    مهلة_القراءة: طبيعي,
    مهلة_الكتابة: طبيعي
};

// One worker per CPU, 30-second read and write timeouts.
عام عرف إعداد_توازي_افتراضي(): إعداد_توازي {
    دع الناتج: إعداد_توازي = {
        العمال: 0,
        مهلة_القراءة: 30000,
        مهلة_الكتابة: 30000
    };
    أرجع الناتج;
}

عرف عدد_العمال(المطلوب: طبيعي): طبيعي {
    إذا (المطلوب > 0) { أرجع المطلوب; };
    طابق عدد_المعالجات_المتاحة() مع
    | نتيجة.نجح(العدد) -> { إذا (العدد > 0) { أرجع العدد; }; أرجع 1; }
    | نتيجة.خطأ(_) -> { أرجع 4; };
}

عرف خدم_اتصال_بموجه<S>(
    الناقل: ناقل_ويب,
    الحدود: &حدود_ويب,
    الموجه: &موجه<S>,
    السجل: &إعداد_سجل
): نتيجة عدد, خطأ_خادم_ويب {
    دع الخدمة: خدمة_ويب<موجه<S>, متجه ط8, متجه ط8> = خدمة_مسجلة(*السجل);
    دع المسلم: مسلم_اتصال_ويب<موجه<S> > = مسلم_نهر();
    أرجع خدم_اتصال_ويب_مع_تسليم(الناقل, الحدود, الموجه, الخدمة, المسلم);
}

عرف خدم_اتصال_آمن_بموجه<S>(
    التدفق: تدفق_تي_سي_بي,
    الأمان: &إعداد_خادم_تي_إل_إس,
    الحدود: &حدود_ويب,
    الموجه: &موجه<S>,
    السجل: &إعداد_سجل
): نتيجة عدد, خطأ_خادم_ويب {
    دع الخدمة: خدمة_ويب<موجه<S>, متجه ط8, متجه ط8> = خدمة_مسجلة(*السجل);
    دع المسلم: مسلم_اتصال_ويب<موجه<S> > = مسلم_نهر();
    أرجع خدم_اتصال_ويب_آمن_مع_تسليم(التدفق, الأمان, الحدود, الموجه, الخدمة, المسلم);
}

// One worker: accept, serve, repeat. A failed accept is retried after a short
// pause (1 ms doubling to 1 s); 64 failures in a row end the worker, as in
// std's own accept loop.
عرف اعمل<S>(
    المستمع: &مستمع_تي_سي_بي,
    الموجه: &موجه<S>,
    الأمان: &اختياري مشترك<إعداد_خادم_تي_إل_إس>,
    الحدود: حدود_ويب,
    مهلة_القراءة: طبيعي,
    مهلة_الكتابة: طبيعي,
    السجل: إعداد_سجل
): فراغ {
    دع إخفاقات: متغير عدد = 0;
    دع الانتظار: متغير عدد = 1000000;
    طالما (إخفاقات < 64 && !طلب_الإيقاف()) {
        طابق اقبل_تي_سي_بي(المستمع) مع
        | نتيجة.خطأ(_) -> {
            إخفاقات := إخفاقات + 1;
            دع تجاهل: نتيجة عدد, عدد = نم_نانو(الانتظار);
            إذا (الانتظار < 1000000000) { الانتظار := الانتظار * 2; };
        }
        | نتيجة.نجح(التدفق) -> {
          إذا (طلب_الإيقاف()) {
            // A wake-up connection (or a late client) during shutdown.
            دع تجاهل_غلق: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق);
          } وإلا {
            إخفاقات := 0;
            الانتظار := 1000000;
            دع _ق: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(&التدفق, خيار_مقبس.مهلة_استقبال(مهلة_القراءة));
            دع _ك: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(&التدفق, خيار_مقبس.مهلة_إرسال(مهلة_الكتابة));
            دع _ت: نتيجة عدد, عدد = اضبط_خيار_تدفق_تي_سي_بي(&التدفق, خيار_مقبس.بلا_تأخير_تي_سي_بي(صواب));
            طابق *الأمان مع
            | اختياري.موجود(إعداد_الأمان) -> {
                دع تجاهل: نتيجة عدد, خطأ_خادم_ويب = خدم_اتصال_آمن_بموجه(
                    التدفق,
                    اقرأ_مشترك(&إعداد_الأمان),
                    &الحدود,
                    الموجه,
                    &السجل
                );
            }
            | اختياري.لا_شيء -> {
                دع تجاهل: نتيجة عدد, خطأ_خادم_ويب = خدم_اتصال_بموجه(
                    ناقل_ويب.تي_سي_بي(التدفق),
                    &الحدود,
                    الموجه,
                    &السجل
                );
            };
          };
        };
    }
}

// Serves الموجه on a pool of threads. It returns only when every worker has
// stopped; the result is the number of workers that started.
عام عرف شغل_متوازيا<S>(
    الإعداد: &إعداد,
    الموجه: موجه<S>,
    التوازي: &إعداد_توازي
): نتيجة عدد, خطأ_تشغيل {
    دع بلا_أمان: اختياري مشترك<إعداد_خادم_تي_إل_إس> = اختياري.لا_شيء();
    أرجع شغل_الحوض(الإعداد, الموجه, التوازي, بلا_أمان);
}

// HTTPS on a pool of threads: each worker runs the TLS handshake (ALPN "h2"
// and "http/1.1" unless الأمان lists its own), then HTTP/2 or HTTP/1.
عام عرف شغل_آمنا_متوازيا<S>(
    الإعداد: &إعداد,
    الأمان: &إعداد_خادم_تي_إل_إس,
    الموجه: موجه<S>,
    التوازي: &إعداد_توازي
): نتيجة عدد, خطأ_تشغيل {
    دع القيمة: متغير إعداد_خادم_تي_إل_إس = انسخ_إعداد_خادم_تي_إل_إس(الأمان);
    إذا ((الطول(القيمة.البروتوكولات) مثل طبيعي) == 0) {
        دع البروتوكولات: متجه نص = [«h2», «http/1.1»];
        اضبط_بروتوكولات_خادم_تي_إل_إس(&متغير القيمة, &البروتوكولات);
    };
    دع المشترك: مشترك<إعداد_خادم_تي_إل_إس> = أنشئ_مشترك(القيمة);
    أرجع شغل_الحوض(الإعداد, الموجه, التوازي, اختياري.موجود(المشترك));
}

// HTTPS on العنوان with العمال threads and a PKCS#12 identity file.
عام عرف شغل_آمنا_على_متوازيا<S>(
    العنوان: &نص,
    ملف_الهوية: &نص,
    كلمة_المرور: &نص,
    الموجه: موجه<S>,
    العمال: طبيعي
): نتيجة عدد, خطأ_تشغيل {
    دع البايتات: متجه ط8;
    طابق اقرأ_بايتات_ملف(ملف_الهوية) مع
    | نتيجة.خطأ(الرمز) -> { أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الرمز)); }
    | نتيجة.نجح(القيمة) -> { البايتات := القيمة; };
    دع الأمان: إعداد_خادم_تي_إل_إس =
        أنشئ_إعداد_خادم_تي_إل_إس(أنشئ_هوية_خادم_تي_إل_إس(البايتات, كلمة_المرور));
    دع الإعداد: إعداد = إعداد_خادم_ويب_افتراضي(العنوان);
    دع التوازي: متغير إعداد_توازي = إعداد_توازي_افتراضي();
    التوازي.العمال := العمال;
    أرجع شغل_آمنا_متوازيا(&الإعداد, &الأمان, الموجه, &التوازي);
}

عرف شغل_الحوض<S>(
    الإعداد: &إعداد,
    الموجه: موجه<S>,
    التوازي: &إعداد_توازي,
    الأمان: اختياري مشترك<إعداد_خادم_تي_إل_إس>
): نتيجة عدد, خطأ_تشغيل {
    دع المشترك: مشترك<موجه<S> > = أنشئ_مشترك(الموجه);
    أرجع شغل_الحوض_بمشترك(الإعداد, المشترك, التوازي, الأمان);
}

// The pool for a router that is already shared (the event-driven server
// falls back to it on targets without non-blocking sockets).
عام عرف شغل_الحوض_بمشترك<S>(
    الإعداد_الأصلي: &إعداد,
    المشترك: مشترك<موجه<S> >,
    التوازي: &إعداد_توازي,
    الأمان: اختياري مشترك<إعداد_خادم_تي_إل_إس>
): نتيجة عدد, خطأ_تشغيل {
    دع الإعداد_الفعلي: إعداد = إعداد_من_البيئة(الإعداد_الأصلي);
    دع الإعداد: &إعداد = &الإعداد_الفعلي;
    دع السجل: إعداد_سجل = إعداد_سجل_من_البيئة();
    دع المستمع: مشترك<مستمع_تي_سي_بي>;
    طابق اربط_للتشغيل(الإعداد, &السجل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(القيمة) -> { المستمع := أنشئ_مشترك(القيمة); };

    دع العدد: طبيعي = عدد_العمال((*التوازي).العمال);
    دع مهلة_القراءة: طبيعي = (*التوازي).مهلة_القراءة;
    دع مهلة_الكتابة: طبيعي = (*التوازي).مهلة_الكتابة;
    دع آمن: متغير منطقي = خطأ;
    دع وصف_الأمان: متغير نص = «»;
    طابق الأمان مع
    | اختياري.موجود(_) -> { آمن := صواب; وصف_الأمان := «, TLS (HTTP/2 and HTTP/1.1)»; }
    | اختياري.لا_شيء -> { };
    دع الأجزاء: متجه نص = [«a pool of », طبيعي_إلى_نص(العدد), « threads», وصف_الأمان];
    دع الفاصل: نص = «»;
    سجل_البدء(&السجل, اقرأ_مشترك(&المشترك), &(*الإعداد).العنوان, صل_النصوص(&الأجزاء, &الفاصل), آمن);
    // Before any worker starts, so every thread leaves the signals to it.
    دع تجاهل_إيقاف: منطقي = فعل_الإيقاف_الآمن(&السجل, &(*الإعداد).العنوان, العدد);
    دع المقابض: متغير متجه مقبض_خيط = [];
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        دع مستمع_العامل: مشترك<مستمع_تي_سي_بي> = استنسخ_مشترك(&المستمع);
        دع موجه_العامل: مشترك<موجه<S> > = استنسخ_مشترك(&المشترك);
        دع حدود_العامل: حدود_ويب = (*الإعداد).الحدود;
        دع أمان_العامل: اختياري مشترك<إعداد_خادم_تي_إل_إس> = استنسخ(&الأمان);
        دع سجل_العامل: إعداد_سجل = السجل;
        طابق أطلق(دالة(): فراغ -> اعمل(
            اقرأ_مشترك(&مستمع_العامل), اقرأ_مشترك(&موجه_العامل), &أمان_العامل,
            حدود_العامل, مهلة_القراءة, مهلة_الكتابة, سجل_العامل
        )) مع
        | نتيجة.خطأ(_) -> { }
        | نتيجة.نجح(المقبض) -> { ألحق(المقابض, المقبض); };
        ف := ف + 1;
    }

    دع بدأ: طبيعي = الطول(المقابض) مثل طبيعي;
    إذا (بدأ == 0) {
        // No threads on this target (WASI): serve on this thread.
        اعمل(اقرأ_مشترك(&المستمع), اقرأ_مشترك(&المشترك), &الأمان, (*الإعداد).الحدود, مهلة_القراءة, مهلة_الكتابة, السجل);
        أرجع نتيجة.نجح(0);
    };
    إذا (بدأ < العدد) {
        دع التحذير: متجه نص = [«only », طبيعي_إلى_نص(بدأ), « of », طبيعي_إلى_نص(العدد), « worker threads started»];
        سجل_بإعداد(&السجل, مستوى_سجل.تحذير(), صل_النصوص(&التحذير, &الفاصل));
    };
    ف := 0;
    طالما (ف < بدأ) {
        انضم(&متغير المقابض[ف]);
        ف := ف + 1;
    }
    سجل_بإعداد(&السجل, مستوى_سجل.معلومة(), سطر_العملية(خطأ));
    أرجع نتيجة.نجح(بدأ مثل عدد);
}

// Serves on العنوان with العمال threads (0 = one per CPU) and the default
// timeouts.
عام عرف شغل_على_متوازيا<S>(
    العنوان: &نص,
    الموجه: موجه<S>,
    العمال: طبيعي
): نتيجة عدد, خطأ_تشغيل {
    دع الإعداد: إعداد = إعداد_خادم_ويب_افتراضي(العنوان);
    دع التوازي: متغير إعداد_توازي = إعداد_توازي_افتراضي();
    التوازي.العمال := العمال;
    أرجع شغل_متوازيا(&الإعداد, الموجه, &التوازي);
}

// Binds الإعداد's address; a failure is logged.
عرف اربط_للتشغيل(الإعداد: &إعداد, السجل: &إعداد_سجل): نتيجة مستمع_تي_سي_بي, خطأ_تشغيل {
    دع العنوان: عنوان_مقبس;
    طابق حلل_عنوان_مقبس(&(*الإعداد).العنوان) مع
    | نتيجة.خطأ(_) -> {
        دع الخطأ: خطأ_تشغيل = خطأ_خادم_ويب.عنوان_غير_صالح();
        سجل_فشل_التشغيل(السجل, &(*الإعداد).العنوان, &الخطأ);
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(القيمة) -> { العنوان := القيمة; };
    دع الخيارات: متغير متجه خيار_مقبس = [];
    إذا ((*الإعداد).إعادة_استخدام_العنوان) {
        ألحق(الخيارات, خيار_مقبس.إعادة_استخدام_العنوان(صواب));
    };
    طابق اربط_مستمع_تي_سي_بي_بخيارات(&العنوان, (*الإعداد).التراكم, &الخيارات) مع
    | نتيجة.خطأ(الرمز) -> {
        دع الخطأ: خطأ_تشغيل = خطأ_خادم_ويب.شبكة(الرمز);
        سجل_فشل_التشغيل(السجل, &(*الإعداد).العنوان, &الخطأ);
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(المستمع) -> { أرجع نتيجة.نجح(المستمع); };
}

// Serves on this thread: connections are answered one at a time (the
// interpreter has no threads). Same logging, live routes and graceful
// shutdown as the pool.
عرف شغل_تسلسليا<S>(
    الإعداد_الأصلي: &إعداد,
    الموجه: &موجه<S>,
    الأمان: &اختياري مشترك<إعداد_خادم_تي_إل_إس>
): نتيجة عدد, خطأ_تشغيل {
    دع الإعداد_الفعلي: إعداد = إعداد_من_البيئة(الإعداد_الأصلي);
    دع الإعداد: &إعداد = &الإعداد_الفعلي;
    دع السجل: إعداد_سجل = إعداد_سجل_من_البيئة();
    طابق اربط_للتشغيل(الإعداد, &السجل) مع
    | نتيجة.خطأ(الخطأ) -> { أرجع نتيجة.خطأ(الخطأ); }
    | نتيجة.نجح(المستمع) -> {
        دع آمن: متغير منطقي = خطأ;
        دع الطريقة: متغير نص = «one thread»;
        طابق *الأمان مع
        | اختياري.موجود(_) -> { آمن := صواب; الطريقة := «one thread, TLS (HTTP/2 and HTTP/1.1)»; }
        | اختياري.لا_شيء -> { };
        سجل_البدء(&السجل, الموجه, &(*الإعداد).العنوان, الطريقة, آمن);
        دع تجاهل_إيقاف: منطقي = فعل_الإيقاف_الآمن(&السجل, &(*الإعداد).العنوان, 1);
        دع التوازي: إعداد_توازي = إعداد_توازي_افتراضي();
        اعمل(&المستمع, الموجه, الأمان, (*الإعداد).الحدود, التوازي.مهلة_القراءة, التوازي.مهلة_الكتابة, السجل);
        سجل_بإعداد(&السجل, مستوى_سجل.معلومة(), سطر_العملية(خطأ));
        أرجع نتيجة.نجح(1);
    };
}

// Serves on one thread: connections are answered one at a time.
عام عرف شغل<S>(
    الإعداد: &إعداد,
    الموجه: &موجه<S>
): نتيجة عدد, خطأ_تشغيل {
    دع بلا_أمان: اختياري مشترك<إعداد_خادم_تي_إل_إس> = اختياري.لا_شيء();
    أرجع شغل_تسلسليا(الإعداد, الموجه, &بلا_أمان);
}

عام عرف شغل_على<S>(
    العنوان: &نص,
    الموجه: &موجه<S>
): نتيجة عدد, خطأ_تشغيل {
    دع الإعداد: إعداد =
        إعداد_خادم_ويب_افتراضي(العنوان);
    أرجع شغل(
        &الإعداد,
        الموجه
    );
}

// HTTPS with std's TLS: ALPN offers "h2" and "http/1.1", then HTTP/2 or
// HTTP/1 by what the client picks. Connections are served one at a time.
عام عرف شغل_آمنا<S>(
    الإعداد: &إعداد,
    الأمان: &إعداد_خادم_تي_إل_إس,
    الموجه: &موجه<S>
): نتيجة عدد, خطأ_تشغيل {
    دع مع_أمان: اختياري مشترك<إعداد_خادم_تي_إل_إس> = اختياري.موجود(أنشئ_مشترك(انسخ_إعداد_خادم_تي_إل_إس(الأمان)));
    أرجع شغل_تسلسليا(الإعداد, الموجه, &مع_أمان);
}

// HTTPS on العنوان with the certificate and key from a PKCS#12 file (.p12 /
// .pfx) and its password. A file that can't be read is a network error with
// the OS error code.
عام عرف شغل_آمنا_على<S>(
    العنوان: &نص,
    ملف_الهوية: &نص,
    كلمة_المرور: &نص,
    الموجه: &موجه<S>
): نتيجة عدد, خطأ_تشغيل {
    دع البايتات: متجه ط8;
    طابق اقرأ_بايتات_ملف(ملف_الهوية) مع
    | نتيجة.خطأ(الرمز) -> {
        دع السجل: إعداد_سجل = إعداد_سجل_من_البيئة();
        دع الأجزاء: متجه نص = [«cannot read the TLS identity file », استنسخ(ملف_الهوية), «: », وصف_رمز_نظام(الرمز)];
        سجل_بإعداد(&السجل, مستوى_سجل.عطل(), صل_نصوص(الأجزاء));
        أرجع نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الرمز));
    }
    | نتيجة.نجح(القيمة) -> { البايتات := القيمة; };
    دع الأمان: إعداد_خادم_تي_إل_إس =
        أنشئ_إعداد_خادم_تي_إل_إس(أنشئ_هوية_خادم_تي_إل_إس(البايتات, كلمة_المرور));
    دع الإعداد: إعداد = إعداد_خادم_ويب_افتراضي(العنوان);
    أرجع شغل_آمنا(&الإعداد, &الأمان, الموجه);
}

عام مرادف parallel_config = إعداد_توازي;
عام مرادف serve_tls = شغل_آمنا;
عام مرادف serve_tls_on = شغل_آمنا_على;
عام مرادف serve = شغل;
عام مرادف serve_on = شغل_على;
عام مرادف serve_pool_shared = شغل_الحوض_بمشترك;
عام مرادف default_parallel_config = إعداد_توازي_افتراضي;
عام مرادف serve_parallel = شغل_متوازيا;
عام مرادف serve_tls_parallel = شغل_آمنا_متوازيا;
عام مرادف serve_tls_on_parallel = شغل_آمنا_على_متوازيا;
عام مرادف serve_on_parallel = شغل_على_متوازيا;
