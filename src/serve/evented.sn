من std.http استورد
    إعداد_خادم_ويب,
    خطأ_خادم_ويب,
    طلب_ويب,
    استجابة_ويب,
    خدمة_ويب,
    إعداد_خادم_ويب_افتراضي,
    شغل_خادم_ويب_بأحداث_مع_تسليم,
    مسلم_اتصال_ويب;

من std.tls استورد إعداد_خادم_تي_إل_إس;

من std.sync استورد
    مشترك,
    أنشئ_مشترك,
    اقرأ_مشترك;

من std.thread استورد عدد_المعالجات_المتاحة;

استورد std.text.number;
استورد std.text.transform;
استورد routing.router;
استورد serve.server;
استورد serve.parallel;
استورد log.log;
استورد serve.shutdown;

// Serves الموجه on std's event-driven server: every connection waits
// non-blocking in one poller (epoll, kqueue), and الخيوط worker threads
// (0 = one per CPU) take connections as they become ready. Idle or slow
// clients cost no thread, so thousands of keep-alive connections are fine.
// A handler runs on the worker that read its request and may block that
// worker only.
//
// The router moves into an Arc shared by the workers, so pass it by value;
// state in S that changes must use std.sync. On targets without a poller
// (Windows for now) std serves one connection at a time. Where std cannot
// make sockets non-blocking (macOS today: errno 45, ENOTSUP), this logs a
// warning and serves on the thread pool instead.
عام عرف شغل_بأحداث<S>(
    الإعداد_الأصلي: &إعداد,
    الموجه: موجه<S>,
    الخيوط: طبيعي
): نتيجة عدد, خطأ_تشغيل {
    دع الإعداد_الفعلي: إعداد = إعداد_من_البيئة(الإعداد_الأصلي);
    دع الإعداد: &إعداد = &الإعداد_الفعلي;
    دع السجل: إعداد_سجل = إعداد_سجل_من_البيئة();
    دع العدد: متغير طبيعي = الخيوط;
    إذا (العدد == 0) {
        طابق عدد_المعالجات_المتاحة() مع
        | نتيجة.نجح(ن) -> { العدد := ن; }
        | نتيجة.خطأ(_) -> { العدد := 1; };
    };
    دع الأجزاء: متجه نص = [«an event loop with », طبيعي_إلى_نص(العدد), « worker threads»];
    دع الفاصل: نص = «»;
    سجل_البدء(&السجل, &الموجه, &(*الإعداد).العنوان, صل_النصوص(&الأجزاء, &الفاصل), خطأ);
    دع تجاهل_إيقاف: منطقي = فعل_الإيقاف_الآمن(&السجل, &(*الإعداد).العنوان, العدد);
    دع المشترك: مشترك<موجه<S> > = أنشئ_مشترك(الموجه);
    دع الخدمة: خدمة_ويب<موجه<S>, متجه ط8, متجه ط8> = خدمة_مسجلة(السجل);
    دع المسلم: مسلم_اتصال_ويب<موجه<S> > = مسلم_نهر();
    دع النتيجة: نتيجة عدد, خطأ_تشغيل = شغل_خادم_ويب_بأحداث_مع_تسليم(الإعداد, المشترك, الخدمة, الخيوط, المسلم);
    دع الرمز: عدد = رمز_الشبكة(&النتيجة);
    إذا (الرمز == -45 || الرمز == -95) {
            سجل_بإعداد(&السجل, مستوى_سجل.تحذير(),
                «the event loop is not available on this platform (std cannot make sockets non-blocking here); serving on the thread pool»);
            دع التوازي: متغير إعداد_توازي = إعداد_توازي_افتراضي();
            التوازي.العمال := الخيوط;
            دع بلا_أمان: اختياري مشترك<إعداد_خادم_تي_إل_إس> = اختياري.لا_شيء();
            أرجع شغل_الحوض_بمشترك(الإعداد, المشترك, &التوازي, بلا_أمان);
    };
    أرجع بعد_التشغيل(&السجل, &(*الإعداد).العنوان, النتيجة);
}

عرف رمز_الشبكة(النتيجة: &نتيجة عدد, خطأ_تشغيل): عدد {
    طابق *النتيجة مع
    | نتيجة.خطأ(خطأ_خادم_ويب.شبكة(الرمز)) -> { أرجع الرمز; }
    | _ -> { أرجع 0; };
}

عام عرف شغل_على_بأحداث<S>(
    العنوان: &نص,
    الموجه: موجه<S>,
    الخيوط: طبيعي
): نتيجة عدد, خطأ_تشغيل {
    دع الإعداد: إعداد = إعداد_خادم_ويب_افتراضي(العنوان);
    أرجع شغل_بأحداث(&الإعداد, الموجه, الخيوط);
}

عام مرادف serve_evented = شغل_بأحداث;
عام مرادف serve_on_evented = شغل_على_بأحداث;
