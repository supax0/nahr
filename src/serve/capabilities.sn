عام نوع قدرات_تشغيل = {
    أحداث_مخزنة: منطقي,
    بث_أحداث_حي: منطقي,
    ترميز_مقبس_ويب: منطقي,
    ترقية_مقبس_ويب_حية: منطقي,
    إلغاء_رشيق: منطقي,
    مهلة_قاطعة: منطقي
};

عام عرف قدرات_التشغيل(): قدرات_تشغيل {
    ليكن الناتج: قدرات_تشغيل = {
        أحداث_مخزنة: صواب,
        بث_أحداث_حي: خطأ,
        ترميز_مقبس_ويب: صواب,
        ترقية_مقبس_ويب_حية: خطأ,
        إلغاء_رشيق: خطأ,
        مهلة_قاطعة: خطأ
    };
    أرجع الناتج;
}

عام مرادف serve_capabilities = قدرات_تشغيل;
عام مرادف current_serve_capabilities = قدرات_التشغيل;
