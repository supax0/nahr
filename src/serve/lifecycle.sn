استورد routing.router;
استورد serve.server;
استورد serve.parallel;

عام نوع خطاف_دورة_حياة<S> = دالة(
    &S
): فراغ;

عام عرف شغل_مع_دورة_حياة<S>(
    الإعداد: &إعداد,
    الموجه: &موجه<S>,
    عند_البدء: خطاف_دورة_حياة<S>,
    عند_الإيقاف: خطاف_دورة_حياة<S>
): نتيجة عدد, خطأ_تشغيل {
    عند_البدء(حالة_الموجه(الموجه));
    دع النتيجة: نتيجة عدد, خطأ_تشغيل =
        شغل(الإعداد, الموجه);
    عند_الإيقاف(حالة_الموجه(الموجه));
    أرجع النتيجة;
}

عام عرف شغل_على_مع_دورة_حياة<S>(
    العنوان: &نص,
    الموجه: &موجه<S>,
    عند_البدء: خطاف_دورة_حياة<S>,
    عند_الإيقاف: خطاف_دورة_حياة<S>
): نتيجة عدد, خطأ_تشغيل {
    عند_البدء(حالة_الموجه(الموجه));
    دع النتيجة: نتيجة عدد, خطأ_تشغيل =
        شغل_على(العنوان, الموجه);
    عند_الإيقاف(حالة_الموجه(الموجه));
    أرجع النتيجة;
}

عام نوع lifecycle_hook<S> = خطاف_دورة_حياة<S>;
عام مرادف serve_with_lifecycle = شغل_مع_دورة_حياة;
عام مرادف serve_on_with_lifecycle = شغل_على_مع_دورة_حياة;
