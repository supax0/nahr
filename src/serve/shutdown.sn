من std.http استورد
    اطلب_إيقاف_خوادم_الويب,
    هل_طلب_إيقاف_الويب;

من std.os استورد
    احجب_إشارات_الإيقاف,
    ارفع_حجب_إشارات_الإيقاف,
    انتظر_إشارة_إيقاف,
    إشارة_إيقاف,
    خطأ_إشارة;

من std.net استورد
    عنوان_مقبس,
    حلل_عنوان_مقبس,
    اتصل_تي_سي_بي,
    أغلق_تدفق_تي_سي_بي;

من std.process استورد اخرج, معرف_العملية;
من std.thread استورد أطلق;
من std.env استورد متغير_بيئة;
من std.text استورد من_بايتات, نصان_متساويان, صل_النصوص, طبيعي_إلى_نص;

استورد log.log;

// Graceful shutdown, as uvicorn does it: on Ctrl+C (SIGINT) or SIGTERM the
// server logs "Shutting down", stops accepting connections, lets the requests
// in progress finish (their responses carry "connection: close"), and the
// serve function returns; a second Ctrl+C quits at once. std does the
// draining (std.http shutdown.sn); Nahr blocks the signals, waits for them on
// its own thread so it can log, and wakes the workers waiting in accept.
//
// The serve functions turn this on before they start any thread. A program
// that starts its own threads before serving should call
// فعل_الإيقاف_الآمن first in main, since only threads started after it
// leave the signals to it. NAHR_GRACEFUL=0 keeps the default behaviour (the
// process ends at once).

عرف بيئة(الاسم: نص): نص {
    طابق متغير_بيئة(&الاسم) مع
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> { أرجع القيمة; }
    | _ -> { أرجع «»; };
}

عرف صل_أجزاء(الأجزاء: متجه نص): نص {
    دع الفاصل: نص = «»;
    أرجع صل_النصوص(&الأجزاء, &الفاصل);
}

// "Started server process [1234]" (uvicorn's first line).
عام عرف سطر_العملية(البداية: منطقي): نص {
    دع الكلمة: متغير نص = «Finished»;
    إذا (البداية) { الكلمة := «Started»; };
    دع الأجزاء: متجه نص = [الكلمة, « server process [», طبيعي_إلى_نص(معرف_العملية() مثل طبيعي), «]»];
    أرجع صل_أجزاء(الأجزاء);
}

// The address to connect to for waking a listener: a wildcard host becomes
// the loopback address.
عرف عنوان_الإيقاظ(العنوان: &نص): نص {
    دع العدد: طبيعي = الطول(*العنوان) مثل طبيعي;
    دع النقطتان: متغير طبيعي = العدد;
    دع ف: متغير طبيعي = 0;
    طالما (ف < العدد) {
        إذا ((*العنوان)[ف] == 0x3A) { النقطتان := ف; };
        ف := ف + 1;
    }
    إذا (النقطتان == العدد) { أرجع استنسخ(العنوان); };
    دع المضيف: متغير متجه ط8 = [];
    دع المنفذ: متغير متجه ط8 = [];
    ف := 0;
    طالما (ف < النقطتان) { ألحق(المضيف, (*العنوان)[ف]); ف := ف + 1; }
    ف := النقطتان;
    طالما (ف < العدد) { ألحق(المنفذ, (*العنوان)[ف]); ف := ف + 1; }
    دع نص_المضيف: نص = من_بايتات(&المضيف);
    دع الكل: نص = «0.0.0.0»;
    دع الكل6: نص = «[::]»;
    دع الفارغ: نص = «»;
    دع منفذ_نصي: نص = من_بايتات(&المنفذ);
    إذا (نصان_متساويان(&نص_المضيف, &الكل) || نصان_متساويان(&نص_المضيف, &الفارغ)) {
        دع الأجزاء: متجه نص = [«127.0.0.1», منفذ_نصي];
        أرجع صل_أجزاء(الأجزاء);
    };
    إذا (نصان_متساويان(&نص_المضيف, &الكل6)) {
        دع الأجزاء: متجه نص = [«[::1]», منفذ_نصي];
        أرجع صل_أجزاء(الأجزاء);
    };
    أرجع استنسخ(العنوان);
}

// Connects to the listener العدد times and closes at once, so workers that
// wait in accept see the shutdown.
عام عرف أيقظ_المستمعين(العنوان: &نص, العدد: طبيعي): فراغ {
    دع الهدف: نص = عنوان_الإيقاظ(العنوان);
    طابق حلل_عنوان_مقبس(&الهدف) مع
    | نتيجة.خطأ(_) -> { أرجع; }
    | نتيجة.نجح(المقبس) -> {
        دع ف: متغير طبيعي = 0;
        طالما (ف < العدد) {
            طابق اتصل_تي_سي_بي(&المقبس) مع
            | نتيجة.نجح(التدفق) -> { دع تجاهل: نتيجة عدد, عدد = أغلق_تدفق_تي_سي_بي(التدفق); }
            | نتيجة.خطأ(_) -> { };
            ف := ف + 1;
        }
    };
}

عرف اسم_الإشارة(الإشارة: &إشارة_إيقاف): نص {
    طابق *الإشارة مع
    | إشارة_إيقاف.مقاطعة -> { أرجع «Ctrl+C»; }
    | إشارة_إيقاف.إنهاء -> { أرجع «SIGTERM»; };
}

عرف راقب_إشارات_الإيقاف(السجل: إعداد_سجل, العنوان: نص, العمال: طبيعي): فراغ {
    طابق انتظر_إشارة_إيقاف() مع
    | نتيجة.خطأ(_) -> { أرجع; }
    | نتيجة.نجح(الإشارة) -> {
        دع الأجزاء: متجه نص = [«Shutting down (», اسم_الإشارة(&الإشارة), «)»];
        سجل_بإعداد(&السجل, مستوى_سجل.معلومة(), صل_أجزاء(الأجزاء));
        سجل_بإعداد(&السجل, مستوى_سجل.معلومة(),
            «Waiting for requests in progress to finish. (CTRL+C to force quit)»);
        اطلب_إيقاف_خوادم_الويب();
        أيقظ_المستمعين(&العنوان, العمال);
    };
    طابق انتظر_إشارة_إيقاف() مع
    | نتيجة.خطأ(_) -> { }
    | نتيجة.نجح(_) -> {
        سجل_بإعداد(&السجل, مستوى_سجل.تحذير(), «Forced quit»);
        اخرج(130);
    };
}

// Blocks SIGINT and SIGTERM and starts the thread that turns them into a
// graceful shutdown of the server on العنوان with العمال accepting workers.
// Answers whether it is on (off with NAHR_GRACEFUL=0, after a shutdown was
// already requested, or where std has no signals, e.g. Windows).
عام عرف فعل_الإيقاف_الآمن(السجل: &إعداد_سجل, العنوان: &نص, العمال: طبيعي): منطقي {
    دع المفعل: نص = بيئة(«NAHR_GRACEFUL»);
    دع صفر: نص = «0»;
    إذا (نصان_متساويان(&المفعل, &صفر)) { أرجع خطأ; };
    طابق احجب_إشارات_الإيقاف() مع
    | نتيجة.خطأ(_) -> {
        سجل_بإعداد(السجل, مستوى_سجل.تصحيح(), «signals are not available here; Ctrl+C stops the process at once»);
        أرجع خطأ;
    }
    | نتيجة.نجح(_) -> { };
    دع نسخة_السجل: إعداد_سجل = *السجل;
    دع نسخة_العنوان: نص = استنسخ(العنوان);
    طابق أطلق(دالة(): فراغ -> راقب_إشارات_الإيقاف(نسخة_السجل, استنسخ(&نسخة_العنوان), العمال)) مع
    | نتيجة.خطأ(_) -> {
        // No thread to take the signals (the interpreter, for one): give
        // them back, or Ctrl+C would be blocked with nobody waiting for it.
        دع تجاهل: نتيجة منطقي, خطأ_إشارة = ارفع_حجب_إشارات_الإيقاف();
        سجل_بإعداد(السجل, مستوى_سجل.تصحيح(), «no thread for the signal watcher; Ctrl+C stops the process at once»);
        أرجع خطأ;
    }
    | نتيجة.نجح(_) -> { أرجع صواب; };
}

// Whether a graceful shutdown was requested.
عام عرف طلب_الإيقاف(): منطقي { أرجع هل_طلب_إيقاف_الويب(); }

عام مرادف enable_graceful_shutdown = فعل_الإيقاف_الآمن;
عام مرادف shutdown_requested = طلب_الإيقاف;
عام مرادف wake_listeners = أيقظ_المستمعين;
عام مرادف process_line = سطر_العملية;
