من std.http استورد
    استجابة_نص_ويب,
    استجابة_ويب;

استورد response.headers;

// Generic application errors remain application-owned. Nahr only defines the
// conversion contract used at handler boundaries.
عام نوع محول_خطأ<E> = دالة(
    &E
): استجابة_ويب<متجه ط8>;

عام عرف حول_خطأ<E>(
    الخطأ: &E,
    المحول: محول_خطأ<E>
): استجابة {
    أرجع المحول(الخطأ);
}

// Small ready-made error type for simple applications. Larger applications
// should define their own error type and converter.
عام نوع خطأ_جاهز =
    | طلب_سيئ بنوع نص
    | غير_مصرح بنوع نص
    | ممنوع بنوع نص
    | غير_موجود بنوع نص
    | تعارض بنوع نص
    | داخلي بنوع نص
;

عام عرف رد_خطأ_جاهز(الخطأ: &خطأ_جاهز): استجابة {
    طابق *الخطأ مع
    | خطأ_جاهز.طلب_سيئ(النص) -> {
        أرجع استجابة_نص_ويب(400, &النص);
    }
    | خطأ_جاهز.غير_مصرح(النص) -> {
        أرجع استجابة_نص_ويب(401, &النص);
    }
    | خطأ_جاهز.ممنوع(النص) -> {
        أرجع استجابة_نص_ويب(403, &النص);
    }
    | خطأ_جاهز.غير_موجود(النص) -> {
        أرجع استجابة_نص_ويب(404, &النص);
    }
    | خطأ_جاهز.تعارض(النص) -> {
        أرجع استجابة_نص_ويب(409, &النص);
    }
    | خطأ_جاهز.داخلي(النص) -> {
        أرجع استجابة_نص_ويب(500, &النص);
    };
}

عام نوع error_mapper<E> = محول_خطأ<E>;
عام مرادف map_error = حول_خطأ;
عام مرادف common_error = خطأ_جاهز;
عام مرادف common_error_response = رد_خطأ_جاهز;
عام مرادف common_error.bad_request = خطأ_جاهز.طلب_سيئ;
عام مرادف common_error.unauthorized = خطأ_جاهز.غير_مصرح;
عام مرادف common_error.forbidden = خطأ_جاهز.ممنوع;
عام مرادف common_error.not_found = خطأ_جاهز.غير_موجود;
عام مرادف common_error.conflict = خطأ_جاهز.تعارض;
عام مرادف common_error.internal = خطأ_جاهز.داخلي;
