من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    أول_رأس_طلب_ويب,
    استجابة_نص_ويب;

استورد handler.adapter;
استورد extract.typed;

عام عرف رأس_طلب(
    الطلب: &طلب,
    الاسم: &نص
): اختياري نص {
    أرجع أول_رأس_طلب_ويب(الطلب, الاسم);
}

عرف نفذ_استخراج_رأس<S>(
    الاسم: &نص,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة اختياري نص, استجابة_ويب<متجه ط8> {
    أرجع نتيجة.نجح(رأس_طلب(الطلب, الاسم));
}

عام عرف استخرج_رأسا<S>(الاسم: &نص): مستخرج<S, اختياري نص> {
    ليكن الدالة: دالة_استخراج_بمعطى<S, اختياري نص> = دالة(
        الاسم_الممرر: &نص,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة اختياري نص, استجابة_ويب<متجه ط8> -> نفذ_استخراج_رأس(
        الاسم_الممرر,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع مستخرج_بمعطى(الدالة, الاسم);
}

عرف نفذ_استخراج_رأس_مطلوب<S>(
    الاسم: &نص,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة نص, استجابة_ويب<متجه ط8> {
    طابق رأس_طلب(الطلب, الاسم) مع
    | اختياري.موجود(القيمة) -> {
        أرجع نتيجة.نجح(القيمة);
    }
    | اختياري.لا_شيء -> {
        ليكن الرسالة: نص = «Required header is missing»;
        أرجع نتيجة.خطأ(
            استجابة_نص_ويب(400, &الرسالة)
        );
    };
}

عام عرف استخرج_رأسا_مطلوبا<S>(
    الاسم: &نص
): مستخرج<S, نص> {
    ليكن الدالة: دالة_استخراج_بمعطى<S, نص> = دالة(
        الاسم_الممرر: &نص,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة نص, استجابة_ويب<متجه ط8> -> نفذ_استخراج_رأس_مطلوب(
        الاسم_الممرر,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع مستخرج_بمعطى(الدالة, الاسم);
}

عام مرادف header = رأس_طلب;
عام مرادف extract_header = استخرج_رأسا;
عام مرادف extract_required_header = استخرج_رأسا_مطلوبا;
