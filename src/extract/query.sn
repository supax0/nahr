من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    استجابة_نص_ويب,
    زوج_استعلام_ويب,
    استعلام_هدف_ويب,
    حلل_استعلام_ويب,
    أول_قيمة_استعلام_ويب;

استورد std.text.number;
استورد handler.adapter;
استورد extract.typed;

عام نوع زوج_استعلام = زوج_استعلام_ويب;

عام نوع خطأ_استعلام =
    | استعلام_غير_صالح
    | معامل_مفقود
    | عدد_غير_صالح بنوع خطأ_تحليل_عدد
;

عام عرف استعلام(
    الطلب: &طلب
): نتيجة متجه زوج_استعلام, خطأ_استعلام {
    طابق استعلام_هدف_ويب(&(*الطلب).الهدف) مع
    | اختياري.لا_شيء -> {
        دع فارغ: متجه زوج_استعلام = [];
        أرجع نتيجة.نجح(فارغ);
    }
    | اختياري.موجود(النص) -> {
        طابق حلل_استعلام_ويب(&النص) مع
        | نتيجة.نجح(الأزواج) -> {
            أرجع نتيجة.نجح(الأزواج);
        }
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة.خطأ(
                خطأ_استعلام.استعلام_غير_صالح()
            );
        };
    };
}

عام عرف معامل_استعلام(
    الطلب: &طلب,
    الاسم: &نص
): نتيجة اختياري نص, خطأ_استعلام {
    طابق استعلام(الطلب) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(الأزواج) -> {
        أرجع نتيجة.نجح(
            أول_قيمة_استعلام_ويب(&الأزواج, الاسم)
        );
    };
}

عام عرف معامل_استعلام_مطلوب(
    الطلب: &طلب,
    الاسم: &نص
): نتيجة نص, خطأ_استعلام {
    طابق معامل_استعلام(الطلب, الاسم) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(اختياري.لا_شيء) -> {
        أرجع نتيجة.خطأ(خطأ_استعلام.معامل_مفقود());
    }
    | نتيجة.نجح(اختياري.موجود(القيمة)) -> {
        أرجع نتيجة.نجح(القيمة);
    };
}

عام عرف معامل_استعلام_عدد(
    الطلب: &طلب,
    الاسم: &نص
): نتيجة عدد, خطأ_استعلام {
    طابق معامل_استعلام_مطلوب(الطلب, الاسم) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(النص) -> {
        طابق حلل_عدد(&النص) مع
        | نتيجة.نجح(القيمة) -> {
            أرجع نتيجة.نجح(القيمة);
        }
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(
                خطأ_استعلام.عدد_غير_صالح(الخطأ)
            );
        };
    };
}

عام عرف معامل_استعلام_طبيعي(
    الطلب: &طلب,
    الاسم: &نص
): نتيجة طبيعي, خطأ_استعلام {
    طابق معامل_استعلام_مطلوب(الطلب, الاسم) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(النص) -> {
        طابق حلل_طبيعي(&النص) مع
        | نتيجة.نجح(القيمة) -> {
            أرجع نتيجة.نجح(القيمة);
        }
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(
                خطأ_استعلام.عدد_غير_صالح(الخطأ)
            );
        };
    };
}

عرف رفض_استعلام(): استجابة_ويب<متجه ط8> {
    دع الرسالة: نص = «Invalid query parameter»;
    أرجع استجابة_نص_ويب(400, &الرسالة);
}

عرف نفذ_استخراج_معامل_استعلام<S>(
    الاسم: &نص,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة اختياري نص, استجابة_ويب<متجه ط8> {
    طابق معامل_استعلام(الطلب, الاسم) مع
    | نتيجة.نجح(القيمة) -> {
        أرجع نتيجة.نجح(القيمة);
    }
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(رفض_استعلام());
    };
}

عام عرف استخرج_معامل_استعلام<S>(
    الاسم: &نص
): مستخرج<S, اختياري نص> {
    دع الدالة: دالة_استخراج_بمعطى<S, اختياري نص> = دالة(
        الاسم_الممرر: &نص,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة اختياري نص, استجابة_ويب<متجه ط8> -> نفذ_استخراج_معامل_استعلام(
        الاسم_الممرر,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع مستخرج_بمعطى(الدالة, الاسم);
}

عرف نفذ_استخراج_معامل_استعلام_مطلوب<S>(
    الاسم: &نص,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
