عام مرادف query_pair = زوج_استعلام;
عام مرادف query_error = خطأ_استعلام;
عام مرادف query_params = استعلام;
عام مرادف query_param = معامل_استعلام;
عام مرادف required_query_param = معامل_استعلام_مطلوب;
عام مرادف query_int = معامل_استعلام_عدد;
عام مرادف query_uint = معامل_استعلام_طبيعي;
عام مرادف extract_query = استخرج_معامل_استعلام;
عام مرادف extract_required_query = استخرج_معامل_استعلام_مطلوب;
عام مرادف extract_query_int = استخرج_معامل_استعلام_عدد;
عام مرادف extract_query_uint = استخرج_معامل_استعلام_طبيعي;
عام مرادف query_error.invalid_query = خطأ_استعلام.استعلام_غير_صالح;
عام مرادف query_error.missing = خطأ_استعلام.معامل_مفقود;
عام مرادف query_error.invalid_number = خطأ_استعلام.عدد_غير_صالح;
