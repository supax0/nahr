    دع الدالة: دالة_استخراج_بمعطى<S, نص> = دالة(
        الاسم_الممرر: &نص,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة نص, استجابة_ويب<متجه ط8> -> نفذ_استخراج_معامل_استعلام_مطلوب(
        الاسم_الممرر,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع مستخرج_بمعطى(الدالة, الاسم);
}

