من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب;

// Typed extraction contract. An extractor either produces one application
// value or an HTTP response that ends request processing before the handler.
//
// SultanC closures capture plain values only (numbers, booleans, function
// values), so an extractor cannot keep its configuration (a parameter or
// header name) inside a closure. The configuration travels as data instead:
// `المعطيات` holds the extractor's text arguments, and `التنفيذ` receives
// that vector plus the offset where its own arguments start. Combined
// extractors concatenate their parts' arguments and pass each part its offset,
// so no text is ever captured or copied per request.
عام نوع تنفيذ_مستخرج<S, T> = دالة(
    &متجه نص,
    طبيعي,
    &S,
    &طلب_ويب<متجه ط8>,
    &معاملات_مسار_ويب
): نتيجة T, استجابة_ويب<متجه ط8>;

عام نوع مستخرج<S, T> = {
    التنفيذ: تنفيذ_مستخرج<S, T>,
    المعطيات: متجه نص
};

// Plain extractor function: no text arguments.
عام نوع دالة_استخراج<S, T> = دالة(
    &S,
    &طلب_ويب<متجه ط8>,
    &معاملات_مسار_ويب
): نتيجة T, استجابة_ويب<متجه ط8>;

// Extractor function with exactly one text argument (a name).
عام نوع دالة_استخراج_بمعطى<S, T> = دالة(
    &نص,
    &S,
    &طلب_ويب<متجه ط8>,
    &معاملات_مسار_ويب
): نتيجة T, استجابة_ويب<متجه ط8>;

عام نوع قيمتان<A, B> = {
    الأولى: A,
    الثانية: B
};

عام نوع ثلاث_قيم<A, B, C> = {
    الأولى: A,
    الثانية: B,
    الثالثة: C
};

// Runs an extractor with its own arguments.
عام عرف استخرج<S, T>(
    المستخرج: &مستخرج<S, T>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة T, استجابة_ويب<متجه ط8> {
    دع التنفيذ: تنفيذ_مستخرج<S, T> = (*المستخرج).التنفيذ;
    أرجع التنفيذ(
        &(*المستخرج).المعطيات,
        0,
        الحالة,
        الطلب,
        المعاملات
    );
}

عرف نفذ_دالة_استخراج<S, T>(
    الدالة: دالة_استخراج<S, T>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة T, استجابة_ويب<متجه ط8> {
    أرجع الدالة(الحالة, الطلب, المعاملات);
}

// Wraps an application extractor function that needs no arguments.
عام عرف مستخرج_من_دالة<S, T>(
    الدالة: دالة_استخراج<S, T>
): مستخرج<S, T> {
    دع التنفيذ: تنفيذ_مستخرج<S, T> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة T, استجابة_ويب<متجه ط8> -> نفذ_دالة_استخراج(
        الدالة,
        الحالة,
        الطلب,
        المعاملات
    );
    دع المعطيات: متجه نص = [];
    دع الناتج: مستخرج<S, T> = {
        التنفيذ: التنفيذ,
        المعطيات: المعطيات
    };
    أرجع الناتج;
}

عرف نفذ_دالة_استخراج_بمعطى<S, T>(
    الدالة: دالة_استخراج_بمعطى<S, T>,
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة T, استجابة_ويب<متجه ط8> {
    أرجع الدالة(
        &(*المعطيات)[الإزاحة],
        الحالة,
        الطلب,
        المعاملات
    );
}

// Wraps an extractor function configured by one text argument.
عام عرف مستخرج_بمعطى<S, T>(
    الدالة: دالة_استخراج_بمعطى<S, T>,
    المعطى: &نص
): مستخرج<S, T> {
    دع التنفيذ: تنفيذ_مستخرج<S, T> = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة T, استجابة_ويب<متجه ط8> -> نفذ_دالة_استخراج_بمعطى(
        الدالة,
        المعطيات,
        الإزاحة,
        الحالة,
        الطلب,
        المعاملات
    );
    دع المعطيات: متغير متجه نص = [];
    ألحق(المعطيات, استنسخ(المعطى));
    دع الناتج: مستخرج<S, T> = {
        التنفيذ: التنفيذ,
        المعطيات: المعطيات
    };
    أرجع الناتج;
}

// Appends a copy of every argument of المصدر to الهدف.
عام عرف ألحق_معطيات(
    الهدف: &متغير متجه نص,
    المصدر: &متجه نص
): فراغ {
    دع الموضع: متغير طبيعي = 0;
    طالما (الموضع < (الطول(*المصدر) مثل طبيعي)) {
        ألحق(*الهدف, استنسخ(&(*المصدر)[الموضع]));
        الموضع := الموضع + 1;
    }
}

عرف نفذ_جمع_مستخرجين<S, A, B>(
    الأول: تنفيذ_مستخرج<S, A>,
    الثاني: تنفيذ_مستخرج<S, B>,
    عدد_الأول: طبيعي,
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة قيمتان<A, B>, استجابة_ويب<متجه ط8> {
    دع القيمة_الأولى: A;
    طابق الأول(المعطيات, الإزاحة, الحالة, الطلب, المعاملات) مع
    | نتيجة.خطأ(الاستجابة) -> { أرجع نتيجة.خطأ(الاستجابة); }
    | نتيجة.نجح(القيمة) -> { القيمة_الأولى := القيمة; };

    دع القيمة_الثانية: B;
    طابق الثاني(
        المعطيات,
        الإزاحة + عدد_الأول,
        الحالة,
        الطلب,
        المعاملات
    ) مع
    | نتيجة.خطأ(الاستجابة) -> { أرجع نتيجة.خطأ(الاستجابة); }
    | نتيجة.نجح(القيمة) -> { القيمة_الثانية := القيمة; };

    دع القيم: قيمتان<A, B> = {
        الأولى: القيمة_الأولى,
        الثانية: القيمة_الثانية
    };
    أرجع نتيجة.نجح(القيم);
}

عام عرف اجمع_مستخرجين<S, A, B>(
    الأول: مستخرج<S, A>,
    الثاني: مستخرج<S, B>
): مستخرج<S, قيمتان<A, B> > {
    دع تنفيذ_الأول: تنفيذ_مستخرج<S, A> = الأول.التنفيذ;
    دع تنفيذ_الثاني: تنفيذ_مستخرج<S, B> = الثاني.التنفيذ;
    دع عدد_الأول: طبيعي = الطول(الأول.المعطيات) مثل طبيعي;
    دع التنفيذ: تنفيذ_مستخرج<S, قيمتان<A, B> > = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة قيمتان<A, B>, استجابة_ويب<متجه ط8> -> نفذ_جمع_مستخرجين(
        تنفيذ_الأول,
        تنفيذ_الثاني,
        عدد_الأول,
        المعطيات,
        الإزاحة,
        الحالة,
        الطلب,
        المعاملات
    );
    دع المعطيات: متغير متجه نص = [];
    ألحق_معطيات(&متغير المعطيات, &الأول.المعطيات);
    ألحق_معطيات(&متغير المعطيات, &الثاني.المعطيات);
    دع الناتج: مستخرج<S, قيمتان<A, B> > = {
        التنفيذ: التنفيذ,
        المعطيات: المعطيات
    };
    أرجع الناتج;
}

عرف نفذ_جمع_ثلاثة_مستخرجات<S, A, B, C>(
    الأول: تنفيذ_مستخرج<S, A>,
    الثاني: تنفيذ_مستخرج<S, B>,
    الثالث: تنفيذ_مستخرج<S, C>,
    عدد_الأول: طبيعي,
    عدد_الثاني: طبيعي,
    المعطيات: &متجه نص,
    الإزاحة: طبيعي,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة ثلاث_قيم<A, B, C>, استجابة_ويب<متجه ط8> {
    دع القيمة_الأولى: A;
    طابق الأول(المعطيات, الإزاحة, الحالة, الطلب, المعاملات) مع
    | نتيجة.خطأ(الاستجابة) -> { أرجع نتيجة.خطأ(الاستجابة); }
    | نتيجة.نجح(القيمة) -> { القيمة_الأولى := القيمة; };

    دع القيمة_الثانية: B;
    طابق الثاني(
        المعطيات,
        الإزاحة + عدد_الأول,
        الحالة,
        الطلب,
        المعاملات
    ) مع
    | نتيجة.خطأ(الاستجابة) -> { أرجع نتيجة.خطأ(الاستجابة); }
    | نتيجة.نجح(القيمة) -> { القيمة_الثانية := القيمة; };

    دع القيمة_الثالثة: C;
    طابق الثالث(
        المعطيات,
        الإزاحة + عدد_الأول + عدد_الثاني,
        الحالة,
        الطلب,
        المعاملات
    ) مع
    | نتيجة.خطأ(الاستجابة) -> { أرجع نتيجة.خطأ(الاستجابة); }
    | نتيجة.نجح(القيمة) -> { القيمة_الثالثة := القيمة; };

    دع القيم: ثلاث_قيم<A, B, C> = {
        الأولى: القيمة_الأولى,
        الثانية: القيمة_الثانية,
        الثالثة: القيمة_الثالثة
    };
    أرجع نتيجة.نجح(القيم);
}

عام عرف اجمع_ثلاثة_مستخرجات<S, A, B, C>(
    الأول: مستخرج<S, A>,
    الثاني: مستخرج<S, B>,
    الثالث: مستخرج<S, C>
): مستخرج<S, ثلاث_قيم<A, B, C> > {
    دع تنفيذ_الأول: تنفيذ_مستخرج<S, A> = الأول.التنفيذ;
    دع تنفيذ_الثاني: تنفيذ_مستخرج<S, B> = الثاني.التنفيذ;
    دع تنفيذ_الثالث: تنفيذ_مستخرج<S, C> = الثالث.التنفيذ;
    دع عدد_الأول: طبيعي = الطول(الأول.المعطيات) مثل طبيعي;
    دع عدد_الثاني: طبيعي = الطول(الثاني.المعطيات) مثل طبيعي;
    دع التنفيذ: تنفيذ_مستخرج<S, ثلاث_قيم<A, B, C> > = دالة(
        المعطيات: &متجه نص,
        الإزاحة: طبيعي,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة ثلاث_قيم<A, B, C>, استجابة_ويب<متجه ط8> -> نفذ_جمع_ثلاثة_مستخرجات(
        تنفيذ_الأول,
        تنفيذ_الثاني,
        تنفيذ_الثالث,
        عدد_الأول,
        عدد_الثاني,
        المعطيات,
        الإزاحة,
        الحالة,
        الطلب,
        المعاملات
    );
    دع المعطيات: متغير متجه نص = [];
    ألحق_معطيات(&متغير المعطيات, &الأول.المعطيات);
    ألحق_معطيات(&متغير المعطيات, &الثاني.المعطيات);
    ألحق_معطيات(&متغير المعطيات, &الثالث.المعطيات);
    دع الناتج: مستخرج<S, ثلاث_قيم<A, B, C> > = {
        التنفيذ: التنفيذ,
        المعطيات: المعطيات
    };
    أرجع الناتج;
}

عام نوع extractor<S, T> = مستخرج<S, T>;
عام نوع extractor_run<S, T> = تنفيذ_مستخرج<S, T>;
عام نوع extractor_fn<S, T> = دالة_استخراج<S, T>;
عام نوع extractor_fn_with_arg<S, T> = دالة_استخراج_بمعطى<S, T>;
عام نوع extracted_pair<A, B> = قيمتان<A, B>;
عام نوع extracted_triple<A, B, C> = ثلاث_قيم<A, B, C>;
عام مرادف extract = استخرج;
عام مرادف extractor_from_fn = مستخرج_من_دالة;
عام مرادف extractor_with_arg = مستخرج_بمعطى;
عام مرادف append_arguments = ألحق_معطيات;
عام مرادف combine_extractors = اجمع_مستخرجين;
عام مرادف combine_three_extractors = اجمع_ثلاثة_مستخرجات;
