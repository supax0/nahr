من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    أول_قيمة_رأس_ويب,
    استجابة_نص_ويب;

استورد std.text.search;
استورد std.text.substring;
استورد std.text.transform;
استورد handler.adapter;
استورد extract.typed;
استورد response.headers;

عام نوع خطأ_مصادقة =
    | مفقود
    | مخطط_غير_مدعوم
    | رمز_فارغ
    | رمز_غير_صالح
;

// Whether ب may appear in a bearer token (RFC 6750 §2.1, b64token):
// ALPHA / DIGIT / "-" / "." / "_" / "~" / "+" / "/", then "=" padding.
عرف محرف_رمز_حامل(ب: ط8): منطقي {
    إذا ((ب >= 0x41 && ب <= 0x5A) || (ب >= 0x61 && ب <= 0x7A)) { أرجع صواب; };
    إذا (ب >= 0x30 && ب <= 0x39) { أرجع صواب; };
    أرجع ب == 0x2D || ب == 0x2E || ب == 0x5F || ب == 0x7E
        || ب == 0x2B || ب == 0x2F;
}

// Parses `Authorization: Bearer <token>`. The scheme is case-insensitive
// (RFC 9110 §11.1) and may be followed by several spaces.
عام عرف رمز_حامل(
    الطلب: &طلب
): نتيجة نص, خطأ_مصادقة {
    ليكن الاسم: نص = «authorization»;
    ليكن القيمة: نص;
    طابق أول_قيمة_رأس_ويب(&(*الطلب).الرؤوس, &الاسم) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_مصادقة.مفقود()); }
    | اختياري.موجود(النص) -> { القيمة := النص; };

    ليكن العدد: طبيعي = الطول(القيمة) مثل طبيعي;
    ليكن المخطط: نص = «bearer»;
    إذا (العدد < 6) {
        أرجع نتيجة.خطأ(خطأ_مصادقة.مخطط_غير_مدعوم());
    };
    طابق مقطع_نص(&القيمة, 0, 6) مع
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_مصادقة.مخطط_غير_مدعوم()); }
    | اختياري.موجود(البداية) -> {
        إذا (!نصان_متساويان_بلا_حالة_أسكي(&البداية, &المخطط)) {
            أرجع نتيجة.خطأ(خطأ_مصادقة.مخطط_غير_مدعوم());
        };
    };
    إذا (العدد == 6) { أرجع نتيجة.خطأ(خطأ_مصادقة.رمز_فارغ()); };
    إذا (القيمة[6] != 0x20) {
        // "Bearerx…" is another scheme.
        أرجع نتيجة.خطأ(خطأ_مصادقة.مخطط_غير_مدعوم());
    };
    ليكن البداية: متغير طبيعي = 6;
    طالما (البداية < العدد && القيمة[البداية] == 0x20) {
        البداية := البداية + 1;
    }
    ليكن النهاية: متغير طبيعي = العدد;
    طالما (النهاية > البداية && القيمة[النهاية - 1] == 0x20) {
        النهاية := النهاية - 1;
    }
    إذا (البداية >= النهاية) { أرجع نتيجة.خطأ(خطأ_مصادقة.رمز_فارغ()); };

    ليكن ف: متغير طبيعي = البداية;
    طالما (ف < النهاية && محرف_رمز_حامل(القيمة[ف])) { ف := ف + 1; }
    إذا (ف == البداية) { أرجع نتيجة.خطأ(خطأ_مصادقة.رمز_غير_صالح()); };
    طالما (ف < النهاية && القيمة[ف] == 0x3D) { ف := ف + 1; }
    إذا (ف != النهاية) { أرجع نتيجة.خطأ(خطأ_مصادقة.رمز_غير_صالح()); };

    طابق مقطع_نص(&القيمة, البداية, النهاية - البداية) مع
    | اختياري.موجود(الرمز) -> { أرجع نتيجة.نجح(الرمز); }
    | اختياري.لا_شيء -> { أرجع نتيجة.خطأ(خطأ_مصادقة.رمز_فارغ()); };
}

// 401 with a Bearer challenge. A request without credentials gets the bare
// challenge; a malformed or rejected token gets `error="invalid_request"` or
// `error="invalid_token"` (RFC 6750 §3, §3.1).
عام عرف رد_غير_مصرح_حامل(الخطأ: &نص): استجابة_ويب<متجه ط8> {
    ليكن الرسالة: نص = «Unauthorized»;
    ليكن الاستجابة: متغير استجابة_ويب<متجه ط8> =
        استجابة_نص_ويب(401, &الرسالة);
    ليكن الاسم: نص = «www-authenticate»;
    ليكن القيمة: متغير نص = «Bearer»;
    إذا ((الطول(*الخطأ) مثل طبيعي) > 0) {
        ليكن الأجزاء: متجه نص = [«Bearer error="», استنسخ(الخطأ), «"»];
        ليكن فارغ: نص = «»;
        القيمة := صل_النصوص(&الأجزاء, &فارغ);
    };
    ليكن تجاهل: منطقي = عين_رأسا(
        &متغير الاستجابة,
        &الاسم,
        &القيمة
    );
    أرجع الاستجابة;
}

عرف رمز_خطأ_حامل(الخطأ: &خطأ_مصادقة): نص {
    طابق *الخطأ مع
    | خطأ_مصادقة.مفقود -> { أرجع «»; }
    | خطأ_مصادقة.مخطط_غير_مدعوم -> { أرجع «»; }
    | خطأ_مصادقة.رمز_فارغ -> { أرجع «invalid_request»; }
    | خطأ_مصادقة.رمز_غير_صالح -> { أرجع «invalid_request»; };
}

عرف رفض_مصادقة(الخطأ: &خطأ_مصادقة): استجابة_ويب<متجه ط8> {
    ليكن الرمز: نص = رمز_خطأ_حامل(الخطأ);
    أرجع رد_غير_مصرح_حامل(&الرمز);
}

عرف نفذ_استخراج_رمز_حامل<S>(
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة نص, استجابة_ويب<متجه ط8> {
    طابق رمز_حامل(الطلب) مع
    | نتيجة.نجح(الرمز) -> {
        أرجع نتيجة.نجح(الرمز);
    }
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(رفض_مصادقة(&الخطأ));
    };
}

عام عرف استخرج_رمز_حامل<S>(): مستخرج<S, نص> {
    ليكن المستخرج: دالة_استخراج<S, نص> = دالة(
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة نص, استجابة_ويب<متجه ط8> ->
        نفذ_استخراج_رمز_حامل(
            الحالة,
            الطلب,
            المعاملات
        );
    أرجع مستخرج_من_دالة(المستخرج);
}

عام نوع مدقق_هوية_حامل<S, T> = دالة(
    &S,
    &نص
): نتيجة T, استجابة_ويب<متجه ط8>;

عرف نفذ_استخراج_هوية_حامل<S, T>(
    المدقق: مدقق_هوية_حامل<S, T>,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة T, استجابة_ويب<متجه ط8> {
    طابق رمز_حامل(الطلب) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(رفض_مصادقة(&الخطأ));
    }
    | نتيجة.نجح(الرمز) -> {
        أرجع المدقق(الحالة, &الرمز);
    };
}

عام عرف استخرج_هوية_حامل<S, T>(
    المدقق: مدقق_هوية_حامل<S, T>
): مستخرج<S, T> {
    ليكن المستخرج: دالة_استخراج<S, T> = دالة(
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة T, استجابة_ويب<متجه ط8> ->
        نفذ_استخراج_هوية_حامل(
            المدقق,
            الحالة,
            الطلب,
            المعاملات
        );
    أرجع مستخرج_من_دالة(المستخرج);
}

عام مرادف auth_error = خطأ_مصادقة;
عام مرادف bearer_token = رمز_حامل;
عام مرادف extract_bearer = استخرج_رمز_حامل;
عام نوع bearer_identity_validator<S, T> = مدقق_هوية_حامل<S, T>;
عام مرادف extract_bearer_identity = استخرج_هوية_حامل;
عام مرادف auth_error.missing = خطأ_مصادقة.مفقود;
عام مرادف auth_error.unsupported_scheme = خطأ_مصادقة.مخطط_غير_مدعوم;
عام مرادف auth_error.empty_token = خطأ_مصادقة.رمز_فارغ;
عام مرادف auth_error.invalid_token = خطأ_مصادقة.رمز_غير_صالح;
عام مرادف bearer_unauthorized = رد_غير_مصرح_حامل;
