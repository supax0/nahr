من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    قيمة_معامل_مسار_ويب,
    استجابة_نص_ويب;

استورد std.text.number;
استورد std.uri.uri;
استورد extract.typed;

عام نوع معاملات_مسار = معاملات_مسار_ويب;

عام نوع خطأ_معامل_مسار =
    | مفقود
    | ترميز_غير_صالح
    | عدد_غير_صالح بنوع خطأ_تحليل_عدد
;

// The matched segment exactly as it appeared in the request target, still
// percent-encoded.
عام عرف معامل_مسار_خام(
    المعاملات: &معاملات_مسار,
    الاسم: &نص
): اختياري نص {
    أرجع قيمة_معامل_مسار_ويب(المعاملات, الاسم);
}

// The matched segment, percent-decoded (RFC 3986 §2.1) and checked to be
// UTF-8: "/users/%D8%B9%D9%84%D9%8A" gives "علي". Decoding happens after
// matching, so "%2F" never splits a segment.
عام عرف معامل_مسار(
    المعاملات: &معاملات_مسار,
    الاسم: &نص
): نتيجة نص, خطأ_معامل_مسار {
    طابق قيمة_معامل_مسار_ويب(المعاملات, الاسم) مع
    | اختياري.لا_شيء -> {
        أرجع نتيجة.خطأ(خطأ_معامل_مسار.مفقود());
    }
    | اختياري.موجود(الخام) -> {
        طابق فك_الترميز_النسبي(&الخام) مع
        | نتيجة.نجح(القيمة) -> { أرجع نتيجة.نجح(القيمة); }
        | نتيجة.خطأ(_) -> {
            أرجع نتيجة.خطأ(خطأ_معامل_مسار.ترميز_غير_صالح());
        };
    };
}

عام عرف معامل_مسار_عدد(
    المعاملات: &معاملات_مسار,
    الاسم: &نص
): نتيجة عدد, خطأ_معامل_مسار {
    طابق معامل_مسار(المعاملات, الاسم) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(النص) -> {
        طابق حلل_عدد(&النص) مع
        | نتيجة.نجح(القيمة) -> {
            أرجع نتيجة.نجح(القيمة);
        }
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(
                خطأ_معامل_مسار.عدد_غير_صالح(الخطأ)
            );
        };
    };
}

عام عرف معامل_مسار_طبيعي(
    المعاملات: &معاملات_مسار,
    الاسم: &نص
): نتيجة طبيعي, خطأ_معامل_مسار {
    طابق معامل_مسار(المعاملات, الاسم) مع
    | نتيجة.خطأ(الخطأ) -> {
        أرجع نتيجة.خطأ(الخطأ);
    }
    | نتيجة.نجح(النص) -> {
        طابق حلل_طبيعي(&النص) مع
        | نتيجة.نجح(القيمة) -> {
            أرجع نتيجة.نجح(القيمة);
        }
        | نتيجة.خطأ(الخطأ) -> {
            أرجع نتيجة.خطأ(
                خطأ_معامل_مسار.عدد_غير_صالح(الخطأ)
            );
        };
    };
}

عرف رفض_معامل_مسار(): استجابة_ويب<متجه ط8> {
    ليكن الرسالة: نص = «Invalid path parameter»;
    أرجع استجابة_نص_ويب(400, &الرسالة);
}

عرف نفذ_استخراج_معامل_مسار<S>(
    الاسم: &نص,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة نص, استجابة_ويب<متجه ط8> {
    طابق معامل_مسار(المعاملات, الاسم) مع
    | نتيجة.نجح(القيمة) -> {
        أرجع نتيجة.نجح(القيمة);
    }
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(رفض_معامل_مسار());
    };
}

عام عرف استخرج_معامل_مسار<S>(
    الاسم: &نص
): مستخرج<S, نص> {
    ليكن الدالة: دالة_استخراج_بمعطى<S, نص> = دالة(
        الاسم_الممرر: &نص,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة نص, استجابة_ويب<متجه ط8> -> نفذ_استخراج_معامل_مسار(
        الاسم_الممرر,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع مستخرج_بمعطى(الدالة, الاسم);
}

عرف نفذ_استخراج_معامل_مسار_عدد<S>(
    الاسم: &نص,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة عدد, استجابة_ويب<متجه ط8> {
    طابق معامل_مسار_عدد(المعاملات, الاسم) مع
    | نتيجة.نجح(القيمة) -> {
        أرجع نتيجة.نجح(القيمة);
    }
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(رفض_معامل_مسار());
    };
}

عام عرف استخرج_معامل_مسار_عدد<S>(
    الاسم: &نص
): مستخرج<S, عدد> {
    ليكن الدالة: دالة_استخراج_بمعطى<S, عدد> = دالة(
        الاسم_الممرر: &نص,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة عدد, استجابة_ويب<متجه ط8> -> نفذ_استخراج_معامل_مسار_عدد(
        الاسم_الممرر,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع مستخرج_بمعطى(الدالة, الاسم);
}

عرف نفذ_استخراج_معامل_مسار_طبيعي<S>(
    الاسم: &نص,
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة طبيعي, استجابة_ويب<متجه ط8> {
    طابق معامل_مسار_طبيعي(المعاملات, الاسم) مع
    | نتيجة.نجح(القيمة) -> {
        أرجع نتيجة.نجح(القيمة);
    }
    | نتيجة.خطأ(_) -> {
        أرجع نتيجة.خطأ(رفض_معامل_مسار());
    };
}

عام عرف استخرج_معامل_مسار_طبيعي<S>(
    الاسم: &نص
): مستخرج<S, طبيعي> {
    ليكن الدالة: دالة_استخراج_بمعطى<S, طبيعي> = دالة(
        الاسم_الممرر: &نص,
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة طبيعي, استجابة_ويب<متجه ط8> -> نفذ_استخراج_معامل_مسار_طبيعي(
        الاسم_الممرر,
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع مستخرج_بمعطى(الدالة, الاسم);
}

عام مرادف path_params = معاملات_مسار;
عام مرادف path_error = خطأ_معامل_مسار;
عام مرادف path_param = معامل_مسار;
عام مرادف raw_path_param = معامل_مسار_خام;
عام مرادف path_int = معامل_مسار_عدد;
عام مرادف path_uint = معامل_مسار_طبيعي;
عام مرادف extract_path = استخرج_معامل_مسار;
عام مرادف extract_path_int = استخرج_معامل_مسار_عدد;
عام مرادف extract_path_uint = استخرج_معامل_مسار_طبيعي;
عام مرادف path_error.missing = خطأ_معامل_مسار.مفقود;
عام مرادف path_error.invalid_encoding = خطأ_معامل_مسار.ترميز_غير_صالح;
عام مرادف path_error.invalid_number = خطأ_معامل_مسار.عدد_غير_صالح;
