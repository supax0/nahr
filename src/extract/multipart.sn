من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    استجابة_نص_ويب,
    جزء_متعدد_ويب,
    حدود_متعدد_ويب,
    صنف_خطأ_متعدد_ويب,
    حدود_متعدد_ويب_افتراضية,
    حلل_نموذج_متعدد_ويب,
    حلل_نموذج_متعدد_ويب_بحدود;

استورد handler.adapter;
استورد extract.typed;

عام نوع جزء_متعدد = جزء_متعدد_ويب;
عام نوع حدود_متعدد = حدود_متعدد_ويب;
عام نوع خطأ_متعدد = صنف_خطأ_متعدد_ويب;

عام عرف نموذج_متعدد(
    الطلب: &طلب
): نتيجة متجه جزء_متعدد, خطأ_متعدد {
    أرجع حلل_نموذج_متعدد_ويب(الطلب);
}

عام عرف نموذج_متعدد_بحدود(
    الطلب: &طلب,
    الحدود: &حدود_متعدد
): نتيجة متجه جزء_متعدد, خطأ_متعدد {
    أرجع حلل_نموذج_متعدد_ويب_بحدود(
        الطلب,
        الحدود
    );
}

عام عرف حدود_متعدد_افتراضية(): حدود_متعدد {
    أرجع حدود_متعدد_ويب_افتراضية();
}

عرف نفذ_استخراج_نموذج_متعدد<S>(
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة متجه جزء_متعدد, استجابة_ويب<متجه ط8> {
    طابق نموذج_متعدد(الطلب) مع
    | نتيجة.نجح(الأجزاء) -> {
        أرجع نتيجة.نجح(الأجزاء);
    }
    | نتيجة.خطأ(صنف_خطأ_متعدد_ويب.نوع_محتوى_مفقود) -> {
        ليكن الرسالة: نص = «Unsupported media type»;
        أرجع نتيجة.خطأ(استجابة_نص_ويب(415, &الرسالة));
    }
    | نتيجة.خطأ(صنف_خطأ_متعدد_ويب.ليس_نموذجا_متعدد_الأجزاء) -> {
        ليكن الرسالة: نص = «Unsupported media type»;
        أرجع نتيجة.خطأ(استجابة_نص_ويب(415, &الرسالة));
    }
    | نتيجة.خطأ(صنف_خطأ_متعدد_ويب.أجزاء_كثيرة) -> {
        ليكن الرسالة: نص = «Multipart body is too large»;
        أرجع نتيجة.خطأ(استجابة_نص_ويب(413, &الرسالة));
    }
    | نتيجة.خطأ(صنف_خطأ_متعدد_ويب.جزء_كبير) -> {
        ليكن الرسالة: نص = «Multipart body is too large»;
        أرجع نتيجة.خطأ(استجابة_نص_ويب(413, &الرسالة));
    }
    | نتيجة.خطأ(_) -> {
        ليكن الرسالة: نص = «Invalid multipart body»;
        أرجع نتيجة.خطأ(
            استجابة_نص_ويب(400, &الرسالة)
        );
    };
}

عام عرف استخرج_نموذجا_متعددا<S>(): مستخرج<S, متجه جزء_متعدد> {
    ليكن المستخرج: دالة_استخراج<S, متجه جزء_متعدد> = دالة(
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة متجه جزء_متعدد, استجابة_ويب<متجه ط8> ->
        نفذ_استخراج_نموذج_متعدد(
            الحالة,
            الطلب,
            المعاملات
        );
    أرجع مستخرج_من_دالة(المستخرج);
}

عام مرادف multipart_part = جزء_متعدد;
عام مرادف multipart_limits = حدود_متعدد;
عام مرادف multipart_error = خطأ_متعدد;
عام مرادف multipart = نموذج_متعدد;
عام مرادف extract_multipart = استخرج_نموذجا_متعددا;
عام مرادف multipart_with_limits = نموذج_متعدد_بحدود;
عام مرادف default_multipart_limits = حدود_متعدد_افتراضية;
