من std.http استورد
    طلب_ويب,
    استجابة_ويب,
    معاملات_مسار_ويب,
    استجابة_نص_ويب,
    نص_جسم_طلب_ويب,
    صنف_خطأ_جسم_ويب;

استورد extract.typed;

// The rejection for a body that could not be read: a missing or unexpected
// Content-Type is 415 Unsupported Media Type (RFC 9110 §15.5.16); anything
// else is 400.
عام عرف رفض_جسم(
    الخطأ: &صنف_خطأ_جسم_ويب,
    الرسالة: &نص
): استجابة_ويب<متجه ط8> {
    طابق *الخطأ مع
    | صنف_خطأ_جسم_ويب.نوع_محتوى_مفقود -> {
        دع النص: نص = «Unsupported media type»;
        أرجع استجابة_نص_ويب(415, &النص);
    }
    | صنف_خطأ_جسم_ويب.نوع_محتوى_غير_متوقع -> {
        دع النص: نص = «Unsupported media type»;
        أرجع استجابة_نص_ويب(415, &النص);
    }
    | _ -> {
        أرجع استجابة_نص_ويب(400, الرسالة);
    };
}

عرف نفذ_استخراج_نص<S>(
    الحالة: &S,
    الطلب: &طلب_ويب<متجه ط8>,
    المعاملات: &معاملات_مسار_ويب
): نتيجة نص, استجابة_ويب<متجه ط8> {
    طابق نص_جسم_طلب_ويب(الطلب) مع
    | نتيجة.نجح(النص) -> {
        أرجع نتيجة.نجح(النص);
    }
    | نتيجة.خطأ(الخطأ) -> {
        دع الرسالة: نص = «Invalid request body»;
        أرجع نتيجة.خطأ(رفض_جسم(&الخطأ, &الرسالة));
    };
}

عام عرف استخرج_نصا<S>(): مستخرج<S, نص> {
    دع المستخرج: دالة_استخراج<S, نص> = دالة(
        الحالة: &S,
        الطلب: &طلب_ويب<متجه ط8>,
        المعاملات: &معاملات_مسار_ويب
    ): نتيجة نص, استجابة_ويب<متجه ط8> -> نفذ_استخراج_نص(
        الحالة,
        الطلب,
        المعاملات
    );
    أرجع مستخرج_من_دالة(المستخرج);
}

عام مرادف text_body = استخرج_نصا;
عام مرادف body_rejection = رفض_جسم;
